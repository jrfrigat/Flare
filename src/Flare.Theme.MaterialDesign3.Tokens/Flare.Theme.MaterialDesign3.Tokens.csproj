<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(FlareLibTargetFrameworks)</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <PackageId>Flare.Theme.MaterialDesign3.Tokens</PackageId>
    <Description>Material Design 3 baseline design-token values (the reference DesignTokens and light/dark ColorSchemes), the Material 3 palettes and their tonal palette generator for the Flare Blazor component library. Derive custom Material themes from these via `with`. No CSS, JS or theme registration.</Description>
    <PackageTags>blazor;theming;design-tokens;material-design;md3;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flare.Abstractions\Flare.Abstractions.csproj" />
    <!-- Md3Palettes and Md3TonalGenerator build their palettes with PaletteFactory and ColorMath. -->
    <ProjectReference Include="..\Flare.Theming\Flare.Theming.csproj" />
  </ItemGroup>

</Project>
