@namespace Flare.Components
@typeparam TItem
@inherits FlareLocalizedComponentBase

@{
    SyncOptions(_srcOptions, _srcId, _source.Count, SelectSourceAt);
    SyncOptions(_tgtOptions, _tgtId, _target.Count, SelectTargetAt);
}

<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes">
    <!-- Source list -->
    <div class="@Css.Classes.Transfer.Panel">
        <div class="@Css.Classes.Transfer.PanelHeader">
            <FlareText Typo="TypographyScale.LabelLarge">@ResolvedSourceTitle (@_source.Count)</FlareText>
        </div>
        <div class="@Css.Classes.Transfer.List"
             role="listbox"
             aria-label="@ResolvedSourceTitle"
             aria-multiselectable="true"
             aria-activedescendant="@_srcActiveId"
             tabindex="0"
             @onfocus="FocusSource"
             @onkeydown="HandleSourceKeyDown">
            @for (var i = 0; i < _source.Count; i++)
            {
                var it = _source[i];
                var selected = _srcSelected.Contains(it);
                var option = _srcOptions[i];
                <div class="@BuildItemClass(selected, i == _srcActive)"
                     id="@option.Id"
                     @onclick="@option.Select"
                     role="option"
                     aria-selected="@(selected ? "true" : "false")">
                    @ItemText(it)
                </div>
            }
        </div>
    </div>

    <!-- Controls -->
    <div class="@Css.Classes.Transfer.Controls">
        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined"
                     OnClick="MoveToTarget"
                     Disabled="@(_srcSelected.Count == 0)"
                     aria-label="@(CoreText["Transfer_MoveToTarget"].Value)">›</FlareButton>
        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined"
                     OnClick="MoveAllToTarget"
                     Disabled="@(_source.Count == 0)"
                     aria-label="@(CoreText["Transfer_MoveAllToTarget"].Value)">»</FlareButton>
        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined"
                     OnClick="MoveToSource"
                     Disabled="@(_tgtSelected.Count == 0)"
                     aria-label="@(CoreText["Transfer_MoveToSource"].Value)">‹</FlareButton>
        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined"
                     OnClick="MoveAllToSource"
                     Disabled="@(_target.Count == 0)"
                     aria-label="@(CoreText["Transfer_MoveAllToSource"].Value)">«</FlareButton>
    </div>

    <!-- Target list -->
    <div class="@Css.Classes.Transfer.Panel">
        <div class="@Css.Classes.Transfer.PanelHeader">
            <FlareText Typo="TypographyScale.LabelLarge">@ResolvedTargetTitle (@_target.Count)</FlareText>
        </div>
        <div class="@Css.Classes.Transfer.List"
             role="listbox"
             aria-label="@ResolvedTargetTitle"
             aria-multiselectable="true"
             aria-activedescendant="@_tgtActiveId"
             tabindex="0"
             @onfocus="FocusTarget"
             @onkeydown="HandleTargetKeyDown">
            @for (var i = 0; i < _target.Count; i++)
            {
                var it = _target[i];
                var selected = _tgtSelected.Contains(it);
                var option = _tgtOptions[i];
                <div class="@BuildItemClass(selected, i == _tgtActive)"
                     id="@option.Id"
                     @onclick="@option.Select"
                     role="option"
                     aria-selected="@(selected ? "true" : "false")">
                    @ItemText(it)
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Items available in the source (left) panel.</summary>
    [Parameter] public IReadOnlyList<TItem>? SourceItems { get; set; }
    /// <summary>Items already placed in the target (right) panel.</summary>
    [Parameter] public IReadOnlyList<TItem>? TargetItems { get; set; }
    /// <summary>Callback raised when the target list changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<TItem>> TargetItemsChanged { get; set; }
    /// <summary>Function that returns the display text for an item.</summary>
    [Parameter] public Func<TItem, string>? ItemLabel { get; set; }
    /// <summary>Header label shown above the source panel; when null, the localized default is used.</summary>
    [Parameter] public string? SourceTitle { get; set; }
    /// <summary>Header label shown above the target panel; when null, the localized default is used.</summary>
    [Parameter] public string? TargetTitle { get; set; }

    protected override string ComponentCssClass => Css.Classes.Transfer.Root;

    private List<TItem> _source = [];
    private List<TItem> _target = [];
    private readonly HashSet<TItem> _srcSelected = [];
    private readonly HashSet<TItem> _tgtSelected = [];
    private int _srcActive = -1;
    private int _tgtActive = -1;
    private readonly string _srcId = "flare-transfer-src-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _tgtId = "flare-transfer-tgt-" + Guid.NewGuid().ToString("N")[..8];
    private readonly List<Option> _srcOptions = [];
    private readonly List<Option> _tgtOptions = [];

    private readonly record struct Option(string Id, Action Select);

    private string? _srcActiveId => _srcActive >= 0 && _srcActive < _srcOptions.Count ? _srcOptions[_srcActive].Id : null;
    private string? _tgtActiveId => _tgtActive >= 0 && _tgtActive < _tgtOptions.Count ? _tgtOptions[_tgtActive].Id : null;

    // IDs and click handlers belong to positions. The handler looks up the current item when clicked.
    private static void SyncOptions(List<Option> options, string listId, int count, Action<int> select)
    {
        if (options.Count > count) options.RemoveRange(count, options.Count - count);
        for (var i = options.Count; i < count; i++)
        {
            var index = i;
            options.Add(new Option($"{listId}-opt-{index}", () => select(index)));
        }
    }

    protected override void OnParametersSet()
    {
        _source = SourceItems?.ToList() ?? [];
        _target = TargetItems?.ToList() ?? [];
        _srcSelected.RemoveWhere(i => !_source.Contains(i));
        _tgtSelected.RemoveWhere(i => !_target.Contains(i));
        if (_srcActive >= _source.Count) _srcActive = _source.Count - 1;
        if (_tgtActive >= _target.Count) _tgtActive = _target.Count - 1;
    }

    private string ResolvedSourceTitle => SourceTitle ?? CoreText["Transfer_SourceTitle"].Value;
    private string ResolvedTargetTitle => TargetTitle ?? CoreText["Transfer_TargetTitle"].Value;

    private string ItemText(TItem item) => ItemLabel?.Invoke(item) ?? item?.ToString() ?? "";

    private static string BuildItemClass(bool selected, bool active) => (selected, active) switch
    {
        (true, true) => Css.Classes.Transfer.Item + " " + Css.Classes.Transfer.ItemSelected + " " + Css.Classes.Transfer.ItemActive,
        (true, false) => Css.Classes.Transfer.Item + " " + Css.Classes.Transfer.ItemSelected,
        (false, true) => Css.Classes.Transfer.Item + " " + Css.Classes.Transfer.ItemActive,
        _ => Css.Classes.Transfer.Item,
    };

    private void ToggleSrcSelect(TItem item) { if (!_srcSelected.Remove(item)) _srcSelected.Add(item); }
    private void ToggleTgtSelect(TItem item) { if (!_tgtSelected.Remove(item)) _tgtSelected.Add(item); }

    private void FocusSource() { if (_srcActive < 0 && _source.Count > 0) _srcActive = 0; }
    private void FocusTarget() { if (_tgtActive < 0 && _target.Count > 0) _tgtActive = 0; }

    private void SelectSourceAt(int index) { _srcActive = index; ToggleSrcSelect(_source[index]); }
    private void SelectTargetAt(int index) { _tgtActive = index; ToggleTgtSelect(_target[index]); }

    private void HandleSourceKeyDown(KeyboardEventArgs e)
        => HandleListKeyDown(e, _source.Count, _srcActive, v => _srcActive = v, () => ToggleSrcSelect(_source[_srcActive]));

    private void HandleTargetKeyDown(KeyboardEventArgs e)
        => HandleListKeyDown(e, _target.Count, _tgtActive, v => _tgtActive = v, () => ToggleTgtSelect(_target[_tgtActive]));

    private static void HandleListKeyDown(KeyboardEventArgs e, int count, int active, Action<int> setActive, Action toggle)
    {
        if (count == 0) return;
        switch (e.Key)
        {
            case "ArrowDown": setActive(Math.Min(active + 1, count - 1)); break;
            case "ArrowUp": setActive(active <= 0 ? 0 : active - 1); break;
            case "Home": setActive(0); break;
            case "End": setActive(count - 1); break;
            case " ":
            case "Enter":
                if (active < 0) setActive(0);
                else toggle();
                break;
        }
    }

    private async Task MoveToTarget()
    {
        foreach (var i in _srcSelected) { _source.Remove(i); _target.Add(i); }
        _srcSelected.Clear();
        await TargetItemsChanged.InvokeAsync(_target.AsReadOnly());
    }

    private async Task MoveAllToTarget()
    {
        _target.AddRange(_source);
        _source.Clear();
        _srcSelected.Clear();
        await TargetItemsChanged.InvokeAsync(_target.AsReadOnly());
    }

    private async Task MoveToSource()
    {
        foreach (var i in _tgtSelected) { _target.Remove(i); _source.Add(i); }
        _tgtSelected.Clear();
        await TargetItemsChanged.InvokeAsync(_target.AsReadOnly());
    }

    private async Task MoveAllToSource()
    {
        _source.AddRange(_target);
        _target.Clear();
        _tgtSelected.Clear();
        await TargetItemsChanged.InvokeAsync(_target.AsReadOnly());
    }
}
