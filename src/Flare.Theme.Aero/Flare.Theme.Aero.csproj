<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>$(FlareLibTargetFrameworks)</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <PackageId>Flare.Theme.Aero</PackageId>
    <Description>Aero (Windows 7 Aero / Office 2010 / 1C) theme for the Flare Blazor component library</Description>
    <PackageTags>blazor;theming;aero;aero;windows7;office2010;1c;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Built from components.imports.css into wwwroot/css/components.css; see Directory.Build.targets. -->
    <FlareCssBundle>components</FlareCssBundle>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flare.Abstractions\Flare.Abstractions.csproj" />
    <ProjectReference Include="..\Flare.Theming\Flare.Theming.csproj" />
    <ProjectReference Include="..\Flare.Theme.MaterialDesign3.Tokens\Flare.Theme.MaterialDesign3.Tokens.csproj" />
  </ItemGroup>

</Project>
