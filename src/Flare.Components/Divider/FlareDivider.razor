@namespace Flare.Components
@inherits FlareComponentBase

@if (Vertical)
{
    <div class="@BuildCssClass(Css.Classes.Divider.Vertical, _insetClass)" style="@Style" aria-hidden="true" @attributes="AdditionalAttributes"></div>
}
else if (ChildContent is not null || !string.IsNullOrEmpty(Text))
{
    @* A text divider is a labelled separator: the text is the meaning ("OR", a section name), and a
       caller-provided fragment may even be interactive. Hiding the whole node removed all of it from
       the accessibility tree; only the purely decorative line below stays hidden. *@
    <div class="@BuildCssClass(Css.Classes.Divider.Text, _textAlignClass, _insetClass)" style="@Style" @attributes="AdditionalAttributes">
        <span class="@Css.Classes.Divider.TextContent">@if (ChildContent is not null) { @ChildContent } else { @Text }</span>
    </div>
}
else
{
    <hr class="@BuildCssClass(_insetClass)" style="@Style" aria-hidden="true" @attributes="AdditionalAttributes" />
}

@code {
    /// <summary>Renders a vertical divider instead of horizontal.</summary>
    [Parameter] public bool Vertical { get; set; }
    /// <summary>Optional text label centered in the divider (e.g. "OR"). Ignored when
    /// <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Markup centered in the divider instead of <see cref="Text"/>. The label is the whole of
    /// what a divider renders, so content written between the tags binds here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Controls where the text label is anchored when <see cref="Text"/> is set.</summary>
    [Parameter] public DividerTextAlign TextAlign { get; set; } = DividerTextAlign.Center;
    /// <summary>Inset style (None full-bleed, Inset leading-edge, MiddleInset both edges).</summary>
    [Parameter] public DividerInset Inset { get; set; } = DividerInset.None;

    protected override string ComponentCssClass => Css.Classes.Divider.Root;

    private string _insetClass => Inset switch
    {
        DividerInset.Inset => Css.Classes.Divider.Inset,
        DividerInset.MiddleInset => Css.Classes.Divider.MiddleInset,
        _ => string.Empty,
    };

    // No gated ShouldRender: the old key covered only four parameters, so a changed Class, Style,
    // AdditionalAttributes or ChildContent after one unchanged render was skipped and the DOM kept the
    // stale markup. A divider is a handful of nodes; the diff is the cheaper correct answer.

    private string _textAlignClass => TextAlign switch
    {
        DividerTextAlign.Left  => Css.Classes.Divider.TextLeft,
        DividerTextAlign.Right => Css.Classes.Divider.TextRight,
        _                      => Css.Classes.Divider.TextCenter,
    };
}
