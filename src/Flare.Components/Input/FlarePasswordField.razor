@namespace Flare.Components
@inherits FlareEditableFieldBase
@implements IFlareField<string>
@using System.Linq.Expressions

<FlareField @ref="_field"
            TValue="string"
            Value="Value"
            ValueChanged="OnValueChanged"
            Label="@Label" LabelContent="@LabelContent"
            Placeholder="@Placeholder"
            HelperText="@HelperText"
            ErrorText="@ErrorText"
            Disabled="@Disabled"
            ReadOnly="@ReadOnly"
            Required="@Required"
            MaxLength="@MaxLength"
            Clearable="@Clearable"
            Autocomplete="@Autocomplete"
            Immediate="@Immediate"
            DebounceInterval="@DebounceInterval"
            Variant="@Variant"
            Size="@Size"
            Typo="@Typo"
            FullWidth="@FullWidth"
            Margin="@Margin"
            Class="@Class"
            Style="@Style"
            For="@For"
            OnFocus="@OnFocus"
            OnBlur="@OnBlur"
            OnKeyDown="@OnKeyDown"
            OnKeyUp="@OnKeyUp"
            Type="@(_showPassword ? "text" : "password")"
            AdditionalAttributes="@AdditionalAttributes">
    <TrailingIcon>
        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                     AriaLabel="@(_showPassword ? "Hide password" : "Show password")"
                     OnClick="ToggleVisibility">
            <LeadingIcon><FlareIconView Value="@(_showPassword ? FlareIcons.VisibilityOff : FlareIcons.Visibility)" /></LeadingIcon>
        </FlareButton>
    </TrailingIcon>
</FlareField>

@if (ShowStrength)
{
    @* FlareMeter rather than FlareProgress: the five stops ARE the scale, and a meter draws a scale
       where a progress bar draws a fraction. Colour comes from the semantic roles, so a theme moves it
       without this component knowing. *@
    <div class="@Css.Classes.Input.Strength">
        <FlareMeter Size="TrackSize.Xs" aria-hidden="true">
            @for (var step = 0; step < FlarePasswordStrength.MaxScore; step++)
            {
                <FlareMeterSegment Value="1" Color="@(step < _strength.Score ? StrengthColor : FlareColor.OnSurfaceVariant)" />
            }
        </FlareMeter>

        @* The score is announced, not just drawn: a meter nobody can hear is half a feature. Polite,
           because it changes on every keystroke and an assertive live region would interrupt typing. *@
        <span class="@Css.Classes.Input.StrengthLabel" role="status" aria-live="polite">
            @StrengthText
            @if (_strength.Suggestions.Count > 0)
            {
                <span class="@Css.Classes.Input.StrengthHint">@string.Join(" ", _strength.Suggestions)</span>
            }
        </span>
    </div>
}

@code {
    /// <summary>
    /// Shows a strength meter under the field. Off by default: a sign-in form has nothing to judge, and a
    /// meter there is noise.
    /// </summary>
    [Parameter] public bool ShowStrength { get; set; }

    /// <summary>
    /// Judges the password. Null uses <see cref="FlarePasswordRules.Evaluate"/>, which is a reasonable
    /// default and not a standard - password policy belongs to the application, so this is a delegate
    /// rather than a rule set baked into the component.
    /// </summary>
    [Parameter] public Func<string?, FlarePasswordStrength>? StrengthEvaluator { get; set; }

    /// <summary>The bound password value.</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Fires when the value changes, so the field can be driven with <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    // Label, Placeholder, HelperText, ErrorText, Disabled, ReadOnly and Required are inherited from
    // FlareFieldBase (IFlareField) and forwarded to the inner FlareField.
    /// <summary>Maximum number of characters allowed. 0 = no limit. Server-side validation is always required.</summary>
    [Parameter] public int MaxLength { get; set; } = 0;
    /// <summary>When true, the value updates on every keystroke (oninput) rather than only on change/blur.</summary>
    [Parameter] public bool Immediate { get; set; }
    /// <summary>Debounce in milliseconds for <see cref="Immediate"/> updates. 0 = no debounce.</summary>
    [Parameter] public int DebounceInterval { get; set; }
    /// <summary>When true (the default), the field is block-level and fills the width of its container.
    /// Set to false to size the field to its content (inline) instead.</summary>
    [Parameter] public bool FullWidth { get; set; } = true;
    /// <summary>Vertical (block) margin around the field. <see cref="FieldMargin.None"/> (default) leaves
    /// spacing to the surrounding layout; <see cref="FieldMargin.Dense"/> / <see cref="FieldMargin.Normal"/>
    /// add a compact / comfortable margin above and below.</summary>
    [Parameter] public FieldMargin Margin { get; set; } = FieldMargin.None;
    /// <summary>Expression used to bind and validate the field inside an <c>EditForm</c>.</summary>
    [Parameter] public Expression<Func<string>>? For { get; set; }
    /// <summary>Shows a clear (x) button inside the field when the input has a value.</summary>
    [Parameter] public bool Clearable { get; set; }
    /// <summary>The HTML <c>autocomplete</c> token; use <c>current-password</c> or <c>new-password</c>
    /// to drive password-manager autofill correctly.</summary>
    [Parameter] public string? Autocomplete { get; set; }
    /// <summary>Invoked when the input gains focus.</summary>
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.FocusEventArgs> OnFocus { get; set; }
    /// <summary>Invoked when the input loses focus.</summary>
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.FocusEventArgs> OnBlur { get; set; }
    /// <summary>Invoked on keydown in the input, so a form can submit on Enter directly from the password field.</summary>
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.KeyboardEventArgs> OnKeyDown { get; set; }
    /// <summary>Invoked on keyup in the input.</summary>
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.KeyboardEventArgs> OnKeyUp { get; set; }

    private bool _showPassword;
    private FlareField<string>? _field;
    protected override string ComponentCssClass => Css.Classes.PasswordInput.Root;

    /// <inheritdoc />
    protected override ValueTask FocusCoreAsync() => _field?.FocusAsync() ?? ValueTask.CompletedTask;
    /// <summary>Selects (highlights) all the text in the field.</summary>
    public ValueTask SelectAsync() => _field?.SelectAsync() ?? ValueTask.CompletedTask;
    /// <summary>Removes keyboard focus from the field.</summary>
    public ValueTask BlurAsync() => _field?.BlurAsync() ?? ValueTask.CompletedTask;

    private void ToggleVisibility() => _showPassword = !_showPassword;

    // Recomputed on render rather than cached: the evaluator is a caller's delegate over a string that
    // is at most a few dozen characters, and a cache here would be state that can disagree with Value.
    private FlarePasswordStrength _strength =>
        StrengthEvaluator is { } custom
            ? custom(Value)
            : FlarePasswordRules.Evaluate(Value, SuggestionText);

    // The rule returns keys so the default rule stays free of display text; the field turns them into
    // the localized sentences, which is where resx belongs.
    private static string SuggestionText(string key) => key switch
    {
        "Longer" => FlareStrings.Password_MakeLonger,
        "Mix" => FlareStrings.Password_MixCharacters,
        "Common" => FlareStrings.Password_TooCommon,
        _ => key,
    };

    // Red through amber to green, from the semantic roles, so a theme repoints them all at once.
    private FlareColor StrengthColor => _strength.Score switch
    {
        <= 1 => FlareColor.Error,
        2 => FlareColor.Warning,
        3 => FlareColor.Tertiary,
        _ => FlareColor.Success,
    };

    private string StrengthText => _strength.Score switch
    {
        0 => FlareStrings.Password_VeryWeak,
        1 => FlareStrings.Password_Weak,
        2 => FlareStrings.Password_Fair,
        3 => FlareStrings.Password_Good,
        _ => FlareStrings.Password_Strong,
    };

    // Propagate the inner field's change to this component's own ValueChanged so a consumer's
    // @bind-Value actually receives the typed value. Assign the local Value first so the field
    // reflects the change immediately (before the parent re-renders it back down).
    private async Task OnValueChanged(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

}
