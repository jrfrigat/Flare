@namespace Flare.Components
@inherits FlareEditableFieldBase
@implements IFlareField<string>
@using System.Linq.Expressions
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Web

<FlareFieldChrome Variant="Variant" Size="Size"
                  Invalid="@(!string.IsNullOrEmpty(DisplayedErrorText))"
                  Disabled="Disabled" ReadOnly="ReadOnly"
                  Label="@Label" LabelContent="@LabelContent" LabelFor="@ControlId"
                  HelperText="@HelperText" HelperId="@HelperId"
                  ErrorText="@DisplayedErrorText" ErrorId="@ErrorId"
                  Class="@Class" Style="@Style" Attributes="AdditionalAttributes">
    <Field>
        <div class="@Css.Classes.Input.Field">
            <FlareTextInput @ref="_input"
                               Value="@_display"
                               ValueChanged="OnInput"
                               Immediate="true"
                               Id="@ControlId"
                               Type="text"
                               InputMode="@EffectiveInputMode"
                               Placeholder="@(string.IsNullOrEmpty(Placeholder) ? _derivedPlaceholder : Placeholder)"
                               Disabled="Disabled"
                               ReadOnly="ReadOnly"
                               Required="Required"
                               MaxLength="@(Pattern?.Length ?? 0)"
                               AriaInvalid="@(!string.IsNullOrEmpty(DisplayedErrorText))"
                               AriaDescribedBy="@SupportDescribedBy"
                               OnFocus="OnFocus"
                               OnBlur="OnBlur"
                               OnKeyDown="OnKeyDown"
                               OnKeyUp="OnKeyUp"
                               Style="@_typoStyle"
                               AdditionalAttributes="InputAttributes" />
            @if (Clearable && !string.IsNullOrEmpty(_display) && !Disabled && !ReadOnly)
            {
                <button type="button"
                        class="@Css.Classes.Input.Clear"
                        aria-label="@(FlareStrings.Input_Clear)"
                        tabindex="-1"
                        @onclick="HandleClear">
                    <span aria-hidden="true">&#x2715;</span>
                </button>
            }
        </div>
    </Field>
</FlareFieldChrome>

@code {
    /// <summary>Current value as the field shows it: the text formatted by the active mask, or the literal
    /// text when <see cref="AutoApply"/> is false. Null when the field is empty.</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Raised with the formatted value as the user edits, or null when the field becomes empty.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>Mask pattern; use # digit, A letter, * alphanumeric. Overrides <see cref="Preset"/>.</summary>
    [Parameter] public string? Mask { get; set; }
    /// <summary>Ready-made mask preset (Phone/Date/Time/IpAddress/CreditCard/Ssn). Used when <see cref="Mask"/> is not set.</summary>
    [Parameter] public MaskPreset Preset { get; set; } = MaskPreset.None;
    /// <summary>Applies the mask while typing, inserting the mask literals. False keeps the typed text as is.</summary>
    [Parameter] public bool AutoApply { get; set; } = true;
    /// <summary>Expression used to bind and validate the field.</summary>
    [Parameter] public Expression<Func<string?>>? For { get; set; }
    /// <summary>Shows a clear (x) button inside the field when it has a value.</summary>
    [Parameter] public bool Clearable { get; set; }
    /// <summary>Invoked when the input gains focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnFocus { get; set; }
    /// <summary>Invoked when the input loses focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }
    /// <summary>Invoked on keydown in the input (e.g. to submit the form on Enter).</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    /// <summary>Invoked on keyup in the input.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyUp { get; set; }
    /// <summary>Invoked when the clear (x) button is clicked, after the value has been reset.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClearButtonClick { get; set; }

    protected override string ComponentCssClass => Css.Classes.Input.Root;

    private string _display = string.Empty;
    private FlareTextInput? _input;
    private string? _typoStyle => Typo is { } t ? FlareTypography.FontStyle(t) : null;

    /// <inheritdoc />
    protected override ValueTask FocusCoreAsync() => _input?.FocusAsync() ?? ValueTask.CompletedTask;
    /// <summary>Selects (highlights) all the text in the field.</summary>
    public ValueTask SelectAsync() => _input?.SelectAsync() ?? ValueTask.CompletedTask;
    /// <summary>Removes keyboard focus from the field.</summary>
    public ValueTask BlurAsync() => _input?.BlurAsync() ?? ValueTask.CompletedTask;

    private async Task HandleClear(MouseEventArgs e)
    {
        _display = string.Empty;
        await ValueChanged.InvokeAsync(null);
        NotifyFieldChanged();
        await OnClearButtonClick.InvokeAsync(e);
    }

    private string? Pattern => Mask ?? (Preset switch
    {
        MaskPreset.Phone      => "(###) ###-####",
        MaskPreset.Date       => "##/##/####",
        MaskPreset.Time       => "##:##",
        MaskPreset.IpAddress  => "###.###.###.###",
        MaskPreset.CreditCard => "#### #### #### ####",
        MaskPreset.Ssn        => "###-##-####",
        _ => null,
    });

    /// <summary>The mobile keyboard hint; derived from the mask when null.</summary>
    [Parameter] public string? InputMode { get; set; }

    private string? EffectiveInputMode
    {
        get
        {
            if (InputMode is { Length: > 0 }) return InputMode;
            if (Preset == MaskPreset.Phone) return "tel";
            if (Pattern is not { Length: > 0 } mask) return null;
            return mask.Any(c => c is 'A' or '*') ? null : "numeric";
        }
    }

    private string? _derivedPlaceholder => Pattern is null ? null : string.Concat(Pattern.Select(c =>
        c == '#' || c == 'A' || c == '*' ? '_' : c));

    private string? _lastValue;
    private string? _lastPattern;
    private bool _lastAutoApply;
    private bool _hasSyncedParameters;

    protected override void OnParametersSet()
    {
        UpdateFieldIdentifier(For);
        var pattern = Pattern;
        if (!_hasSyncedParameters || Value != _lastValue || pattern != _lastPattern || AutoApply != _lastAutoApply)
        {
            _hasSyncedParameters = true;
            _lastValue = Value;
            _lastPattern = pattern;
            _lastAutoApply = AutoApply;
            _display = FormatValue(Value);
        }
    }

    private string FormatValue(string? value) =>
        string.IsNullOrEmpty(value) ? string.Empty : AutoApply ? ApplyMask(value) : value;

    private static readonly TimeSpan RegexTimeout = TimeSpan.FromMilliseconds(100);

    private bool MatchesMask(string value)
    {
        if (string.IsNullOrEmpty(Pattern)) return true;
        try
        {
            return Regex.IsMatch(value, Pattern, RegexOptions.None, RegexTimeout);
        }
        catch (RegexMatchTimeoutException) { return false; }
    }

    private async Task OnInput(string? raw)
    {
        raw ??= string.Empty;
        _display = AutoApply ? ApplyMask(raw) : raw;
        await ValueChanged.InvokeAsync(_display.Length > 0 ? _display : null);
        NotifyFieldChanged();
    }

    private string ApplyMask(string input)
    {
        if (string.IsNullOrEmpty(Pattern)) return input;
        var raw = ExtractRaw(input);
        if (raw.Length == 0) return string.Empty;
        var result = new System.Text.StringBuilder();
        var ri = 0;
        foreach (var mc in Pattern) //-V3080 the IsNullOrEmpty(Pattern) guard above ensures Pattern is non-null here
        {
            var isPlaceholder = mc is '#' or 'A' or '*';
            if (isPlaceholder)
            {
                if (ri >= raw.Length) break;
                var c = raw[ri];
                var ok = mc switch
                {
                    '#' => char.IsDigit(c),
                    'A' => char.IsLetter(c),
                    _ => char.IsLetterOrDigit(c),
                };
                if (!ok) break;
                result.Append(c);
                ri++;
            }
            else
            {
                result.Append(mc);
                if (ri < raw.Length && raw[ri] == mc) ri++;
            }
        }
        return result.ToString();
    }

    private string ExtractRaw(string masked)
    {
        if (string.IsNullOrEmpty(Pattern)) return masked;
        var result = new System.Text.StringBuilder();
        var mi = 0;
        foreach (var c in masked)
        {
            // Skip mask literals not present in the input.
            var consumedLiteral = false;
            while (mi < Pattern.Length && Pattern[mi] is not ('#' or 'A' or '*'))
            {
                if (c == Pattern[mi]) { mi++; consumedLiteral = true; break; }
                mi++;
            }
            if (consumedLiteral) continue;
            if (mi >= Pattern.Length) break;
            result.Append(c);
            mi++;
        }
        return result.ToString();
    }
}
