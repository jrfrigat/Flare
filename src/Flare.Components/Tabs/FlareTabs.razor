@namespace Flare.Components
@inherits FlareContainerBase
@implements IAsyncDisposable
@inject Flare.Components.Services.IUiJsService Ui

<div class="@BuildCssClass(_verticalClass, _placementClass, _variantClass, _rotatedClass, _fillClass)" style="@_rootStyle" @attributes="AdditionalAttributes">
    <div class="@Css.Classes.Tabs.BarWrap">
    @if (HeaderStart is not null)
    {
        <div class="@Css.Classes.Tabs.HeaderStart">@HeaderStart</div>
    }
    @if (_showArrows)
    {
        <button type="button" class="@Css.Classes.Tabs.Scroll @Css.Classes.Tabs.ScrollPrev"
                disabled="@_atStart" aria-label="@(FlareStrings.Tabs_ScrollBack)"
                tabindex="-1" @onclick="ScrollPrev">
            <FlareIconView Value="FlareIcons.ChevronLeft" />
        </button>
    }
    <div class="@Css.Classes.Tabs.Bar" role="tablist" tabindex="-1" aria-orientation="@(_vertical ? "vertical" : "horizontal")" @ref="_barRef"
         data-flare-keyboard-fallback="@(_jsKeyboardRegistered ? null : "true")"
         @onkeydown="_fallbackKeyHandler">
        @foreach (var tab in _tabs)
        {
            var isActive = tab == _context?.ActiveTab;
            <div class="@Css.Classes.Tabs.Item" role="presentation" @key="tab">
            <button type="button" class="@Css.Classes.Tabs.TabButton @(isActive ? Css.Classes.Tabs.TabActive : "")"
                    id="@tab.TabId"
                    @ref="_tabElements[tab]"
                    role="tab"
                    aria-selected="@(isActive ? "true" : "false")"
                    aria-controls="@tab.PanelId"
                    aria-label="@tab.Label"
                    data-closeable="@(tab.Closeable ? "true" : null)"
                    title="@tab.Tooltip"
                    tabindex="@(isActive ? 0 : -1)"
                    disabled="@tab.Disabled"
                    @onclick="@(() => OnTabClick(tab))">
                @if (tab.LeadingIcon is not null)
                {
                    @tab.LeadingIcon
                }
                <span class="@Css.Classes.Tabs.Label">@tab.Label</span>
                @if (tab.BadgeDot)
                {
                    <span class="@Css.Classes.Tabs.Badge @Css.Classes.Tabs.BadgeDot @tab.BadgeColor.CssClass" style="@tab.BadgeColor.StyleMainOn()"></span>
                }
                else if (!string.IsNullOrEmpty(tab.Badge))
                {
                    <span class="@Css.Classes.Tabs.Badge @tab.BadgeColor.CssClass" style="@tab.BadgeColor.StyleMainOn()">@tab.Badge</span>
                }
            </button>
                @if (tab.Closeable)
                {
                    <button type="button" class="@Css.Classes.Tabs.TabClose" tabindex="-1" disabled="@tab.Disabled"
                            @onclick="@(() => CloseTab(tab))" @onclick:stopPropagation="true" aria-label="@($"{FlareStrings.Aria_CloseTab}: {tab.Label}")">
                        <FlareIconView Value="FlareIcons.Close" />
                    </button>
                }
            </div>
        }
    </div>
    @if (_showArrows)
    {
        <button type="button" class="@Css.Classes.Tabs.Scroll @Css.Classes.Tabs.ScrollNext"
                disabled="@_atEnd" aria-label="@(FlareStrings.Tabs_ScrollForward)"
                tabindex="-1" @onclick="ScrollNext">
            <FlareIconView Value="FlareIcons.ChevronRight" />
        </button>
    }
    @if (HeaderEnd is not null)
    {
        <div class="@Css.Classes.Tabs.HeaderEnd">@HeaderEnd</div>
    }
    </div>
    <div class="@Css.Classes.Tabs.Panels">
        <CascadingValue Value="_context" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>
</div>

@code {
    /// <summary>FlareTab panels rendered inside the tab container.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Custom content rendered at the start (left/top) of the tab header, before the tabs - e.g. a title or action buttons.</summary>
    [Parameter] public RenderFragment? HeaderStart { get; set; }
    /// <summary>Custom content rendered at the end (right/bottom) of the tab header, after the tabs - e.g. action buttons. The tab bar grows to push this to the far edge.</summary>
    [Parameter] public RenderFragment? HeaderEnd { get; set; }
    /// <summary>Type scale applied to the tab labels. Null (default) keeps the theme's label scale.</summary>
    [Parameter] public TypographyScale? Typo { get; set; }
    /// <summary>Side the tab bar is placed on (Top/Bottom/Left/Right). Left/Right render a vertical bar. Default Top.</summary>
    [Parameter] public TabsPlacement Placement { get; set; } = TabsPlacement.Top;
    /// <summary>Rotation applied to each tab label (0/90/180/270 degrees). Default none.</summary>
    [Parameter] public TabLabelRotation LabelRotation { get; set; } = TabLabelRotation.None;
    /// <summary>Visual variant of the tab bar (theme-independent). Default keeps the active theme's style.</summary>
    [Parameter] public TabsVariant Variant { get; set; } = TabsVariant.Default;
    /// <summary>Callback fired with the label of a closed tab.</summary>
    [Parameter] public EventCallback<string> OnTabClose { get; set; }
    /// <summary>Zero-based index of the active tab. Supports two-way binding (<c>@bind-ActiveIndex</c>).</summary>
    [Parameter] public int ActiveIndex { get; set; }
    /// <summary>Fired with the new active-tab index whenever the selection changes.</summary>
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    /// <summary>
    /// Invoked before a tab is activated or closed. Set <see cref="TabInteractionEventArgs.Cancel"/>
    /// in the handler to veto the interaction (e.g. block switching away from a tab with unsaved
    /// changes). Async handlers are awaited before the interaction proceeds.
    /// </summary>
    [Parameter] public EventCallback<TabInteractionEventArgs> OnPreviewInteraction { get; set; }
    /// <summary>
    /// When true, only the active tab's panel content is rendered: switching tabs unmounts the
    /// previous panel and mounts the new one. Keeps heavy tab content (large forms, token editors,
    /// data grids) out of the DOM and the component tree until its tab is opened. Default false
    /// renders every panel up front (inactive ones hidden with CSS), which preserves transient
    /// panel state across switches at the cost of building all panels at once.
    /// </summary>
    [Parameter] public bool Lazy { get; set; }

    protected override string ComponentCssClass => Css.Classes.Tabs.Root;

    private readonly List<FlareTab> _tabs = [];
    private FlareTab? _active;
    private int _currentIndex = -1;
    // Last ActiveIndex value seen from the parent; lets OnParametersSet tell a parent-driven change
    // apart from the user's own clicks (which advance _currentIndex but not ActiveIndex).
    private int _lastBoundIndex;
    private FlareTabsContext? _context;
    private string? _variantClass => Variant switch
    {
        TabsVariant.Underline => Css.Classes.Tabs.Underline,
        TabsVariant.Primary => Css.Classes.Tabs.Primary,
        TabsVariant.Secondary => Css.Classes.Tabs.Secondary,
        TabsVariant.Text => Css.Classes.Tabs.Text,
        TabsVariant.Tonal => Css.Classes.Tabs.Tonal,
        TabsVariant.Filled => Css.Classes.Tabs.Filled,
        TabsVariant.Outlined => Css.Classes.Tabs.Outlined,
        _ => null, // Default - theme's native underline styling
    };

    private bool _vertical => Placement is TabsPlacement.Left or TabsPlacement.Right;

    // Left/Right reuse the existing vertical bar styling; Bottom/Right add a flip modifier.
    private string? _verticalClass => _vertical ? Css.Classes.Tabs.Vertical : null;
    private string? _placementClass => Placement switch
    {
        TabsPlacement.Bottom => Css.Classes.Tabs.Bottom,
        TabsPlacement.Right => Css.Classes.Tabs.Right,
        _ => null,
    };

    private int _rotationDeg => LabelRotation switch
    {
        TabLabelRotation.Rotate90 => 90,
        TabLabelRotation.Rotate180 => 180,
        TabLabelRotation.Rotate270 => 270,
        _ => 0,
    };
    private string? _rotatedClass => _rotationDeg is 90 or 270 ? Css.Classes.Tabs.Rotated : null;
    private string? _fillClass => FillHeight ? $"{Css.Classes.Fill.Root} {Css.Classes.Tabs.Fill}" : null;

    // When Typo is set, repoint the tab-label font tokens at the chosen type scale.
    private string? _typoVars => Typo is { } t
        ? TypoVars(FlareTypography.Tokens(t))
        : null;

    // The tab-label tokens repointed at one type scale. The four scale names come from the registry
    // rather than from a slug, so Flare.CssAudit can see which step is being asked for.
    private static string TypoVars((string Font, string Weight, string Size, string Height) t) =>
        $"{Css.Tokens.Tabs.LabelFont}:var({t.Font});"
        + $"{Css.Tokens.Tabs.LabelSize}:var({t.Size});"
        + $"{Css.Tokens.Tabs.LabelWeight}:var({t.Weight})";

    // Cached in OnParametersSet - depends only on parameters (LabelRotation, Typo, Style), so it need
    // not be re-joined on every render (runtime state like overflow/active-tab does not affect it).
    private string _rootStyle = "";
    private string BuildRootStyle() =>
        string.Join(";", new[] { $"{Css.Tokens.LocalVars.TabLabelRotation}:{_rotationDeg}deg", _typoVars, Style }.Where(s => !string.IsNullOrEmpty(s)));

    // Overflow scrolling (horizontal only): JS reports overflow + edge state.
    private ElementReference _barRef;
    private readonly Dictionary<FlareTab, ElementReference> _tabElements = new();
    private FlareTab? _focusPending;
    private FlareTab? _closingTab;
    private bool _focusBarPending;
    private int _lastReportedIndex = -2;
    private DotNetObjectReference<FlareTabs>? _dotNetRef;
    private bool _overflowing;
    private bool _atStart = true;
    private bool _atEnd;
    private bool _jsKeyboardRegistered;
    private int _keyboardRegistrationAttempts;
    private bool _retryKeyboardPending;
    private bool _showArrows => _overflowing && !_vertical;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _headerRefreshPending = false;
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await RegisterKeyboardAsync();
            if (_jsKeyboardRegistered && !_vertical)
            {
                try { await Ui.RegisterTabScrollerAsync(_barRef, _dotNetRef); }
                catch (InvalidOperationException) { }
                catch (JSException) { }
            }
        }
        else if (_retryKeyboardPending)
        {
            _retryKeyboardPending = false;
            await RegisterKeyboardAsync();
        }
        if (_focusPending is { } target)
        {
            _focusPending = null;
            if (_tabElements.TryGetValue(target, out var element))
            {
                await element.FocusAsync(preventScroll: true);
                // The reveal is an enhancement of the module that owns the keyboard. When that module
                // failed to load, calling it throws and the circuit dies - which is what made the
                // C# fallback look like it lost the second key.
                if (_jsKeyboardRegistered)
                {
                    try { await Ui.RevealFocusedTabAsync(_barRef); }
                    catch (InvalidOperationException) { }
                    catch (JSException) { }
                }
            }
        }
        else if (_focusBarPending)
        {
            _focusBarPending = false;
            await _barRef.FocusAsync(preventScroll: true);
        }
        if (ActiveIndexChanged.HasDelegate && _currentIndex != ActiveIndex && _lastReportedIndex != _currentIndex)
        {
            _lastReportedIndex = _currentIndex;
            await ActiveIndexChanged.InvokeAsync(_currentIndex);
        }
    }

    [JSInvokable]
    public void OnTabScrollState(bool overflowing, bool atStart, bool atEnd)
    {
        _overflowing = overflowing;
        _atStart = atStart;
        _atEnd = atEnd;
        StateHasChanged();
    }

    private async Task ScrollPrev() => await Ui.ScrollTabsAsync(_barRef, -1);

    private async Task ScrollNext() => await Ui.ScrollTabsAsync(_barRef, 1);

    public override async ValueTask DisposeAsync()
    {
        try { await Ui.RemoveTabKeyboardAsync(_barRef); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        try { await Ui.RemoveTabScrollerAsync(_barRef); }
        catch { }
        _dotNetRef?.Dispose();
        await base.DisposeAsync();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RebuildContext();
    }

    // React only when the PARENT changes ActiveIndex (two-way binding / programmatic), tracked via
    // _lastBoundIndex. Comparing against _currentIndex instead would snap the selection back to
    // ActiveIndex on ANY unrelated parent re-render after the user clicked a different tab.
    protected override void OnParametersSet()
    {
        _rootStyle = BuildRootStyle();
        if (ActiveIndex != _lastBoundIndex || _active is null || _active.Disabled)
        {
            _lastBoundIndex = ActiveIndex;
            SetActiveByIndex();
        }
        if (_context?.ActiveTab != _active || _context?.Lazy != Lazy) RebuildContext();
    }

    private void RebuildContext()
    {
        _context = new FlareTabsContext(
            _active,
            tab => _ = InvokeAsync(() => SelectTab(tab)),
            RegisterTab,
            UnregisterTab,
            Lazy,
            OnHeaderChanged);
    }

    // A tab's header change re-renders the bar, and that render hands the tabs their parameters again.
    // A label that differs on every evaluation (a clock, a random id) would then ping-pong forever, so
    // the bar catches up at most once per render batch; the flag clears after the batch lands.
    private bool _headerRefreshPending;

    private void OnHeaderChanged()
    {
        if (_active?.Disabled == true || (_active is null && _tabs.Any(t => !t.Disabled)))
        {
            SetActiveByIndex();
            RebuildContext();
        }
        if (_headerRefreshPending) return;
        _headerRefreshPending = true;
        StateHasChanged();
    }

    private void RegisterTab(FlareTab tab)
    {
        if (_tabs.Contains(tab)) return;
        _tabs.Add(tab);
        // Honor the bound ActiveIndex as tabs arrive: select when nothing is active yet, or when the
        // tab that just registered is the bound target (which may only now have become reachable).
        if (_active is null || _tabs.IndexOf(tab) == ActiveIndex)
            SetActiveByIndex();
        RebuildContext();
        StateHasChanged();
    }

    private void UnregisterTab(FlareTab tab)
    {
        _tabElements.Remove(tab);
        var oldIndex = _tabs.IndexOf(tab);
        var wasActive = _active == tab;
        _tabs.Remove(tab);
        if (_active == tab)
        {
            _active = null;
            SetActiveByIndex();
        }
        else
        {
            _currentIndex = _active is null ? -1 : _tabs.IndexOf(_active);
        }
        RebuildContext();
        if (_closingTab == tab)
        {
            _closingTab = null;
            var next = _tabs.Skip(Math.Max(0, oldIndex)).FirstOrDefault(t => !t.Disabled)
                ?? _tabs.Take(Math.Max(0, oldIndex)).LastOrDefault(t => !t.Disabled);
            if (wasActive || _active is null || _active.Disabled || !_tabs.Contains(_active))
                _active = next;
            if (_active is { Disabled: false }) _focusPending = _active;
            else _focusBarPending = true;
            _currentIndex = _active is null ? -1 : _tabs.IndexOf(_active);
            RebuildContext();
        }
        StateHasChanged();
    }

    // Selects the tab at the bound ActiveIndex, clamping to the first tab when out of range.
    private void SetActiveByIndex()
    {
        if (_tabs.Count == 0)
        {
            _active = null;
            _currentIndex = -1;
            return;
        }
        var idx = ActiveIndex >= 0 && ActiveIndex < _tabs.Count ? ActiveIndex : 0;
        _active = _tabs.Skip(idx).FirstOrDefault(t => !t.Disabled)
            ?? _tabs.Take(idx).FirstOrDefault(t => !t.Disabled);
        _currentIndex = _active is null ? -1 : _tabs.IndexOf(_active);
    }

    // Single funnel for selection: runs the preview guard, updates state, and notifies the binding.
    private async Task SelectTab(FlareTab tab)
    {
        if (tab.Disabled || tab == _active) return;
        var index = _tabs.IndexOf(tab);
        if (index < 0) return;
        if (!await AllowInteraction(index, tab.Label, TabInteractionType.Activate)) return;

        _active = tab;
        _currentIndex = index;
        RebuildContext();
        _lastReportedIndex = index;
        if (ActiveIndexChanged.HasDelegate) await ActiveIndexChanged.InvokeAsync(index);
        StateHasChanged();
    }

    private async Task OnTabClick(FlareTab tab)
    {
        if (tab.OnClick.HasDelegate) await tab.OnClick.InvokeAsync();
        await SelectTab(tab);
    }

    private async Task CloseTab(FlareTab tab)
    {
        if (tab.Disabled) return;
        var index = _tabs.IndexOf(tab);
        if (index < 0) return;
        if (!await AllowInteraction(index, tab.Label, TabInteractionType.Close)) return;
        _closingTab = tab;
        await OnTabClose.InvokeAsync(tab.Label);
    }

    private async Task<bool> AllowInteraction(int index, string label, TabInteractionType type)
    {
        if (!OnPreviewInteraction.HasDelegate) return true;
        var args = new TabInteractionEventArgs { PanelIndex = index, Label = label, InteractionType = type };
        await OnPreviewInteraction.InvokeAsync(args);
        return !args.Cancel;
    }

    // The C# path for the keys the module owns. Bound only while the module's registration has failed:
    // with the module live it would send every key in the tablist over the circuit for nothing, and the
    // module already drives the same navigation.
    private Func<KeyboardEventArgs, Task>? _fallbackKeyHandler =>
        _jsKeyboardRegistered ? null : OnFallbackKeyDown;

    private async Task OnFallbackKeyDown(KeyboardEventArgs e)
    {
        // No module means no computed-direction read: the resolved theme RTL state is the best truth
        // available, and the module path overrides it with what the browser actually lays out.
        if (e.Key is "Home" or "End" or "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown" or "Delete")
            await OnTabNavigation(e.Key, ThemeService?.IsRtl == true);
    }

    // The listener lives in flare-ui.js, which a stale PWA can serve as a failed module. One retry on
    // the next render recovers when the module becomes available; without it the failure was silent
    // and the arrows, Home, End and Delete stayed dead for the life of the page.
    private async Task RegisterKeyboardAsync()
    {
        try
        {
            await Ui.RegisterTabKeyboardAsync(_barRef, _dotNetRef!);
            _jsKeyboardRegistered = true;
        }
        catch (InvalidOperationException) { _jsKeyboardRegistered = false; }
        catch (JSException) { _jsKeyboardRegistered = false; }

        if (!_jsKeyboardRegistered && _keyboardRegistrationAttempts == 0)
        {
            _keyboardRegistrationAttempts = 1;
            _retryKeyboardPending = true;
            StateHasChanged();
        }
    }

    /// <summary>Activates and focuses the available tab addressed by an orientation-aware navigation key.</summary>
    /// <param name="key">The navigation key whose native scroll behavior was prevented.</param>
    /// <param name="rtl">Whether the tablist resolves to right-to-left in the browser.</param>
    [JSInvokable]
    public async Task OnTabNavigation(string key, bool rtl)
    {
        if (key == "Delete")
        {
            if (_active is { Closeable: true, Disabled: false } tab) await CloseTab(tab);
            return;
        }
        var enabled = _tabs.Where(t => !t.Disabled).ToList();
        if (enabled.Count == 0) return;
        var current = _active is not null ? enabled.IndexOf(_active) : -1;

        var forward = _vertical ? "ArrowDown" : rtl ? "ArrowLeft" : "ArrowRight";
        var backward = _vertical ? "ArrowUp" : rtl ? "ArrowRight" : "ArrowLeft";
        FlareTab? target = key switch
        {
            var k when k == forward => enabled[(current + 1) % enabled.Count],
            var k when k == backward => enabled[current <= 0 ? enabled.Count - 1 : current - 1],
            "Home" => enabled[0],
            "End" => enabled[^1],
            _ => null,
        };
        if (target is null) return;
        await SelectTab(target);
        if (_active == target)
        {
            _focusPending = target;
            StateHasChanged();
        }
    }
}
