@namespace Flare.Components
@inherits FlareComponentBase
@inject Flare.Components.Services.IOverlayJsService Overlay
@inject IBrowserViewportService Viewport
@inject IScrollService Scroll
@implements IAsyncDisposable

@* Responsive is Temporary below the breakpoint, so it renders a scrim too - and carries a class
   that hides it again above the breakpoint, where the same drawer is in-flow and dismisses
   nothing. *@
@if (Open && Variant is DrawerVariant.Temporary or DrawerVariant.Responsive)
{
    <div class="@BuildScrimCssClass()" @onclick="CloseDrawer" aria-hidden="true" />
}

<div class="@BuildCssClass(_anchorClass, _openClass, _variantClass, _autoCloseClass, _contentPadClass)"
     style="@_sizeStyle @_contentPadStyle @Style"
     role="@_role"
     tabindex="@(_dialogLike ? "-1" : null)"
     aria-modal="@(_dialogLike ? "true" : null)"
     aria-label="@(AriaLabel ?? FlareStrings.Drawer_Label)"
     inert="@_closedOverlay"
     @onfocusin="HandleFocusIn"
     @onfocusout="HandleFocusOut"
     @ref="_drawerEl"
     @attributes="AdditionalAttributes">
    @if (HeaderContent is not null)
    {
        <div class="@Css.Classes.Drawer.Header">
            @HeaderContent
        </div>
    }
    <div class="@Css.Classes.Drawer.Content">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Controls whether the drawer is visible.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>Callback fired when the drawer open state changes.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    /// <summary>Main content rendered inside the drawer body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Optional header content shown above the body.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    /// <summary>Drawer variant: Temporary (slides in as a modal dialog, default), Persistent (in the
    /// layout flow, collapsing to zero width when closed), Permanent (always visible), Mini (icon-only,
    /// expands on hover), or Responsive (Persistent at 960px and wider, Temporary below that - the
    /// stylesheet decides, and the keyboard modal state follows the same breakpoint).</summary>
    [Parameter] public DrawerVariant Variant { get; set; } = DrawerVariant.Temporary;
    /// <summary>Edge from which the drawer slides in.</summary>
    [Parameter] public DrawerAnchor Anchor { get; set; } = DrawerAnchor.Left;
    /// <summary>Width applied to left/right anchored drawers. <c>null</c> (the default) takes the theme's
    /// own width; set it to override that for one drawer.</summary>
    [Parameter] public string? Width { get; set; }
    /// <summary>Height applied to top/bottom anchored drawers.</summary>
    [Parameter] public string Height { get; set; } = "320px";
    /// <summary>Closes the drawer when the scrim backdrop is clicked.</summary>
    [Parameter] public bool CloseOnScrimClick { get; set; } = true;
    /// <summary>Closes the drawer when the Escape key is pressed.</summary>
    [Parameter] public bool CloseOnEsc { get; set; } = true;
    /// <summary>Accessible label for the drawer element. Null uses the localized default.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>Breakpoint below which the drawer is automatically hidden. A drawer the stylesheet has
    /// hidden holds no focus trap, so the page behind it stays reachable by keyboard.</summary>
    [Parameter] public Breakpoint? AutoCloseBelow { get; set; }
    /// <summary>
    /// Horizontal inset on the content region, on the shared <see cref="FlareSpacing"/> scale - the same
    /// steps <c>FlareStack.Gap</c> uses, so a drawer and a stack asking for the same step get the same value
    /// from the theme. Vertical padding is unaffected.
    ///
    /// <see cref="FlareSpacing.None"/> (the default) leaves the content full-bleed, because a drawer cannot
    /// know what it holds: a nav menu carries its own item insets and wants its state layer to reach the
    /// panel edge, while a form wants to sit off the edge and line up with the header. Set it to match the
    /// header's own inset (<see cref="FlareSpacing.Large"/> in the in-box themes) for the form case.
    /// </summary>
    [Parameter] public FlareSpacing ContentPadding { get; set; } = FlareSpacing.None;
    /// <summary>Raw CSS inline padding used when <see cref="ContentPadding"/> is
    /// <see cref="FlareSpacing.Custom"/>.</summary>
    [Parameter] public string? ContentPaddingValue { get; set; }

    protected override string ComponentCssClass => Css.Classes.Drawer.Root;

    // Mirrors FlareStack's Gap: the enum step only selects a pre-compiled class, and the class reads the
    // theme's spacing scale - no geometry travels through C#. Custom is the escape hatch, sanitised like
    // every other caller-supplied CSS value.
    private string? _contentPadClass => ContentPadding switch
    {
        FlareSpacing.XXSmall => Css.Classes.Drawer.ContentPadXxSmall,
        FlareSpacing.XSmall  => Css.Classes.Drawer.ContentPadXSmall,
        FlareSpacing.Small   => Css.Classes.Drawer.ContentPadSmall,
        FlareSpacing.Medium  => Css.Classes.Drawer.ContentPadMedium,
        FlareSpacing.Large   => Css.Classes.Drawer.ContentPadLarge,
        FlareSpacing.XLarge  => Css.Classes.Drawer.ContentPadXLarge,
        _                    => null,   // None (full-bleed) and Custom carry no class
    };

    private string? _contentPadStyle
    {
        get
        {
            if (ContentPadding != FlareSpacing.Custom) return null;
            var safe = Flare.Components.Security.CssValidator.StripDangerous(ContentPaddingValue);
            return safe is null ? null : $"--_content-pad-x:{safe};";
        }
    }

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<FlareDrawer>? _dotNetRef;
    // The viewport tier drives the Responsive variant and AutoCloseBelow. Md is the fallback the viewport
    // service reports when no browser width is known (prerender), so a drawer does not flash a modal
    // state it may not have.
    private Breakpoint _breakpoint = Breakpoint.Md;
    private IAsyncDisposable? _breakpointSubscription;
    private bool _modalActive;
    private bool _escRegistered;
    // An open modal drawer owns the background scroll the same way a dialog does. The lock is held as a
    // token rather than paired calls: disposing it twice is a no-op, so the close path and the dispose
    // path cannot both decrement the shared count for one open.
    private IAsyncDisposable? _scrollLock;
    // A render can arrive while a previous OnAfterRenderAsync is still awaiting JS. The transitions then
    // have to run one after the other - otherwise a close releases what an open has not registered yet,
    // and the open traps focus on a drawer that is already hidden. The same race FlareDialog serializes.
    private readonly SemaphoreSlim _modalSync = new(1, 1);
    private bool _disposed;
    // Whether the drawer was already open and modal at the previous reconciliation: a drawer that becomes
    // modal while already open is a background layer under whatever modal is above it, not a newly opened
    // one, and a modal close already restores focus by releasing its trap.
    private bool _wasOpenAtLastSync;
    private bool _wasModalAtLastSync;
    // Whether focus currently sits inside the drawer. Only the close path needs it: an in-flow drawer that
    // becomes inert with focus inside would strand the keyboard on the page body.
    private bool _focusInside;

    private string? _anchorClass;
    private string? _openClass;
    private string? _variantClass;
    private string? _autoCloseClass;
    private string? _autoCloseScrimClass;

    // Responsive is the in-flow drawer at 960px and wider and the overlay below it, so whether this
    // drawer behaves as a modal dialog depends on the viewport, not on the variant alone.
    private bool _dialogLike => Variant == DrawerVariant.Temporary
        || (Variant == DrawerVariant.Responsive && _breakpoint < Breakpoint.Md);

    // AutoCloseBelow hides the drawer with display:none below its bound; a hidden drawer is neither
    // modal nor allowed to hold the keyboard.
    private bool _autoClosed => AutoCloseBelow is { } below && _breakpoint < below;

    // The ONE state the Escape handler and the focus trap follow.
    private bool _effectiveModal => Open && _dialogLike && !_autoClosed;

    // Only a drawer rendered as an overlay is a modal dialog. An in-flow drawer sits in the layout with
    // the rest of the page reachable beside it, so calling it a modal dialog tells a screen reader the
    // page is inert when it is not.
    private string _role => _dialogLike ? "dialog" : "navigation";

    // The viewport is only needed where it changes behavior; a plain Temporary drawer subscribes to nothing.
    private bool _needsViewport => Variant == DrawerVariant.Responsive || AutoCloseBelow is not null;

    // A closed drawer can still be painted: Temporary/Responsive are translated off screen and Persistent
    // keeps `visibility: visible` so its width can animate to zero. Without inert their links, buttons and
    // fields stay in the tab order and the accessibility tree while nobody can see them. Permanent and
    // Mini have no closed state, so they are never inert.
    private bool _closedOverlay => !Open
        && Variant is DrawerVariant.Temporary or DrawerVariant.Responsive or DrawerVariant.Persistent;

    private string BuildScrimCssClass()
    {
        var responsive = Variant == DrawerVariant.Responsive ? Css.Classes.Drawer.ScrimResponsive : null;
        return string.Join(' ', new[] { Css.Classes.Drawer.Scrim, responsive, _autoCloseScrimClass }
            .Where(c => !string.IsNullOrEmpty(c)));
    }

    // Only emit a size when the CALLER asked for one. An inline width beats the stylesheet, so emitting a
    // default here would (and did) make --flare-drawer-width unreachable: the theme's value never rendered.
    private string? _sizeStyle => Anchor is DrawerAnchor.Left or DrawerAnchor.Right
        ? (Width is null ? null : $"width:{Width};")
        : $"height:{Height};";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // Named, not built: Flare.CssAudit can only match a name it can read, and a name assembled
        // from an enum is one it cannot.
        _anchorClass = Anchor switch
        {
            DrawerAnchor.Right => Css.Classes.Drawer.Right,
            DrawerAnchor.Top => Css.Classes.Drawer.Top,
            DrawerAnchor.Bottom => Css.Classes.Drawer.Bottom,
            _ => Css.Classes.Drawer.Left,
        };

        // The overlay variants slide in on a transform; the in-flow ones grow from zero width. Those
        // are different CSS mechanisms, so "open" is a different class. Responsive is BOTH: which
        // half applies is the stylesheet's decision at the breakpoint, not this component's.
        _openClass = (Variant, Open) switch
        {
            (DrawerVariant.Temporary, true)  => Css.Classes.Drawer.Open,
            (DrawerVariant.Persistent, true) => Css.Classes.Drawer.Expanded,
            (DrawerVariant.Responsive, true) => $"{Css.Classes.Drawer.Open} {Css.Classes.Drawer.Expanded}",
            _                                => null,
        };

        _variantClass = Variant switch
        {
            DrawerVariant.Permanent  => Css.Classes.Drawer.Permanent,
            DrawerVariant.Mini       => Css.Classes.Drawer.Mini,
            DrawerVariant.Persistent => Css.Classes.Drawer.Persistent,
            DrawerVariant.Responsive => Css.Classes.Drawer.Responsive,
            _                        => null,
        };

        _autoCloseClass = AutoCloseBelow switch
        {
            Breakpoint.Sm => Css.Classes.Drawer.AcSm,
            Breakpoint.Md => Css.Classes.Drawer.AcMd,
            Breakpoint.Lg => Css.Classes.Drawer.AcLg,
            Breakpoint.Xl => Css.Classes.Drawer.AcXl,
            Breakpoint.Xxl => Css.Classes.Drawer.AcXxl,
            _             => null,
        };

        _autoCloseScrimClass = AutoCloseBelow switch
        {
            Breakpoint.Sm => Css.Classes.Drawer.ScrimAcSm,
            Breakpoint.Md => Css.Classes.Drawer.ScrimAcMd,
            Breakpoint.Lg => Css.Classes.Drawer.ScrimAcLg,
            Breakpoint.Xl => Css.Classes.Drawer.ScrimAcXl,
            Breakpoint.Xxl => Css.Classes.Drawer.ScrimAcXxl,
            _             => null,
        };
    }

    private ElementReference _drawerEl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _modalSync.WaitAsync();
        try
        {
            if (_disposed) return;
            await SyncViewportSubscriptionAsync();
            await SyncModalAsync();
        }
        finally
        {
            _modalSync.Release();
        }
    }

    // Subscribed only where the viewport changes behavior. The immediate notification seeds the current
    // tier; the CSS breakpoints and FlareBreakpoints share the same bounds, so a tier change is exactly a
    // breakpoint crossing.
    private async Task SyncViewportSubscriptionAsync()
    {
        if (_needsViewport == (_breakpointSubscription is not null)) return;

        if (_needsViewport)
        {
            try { _breakpointSubscription = await Viewport.SubscribeBreakpointAsync(OnBreakpointChangedAsync); }
            catch (InvalidOperationException) { }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        else
        {
            var subscription = _breakpointSubscription;
            _breakpointSubscription = null;
            _breakpoint = Breakpoint.Md;
            if (subscription is not null)
            {
                try { await subscription.DisposeAsync(); } catch { }
            }
        }
    }

    private async Task OnBreakpointChangedAsync(Breakpoint breakpoint)
    {
        if (_disposed || breakpoint == _breakpoint) return;
        _breakpoint = breakpoint;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    // focusin/focusout bubble and C# has no event target, but the close path only needs to know whether
    // THIS drawer held focus. The blur that `inert` itself causes on close must not erase that fact before
    // the focus is sent back out, hence the guard.
    private void HandleFocusIn() => _focusInside = true;

    private void HandleFocusOut()
    {
        if (!_closedOverlay) _focusInside = false;
    }

    // Idempotent reconciliation, so every transition - open, close, variant switch, resize, breakpoint
    // hiding, CloseOnEsc toggled while open - converges on the same registrations and releases the rest.
    private async Task SyncModalAsync()
    {
        var modal = _effectiveModal;
        var wasOpen = _wasOpenAtLastSync;
        var wasModal = _wasModalAtLastSync;
        _wasOpenAtLastSync = Open;
        _wasModalAtLastSync = modal;

        if (modal && CloseOnEsc && !_escRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await Overlay.RegisterDialogEscAsync(_id, _dotNetRef);
                _escRegistered = true;
            }
            catch (InvalidOperationException) { }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        else if (_escRegistered && (!modal || !CloseOnEsc))
        {
            _escRegistered = false;
            try { await Overlay.RemoveDialogEscAsync(_id); } catch { }
        }

        if (modal && _scrollLock is null)
        {
            try { _scrollLock = await Scroll.LockAsync(); }
            catch (InvalidOperationException) { }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        else if (!modal && _scrollLock is not null)
        {
            try { await ReleaseScrollLockAsync(); } catch { }
        }

        if (modal && !_modalActive)
        {
            try
            {
                // A drawer that was already open when it became modal is a background layer: a dialog
                // above it keeps the keyboard, and the drawer takes over when that dialog closes.
                await Overlay.TrapFocusAsync(_id, _drawerEl, background: wasOpen);
                _modalActive = true;
            }
            catch (InvalidOperationException) { }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        else if (!modal && _modalActive)
        {
            _modalActive = false;
            _focusInside = false;
            try { await Overlay.ReleaseFocusTrapAsync(_id); } catch { }
        }

        // An in-flow drawer becomes inert from this render on, and the modal path above already restored
        // focus by releasing its trap. This one moves the keyboard back to where the user came from.
        if (wasOpen && !Open && !wasModal && _closedOverlay && _focusInside)
        {
            _focusInside = false;
            try { await Overlay.RestoreFocusOutsideAsync(_drawerEl); } catch { }
        }
    }

    [JSInvokable]
    public async Task CloseFromEsc()
    {
        if (CloseOnEsc)
            await OpenChanged.InvokeAsync(false);
    }

    private async Task ReleaseScrollLockAsync()
    {
        var held = _scrollLock;
        _scrollLock = null;
        if (held is not null) await held.DisposeAsync();
    }

    private async Task CloseDrawer()
    {
        if (CloseOnScrimClick)
            await OpenChanged.InvokeAsync(false);
    }

    public override async ValueTask DisposeAsync()
    {
        _disposed = true;
        // A queued OnAfterRenderAsync must not register anything after this point; wait for the one in
        // flight and release whatever it or an earlier pass acquired.
        await _modalSync.WaitAsync();
        try
        {
            var subscription = _breakpointSubscription;
            _breakpointSubscription = null;
            if (subscription is not null)
            {
                try { await subscription.DisposeAsync(); } catch { }
            }
            try { await ReleaseScrollLockAsync(); } catch { }
            try { await Overlay.RemoveDialogEscAsync(_id); } catch { }
            try { await Overlay.ReleaseFocusTrapAsync(_id); } catch { }
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
        finally
        {
            _modalSync.Release();
        }
        await base.DisposeAsync();
    }
}
