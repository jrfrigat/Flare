@namespace Flare.Components
@inherits FlareComponentBase
@inject ISnackbarService SnackbarService
@inject NavigationManager Navigation

@* The live-region semantics sit on each toast, not the container: a stack mixes politeness levels, and a
   container can only carry one. role="alert" makes an Error interrupt the screen reader (assertive);
   role="status" (polite) lets Success/Info/Warning wait their turn. aria-atomic reads the whole toast as a
   unit. *@
<div class="@Css.Classes.Snackbar.Provider @_positionClass">
    @foreach (var msg in _messages)
    {
        var m = msg;
        <div class="@BuildCssClass(Css.Classes.Snackbar.Root, SeverityClass(m.Severity), m.ShowProgress ? Css.Classes.Snackbar.WithProgress : null, m.CssClass)"
             role="@(m.Severity == SnackbarSeverity.Error ? "alert" : "status")"
             aria-atomic="true"
             @onmouseenter="@(() => Pause(m.Id, PauseReason.Hover))"
             @onmouseleave="@(() => Resume(m.Id, PauseReason.Hover))"
             @onfocusin="@(() => Pause(m.Id, PauseReason.Focus))"
             @onfocusout="@(() => Resume(m.Id, PauseReason.Focus))">
            <span class="@Css.Classes.Snackbar.Text">
                @if (m.Content is not null)
                {
                    @m.Content
                }
                else
                {
                    @m.Text
                }
            </span>
            <div class="@Css.Classes.Snackbar.Actions">
                @if (!string.IsNullOrEmpty(m.ActionText) && m.OnAction is not null)
                {
                    <button class="@Css.Classes.Snackbar.ActionBtn" type="button"
                            @onclick="@(() => RunActionAsync(m))">
                        @m.ActionText
                    </button>
                }
                @if (m.ShowClose)
                {
                    <button class="@Css.Classes.Snackbar.CloseBtn" type="button"
                            aria-label="@(FlareStrings.Snackbar_Close)"
                            @onclick="@(() => Dismiss(m.Id))">✕</button>
                }
            </div>
            @if (m.ShowProgress)
            {
                @* Indeterminate bar; --fc-main is set to currentColor on the wrapper (snackbar.css) so it
                   stays legible on every snackbar surface without hard-coding a role color. *@
                <div class="@Css.Classes.Snackbar.Progress">
                    <FlareProgressLinear />
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Maximum number of snackbar messages shown simultaneously.</summary>
    [Parameter] public int MaxVisible { get; set; } = 5;
    /// <summary>Screen position where the snackbar stack appears.</summary>
    [Parameter] public SnackbarPosition Position { get; set; } = SnackbarPosition.BottomCenter;

    // Named, not built. Normal has no accent rule at all, so building the class from the enum name
    // emitted flare-snackbar--normal - a class the stylesheet does not define and the CSS audit could
    // not have told anyone about, because it never appeared in the source as a name.
    private static string SeverityClass(SnackbarSeverity severity) => severity switch
    {
        SnackbarSeverity.Info => Css.Classes.Snackbar.Info,
        SnackbarSeverity.Success => Css.Classes.Snackbar.Success,
        SnackbarSeverity.Warning => Css.Classes.Snackbar.Warning,
        SnackbarSeverity.Error => Css.Classes.Snackbar.Error,
        _ => string.Empty,
    };

    private readonly List<SnackbarMessage> _messages = [];

    protected override string ComponentCssClass => Css.Classes.Snackbar.Host;

    private string _positionClass => Position switch
    {
        SnackbarPosition.TopLeft      => Css.Classes.Snackbar.TopLeft,
        SnackbarPosition.TopCenter    => Css.Classes.Snackbar.TopCenter,
        SnackbarPosition.TopRight     => Css.Classes.Snackbar.TopRight,
        SnackbarPosition.BottomLeft   => Css.Classes.Snackbar.BottomLeft,
        SnackbarPosition.BottomRight  => Css.Classes.Snackbar.BottomRight,
        _                             => Css.Classes.Snackbar.BottomCenter,
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SnackbarService.OnShow += HandleShow;
        SnackbarService.OnUpdate += HandleUpdate;
        SnackbarService.OnRemove += HandleRemove;
        SnackbarService.OnClear += HandleClear;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    // Dismiss any message flagged CloseAfterNavigation when the route changes.
    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(() =>
        {
            var closing = _messages.Where(m => m.CloseAfterNavigation).ToList();
            if (closing.Count == 0) return;
            foreach (var m in closing) StopTimer(m.Id);
            _messages.RemoveAll(m => m.CloseAfterNavigation);
            StateHasChanged();
        });

    private void HandleShow(SnackbarMessage msg) => InvokeAsync(() =>
    {
        // Opt-in de-duplication: drop a repeated text/severity notice instead of stacking copies.
        if (msg.PreventDuplicate && msg.Content is null &&
            _messages.Any(m => m.Text == msg.Text && m.Severity == msg.Severity))
            return;

        while (_messages.Count >= MaxVisible && _messages.Count > 0)
        {
            StopTimer(_messages[0].Id);
            _messages.RemoveAt(0);
        }
        _messages.Add(msg);
        StateHasChanged();
        // DurationMs <= 0 keeps the snackbar until the user dismisses it (close/action) - useful
        // for actionable notices like "a new version is available".
        StartTimer(msg);
    });

    // Replace a shown message in place (same list slot), so e.g. a "new version" notice can morph into
    // an "updating..." one without the dismiss-and-re-add flicker. No-op if it is no longer shown.
    private void HandleUpdate(SnackbarMessage msg) => InvokeAsync(() =>
    {
        var index = _messages.FindIndex(m => m.Id == msg.Id);
        if (index < 0) return;
        _messages[index] = msg;
        StateHasChanged();
    });

    // Programmatic single dismissal (ISnackbarService.Remove).
    private void HandleRemove(Guid id) => InvokeAsync(() => Dismiss(id));

    // Programmatic dismiss-all (ISnackbarService.Clear).
    private void HandleClear() => InvokeAsync(() =>
    {
        if (_messages.Count == 0) return;
        StopAllTimers();
        _messages.Clear();
        StateHasChanged();
    });

    private void Dismiss(Guid id)
    {
        StopTimer(id);
        var msg = _messages.FirstOrDefault(m => m.Id == id);
        if (msg is not null)
        {
            _messages.Remove(msg);
            InvokeAsync(StateHasChanged);
        }
    }

    // Auto-hide is a per-message remaining-time timer, not one Task.Delay per show: a toast the reader
    // hovers, focuses or acts on is paused and resumes with the time it had left. The reasons are bits
    // because hover and focus overlap - resuming on mouseleave while the action still has focus would
    // hide the toast under the user's fingers.
    private enum PauseReason { Hover = 1, Focus = 2, Action = 4 }

    private sealed class TimerState
    {
        public int RemainingMs;
        public int PauseMask;
        public bool Stopped;
        public long StartedAt;
        public CancellationTokenSource? Cts;
    }

    private readonly Dictionary<Guid, TimerState> _timers = [];

    private async Task RunActionAsync(SnackbarMessage m)
    {
        if (m.OnAction is null) return;
        Pause(m.Id, PauseReason.Action);
        try { await m.OnAction(); }
        finally { Resume(m.Id, PauseReason.Action); }
    }

    private void StartTimer(SnackbarMessage msg)
    {
        if (msg.DurationMs <= 0) return;
        StopTimer(msg.Id);
        var state = new TimerState { RemainingMs = msg.DurationMs };
        _timers[msg.Id] = state;
        RestartTimer(msg.Id, state);
    }

    private void RestartTimer(Guid id, TimerState state)
    {
        if (state.Stopped) return;
        state.Cts?.Dispose();
        state.Cts = new CancellationTokenSource();
        state.StartedAt = Environment.TickCount64;
        _ = WaitForTimerAsync(id, state, state.Cts.Token);
    }

    private async Task WaitForTimerAsync(Guid id, TimerState state, CancellationToken token)
    {
        try { await Task.Delay(state.RemainingMs, token); }
        catch (OperationCanceledException) { return; }
        // A pause can land after the delay already completed: the mask decides, not the wake-up.
        if (state.Stopped || state.PauseMask != 0) return;
        if (!_timers.TryGetValue(id, out var current) || !ReferenceEquals(current, state)) return;
        _timers.Remove(id);
        state.Stopped = true;
        state.Cts?.Dispose();
        state.Cts = null;
        Dismiss(id);
    }

    private void Pause(Guid id, PauseReason reason)
    {
        if (!_timers.TryGetValue(id, out var state) || state.Stopped) return;
        var bit = (int)reason;
        if ((state.PauseMask & bit) != 0) return;
        if (state.PauseMask == 0)
        {
            var elapsed = (int)(Environment.TickCount64 - state.StartedAt);
            state.RemainingMs = Math.Max(0, state.RemainingMs - elapsed);
            state.Cts?.Cancel();
        }
        state.PauseMask |= bit;
    }

    private void Resume(Guid id, PauseReason reason)
    {
        if (!_timers.TryGetValue(id, out var state) || state.Stopped) return;
        var bit = (int)reason;
        if ((state.PauseMask & bit) == 0) return;
        state.PauseMask &= ~bit;
        if (state.PauseMask == 0) RestartTimer(id, state);
    }

    private void StopTimer(Guid id)
    {
        if (!_timers.Remove(id, out var state)) return;
        state.Stopped = true;
        state.Cts?.Cancel();
        state.Cts?.Dispose();
        state.Cts = null;
    }

    private void StopAllTimers()
    {
        foreach (var state in _timers.Values)
        {
            state.Stopped = true;
            state.Cts?.Cancel();
            state.Cts?.Dispose();
            state.Cts = null;
        }
        _timers.Clear();
    }

    public override async ValueTask DisposeAsync()
    {
        StopAllTimers();
        SnackbarService.OnShow -= HandleShow;
        SnackbarService.OnUpdate -= HandleUpdate;
        SnackbarService.OnRemove -= HandleRemove;
        SnackbarService.OnClear -= HandleClear;
        Navigation.LocationChanged -= HandleLocationChanged;
        await base.DisposeAsync();
    }
}
