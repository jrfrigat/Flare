@namespace Flare.Components
@inherits FlareComponentBase
@implements IAsyncDisposable
@inject Flare.Components.Services.IResizeJsService Resize

@* BuildCssClass already emits ComponentCssClass, which IS the root class - naming it again put
   `flare-resizable` in the attribute twice. *@
<div class="@BuildCssClass() @_edgeClass"
     style="@BuildStyle()"
     @attributes="AdditionalAttributes"
     @ref="_container">
    @ChildContent
    <div class="@Css.Classes.Resizable.Handle" @ref="_handle" role="separator" tabindex="0"
         aria-label="@FlareStrings.Splitter_Resize"
         aria-orientation="@(Edge is ResizableEdge.Left or ResizableEdge.Right ? "vertical" : "horizontal")"></div>
    <div class="@Css.Classes.Resizable.Controls" data-flare-resize-controls>
        <button type="button" class="@Css.Classes.Resizable.Control" data-flare-resize-step="-1"
                aria-label="@FlareStrings.Resize_Decrease">-</button>
        <button type="button" class="@Css.Classes.Resizable.Control" data-flare-resize-step="1"
                aria-label="@FlareStrings.Resize_Increase">+</button>
    </div>
</div>

@code {

    /// <summary>Content rendered inside the resizable container.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Which edge carries the drag handle. Default <see cref="ResizableEdge.Right" /> (width).</summary>
    [Parameter] public ResizableEdge Edge { get; set; } = ResizableEdge.Right;
    /// <summary>Initial size as a CSS length (for example <c>300px</c> or <c>20rem</c>), applied along
    /// the edge's axis: width for left/right, height for top/bottom.</summary>
    [Parameter] public string? InitialSize { get; set; }
    /// <summary>Minimum size as a CSS length. <c>px</c>, <c>rem</c>, <c>em</c>, <c>%</c>, <c>vw</c>
    /// and <c>vh</c> are resolved against the parent box (percentages) or the viewport; an unsupported
    /// value is ignored rather than treated as pixels. The handle's own footprint is always a floor.</summary>
    [Parameter] public string? MinSize { get; set; }
    /// <summary>Maximum size, with the same units and resolution as <see cref="MinSize"/>. A value
    /// below the resolved minimum is raised to it, so the range is never inverted.</summary>
    [Parameter] public string? MaxSize { get; set; }
    /// <summary>Invoked with the resulting size in pixels (for example <c>256px</c>) after a drag, a
    /// step button, or Home/End.</summary>
    [Parameter] public EventCallback<string> OnResized { get; set; }

    protected override string ComponentCssClass => Css.Classes.Resizable.Root;

    // The edge modifier used to be lower-cased off the enum name, which made the class name something
    // the audit could not read: rename either end and the handle silently loses its side.
    private string _edgeClass => Edge switch
    {
        ResizableEdge.Bottom => Css.Classes.Resizable.Bottom,
        ResizableEdge.Left   => Css.Classes.Resizable.Left,
        ResizableEdge.Top    => Css.Classes.Resizable.Top,
        _                    => Css.Classes.Resizable.Right
    };

    private ElementReference _container;
    private ElementReference _handle;
    private DotNetObjectReference<FlareResizable>? _dotNetRef;
    // The drag configuration travels to JS once per change instead of once per instance. Registering
    // again replaces the previous listener set in the JS registry, so repeated updates cannot stack
    // handlers; a parameter change that leaves these three alone needs no round trip.
    private string? _registeredEdge;
    private string? _registeredMin;
    private string? _registeredMax;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var edge = Edge.ToString().ToLowerInvariant();
        if (edge == _registeredEdge && MinSize == _registeredMin && MaxSize == _registeredMax) return;

        _registeredEdge = edge;
        _registeredMin = MinSize;
        _registeredMax = MaxSize;
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            await Resize.RegisterAsync(_container, _handle, edge, MinSize, MaxSize, _dotNetRef);
        }
        catch (InvalidOperationException) { }
        catch (JSException) { }
    }

    [JSInvokable]
    public async Task OnResizedCallback(string newSize)
    {
        await OnResized.InvokeAsync(newSize);
    }

    private string BuildStyle()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(InitialSize))
        {
            // GS-3: sanitize user-supplied CSS value before injection
            var safeSize = Flare.Components.Security.CssValidator.StripDangerous(InitialSize);
            if (!string.IsNullOrEmpty(safeSize))
            {
                var prop = Edge is ResizableEdge.Right or ResizableEdge.Left ? "width" : "height";
                parts.Add($"{prop}:{safeSize}");
            }
        }
        if (!string.IsNullOrEmpty(Style)) parts.Add(Style);
        return string.Join(";", parts);
    }

    public override async ValueTask DisposeAsync()
    {
        try { await Resize.RemoveAsync(_handle); }
        catch { }
        _dotNetRef?.Dispose();
        await base.DisposeAsync();
    }
}
