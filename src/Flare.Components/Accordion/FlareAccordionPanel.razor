@namespace Flare.Components
@inherits FlareComponentBase

<div class="@BuildCssClass(_expanded ? Css.Classes.Accordion.Expanded : null, Disabled ? Css.Classes.Accordion.PanelDisabled : null)" style="@Style" @attributes="AdditionalAttributes">
    @* The toggle is wrapped in a heading, as the WAI-ARIA accordion pattern requires: without one the
       panel titles are buttons and nothing else, so heading navigation - the way a screen reader user
       skims a page - walks straight past the accordion's structure. role="heading" rather than a real
       h1..h6 element because the level is a parameter, and because a generic element carries no user
       agent margins to undo. The button stays the heading's only content, which the pattern also asks
       for: anything else inside it would be unreachable by that navigation. *@
    <div class="@Css.Classes.Accordion.Heading" role="@(_headingLevel > 0 ? "heading" : null)"
         aria-level="@(_headingLevel > 0 ? _headingLevel.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">
        <button class="@Css.Classes.Accordion.Header" type="button" @onclick="Toggle"
                @ref="_headerRef"
                id="@_headerId"
                disabled="@Disabled"
                aria-expanded="@_expanded.ToString().ToLowerInvariant()"
                aria-controls="@_contentId">
            <span class="@Css.Classes.Accordion.PanelHeaderText">
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else
                {
                    @Header
                }
            </span>
            <span class="@Css.Classes.Accordion.Icon" aria-hidden="true">▾</span>
        </button>
    </div>
    <div class="@Css.Classes.Accordion.Content"
         id="@_contentId"
         role="region"
         aria-labelledby="@_headerId"
         inert="@_contentInert"
         @onfocusin="HandleContentFocusIn"
         @onfocusout="HandleContentFocusOut">
        <div class="@Css.Classes.Accordion.Body">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private FlareAccordion? Accordion { get; set; }
    /// <summary>Text displayed in the panel's toggle header button.</summary>
    [Parameter] public string Header { get; set; } = "";
    /// <summary>Rich header content (icons, badges, custom markup); overrides <see cref="Header"/> when set.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    /// <summary>Disables the panel's toggle (cannot expand/collapse).</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Content revealed when the panel is expanded.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Controls whether the panel is currently expanded. A change after the first render
    /// expands or collapses the panel, and the accordion's single-expand slot follows it.</summary>
    [Parameter] public bool Expanded { get; set; }
    /// <summary>Callback fired when the expanded state changes.</summary>
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    /// <summary>Async guard fired before the panel toggles (the argument is the proposed expanded
    /// state); return false to block it -- e.g. confirm before collapsing a panel with unsaved edits.</summary>
    [Parameter] public Func<bool, Task<bool>>? OnBeforeToggle { get; set; }
    /// <summary>Heading level of this panel's title, overriding the accordion's
    /// <see cref="FlareAccordion.HeadingLevel"/>. Null (default) inherits it.</summary>
    [Parameter] public int? HeadingLevel { get; set; }

    protected override string ComponentCssClass => Css.Classes.Accordion.Panel;

    private bool _expanded;
    private bool _lastExpanded;
    private bool _initialised;
    private bool _wasExpanded;
    private bool _contentFocused;
    private ElementReference _headerRef;
    private readonly string _panelId = Guid.NewGuid().ToString("N")[..8];
    // The panel's own level wins over the accordion's; a standalone panel falls back to the same
    // default the accordion carries.
    private int _headingLevel => HeadingLevel ?? Accordion?.HeadingLevel ?? FlareAccordion.DefaultHeadingLevel;
    private string _headerId => $"flare-accordion-hdr-{_panelId}";
    private string _contentId => $"flare-accordion-cnt-{_panelId}";

    /// <summary>Whether the panel is currently expanded, for the accordion's single-expand policy.</summary>
    internal bool IsExpanded => _expanded;

    /// <summary>Registers this panel with its accordion, so switching to single expand can reach it.</summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Accordion?.RegisterPanel(this);
    }

    // Two-way state contract (docs/ru/component-conventions.md), same shape as FlareCollapse: a
    // controlled panel follows the parameter on every set, an uncontrolled one keeps local state until
    // the parameter ITSELF changes. _lastExpanded mirrors the parameter and is never written from an
    // event handler, which is what lets a sibling-driven re-render pass through without reopening a
    // panel the accordion just auto-collapsed - the reason this used to sync only once.
    //
    // A parameter change after mount is the parent opening or closing the panel, and the accordion has
    // to hear about it: otherwise a panel opened from outside never occupies the single-expand slot,
    // and the next sibling toggle leaves two panels open.
    protected override async Task OnParametersSetAsync()
    {
        var wasExpanded = _expanded;
        if (ExpandedChanged.HasDelegate)
            _expanded = Expanded;
        else if (Expanded != _lastExpanded)
            _expanded = Expanded;
        _lastExpanded = Expanded;

        if (!_initialised)
        {
            _initialised = true;
            // A panel that starts expanded claims the single-expand slot. Without this the first user
            // toggle of another panel finds no panel to close and leaves both open.
            if (_expanded) Accordion?.PanelInitiallyExpanded(this);
        }
        else if (Accordion is not null && _expanded != wasExpanded)
        {
            if (_expanded) await Accordion.PanelExternallyExpandedAsync(this);
            else Accordion.PanelCollapsed(this);
        }
    }

    /// <inheritdoc />
    public override ValueTask DisposeAsync()
    {
        Accordion?.UnregisterPanel(this);
        return base.DisposeAsync();
    }

    // A collapsed panel is removed from the accessibility tree and the tab order by inert, which leaves
    // the height animation intact. The focus handlers notice a user inside before that happens; the
    // focusout guard ignores the blur that inert itself causes while the panel is closing, so the header
    // can take the focus back instead of leaving it on body.
    private string? _contentInert => _expanded ? null : "inert";

    private void HandleContentFocusIn() => _contentFocused = true;

    private void HandleContentFocusOut()
    {
        if (_expanded) _contentFocused = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _wasExpanded && !_expanded && _contentFocused)
        {
            _contentFocused = false;
            try { await _headerRef.FocusAsync(); } catch { }
        }
        _wasExpanded = _expanded;
    }

    private async Task Toggle()
    {
        var next = !_expanded;
        // Run the guard before committing; a false result vetoes the toggle.
        if (OnBeforeToggle is not null && !await OnBeforeToggle(next))
            return;

        // Ask the accordion first when opening: in single-expand mode it has to close the current panel,
        // and that panel's own guard may refuse. Committing before asking would leave two panels open.
        if (next && Accordion is not null && !await Accordion.PanelExpandedAsync(this))
            return;

        _expanded = next;
        if (!_expanded)
            Accordion?.PanelCollapsed(this);
        await ExpandedChanged.InvokeAsync(_expanded);
    }

    // Called by the accordion to auto-collapse this panel when a sibling opens (single-expand mode).
    // Returns false when the panel's own guard refuses, which keeps this panel open AND stops the
    // sibling from opening - a veto that closed this panel anyway, or opened both, would make
    // OnBeforeToggle meaningless in exactly the case it exists for.
    // Fires ExpandedChanged so a two-way bound parent stays in sync.
    internal async Task<bool> CollapseAsync()
    {
        if (!_expanded) return true;
        if (OnBeforeToggle is not null && !await OnBeforeToggle(false))
            return false;
        _expanded = false;
        await ExpandedChanged.InvokeAsync(false);
        StateHasChanged();
        return true;
    }
}
