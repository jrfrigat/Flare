@namespace Flare.Components
@inherits FlareComponentBase

<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes">
    <CascadingValue Value="@this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>Accordion panels rendered as children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>When true, multiple panels can be expanded simultaneously.</summary>
    [Parameter] public bool AllowMultiple { get; set; }

    protected override string ComponentCssClass => Css.Classes.Accordion.Root;

    private FlareAccordionPanel? _expandedPanel;

    // Returns false when the currently open panel refuses to close, in which case the panel that asked
    // must not open either - otherwise a vetoed collapse silently turns single-expand into multi-expand.
    internal async Task<bool> PanelExpandedAsync(FlareAccordionPanel panel)
    {
        if (AllowMultiple) { _expandedPanel = panel; return true; }
        if (_expandedPanel is not null && _expandedPanel != panel && !await _expandedPanel.CollapseAsync())
            return false;
        _expandedPanel = panel;
        return true;
    }

    // Claims the slot for a panel declared Expanded in markup. Nothing is collapsed here: initial state
    // is the author's declaration, not a user toggle for the accordion to arbitrate.
    internal void PanelInitiallyExpanded(FlareAccordionPanel panel)
    {
        if (!AllowMultiple) _expandedPanel ??= panel;
    }

    internal void PanelCollapsed(FlareAccordionPanel panel)
    {
        if (_expandedPanel == panel) _expandedPanel = null;
    }
}
