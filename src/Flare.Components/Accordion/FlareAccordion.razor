@namespace Flare.Components
@inherits FlareComponentBase

<div class="@BuildCssClass(_fillClass)" style="@Style" @attributes="AdditionalAttributes">
    <CascadingValue Value="@this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>Accordion panels rendered as children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>When true, multiple panels can be expanded simultaneously. Turning it off while several
    /// are open keeps the most recently opened one and collapses the rest; a panel may still veto that
    /// through its <see cref="FlareAccordionPanel.OnBeforeToggle"/>.</summary>
    [Parameter] public bool AllowMultiple { get; set; }
    /// <summary>
    /// Heading level announced for the panel titles, so screen reader heading navigation reaches the
    /// accordion's sections. The right level depends on the surrounding document - an accordion under
    /// an <c>h2</c> section title wants 3 - which is why it is a parameter and not a fixed tag. Set 0
    /// to drop the heading semantics for an accordion that is a control rather than a section of the
    /// document. Default 3. A panel may override it with its own <c>HeadingLevel</c>.
    /// </summary>
    [Parameter] public int HeadingLevel { get; set; } = DefaultHeadingLevel;

    /// <summary>
    /// Makes the accordion spend the height it was given instead of its content's, so the open panel
    /// takes the remaining space and scrolls inside itself - a section list in a side panel. The
    /// expansion animates by growing the panel's share of the height, while the closed panels keep
    /// their header height. Needs an ancestor with a definite height, like every <c>FillHeight</c> in
    /// the library.
    /// </summary>
    [Parameter] public bool FillHeight { get; set; }

    /// <summary>Heading level used when neither the accordion nor the panel names one.</summary>
    internal const int DefaultHeadingLevel = 3;

    protected override string ComponentCssClass => Css.Classes.Accordion.Root;

    private string? _fillClass => FillHeight
        ? $"{Css.Classes.Fill.Root} {Css.Classes.Accordion.Fill}"
        : null;

    private FlareAccordionPanel? _expandedPanel;
    private readonly List<FlareAccordionPanel> _panels = [];
    private bool _lastAllowMultiple;

    // Returns false when the currently open panel refuses to close, in which case the panel that asked
    // must not open either - otherwise a vetoed collapse silently turns single-expand into multi-expand.
    internal async Task<bool> PanelExpandedAsync(FlareAccordionPanel panel)
    {
        if (AllowMultiple) { _expandedPanel = panel; return true; }
        if (_expandedPanel is not null && _expandedPanel != panel && !await _expandedPanel.CollapseAsync())
            return false;
        _expandedPanel = panel;
        return true;
    }

    // A panel whose Expanded parameter changed after mount: the parent, not a click, decided this, so
    // the slot follows it. The previous panel is asked to collapse rather than dismissed silently, so a
    // veto keeps its word; the new panel owns the slot either way, which is what the next sibling toggle
    // needs to restore single-expand.
    internal async Task PanelExternallyExpandedAsync(FlareAccordionPanel panel)
    {
        if (!AllowMultiple && _expandedPanel is not null && _expandedPanel != panel)
            await _expandedPanel.CollapseAsync();
        _expandedPanel = panel;
    }

    // Claims the slot for a panel declared Expanded in markup. Nothing is collapsed here: initial state
    // is the author's declaration, not a user toggle for the accordion to arbitrate.
    internal void PanelInitiallyExpanded(FlareAccordionPanel panel)
    {
        if (!AllowMultiple) _expandedPanel ??= panel;
    }

    internal void PanelCollapsed(FlareAccordionPanel panel)
    {
        if (_expandedPanel == panel) _expandedPanel = null;
    }

    internal void RegisterPanel(FlareAccordionPanel panel)
    {
        if (!_panels.Contains(panel)) _panels.Add(panel);
    }

    internal void UnregisterPanel(FlareAccordionPanel panel)
    {
        _panels.Remove(panel);
        if (_expandedPanel == panel) _expandedPanel = null;
    }

    // Switching from multi to single expand is an explicit policy: the last opened panel survives and
    // every other open panel is asked to close, so a veto is honored rather than overridden.
    protected override async Task OnParametersSetAsync()
    {
        if (_lastAllowMultiple && !AllowMultiple)
        {
            _expandedPanel ??= _panels.FirstOrDefault(panel => panel.IsExpanded);
            foreach (var panel in _panels.ToArray())
                if (panel != _expandedPanel && panel.IsExpanded)
                    await panel.CollapseAsync();
        }
        _lastAllowMultiple = AllowMultiple;
    }
}
