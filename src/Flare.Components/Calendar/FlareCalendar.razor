@namespace Flare.Components
@using System.Globalization
@inherits FlareLocalizedComponentBase
@inject TimeProvider TimeProvider

@{ var today = Today; var culture = _culture; var dayFormat = culture.DateTimeFormat; var firstDay = (int)_firstDayOfWeek; }
<div class="@BuildCssClass(_multiClass)" style="@Style" @attributes="AdditionalAttributes">
    @if (ShowNavigation)
    {
    <div class="@Css.Classes.Calendar.Nav">
        <button type="button" class="@Css.Classes.Calendar.NavBtn" @onclick="PrevMonth" aria-label="@(CoreText["Calendar_PrevMonth"])">
            <FlareIconView Value="FlareIcons.ChevronLeft" />
        </button>
        <button type="button" class="@Css.Classes.Calendar.NavBtn" @onclick="NextMonth" aria-label="@(CoreText["Calendar_NextMonth"])">
            <FlareIconView Value="FlareIcons.ChevronRight" />
        </button>
    </div>
    }

    <div class="@Css.Classes.Calendar.Months">
        @for (var mi = 0; mi < MonthCount; mi++)
        {
            var monthOffset = mi;
            var monthDate = _viewDate.AddMonths(monthOffset);
            var dates = _monthDates[mi];
            <div class="@Css.Classes.Calendar.Month">
                <div class="@Css.Classes.Calendar.Header">
                    @if (MonthHeaderTemplate is not null) { @MonthHeaderTemplate(monthDate) }
                    else { <FlareText Typo="TypographyScale.TitleMedium" aria-live="polite">@culture.TextInfo.ToTitleCase(monthDate.ToString("MMMM yyyy", culture))</FlareText> }
                </div>
                <div class="@Css.Classes.Calendar.Grid" role="grid">
                    <div class="@Css.Classes.Calendar.Row" role="row">
                        @for (var hi = 0; hi < 7; hi++)
                        {
                            var day = (DayOfWeek)((firstDay + hi) % 7);
                            <div class="@Css.Classes.Calendar.DayLabel" role="columnheader" aria-label="@dayFormat.GetDayName(day)">
                                @if (DayHeaderTemplate is not null) { @DayHeaderTemplate(day) }
                                else { @dayFormat.GetShortestDayName(day) }
                            </div>
                        }
                    </div>
                    @for (var start = 0; start < dates.Count; start += 7)
                    {
                        <div class="@Css.Classes.Calendar.Row" role="row">
                            @for (var di = start; di < Math.Min(start + 7, dates.Count); di++)
                            {
                                var date = dates[di];
                                var other = date.Month != monthDate.Month || date.Year != monthDate.Year;
                                var selected = SelectedDate == date;
                                var dayEvents = !other && _eventsByDate.TryGetValue(date, out var events) ? events : EmptyEvents;
                                <div class="@CellClass(other, date == today, selected)"
                                     @onclick="@(() => SelectDate(date, other))"
                                     role="gridcell"
                                     tabindex="0"
                                     @onkeydown="e => DayKey(e, date, other)"
                                     aria-label="@date.ToString("D", culture)"
                                     aria-selected="@(selected ? "true" : "false")"
                                     aria-current="@(date == today ? "date" : null)">
                                    @if (DateTemplate is not null) { @DateTemplate(date) }
                                    else { <span class="@Css.Classes.Calendar.DayNum">@date.Day</span> }
                                    @foreach (var calEv in dayEvents)
                                    {
                                        @if (EventContainerTemplate is not null)
                                        {
                                            <div class="@EventCssClass(calEv.Color)"
                                                 style="@EventColorStyle(calEv.Color)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                @EventContainerTemplate(calEv)
                                            </div>
                                        }
                                        else
                                        {
                                        <div class="@EventCssClass(calEv.Color)"
                                             style="@EventColorStyle(calEv.Color)"
                                             role="button" tabindex="0"
                                             @onkeydown="e => EventKey(e, calEv)"
                                             @onkeydown:stopPropagation="true"
                                             @onclick="@(() => OnEventClick.InvokeAsync(calEv))"
                                             @onclick:stopPropagation="true">
                                            @if (EventTemplate is not null) { @EventTemplate(calEv) }
                                            else { @calEv.Title }
                                        </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Events to display on the calendar grid cells.</summary>
    [Parameter] public IReadOnlyList<CalendarEvent>? Events { get; set; }
    /// <summary>Currently selected date value.</summary>
    [Parameter] public DateOnly? SelectedDate { get; set; }
    /// <summary>Callback raised when the selected date changes.</summary>
    [Parameter] public EventCallback<DateOnly> SelectedDateChanged { get; set; }
    /// <summary>Date used to determine the initial calendar view month.</summary>
    [Parameter] public DateOnly? InitialDate { get; set; }
    /// <summary>Controlled visible month. Null preserves the InitialDate-based, internally navigated view.</summary>
    [Parameter] public DateOnly? ViewDate { get; set; }
    /// <summary>Raised when the visible month changes through the calendar navigation.</summary>
    [Parameter] public EventCallback<DateOnly> ViewDateChanged { get; set; }
    /// <summary>Shows the built-in month navigation. Turn off when a parent supplies a shared toolbar.</summary>
    [Parameter] public bool ShowNavigation { get; set; } = true;
    /// <summary>Callback raised when the user clicks on a calendar event.</summary>
    [Parameter] public EventCallback<CalendarEvent> OnEventClick { get; set; }
    /// <summary>Custom event content inside the calendar's existing selection control.</summary>
    [Parameter] public RenderFragment<CalendarEvent>? EventTemplate { get; set; }
    /// <summary>Replaces the event interaction control inside the retained cell boundary. Own selection and keyboard actions; interactive children are supported.</summary>
    [Parameter] public RenderFragment<CalendarEvent>? EventContainerTemplate { get; set; }
    /// <summary>Replaces a month's title content.</summary>
    [Parameter] public RenderFragment<DateOnly>? MonthHeaderTemplate { get; set; }
    /// <summary>Replaces the date heading inside a day cell.</summary>
    [Parameter] public RenderFragment<DateOnly>? DateTemplate { get; set; }
    /// <summary>Replaces a weekday's heading content while retaining its accessible name.</summary>
    [Parameter] public RenderFragment<DayOfWeek>? DayHeaderTemplate { get; set; }
    /// <summary>Forces the week to start on Monday. When false (default), the first day of week
    /// is taken from <see cref="Culture"/> (e.g. Sunday for en-US, Monday for most of Europe/RU).</summary>
    [Parameter] public bool MondayFirst { get; set; }
    /// <summary>Culture for day headers, month names and the first day of week. Default = the current formatting culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }
    /// <summary>Number of consecutive months to display side by side. Default: 1.</summary>
    [Parameter] public int MonthCount { get; set; } = 1;
    /// <summary>Maximum events shown per day cell. Prevents rendering DoS from large event lists.</summary>
    [Parameter] public int MaxVisibleEvents { get; set; } = 3;

    protected override string ComponentCssClass => Css.Classes.Calendar.Root;

    // Event color: role -> flare-color-* class (sets --fc-container/--fc-on-container);
    // custom -> inline tonal tokens; default -> primary-container fallback in CSS.
    private static string? EventColorStyle(FlareColor color) => color.StyleContainerSolid();

    // An event chip is a child element, not the calendar root. BuildCssClass would prepend the root
    // class and with it the root's width, border and max-width; the chip has its own event class.
    private static string EventCssClass(FlareColor color) =>
        color.CssClass is { Length: > 0 } role
            ? string.Concat(Css.Classes.Calendar.Event, " ", role)
            : Css.Classes.Calendar.Event;

    private DateOnly _viewDate;
    private DateOnly? _viewDateParameter;
    private CultureInfo _culture => Culture ?? FormattingCulture;

    // Week starts on Monday when forced, otherwise on the culture's first day of week.
    private DayOfWeek _firstDayOfWeek => MondayFirst ? DayOfWeek.Monday : _culture.DateTimeFormat.FirstDayOfWeek;

    private string _multiClass => MonthCount > 1 ? Css.Classes.Calendar.Multi : string.Empty;
    private IReadOnlyList<DateOnly>[] _monthDates = [];
    private (DateOnly Start, DayOfWeek FirstDay, int Count) _dateKey;
    private static readonly List<CalendarEvent> EmptyEvents = [];
    private readonly Dictionary<DateOnly, List<CalendarEvent>> _eventsByDate = [];

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    protected override void OnInitialized()
    {
        _viewDate = ViewDate ?? InitialDate ?? Today;
    }

    protected override void OnParametersSet()
    {
        if (ViewDate is { } date && (ViewDateChanged.HasDelegate || ViewDate != _viewDateParameter)) _viewDate = date;
        _viewDateParameter = ViewDate;
        RebuildCells();
    }

    private void RebuildCells()
    {
        var start = new DateOnly(_viewDate.Year, _viewDate.Month, 1);
        var firstDay = _firstDayOfWeek;
        var count = Math.Max(1, MonthCount);
        var key = (start, firstDay, count);
        if (key != _dateKey)
        {
            var months = new IReadOnlyList<DateOnly>[count];
            for (var i = 0; i < count; i++)
                months[i] = CalendarGrid.Days(start.AddMonths(i), firstDay);
            _monthDates = months;
            _dateKey = key;
        }

        _eventsByDate.Clear();
        if (Events is null || MaxVisibleEvents <= 0 || MonthCount <= 0) return;
        var last = start.AddMonths(count - 1);
        var end = new DateOnly(last.Year, last.Month, DateTime.DaysInMonth(last.Year, last.Month));
        foreach (var item in Events)
        {
            if (item.Date < start || item.Date > end) continue;
            if (!_eventsByDate.TryGetValue(item.Date, out var day))
                _eventsByDate.Add(item.Date, day = []);
            if (day.Count < MaxVisibleEvents)
                day.Add(item);
        }
    }

    private static string CellClass(bool other, bool today, bool selected) => string.Concat(
        Css.Classes.Calendar.Cell,
        other ? " " + Css.Classes.Calendar.CellOther : "",
        today ? " " + Css.Classes.Calendar.CellToday : "",
        selected ? " " + Css.Classes.Calendar.CellSelected : "");

    private async Task SelectDate(DateOnly date, bool other)
    {
        if (other) return;
        SelectedDate = date;
        await SelectedDateChanged.InvokeAsync(date);
    }

    private Task DayKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, DateOnly date, bool other) =>
        e.Key is "Enter" or " " ? SelectDate(date, other) : Task.CompletedTask;

    private Task EventKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, CalendarEvent item) =>
        e.Key is "Enter" or " " ? OnEventClick.InvokeAsync(item) : Task.CompletedTask;

    private async Task PrevMonth()
    {
        _viewDate = _viewDate.AddMonths(-1);
        await ViewDateChanged.InvokeAsync(_viewDate);
        if (ViewDateChanged.HasDelegate && ViewDate is { } date) _viewDate = date;
        RebuildCells();
    }

    private async Task NextMonth()
    {
        _viewDate = _viewDate.AddMonths(1);
        await ViewDateChanged.InvokeAsync(_viewDate);
        if (ViewDateChanged.HasDelegate && ViewDate is { } date) _viewDate = date;
        RebuildCells();
    }

}
