@namespace Flare.Components
@inherits FlareComponentBase

<div class="@BuildCssClass(_spark ? Css.Classes.Chart.Sparkline : null, Animate ? Css.Classes.Chart.Animate : null)" style="@Style" @attributes="AdditionalAttributes">
    @if ((Title is not null || _showZoomToolbar) && !_spark)
    {
        <div class="@Css.Classes.Chart.Title">
            @if (Title is not null)
            {
                <FlareText Typo="TypographyScale.TitleMedium">@Title</FlareText>
            }
            @if (_showZoomToolbar)
            {
                <div class="@Css.Classes.Chart.Toolbar">
                    <FlareIconButton Icon="@FlareIcons.Add" Size="ButtonSize.Xs" Variant="ButtonVariant.Text"
                                     AriaLabel="@FlareStrings.Chart_ZoomIn"
                                     OnClick="@(() => ZoomByAsync(0.6))" />
                    <FlareIconButton Icon="@FlareIcons.Remove" Size="ButtonSize.Xs" Variant="ButtonVariant.Text"
                                     AriaLabel="@FlareStrings.Chart_ZoomOut"
                                     OnClick="@(() => ZoomByAsync(1.6))" />
                    <FlareIconButton Icon="@FlareIcons.Refresh" Size="ButtonSize.Xs" Variant="ButtonVariant.Text"
                                     AriaLabel="@FlareStrings.Chart_ZoomReset"
                                     Disabled="@(!_zoomed)" OnClick="ResetZoomAsync" />
                </div>
            }
        </div>
    }
    <div class="@Css.Classes.Chart.Body @(_legendRow ? Css.Classes.Chart.BodyRow : null)">
    @if (_showLegend && LegendPosition is ChartLegendPosition.Top or ChartLegendPosition.Left)
    {
        @RenderLegend()
    }
    <div class="@Css.Classes.Chart.Plot @(_zoomActive ? Css.Classes.Chart.PlotZoomable : null) @(_zoomed ? Css.Classes.Chart.PlotZoomed : null)"
         @ref="_plotRef"
         @onpointerdown="OnPlotPointerDown"
         @onpointermove="OnPlotPointerMove"
         @onpointerup="OnPlotPointerUp"
         @onpointerleave="OnPlotPointerLeave"
         @ondblclick="ResetZoomAsync"
         @onwheel="OnPlotWheel"
         @onwheel:preventDefault="_zoomActive">
        @{ var hits = RenderedHits(); }
        <svg class="@Css.Classes.Chart.Svg" viewBox="0 0 @_svgW @_svgH" xmlns="http://www.w3.org/2000/svg"
             preserveAspectRatio="@(_spark ? "none" : null)" style="@_svgStyle"
             aria-label="@AccessibleName" role="@(hits.Count > 0 ? "group" : "img")"
             aria-describedby="@(string.IsNullOrWhiteSpace(Description) ? null : DescriptionId)">
            <title>@AccessibleName</title>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <desc id="@DescriptionId">@Description</desc>
            }
            @* The plot-rectangle clip every cartesian renderer wraps its data marks in, so a zoomed
               window cannot paint over the axes and labels. *@
            @((MarkupString)ClipPathDef)
            @switch (Type)
            {
                case ChartType.Bar: @RenderBar(); break;
                case ChartType.StackedBar: @RenderStackedBar(); break;
                case ChartType.Pie: @RenderPie(false); break;
                case ChartType.Donut: @RenderPie(true); break;
                case ChartType.Scatter: @RenderScatter(); break;
                case ChartType.Bubble: @RenderScatter(); break;
                case ChartType.Radar: @RenderRadar(); break;
                case ChartType.HeatMap: @RenderHeatMap(); break;
                case ChartType.Rose: @RenderRose(); break;
                case ChartType.PolarArea: @RenderPolarArea(); break;
                case ChartType.Combo: @RenderCombo(); break;
                default: @RenderLine(); break; // Line + Area
            }

            @* Hit geometry uses the same viewBox as the rendered data. *@
            @foreach (var hit in hits)
            {
                @if (hit.Shape == HitShape.Rectangle)
                {
                    <rect @key="hit.Key" x="@F(hit.X)" y="@F(hit.Y)" width="@F(hit.Width)" height="@F(hit.Height)"
                          fill="transparent" class="@Css.Classes.Chart.Hit" data-flare-chart-hit="@hit.Key"
                          role="button" aria-label="@hit.Text" tabindex="@(hit == hits[0] ? 0 : -1)"
                          aria-describedby="@(_tooltipVisible && _activeHitKey == hit.Key ? TooltipId : null)"
                          @onmouseenter="e => ShowHit(hit, e)" @onmouseleave="ClearHover"
                          @onclick="e => ActivateHitAsync(hit, e)" />
                }
                else if (hit.Shape == HitShape.Path)
                {
                    <path @key="hit.Key" d="@hit.Path" fill="transparent" class="@Css.Classes.Chart.Hit"
                          data-flare-chart-hit="@hit.Key" role="button" aria-label="@hit.Text" tabindex="@(hit == hits[0] ? 0 : -1)"
                          aria-describedby="@(_tooltipVisible && _activeHitKey == hit.Key ? TooltipId : null)"
                          @onmouseenter="e => ShowHit(hit, e)" @onmouseleave="ClearHover"
                          @onclick="e => ActivateHitAsync(hit, e)" />
                }
                else
                {
                    <circle @key="hit.Key" cx="@F(hit.X)" cy="@F(hit.Y)" r="@F(hit.Radius)"
                            fill="transparent" class="@Css.Classes.Chart.Hit" data-flare-chart-hit="@hit.Key"
                            role="button" aria-label="@hit.Text" tabindex="@(hit == hits[0] ? 0 : -1)"
                            aria-describedby="@(_tooltipVisible && _activeHitKey == hit.Key ? TooltipId : null)"
                            @onmouseenter="e => ShowHit(hit, e)" @onmouseleave="ClearHover"
                            @onclick="e => ActivateHitAsync(hit, e)" />
                }
            }

            @if (_selecting)
            {
                <rect class="@Css.Classes.Chart.ZoomSelection"
                      x="@F(_selectionRect.X)" y="@F(_padT)"
                      width="@F(_selectionRect.Width)" height="@F(_plotH)" />
            }
        </svg>
        @* The shared placement engine owns the tooltip's viewport coordinates. *@
        @if (_tooltipVisible && !string.IsNullOrEmpty(_tooltipText))
        {
            <div class="@Css.Classes.Chart.Tooltip" id="@TooltipId" role="tooltip" @ref="_tooltipRef">
                @_tooltipText
            </div>
        }
    </div>
    @if (_showLegend && LegendPosition is ChartLegendPosition.Bottom or ChartLegendPosition.Right)
    {
        @RenderLegend()
    }
    </div>
    @if (DataTable)
    {
        @RenderDataTable()
    }
</div>
