@namespace Flare.Components
@inherits FlareContainerBase
@using Microsoft.AspNetCore.Components.Web

@* The content is never wrapped in the card's own control. The root is a plain box; an EMPTY native
   control - a button, or an anchor when Href is set - is stretched over it as the last child. A nested
   button or field is therefore not a descendant of the card's handler: its click and its Enter/Space
   answer the nested control alone, and the card never sees them. The native element also supplies
   Enter/Space activation and Space-without-page-scroll, which a div with a key handler cannot. *@
<div class="@CssClass" style="@_cardStyle" id="@(_hasActivationControl ? _rootId : null)" @attributes="_rootAttributes">
    @ChildContent
    @if (Href is not null)
    {
        <a class="@Css.Classes.Card.Hit" href="@Href" target="@Target"
           aria-label="@_activationAriaLabel" aria-labelledby="@_activationLabelledBy"
           @attributes="_linkAttributes"></a>
    }
    else if (_interactive)
    {
        <button class="@Css.Classes.Card.Hit" type="button" role="@Role"
                aria-checked="@AriaChecked"
                aria-label="@_activationAriaLabel" aria-labelledby="@_activationLabelledBy"
                @onclick="HandleClick"></button>
    }
</div>

@code {
    /// <summary>Child content rendered inside the card. Compose with FlareCardMedia / FlareCardHeader / FlareCardContent / FlareCardFooter / FlareCardActions.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Visual variant - Elevated (default), Filled, Outlined, Tonal, or Text. Mirrors ButtonVariant.</summary>
    [Parameter] public CardVariant Variant { get; set; } = CardVariant.Elevated;

    /// <summary>Overall size - controls corner radius and inner gap. Default Md.</summary>
    [Parameter] public CardSize Size { get; set; } = CardSize.Md;

    /// <summary>
    /// Overrides the card's drop shadow with an explicit elevation level (0-5 on the elevation scale,
    /// clamped). <c>Elevation="0"</c> is flat (no shadow); higher values lift the card further. When
    /// <c>null</c> (default) each <see cref="Variant"/> keeps its own elevation - <see cref="CardVariant.Elevated"/>
    /// is level 1, while <see cref="CardVariant.Filled"/>/<see cref="CardVariant.Outlined"/>/<see cref="CardVariant.Tonal"/>/<see cref="CardVariant.Text"/>
    /// are flat. The level is applied through the <c>--flare-card-elevation</c> variable rather than the
    /// final <c>box-shadow</c>, so a clickable elevated card still lifts on hover.
    /// </summary>
    [Parameter] public int? Elevation { get; set; }

    /// <summary>When true, lays the card out horizontally (media on the leading side, content beside it). Default false (vertical).</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Click handler. When set (or <see cref="Href"/>), the whole surface becomes clickable
    /// through a native activation control, so nested buttons, links and fields keep their own clicks and
    /// keys, and keyboard focus shows on the card.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>When set, the card activates as a link to this URL. An empty anchor is stretched over the
    /// surface rather than wrapped around the content, so nested interactive elements stay valid and
    /// independent.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Target for the link card (e.g. "_blank"). Only used with <see cref="Href"/>.</summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>When true, the card can be toggled selected; its activation control carries
    /// <c>role=checkbox</c> and the checked state. Selection shows an accent ring.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>Whether a selectable card is currently selected. Supports two-way binding (@bind-Selected).</summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>Fired when the selected state changes (enables @bind-Selected).</summary>
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }

    /// <summary>Fired with the new selected state whenever the user toggles a selectable card.</summary>
    [Parameter] public EventCallback<bool> OnSelectionChange { get; set; }

    protected override string ComponentCssClass => Css.Classes.Card.Root;

    // Attributes that describe what the browser does when it FOLLOWS the link. They belong on the
    // activation anchor; a div ignores them, and a card that used to render as <a> lost download/rel
    // and friends when its activation moved to an overlay anchor.
    private static readonly string[] _linkAttributeNames =
        ["download", "rel", "hreflang", "referrerpolicy", "ping", "type", "media"];

    private object? _splitSource;
    private bool _splitForHref;
    private bool _splitValid;
    private IReadOnlyDictionary<string, object>? _rootAttributes;
    private IReadOnlyDictionary<string, object>? _linkAttributes;

    // Split once per parameter set: Blazor hands a fresh dictionary per render, so a second split for
    // the same one would only allocate again. Without Href everything stays on the root as before.
    private void SplitAttributes()
    {
        var forHref = Href is not null;
        if (_splitValid && ReferenceEquals(_splitSource, AdditionalAttributes) && _splitForHref == forHref) return;
        _splitValid = true;
        _splitSource = AdditionalAttributes;
        _splitForHref = forHref;

        if (AdditionalAttributes is null || !forHref)
        {
            _rootAttributes = AdditionalAttributes;
            _linkAttributes = null;
            return;
        }

        Dictionary<string, object>? root = null;
        Dictionary<string, object>? link = null;
        foreach (var (name, value) in AdditionalAttributes)
        {
            if (_linkAttributeNames.Contains(name, StringComparer.OrdinalIgnoreCase))
                (link ??= new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase))[name] = value;
            else
                (root ??= new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase))[name] = value;
        }
        _rootAttributes = root;
        _linkAttributes = link;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        SplitAttributes();
    }

    private bool _clickable => Href is not null || OnClick.HasDelegate;
    private bool _interactive => _clickable || Selectable;

    // Explicit Elevation -> set the --flare-card-elevation variable inline (the variant rules read it for
    // the resting shadow) rather than the final box-shadow, so the :hover lift rule can still override it.
    private string? _cardStyle
    {
        get
        {
            if (Elevation is not { } level) return Style;
            var shadow = $"{Css.Tokens.CardField.Elevation}:var({ElevationToken(level)});";
            return string.IsNullOrEmpty(Style) ? shadow : shadow + Style;
        }
    }

    // Named, not built: an elevation level interpolated into a token name is a name the CSS audit
    // cannot read, so it can neither confirm the level exists nor catch one that does not.
    private static string ElevationToken(int level) => Math.Clamp(level, 0, 5) switch
    {
        1 => Css.Tokens.Elevation.Level1,
        2 => Css.Tokens.Elevation.Level2,
        3 => Css.Tokens.Elevation.Level3,
        4 => Css.Tokens.Elevation.Level4,
        5 => Css.Tokens.Elevation.Level5,
        _ => Css.Tokens.Elevation.Level0,
    };

    private string CssClass => BuildCssClass(
        _variantClass, _sizeClass, FillClass,
        Compact ? Css.Classes.Card.Compact : string.Empty,
        _interactive ? Css.Classes.Card.Clickable : string.Empty,
        Selectable ? Css.Classes.Card.Selectable : string.Empty,
        Selectable && Selected ? Css.Classes.Card.Selected : string.Empty);

    // A native button already carries role=button; only a selectable card needs its role stated.
    private string? Role => Selectable ? "checkbox" : null;
    private string? AriaChecked => Selectable ? (Selected ? "true" : "false") : null;

    // Whether the card renders its activation control at all.
    private bool _hasActivationControl => Href is not null || _interactive;

    private async Task HandleClick(MouseEventArgs e)
    {
        if (Selectable) await ToggleSelected();
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(e);
    }

    // The control is empty, so its name comes from the card it covers. A consumer's own naming wins;
    // otherwise aria-labelledby points at the root, whose text is what a screen reader should read for
    // "the whole card".
    private string? _activationAriaLabel => AttributeText("aria-label");

    private string? _activationLabelledBy
    {
        get
        {
            if (AttributeText("aria-labelledby") is { Length: > 0 } given) return given;
            return string.IsNullOrEmpty(_activationAriaLabel) ? _rootId : null;
        }
    }

    private string? AttributeText(string name) =>
        AdditionalAttributes?.TryGetValue(name, out var value) == true ? value as string : null;

    // The id is generated only when the activation control needs something to point at; a card with no
    // control renders exactly the markup it did before.
    private string? _generatedId;
    private string _rootId => AttributeText("id") is { Length: > 0 } given
        ? given
        : _generatedId ??= "flare-card-" + Guid.NewGuid().ToString("N")[..8];

    private async Task ToggleSelected()
    {
        Selected = !Selected;
        if (SelectedChanged.HasDelegate) await SelectedChanged.InvokeAsync(Selected);
        if (OnSelectionChange.HasDelegate) await OnSelectionChange.InvokeAsync(Selected);
    }

    private string _variantClass => Variant switch
    {
        CardVariant.Filled   => Css.Classes.Card.Filled,
        CardVariant.Outlined => Css.Classes.Card.Outlined,
        CardVariant.Text     => Css.Classes.Card.Text,
        CardVariant.Tonal    => Css.Classes.Card.Tonal,
        CardVariant.Elevated => Css.Classes.Card.Elevated,
        _                    => Css.Classes.Card.Elevated,
    };

    private string _sizeClass => Size switch
    {
        CardSize.Sm => Css.Classes.Card.SizeSm,
        CardSize.Lg => Css.Classes.Card.SizeLg,
        _           => Css.Classes.Card.SizeMd,
    };
}
