@namespace Flare.Components
@inherits FlareFileUploadBase
@using Microsoft.AspNetCore.Components.Forms

@* A drop region: it owns its footprint, so it takes no button vocabulary. The button-in-a-row form is a
   separate component, FlareFileUploadButton.

   This absorbed the old FlareDropZone, which was the same component written twice - same hidden input, same
   drag state, same default upload glyph + label + accept hint - down to being demoed on this very page
   beside it. ChildContent and MaxFileSize came across from it.

   On the root's drag handlers: `dragover`/`dragenter` MUST be cancelled - without it the region is not
   a drop target at all. `drop` must NOT be. The hidden input below covers the drop area and takes the
   dropped file as that event's DEFAULT ACTION, so cancelling it here killed the drop this component
   exists to receive, and with it the `change` that was the only path to HandleDropAsync - which is also
   why the highlight stayed lit afterwards. The list region, the one part with no input beneath it,
   cancels its own drop (see FlareUploadFileList); nothing else here has a browser default worth
   stopping. *@
<div class="@BuildCssClass(_draggingClass, _disabledClass)"
     style="@Style"
     aria-label="@(AriaLabel ?? FlareStrings.DropZone_Label)"
     @ondragover:preventDefault="true"
     @ondragenter:preventDefault="true"
     @ondragover="StartDragging"
     @ondragleave="@(() => _isDragging = false)"
     @ondrop="@(() => _isDragging = false)"
     @attributes="AdditionalAttributes">
    <div class="@Css.Classes.FileUpload.DropWrap">
        <label class="@Css.Classes.FileUpload.Zone" for="@InputId">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @if (IconContent is not null)
                {
                    <span class="@Css.Classes.FileUpload.Icon">@IconContent</span>
                }
                else
                {
                    <FlareIconView Value="FlareIcons.UploadFile" Class="@Css.Classes.FileUpload.Icon" />
                }
                <span class="@Css.Classes.FileUpload.Primary">@(_isDragging ? FlareStrings.DropZone_DropFiles : (DropText ?? FlareStrings.FileUpload_DropText))</span>
                @if (!string.IsNullOrEmpty(Accept))
                {
                    <span class="@Css.Classes.FileUpload.Hint">@(FlareStrings.FileUpload_Accepted) @Accept</span>
                }
            }
        </label>
        <InputFile id="@InputId"
                   class="@Css.Classes.FileUpload.Input"
                   accept="@Accept"
                   multiple="@Multiple"
                   disabled="@Disabled"
                   OnChange="HandleDropAsync" />
    </div>
    @if (ShowFileList && Queue.Count > 0)
    {
        <FlareUploadFileList Items="Queue"
                             Interactive="@(Uploader is not null)"
                             AllowCancel="AllowCancel"
                             AllowRetry="AllowRetry"
                             AllowRemove="AllowRemove"
                             FileTemplate="FileTemplate"
                             OnCancel="CancelAsync"
                             OnRetry="RetryAsync"
                             OnRemove="RemoveAsync" />
    }
</div>

@code {
    /// <summary>Instructional text shown inside the drop zone. Defaults to the localized
    /// "FileUpload_DropText" string. Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? DropText { get; set; }
    /// <summary>Icon shown above the instructional text. Defaults to an upload glyph. Ignored when
    /// <see cref="ChildContent"/> is set.</summary>
    [Parameter] public RenderFragment? IconContent { get; set; }
    /// <summary>Replaces the zone's whole default body (icon, text and accept hint) with your own content -
    /// for an avatar dropper, a preview grid, anything the built-in look does not cover.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Accessible label for the zone. Defaults to the localized "File drop zone" string.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    protected override string ComponentCssClass => Css.Classes.FileUpload.Root;

    private bool _isDragging;
    private string _draggingClass => _isDragging ? Css.Classes.FileUpload.Dragging : string.Empty;
    private string _disabledClass => Disabled ? Css.Classes.FileUpload.Disabled : string.Empty;

    // The browser fires dragover continuously while a file is held over the zone. The assignment is
    // idempotent but the render is not skipped, so a drag cost one render per event; the guard makes it
    // one render per drag.
    private void StartDragging()
    {
        if (!_isDragging) _isDragging = true;
    }

    // The drag highlight is cleared by the root's own drop handler now. This still clears it because the
    // file can also arrive through the click-and-pick dialog, which raises change with no drop at all.
    private async Task HandleDropAsync(InputFileChangeEventArgs e)
    {
        _isDragging = false;
        await HandleChangeAsync(e);
    }
}
