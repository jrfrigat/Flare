@namespace Flare.Components
@inherits FlareComponentBase
@implements IMenuEntry
@inject Flare.Components.Services.IOverlayJsService Overlay

<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes" aria-expanded="@_open.ToString().ToLowerInvariant()">
    <div class="@_activatorClass" id="@ItemId" tabindex="-1" @ref="_activatorEl"
         @onmouseenter="ShowSubmenu"
         @onmouseleave="ScheduleHide"
         @onclick="OpenFromPointerAsync"
         @onclick:stopPropagation="true"
         aria-haspopup="menu"
         aria-expanded="@_open.ToString().ToLowerInvariant()"
         aria-controls="@_panelId"
         aria-disabled="@Disabled.ToString().ToLowerInvariant()"
         role="menuitem">
        @if (Icon is not null)
        {
            <FlareIconView Value="Icon" Class="@Css.Classes.Menu.ItemIcon" />
        }
        <span class="@Css.Classes.Menu.ItemLabel">@Label</span>
        <FlareIconView Value="FlareIcons.ChevronRight" Class="@Css.Classes.Menu.SubmenuIcon" />
    </div>
    @if (_open)
    {
        <div id="@_panelId"
             class="@Css.Classes.Menu.SubmenuPanel @_placementClass"
             role="menu"
             tabindex="-1"
             aria-activedescendant="@_focusedItem?.ItemId"
             @ref="_panelEl"
             @onmouseenter="ShowSubmenu"
             @onmouseleave="ScheduleHide"
             @onfocusin="HandlePanelFocusIn"
             @onfocusout="HandlePanelFocusOut"
             @onkeydown="HandleSubmenuKeyDown"
             @onkeydown:stopPropagation="true"
             @onkeydown:preventDefault="true">
            <CascadingValue Value="_menuContext" IsFixed="true">
                <CascadingValue Value="@_focusedItem" Name="MenuFocusedItem">
                    @ChildContent
                </CascadingValue>
            </CascadingValue>
        </div>
    }
</div>

@code {
    /// <summary>Label text for the submenu trigger item.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Icon displayed before the label - any provider (a bare string is a Material Symbols name).</summary>
    [Parameter] public FlareIcon? Icon { get; set; }
    /// <summary>Menu items rendered inside the submenu panel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Submenu opens to this side relative to the parent item.</summary>
    [Parameter] public SubmenuPlacement Placement { get; set; } = SubmenuPlacement.End;
    /// <summary>Delay in milliseconds before hiding the submenu when mouse leaves.</summary>
    [Parameter] public int HideDelay { get; set; } = 150;
    /// <summary>Disables the submenu trigger; it is skipped by keyboard navigation and does not open.</summary>
    [Parameter] public bool Disabled { get; set; }

    // The parent menu's context: this submenu registers itself there so arrows and Home/End can land
    // on the trigger. The submenu then cascades its OWN context to its children.
    [CascadingParameter] private FlareMenuContext? ParentMenuContext { get; set; }
    [CascadingParameter(Name = "MenuFocusedItem")] private IMenuEntry? ParentFocusedItem { get; set; }

    protected override string ComponentCssClass => Css.Classes.Menu.Submenu;

    /// <summary>Stable element id, referenced by the parent menu's <c>aria-activedescendant</c>.</summary>
    internal string ItemId { get; } = "flare-sm-" + Guid.NewGuid().ToString("N")[..8];

    // Maps Placement to the directional panel class that positions the flyout.
    private string _placementClass => Placement switch
    {
        SubmenuPlacement.Start => Css.Classes.Menu.SubmenuPanelStart,
        SubmenuPlacement.Bottom => Css.Classes.Menu.SubmenuPanelBottom,
        SubmenuPlacement.Top => Css.Classes.Menu.SubmenuPanelTop,
        _ => Css.Classes.Menu.SubmenuPanelEnd,
    };

    // Which side the placement engine is asked for. It flips to the opposite one when the flyout does
    // not fit, which is the whole reason a submenu near the right edge of the window used to be
    // unreadable: it opened off-screen and only the page's own scrollbar could reach it.
    private string _placement => Placement switch
    {
        SubmenuPlacement.Start => PanelPlacement.LeftStart,
        SubmenuPlacement.Bottom => PanelPlacement.BottomStart,
        SubmenuPlacement.Top => PanelPlacement.TopStart,
        _ => PanelPlacement.RightStart,
    };

    private string _activatorClass => string.Join(' ', new[]
    {
        Css.Classes.Menu.Item,
        Css.Classes.Menu.SubmenuActivator,
        Disabled ? Css.Classes.Menu.ItemDisabled : null,
        ReferenceEquals(ParentFocusedItem, this) ? Css.Classes.Menu.ItemFocused : null,
    }.Where(c => !string.IsNullOrEmpty(c)));

    private bool _open;
    private bool _wasOpen;
    internal bool IsSubmenuOpen => _open;
    private bool _focusPanelOnOpen;
    private bool _panelFocused;
    private IMenuEntry? _focusedItem;
    private ElementReference _activatorEl;
    private ElementReference _panelEl;
    private readonly AnchoredLayer _layer = new();
    private readonly List<IMenuEntry> _items = [];
    private readonly string _panelId = "flare-submenu-" + Guid.NewGuid().ToString("N")[..8];

    private FlareMenuContext? _menuContext;
    private readonly CancelScope _hideCts = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _menuContext = new FlareMenuContext(CloseAllAsync, RegisterItem);
        ParentMenuContext?.Register(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _layer.SyncAsync(Overlay, _open, _activatorEl, _panelEl,
            new AnchoredPanelOptions { Placement = _placement, GapToken = Css.Tokens.MenuPanel.Offset });

        if (_open && !_wasOpen)
        {
            _wasOpen = true;
            if (_focusPanelOnOpen)
            {
                _focusPanelOnOpen = false;
                _focusedItem ??= _items.FirstOrDefault(i => !i.Disabled);
                try { await _panelEl.FocusAsync(); } catch { }
                StateHasChanged();
            }
        }
        else if (!_open && _wasOpen)
        {
            _wasOpen = false;
            try { await _activatorEl.FocusAsync(); } catch { }
        }
    }

    private void ShowSubmenu()
    {
        if (Disabled) return;
        _hideCts.Cancel();
        _open = true;
    }

    private async Task OpenFromPointerAsync()
    {
        if (Disabled) return;
        await OpenSubmenuAsync();
    }

    internal async Task OpenSubmenuAsync()
    {
        if (Disabled) return;
        _hideCts.Cancel();
        if (_open)
        {
            _focusedItem ??= _items.FirstOrDefault(i => !i.Disabled);
            try { await _panelEl.FocusAsync(); } catch { }
            StateHasChanged();
            return;
        }
        _focusPanelOnOpen = true;
        _open = true;
        StateHasChanged();
    }

    internal async Task CloseSubmenuAsync()
    {
        if (!_open) return;
        _hideCts.Cancel();
        _open = false;
        _focusedItem = null;
        _items.Clear();
        StateHasChanged();
    }

    private void ScheduleHide()
    {
        var ct = _hideCts.Next();
        _ = Task.Delay(HideDelay, ct).ContinueWith(_ =>
        {
            if (ct.IsCancellationRequested) return;
            InvokeAsync(() =>
            {
                // Focus is a stronger signal than the pointer: a keyboard user stays in the submenu
                // even when the mouse has moved away.
                if (ct.IsCancellationRequested || _panelFocused) return;
                _open = false;
                StateHasChanged();
            });
        }, TaskScheduler.Default);
    }

    private async Task CloseAllAsync()
    {
        _hideCts.Cancel();
        _open = false;
        _items.Clear();
        _focusedItem = null;
        if (ParentMenuContext is not null)
            await ParentMenuContext.Close();
    }

    internal void RegisterItem(IMenuEntry item)
    {
        if (!_items.Contains(item))
            _items.Add(item);
    }

    private void HandlePanelFocusIn() => _panelFocused = true;
    private void HandlePanelFocusOut() => _panelFocused = false;

    private async Task HandleSubmenuKeyDown(KeyboardEventArgs e)
    {
        if (!_open) return;

        if (e.Key is "Escape" or "Tab")
        {
            await CloseSubmenuAsync();
            return;
        }

        var enabled = _items.Where(i => !i.Disabled).ToList();
        if (enabled.Count == 0) return;

        if (e.Key is "Enter" or " " or "Spacebar")
        {
            if (e.Repeat || _focusedItem is null) return;
            await _focusedItem.ActivateAsync();
            return;
        }

        var rtl = Theme?.IsRtl == true;
        var closeKey = rtl ? "ArrowRight" : "ArrowLeft";
        var openKey = rtl ? "ArrowLeft" : "ArrowRight";
        if (e.Key is "ArrowRight" or "ArrowLeft")
        {
            if (e.Key == closeKey) { await CloseSubmenuAsync(); return; }
            if (e.Key == openKey && _focusedItem is FlareSubMenu nested)
                await nested.OpenSubmenuAsync();
            return;
        }

        var currentIdx = _focusedItem is not null ? enabled.IndexOf(_focusedItem) : -1;

        if (e.Key == "ArrowDown")
            _focusedItem = enabled[(currentIdx + 1) % enabled.Count];
        else if (e.Key == "ArrowUp")
            _focusedItem = currentIdx < 0 ? enabled[^1] : enabled[((currentIdx - 1) + enabled.Count) % enabled.Count];
        else if (e.Key == "Home")
            _focusedItem = enabled[0];
        else if (e.Key == "End")
            _focusedItem = enabled[^1];
        else
            return;

        if (_focusedItem is not null)
        {
            try { await Overlay.ScrollIntoViewAsync(_focusedItem.ItemId); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
    }

    bool IMenuEntry.Disabled => Disabled;
    string IMenuEntry.ItemId => ItemId;
    Task IMenuEntry.ActivateAsync() => OpenSubmenuAsync();
    bool IMenuEntry.HasSubmenu => true;
    bool IMenuEntry.IsSubmenuOpen => IsSubmenuOpen;
    Task IMenuEntry.OpenSubmenuAsync() => OpenSubmenuAsync();
    Task IMenuEntry.CloseSubmenuAsync() => CloseSubmenuAsync();

    public override async ValueTask DisposeAsync()
    {
        _hideCts.Dispose();
        await _layer.ReleaseAsync(Overlay);
        await base.DisposeAsync();
    }
}
