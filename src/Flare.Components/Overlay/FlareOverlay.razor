@namespace Flare.Components
@inherits FlareComponentBase
@using System.Globalization

@if (Open)
{
    <div class="@BuildCssClass(_absoluteClass)"
         style="@_style"
         @onclick="HandleClickAsync"
         @attributes="AdditionalAttributes">
        <div class="@Css.Classes.Overlay.Scrim" style="@_scrimStyle" aria-hidden="true"
             @onclick="HandleBackdropClickAsync"></div>
        @ChildContent
    </div>
}

@code {
    /// <summary>Controls whether the overlay is visible.</summary>
    [Parameter] public bool              Open        { get; set; }
    /// <summary>Optional content rendered on top of the overlay.</summary>
    [Parameter] public RenderFragment?   ChildContent { get; set; }
    /// <summary>Callback raised when anything on the overlay surface is clicked - a click inside
    /// <see cref="ChildContent"/> reaches it through bubbling too. For a dismissal that only a click on the
    /// backdrop should trigger, use <see cref="OnBackdropClick"/> instead.</summary>
    [Parameter] public EventCallback     OnClick     { get; set; }
    /// <summary>Callback raised when the backdrop (the scrim outside <see cref="ChildContent"/>) is clicked.
    /// A click inside the content does not raise it. A backdrop click still bubbles to <see cref="OnClick"/>,
    /// so set only one of the two for a dismissal.</summary>
    [Parameter] public EventCallback     OnBackdropClick { get; set; }
    /// <summary>Uses absolute positioning instead of fixed.</summary>
    [Parameter] public bool              Absolute    { get; set; }
    /// <summary>Renders a dark semi-transparent background.</summary>
    [Parameter] public bool              Dark        { get; set; } = true;
    /// <summary>Background opacity value between 0 and 1. Null uses the theme's backdrop opacity
    /// (the <c>--flare-overlay-scrim-opacity</c> token); an explicit value wins.</summary>
    [Parameter] public double?           Opacity     { get; set; }
    /// <summary>CSS z-index applied to the overlay element. Null uses the theme's layer (the
    /// <c>--flare-overlay-scrim-layer</c> token); an explicit value wins.</summary>
    [Parameter] public int?              ZIndex      { get; set; }

    protected override string ComponentCssClass => Css.Classes.Overlay.Root;

    private string _absoluteClass => Absolute ? Css.Classes.Overlay.Absolute : string.Empty;

    private string? _style
    {
        get
        {
            var parts = new List<string>(2);
            if (ZIndex is { } z) parts.Add($"z-index:{z}");
            if (Style is not null) parts.Add(Style);
            return parts.Count > 0 ? string.Join(';', parts) : null;
        }
    }

    // The scrim is decoration behind the content, so Opacity lives here and never on the root.
    private string? _scrimStyle
    {
        get
        {
            var parts = new List<string>(2);
            if (Opacity is { } o)
                parts.Add($"opacity:{o.ToString("F2", CultureInfo.InvariantCulture)}");
            if (!Dark) parts.Add("background:transparent");
            return parts.Count > 0 ? string.Join(';', parts) : null;
        }
    }

    private async Task HandleClickAsync()
    {
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
    }

    // Only the scrim reaches this handler; content clicks never touch the backdrop layer.
    private async Task HandleBackdropClickAsync()
    {
        if (OnBackdropClick.HasDelegate) await OnBackdropClick.InvokeAsync();
    }
}
