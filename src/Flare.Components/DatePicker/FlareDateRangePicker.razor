@namespace Flare.Components
@inherits FlareComponentBase
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject TimeProvider TimeProvider

<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="@Css.Classes.Input.Label">@Label</label>
    }
    @if (ShowPresets)
    {
        <div class="@Css.Classes.Daterangepicker.Presets" role="group" aria-label="@Label">
            @foreach (var preset in _effectivePresets)
            {
                var p = preset;
                <button type="button"
                        class="@Css.Classes.Daterangepicker.Preset @(IsActivePreset(p) ? Css.Classes.Daterangepicker.PresetActive : "")"
                        disabled="@(Disabled || ReadOnly)"
                        aria-pressed="@(IsActivePreset(p) ? "true" : "false")"
                        @onclick="@(() => ApplyPreset(p))">@p.Label</button>
            }
        </div>
    }

    @if (Mode == DateRangePickerMode.Fields)
    {
        <div class="@Css.Classes.Daterangepicker.Fields">
            <FlareDatePicker Value="@StartDate"
                             ValueChanged="HandleStartChanged"
                             Label="@(StartLabel ?? FlareStrings.DateRangePicker_StartLabel)"
                             ErrorText="@ErrorText"
                             Disabled="@Disabled"
                             ReadOnly="@ReadOnly"
                             Culture="@_culture"
                             For="@StartFor"
                             Typo="@Typo"
                             Variant="@Variant"
                             Size="@Size"
                             Min="@StartFieldMin"
                             Max="@StartFieldMax"
                             ShowWeekNumbers="@ShowWeekNumbers"
                             FirstDayOfWeek="@FirstDayOfWeek"
                             DayClassFunc="@DayClassFunc"
                             IsDateDisabled="@IsDateDisabled" />
            <FlareIconView Value="FlareIcons.ArrowForward" Class="@Css.Classes.Daterangepicker.Sep" />
            <FlareDatePicker Value="@EndDate"
                             ValueChanged="HandleEndChanged"
                             Label="@(EndLabel ?? FlareStrings.DateRangePicker_EndLabel)"
                             Disabled="@Disabled"
                             ReadOnly="@ReadOnly"
                             Culture="@_culture"
                             For="@EndFor"
                             Typo="@Typo"
                             Variant="@Variant"
                             Size="@Size"
                             Min="@EndFieldMin"
                             Max="@EndFieldMax"
                             ShowWeekNumbers="@ShowWeekNumbers"
                             FirstDayOfWeek="@FirstDayOfWeek"
                             DayClassFunc="@DayClassFunc"
                             IsDateDisabled="@IsDateDisabled" />
        </div>
    }
    else
    {
        <div class="@Css.Classes.Daterangepicker.Calendar" @onmouseleave="@(() => { _hover = null; })">
            <div class="@Css.Classes.DatePicker.Header">
                <span @onclick:stopPropagation>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="PrevMonth" AriaLabel="@FlareStrings.Calendar_PrevMonth" Disabled="@(Disabled || !CanPrev)">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.ChevronLeft" /></LeadingIcon>
                    </FlareButton>
                </span>
                <span class="@Css.Classes.DatePicker.MonthLabel">@HeaderLabel</span>
                <span @onclick:stopPropagation>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="NextMonth" AriaLabel="@FlareStrings.Calendar_NextMonth" Disabled="@(Disabled || !CanNext)">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.ChevronRight" /></LeadingIcon>
                    </FlareButton>
                </span>
            </div>
            <FlareMonthGrid ViewYear="_viewYear" ViewMonth="_viewMonth" Culture="_culture" Today="Today"
                            FirstDayOfWeek="FirstDayOfWeek" ShowWeekNumbers="ShowWeekNumbers"
                            AriaLabel="@HeaderLabel"
                            Selected="@(d => d == StartDate || d == EndDate)"
                            Disabled="@(d => Disabled || IsDayUnavailable(d))"
                            FocusedDate="@FocusedCursor"
                            FocusedDateChanged="@(d => _focusedDate = d)"
                            OnKeyDown="HandleGridKeyDown"
                            DayClass="RangeDayClass"
                            OnDayClick="PickDayAsync"
                            OnDayHover="@(d => { _hover = d; })" />
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorText))
    {
        <span class="@Css.Classes.Input.Helper @Css.Classes.Input.HelperError">@_errorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="@Css.Classes.Input.Helper">@HelperText</span>
    }
</div>

@code {
    /// <summary>Start date of the selected range.</summary>
    [Parameter] public DateOnly? StartDate { get; set; }
    /// <summary>Callback invoked when the start date changes. A range picked in the calendar is published in
    /// two steps: the first day sets the start and clears the end, the second sets both ends; a form sees the
    /// range as unfinished while only the start is set.</summary>
    [Parameter] public EventCallback<DateOnly?> StartDateChanged { get; set; }
    /// <summary>End date of the selected range.</summary>
    [Parameter] public DateOnly? EndDate { get; set; }
    /// <summary>Callback invoked when the end date changes.</summary>
    [Parameter] public EventCallback<DateOnly?> EndDateChanged { get; set; }
    /// <summary>How the range is selected: two linked inputs (<see cref="DateRangePickerMode.Fields"/>,
    /// default) or a single inline range calendar (<see cref="DateRangePickerMode.Calendar"/>).</summary>
    [Parameter] public DateRangePickerMode Mode { get; set; } = DateRangePickerMode.Fields;
    /// <summary>Overall label shown above the picker.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Label for the start date picker (Fields mode). When null, falls back to DateRangePicker_StartLabel.</summary>
    [Parameter] public string? StartLabel { get; set; }
    /// <summary>Label for the end date picker (Fields mode). When null, falls back to DateRangePicker_EndLabel.</summary>
    [Parameter] public string? EndLabel { get; set; }
    /// <summary>Helper text shown below the range picker.</summary>
    [Parameter] public string? HelperText { get; set; }
    /// <summary>Error message shown below the range picker.</summary>
    [Parameter] public string? ErrorText { get; set; }
    /// <summary>Earliest selectable date (inclusive).</summary>
    [Parameter] public DateOnly? Min { get; set; }
    /// <summary>Latest selectable date (inclusive).</summary>
    [Parameter] public DateOnly? Max { get; set; }
    /// <summary>Predicate to disable specific dates.</summary>
    [Parameter] public Func<DateOnly, bool>? IsDateDisabled { get; set; }
    /// <summary>Shortest range the user may pick, in days counting both ends (null or below 1 = no limit). The
    /// calendar disables ends that would be too close, the fields narrow their bounds, and a shorter preset is
    /// not applied. A value bound from outside is shown as it is.</summary>
    [Parameter] public int? MinDays { get; set; }
    /// <summary>Longest range the user may pick, in days counting both ends (null or below 1 = no limit), applied
    /// as <see cref="MinDays"/>.</summary>
    [Parameter] public int? MaxDays { get; set; }
    /// <summary>Whether a day <see cref="IsDateDisabled"/> rejects may lie between the two ends (default true,
    /// e.g. weekends inside a holiday). When false, the pick stops at the first disabled day.</summary>
    [Parameter] public bool AllowDisabledDatesInRange { get; set; } = true;
    /// <summary>Disables the picker when true.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Shows the range without letting it change: the fields stay focusable but read-only, and the
    /// calendar can be browsed while day clicks and presets are ignored.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Culture for the month names, the first day of week and the fields' format. Default =
    /// CurrentUICulture, as for <c>FlareDatePicker</c>.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }
    /// <summary>Model field of the start date inside an <c>EditForm</c>: the start field (or the calendar)
    /// reports changes to the edit context and shows its validation message.</summary>
    [Parameter] public Expression<Func<DateOnly?>>? StartFor { get; set; }
    /// <summary>Model field of the end date inside an <c>EditForm</c>, as <see cref="StartFor"/>.</summary>
    [Parameter] public Expression<Func<DateOnly?>>? EndFor { get; set; }

    [CascadingParameter] private EditContext? EditContext { get; set; }
    private EditContext? _subscribedContext;
    /// <summary>Optional typography scale for the input text (Fields mode).</summary>
    [Parameter] public TypographyScale? Typo { get; set; }
    /// <summary>Visual variant (Filled/Outlined/Bare) for the input fields (Fields mode).</summary>
    [Parameter] public InputVariant Variant { get; set; } = InputVariant.Default;
    /// <summary>Control size (Xs..Xl) for the input fields (Fields mode).</summary>
    [Parameter] public FieldSize Size { get; set; } = FieldSize.Md;
    /// <summary>Shows a row of quick-range preset chips (Today, Last 7 days, This month, ...).</summary>
    [Parameter] public bool ShowPresets { get; set; }
    /// <summary>Custom preset list. When null, a localized default set is used (requires <see cref="ShowPresets"/>).</summary>
    [Parameter] public IReadOnlyList<DateRangePreset>? Presets { get; set; }
    /// <summary>Shows a leading week-of-year number column in the calendar.</summary>
    [Parameter] public bool ShowWeekNumbers { get; set; }
    /// <summary>Overrides the culture's first day of week (null = use the culture's).</summary>
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }
    /// <summary>Returns extra CSS class(es) for a given day cell (e.g. to mark holidays), on top of the range highlight.</summary>
    [Parameter] public Func<DateOnly, string>? DayClassFunc { get; set; }

    protected override string ComponentCssClass => Css.Classes.Daterangepicker.Root;

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);
    private CultureInfo _culture => Culture ?? CultureInfo.CurrentUICulture;

    // The calendar has no inner field to show validation, so it shows the first message of either end itself;
    // in Fields mode each inner field shows its own.
    private string? _errorText => ErrorText
        ?? (Mode == DateRangePickerMode.Calendar ? ValidationMessage(StartFor) ?? ValidationMessage(EndFor) : null);

    private string? ValidationMessage(Expression<Func<DateOnly?>>? field) =>
        EditContext is not null && field is not null
            ? EditContext.GetValidationMessages(FieldIdentifier.Create(field)).FirstOrDefault()
            : null;

    // Every change of an end reaches the edit context - a calendar pick or a preset changes it without an inner
    // field, and a second notice after a field's own one only re-validates.
    private void Notify(Expression<Func<DateOnly?>>? field)
    {
        if (EditContext is not null && field is not null)
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(field));
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public override ValueTask DisposeAsync()
    {
        if (_subscribedContext is not null) _subscribedContext.OnValidationStateChanged -= HandleValidationStateChanged;
        _subscribedContext = null;
        return base.DisposeAsync();
    }

    // --- Calendar-mode state ---
    private int _viewYear;
    private int _viewMonth;
    private DateOnly? _hover;
    private DateOnly? _pendingStart;
    // The keyboard cursor (roving focus); starts from the range and moves with the arrow keys (TASK-128).
    private DateOnly? _focusedDate;
    private DateOnly FocusedCursor => _focusedDate ?? _pendingStart ?? StartDate ?? Today;
    // The range the visible month was last anchored to, so a re-render does not undo month navigation.
    private (DateOnly?, DateOnly?)? _anchoredRange;

    private DateRangeRules _rules => new(MinDays, MaxDays, AllowDisabledDatesInRange, IsDateDisabled);
    private int _minLength => MinDays is > 1 ? MinDays.Value : 1;

    // Reach of the last two anchors (the pending start, or the field ends), so a render does not rescan.
    private (DateRangeRules Rules, DateOnly Anchor, (DateOnly? Lo, DateOnly? Hi) Reach)? _reachA, _reachB;

    private (DateOnly? Lo, DateOnly? Hi) ReachOf(DateOnly anchor)
    {
        var rules = _rules;
        if (_reachA is { } a && a.Rules == rules && a.Anchor == anchor) return a.Reach;
        if (_reachB is { } b && b.Rules == rules && b.Anchor == anchor) return b.Reach;
        var reach = rules.Reach(anchor);
        _reachB = _reachA;
        _reachA = (rules, anchor, reach);
        return reach;
    }

    // Effective bounds for the inner pickers: never start > end, and the length/blackout rules from the other end.
    private DateOnly? StartFieldMin => Later(Min, EndDate is { } e ? ReachOf(e).Lo : null);
    private DateOnly? StartFieldMax => Earlier(EndDate is { } e ? Shift(e, -(_minLength - 1)) : null, Max);
    private DateOnly? EndFieldMin => Later(StartDate is { } s ? Shift(s, _minLength - 1) : null, Min);
    private DateOnly? EndFieldMax => Earlier(Max, StartDate is { } s ? ReachOf(s).Hi : null);

    private static DateOnly Shift(DateOnly d, int days) =>
        DateOnly.FromDayNumber(Math.Clamp(d.DayNumber + days, 0, DateOnly.MaxValue.DayNumber));

    // While the end is being picked, a day it cannot be is off in the calendar and skipped by the arrows. The
    // pending start keeps its look; a click on it is refused by the rules like any other too-short end.
    private bool IsDayUnavailable(DateOnly d) =>
        IsDayDisabled(d) || (_pendingStart is { } p && d != p && !_rules.CanEnd(p, d, ReachOf(p)));

    private IReadOnlyList<DateRangePreset> _effectivePresets => Presets ?? DefaultPresets;

    /// <summary>
    /// The built-in quick-range presets (Today, Yesterday, Last 7 / 30 days, This / Last month, This
    /// year). Exposed so callers can keep the standard set AND add their own via the
    /// <see cref="Presets"/> parameter, e.g.
    /// <c>Presets="[.. FlareDateRangePicker.DefaultPresets, .. myPresets]"</c>. Built fresh on each
    /// access so the localized labels follow the current culture.
    /// </summary>
    public static IReadOnlyList<DateRangePreset> DefaultPresets =>
    [
        new(FlareStrings.DateRangePicker_Today,      t => (t, t)),
        new(FlareStrings.DateRangePicker_Yesterday,  t => (t.AddDays(-1), t.AddDays(-1))),
        new(FlareStrings.DateRangePicker_Last7Days,  t => (t.AddDays(-6), t)),
        new(FlareStrings.DateRangePicker_Last30Days, t => (t.AddDays(-29), t)),
        new(FlareStrings.DateRangePicker_ThisMonth,  t => (new DateOnly(t.Year, t.Month, 1), new DateOnly(t.Year, t.Month, 1).AddMonths(1).AddDays(-1))),
        new(FlareStrings.DateRangePicker_LastMonth,  t => { var f = new DateOnly(t.Year, t.Month, 1).AddMonths(-1); return (f, f.AddMonths(1).AddDays(-1)); }),
        new(FlareStrings.DateRangePicker_ThisYear,   t => (new DateOnly(t.Year, 1, 1), new DateOnly(t.Year, 12, 31))),
    ];

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribedContext, EditContext))
        {
            if (_subscribedContext is not null) _subscribedContext.OnValidationStateChanged -= HandleValidationStateChanged;
            _subscribedContext = EditContext;
            if (_subscribedContext is not null) _subscribedContext.OnValidationStateChanged += HandleValidationStateChanged;
        }

        // Anchor the visible month to the range (or today) when the range changes, while not actively
        // picking the end; a plain re-render keeps the month the user navigated to.
        if (_pendingStart is null && _anchoredRange != (StartDate, EndDate))
        {
            _anchoredRange = (StartDate, EndDate);
            var anchor = StartDate ?? EndDate ?? Today;
            _viewYear = anchor.Year;
            _viewMonth = anchor.Month;
        }
    }

    private string HeaderLabel => new DateTime(_viewYear, _viewMonth, 1).ToString("MMMM yyyy", _culture);

    // Day headers + the 6x7 grid are rendered by the shared FlareMonthGrid (CalendarMath); the
    // start/end/in-range highlight is supplied per day here.
    private string RangeDayClass(DateOnly d) => string.Join(' ', new[]
    {
        InRange(d)      ? Css.Classes.Daterangepicker.DayInRange : null,
        IsRangeStart(d) ? Css.Classes.Daterangepicker.DayStart   : null,
        IsRangeEnd(d)   ? Css.Classes.Daterangepicker.DayEnd     : null,
        DayClassFunc?.Invoke(d),
    }.Where(c => !string.IsNullOrEmpty(c)));

    private bool IsDayDisabled(DateOnly d) =>
        (Min is { } min && d < min) || (Max is { } max && d > max) || (IsDateDisabled?.Invoke(d) ?? false);

    // The range to paint: a committed StartDate..EndDate, or a live preview from the pending start to
    // the hovered day while choosing the end.
    private (DateOnly Lo, DateOnly Hi)? PaintedRange
    {
        get
        {
            if (StartDate is { } s && EndDate is { } e) return (Earliest(s, e), Latest(s, e));
            if (_pendingStart is { } p && _hover is { } h) return (Earliest(p, h), Latest(p, h));
            return null;
        }
    }

    private bool InRange(DateOnly d) => PaintedRange is { } r && d > r.Lo && d < r.Hi;
    private bool IsRangeStart(DateOnly d) => PaintedRange is { } r ? d == r.Lo : d == (_pendingStart ?? StartDate);
    private bool IsRangeEnd(DateOnly d) => PaintedRange is { } r && d == r.Hi && r.Hi != r.Lo;

    // Month navigation stays inside the DateOnly range (TASK-129, as TASK-105 for the date picker).
    private bool CanPrev => _viewYear > 1 || _viewMonth > 1;
    private bool CanNext => _viewYear < 9999 || _viewMonth < 12;

    private void PrevMonth()
    {
        if (!CanPrev) return;
        var d = new DateOnly(_viewYear, _viewMonth, 1).AddMonths(-1);
        _viewYear = d.Year;
        _viewMonth = d.Month;
    }

    private void NextMonth()
    {
        if (!CanNext) return;
        var d = new DateOnly(_viewYear, _viewMonth, 1).AddMonths(1);
        _viewYear = d.Year;
        _viewMonth = d.Month;
    }

    private async Task PickDayAsync(DateOnly date)
    {
        if (Disabled || ReadOnly || IsDayDisabled(date)) return;

        if (_pendingStart is null)
        {
            // First click: start a fresh range.
            _pendingStart = date;
            _hover = date;
            await SetStartAsync(date);
            await SetEndAsync(null);
        }
        else
        {
            // Second click: complete it (swap if the end precedes the start) - unless the length or blackout
            // rules refuse the range, which keeps the start waiting for another end (TASK-148).
            if (!_rules.Allows(_pendingStart.Value, date)) return;
            var lo = Earliest(_pendingStart.Value, date);
            var hi = Latest(_pendingStart.Value, date);
            _pendingStart = null;
            _hover = null;
            await SetStartAsync(lo);
            await SetEndAsync(hi);
        }
    }

    // Arrow keys move the cursor over available days, crossing months as needed; while the end is being
    // picked the preview follows the cursor as it follows the pointer. Enter/Space are left to the native
    // click of the focused day button, which the grid keeps on the cursor (TASK-124, TASK-128).
    private void HandleGridKeyDown(KeyboardEventArgs e)
    {
        if (Disabled) return;
        // The grid has synced the cursor to the day the user sees focused before this runs (TASK-133).
        if (CalendarMath.KeyTarget(FocusedCursor, e.Key, e.ShiftKey,
                FirstDayOfWeek ?? _culture.DateTimeFormat.FirstDayOfWeek, IsDayUnavailable) is not { } day) return;

        _focusedDate = day;
        if (_pendingStart is not null) _hover = day;
        if (day.Year != _viewYear || day.Month != _viewMonth)
        {
            _viewYear = day.Year;
            _viewMonth = day.Month;
        }
    }

    private bool IsActivePreset(DateRangePreset preset)
    {
        if (!StartDate.HasValue || !EndDate.HasValue) return false;
        var (s, e) = preset.Range(Today);
        return StartDate.Value == s && EndDate.Value == e;
    }

    private async Task ApplyPreset(DateRangePreset preset)
    {
        if (Disabled || ReadOnly) return;
        var (s, e) = preset.Range(Today);
        if (s > e) (s, e) = (e, s);
        // A preset obeys the same bounds as a manual pick: Min/Max and IsDateDisabled (TASK-114), and the
        // length and blackout rules (TASK-148).
        if (IsDayDisabled(s) || IsDayDisabled(e) || !_rules.Allows(s, e)) return;
        _pendingStart = null;
        _hover = null;
        await SetStartAsync(s);
        await SetEndAsync(e);
    }

    private async Task HandleStartChanged(DateOnly? value)
    {
        await SetStartAsync(value);
        // clamp: if start > end, clear end
        if (value.HasValue && EndDate.HasValue && value.Value > EndDate.Value)
            await SetEndAsync(null);
    }

    private Task HandleEndChanged(DateOnly? value) => SetEndAsync(value);

    private async Task SetStartAsync(DateOnly? v)
    {
        StartDate = v;
        await StartDateChanged.InvokeAsync(v);
        Notify(StartFor);
    }

    private async Task SetEndAsync(DateOnly? v)
    {
        EndDate = v;
        await EndDateChanged.InvokeAsync(v);
        Notify(EndFor);
    }

    private static DateOnly Earliest(DateOnly a, DateOnly b) => a <= b ? a : b;
    private static DateOnly Latest(DateOnly a, DateOnly b) => a >= b ? a : b;
    private static DateOnly? Earlier(DateOnly? a, DateOnly? b) => (a, b) switch { ({ } x, { } y) => Earliest(x, y), ({ } x, null) => x, (null, { } y) => y, _ => null };
    private static DateOnly? Later(DateOnly? a, DateOnly? b) => (a, b) switch { ({ } x, { } y) => Latest(x, y), ({ } x, null) => x, (null, { } y) => y, _ => null };

}
