@namespace Flare.Components
@inherits FlareFieldBase
@implements IFlareField<DateOnly?>
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject TimeProvider TimeProvider
@inject Flare.Components.Services.IOverlayJsService Overlay
@inject Flare.Components.Services.IElementJsService ElementJs

@* Composes the shared FlareFieldChrome frame (root + label + helper/error). The date field owns its
   trigger well (input + calendar toggle) and the anchored calendar popup, rendered in the Field slot. *@
<FlareFieldChrome ComponentClass="@Css.Classes.DatePicker.Root"
                  Variant="Variant" Size="Size"
                  Invalid="@_invalid"
                  Disabled="Disabled" ReadOnly="ReadOnly"
                  Label="@Label" LabelContent="@LabelContent" LabelFor="@ControlId"
                  HelperText="@HelperText" HelperId="@HelperId"
                  ErrorText="@DisplayedErrorText" ErrorId="@ErrorId"
                  Class="@Class" Style="@Style" Attributes="AdditionalAttributes">
    <Field>
        <div class="@Css.Classes.Input.Field @Css.Classes.Picker.Field" @ref="_fieldEl">
            <input class="@Css.Classes.Input.Control"
                   id="@ControlId"
                   @ref="_inputEl"
                   style="@(Typo is { } _t ? FlareTypography.FontStyle(_t) : null)"
                   type="text"
                   value="@_text"
                   readonly="@(!AllowInput || ReadOnly)"
                   required="@Required"
                   placeholder="@(Placeholder ?? _numericPattern)"
                   disabled="@Disabled"
                   aria-label="@(Label ?? Placeholder)"
                   aria-required="@(Required ? "true" : null)"
                   aria-invalid="@(_invalid ? "true" : null)"
                   aria-describedby="@SupportDescribedBy"
                   @onfocus="HandleFocus"
                   @oninput="HandleInput"
                   @onchange="HandleTextChange"
                   @onblur="HandleBlur"
                   @attributes="InputAttributes" />
            @if (AllowPicker && !Inline)
            {
                <button type="button" class="@Css.Classes.Input.Toggle @Css.Classes.Input.Icon @Css.Classes.Input.IconTrailing"
                        disabled="@(Disabled || ReadOnly)" aria-haspopup="dialog" aria-expanded="@_open"
                        aria-label="@(FlareStrings.DatePicker_Open)" @ref="_toggleEl" @onclick="Toggle">
                    <FlareIconView Value="@FlareIcons.CalendarMonth" />
                </button>
            }
        </div>

        @if (_open && !Inline)
        {
            <div class="@Css.Classes.Picker.Scrim" @onclick="Close" aria-hidden="true"></div>
        }
        @if (_open || Inline)
        {
        <div class="@Css.Classes.Picker.Panel @(Inline ? Css.Classes.Picker.PanelInline : null) @Css.Classes.DatePicker.Panel"
             role="@(Inline ? null : "dialog")" aria-modal="@(Inline ? null : "true")" aria-label="@HeaderLabel" @ref="_panelEl"
             @onkeydown="HandlePanelKeyDown" @onkeydown:stopPropagation="@(!Inline)">
            <div class="@Css.Classes.DatePicker.Header">
                <span @onclick:stopPropagation @onclick="() => { }">
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="PrevView" AriaLabel="@FlareStrings.Picker_Previous" Disabled="@(!CanPrev)">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.ChevronLeft" /></LeadingIcon>
                    </FlareButton>
                </span>
                <button class="@($"{Css.Classes.DatePicker.MonthLabel} {Css.Classes.DatePicker.MonthLabelClickable}")"
                        type="button" @onclick="CycleCalendarView" @onclick:stopPropagation>
                    @HeaderLabel
                </button>
                <span @onclick:stopPropagation @onclick="() => { }">
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="NextView" AriaLabel="@FlareStrings.Picker_Next" Disabled="@(!CanNext)">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.ChevronRight" /></LeadingIcon>
                    </FlareButton>
                </span>
            </div>

            @if (_calView == CalendarView.Day)
            {
                <FlareMonthGrid @ref="_grid" ViewYear="_viewYear" ViewMonth="_viewMonth" Culture="_culture" Today="Today"
                                FirstDayOfWeek="FirstDayOfWeek" ShowWeekNumbers="ShowWeekNumbers"
                                AriaLabel="@HeaderLabel"
                                Selected="@(d => d == Value)"
                                Disabled="IsDayUnavailable"
                                FocusedDate="@FocusedCursor"
                                FocusedDateChanged="@(d => _focusedDate = d)"
                                DayClass="ComposeDayClass"
                                DayContent="DayTemplate"
                                OnDayClick="SelectDay"
                                OnKeyDown="HandleGridKeyDown" />
            }
            else if (_calView == CalendarView.Month)
            {
                <div class="@Css.Classes.DatePicker.MonthGrid">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <button type="button"
                                class="@Css.Classes.DatePicker.MonthBtn @(month == _viewMonth ? Css.Classes.DatePicker.MonthSelected : "")"
                                @onclick="@(() => SelectMonth(month))"
                                @onclick:stopPropagation>
                            @(new DateTime(2000, month, 1).ToString("MMM", _culture))
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="@Css.Classes.DatePicker.YearGrid">
                    @for (var y = _decadeStart; y < _decadeStart + 12; y++)
                    {
                        var year = y;
                        <button type="button"
                                class="@Css.Classes.DatePicker.YearBtn @(year == _viewYear ? Css.Classes.DatePicker.YearSelected : "")"
                                @onclick="@(() => SelectYear(year))"
                                @onclick:stopPropagation>
                            @CalendarMath.YearLabel(year, _culture)
                        </button>
                    }
                </div>
            }

            <div class="@Css.Classes.DatePicker.Footer">
                @if (ShowClearButton)
                {
                    <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" @onclick="ClearValue" @onclick:stopPropagation>@(ClearText ?? FlareStrings.Picker_Clear)</button>
                }
                @if (ShowTodayButton)
                {
                    <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" @onclick="GoToToday" @onclick:stopPropagation>@(TodayText ?? FlareStrings.DatePicker_Today)</button>
                }
            </div>
        </div>
        }
    </Field>
</FlareFieldChrome>

