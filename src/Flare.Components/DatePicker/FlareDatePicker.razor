@namespace Flare.Components
@inherits FlareFieldBase
@implements IFlareField<DateOnly?>
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject TimeProvider TimeProvider
@inject Flare.Components.Services.IOverlayJsService Overlay
@inject Flare.Components.Services.IElementJsService ElementJs

@* Composes the shared FlareFieldChrome frame (root + label + helper/error). The date field owns its
   trigger well (input + calendar toggle) and the anchored calendar popup, rendered in the Field slot. *@
<FlareFieldChrome ComponentClass="@Css.Classes.DatePicker.Root"
                  Variant="Variant" Size="Size"
                  Invalid="@_invalid"
                  Disabled="Disabled" ReadOnly="ReadOnly"
                  Label="@Label" LabelContent="@LabelContent" LabelFor="@ControlId"
                  HelperText="@HelperText" HelperId="@HelperId"
                  ErrorText="@DisplayedErrorText" ErrorId="@ErrorId"
                  Class="@Class" Style="@Style" Attributes="AdditionalAttributes">
    <Field>
        <div class="@Css.Classes.Input.Field @Css.Classes.Picker.Field" @ref="_fieldEl">
            <input class="@Css.Classes.Input.Control"
                   id="@ControlId"
                   @ref="_inputEl"
                   style="@(Typo is { } _t ? FlareTypography.FontStyle(_t) : null)"
                   type="text"
                   value="@_text"
                   readonly="@(!AllowInput || ReadOnly)"
                   required="@Required"
                   placeholder="@(Placeholder ?? (_digitEditing ? _numericPattern : _format))"
                   disabled="@Disabled"
                   aria-label="@(Label ?? Placeholder)"
                   aria-required="@(Required ? "true" : null)"
                   aria-invalid="@(_invalid ? "true" : null)"
                   aria-describedby="@SupportDescribedBy"
                   @onfocus="HandleFocus"
                   @onclick="OpenFromField"
                   @onkeydown="FieldKeyDown"
                   @oninput="HandleInput"
                   @onchange="HandleTextChange"
                   @onblur="HandleBlur"
                   @attributes="InputAttributes" />
            @if (AllowPicker && !Inline)
            {
                <button type="button" class="@Css.Classes.Input.Toggle @Css.Classes.Input.Icon @Css.Classes.Input.IconTrailing"
                        disabled="@(Disabled || ReadOnly)" aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")"
                        aria-label="@(FlareStrings.DatePicker_Open)" @ref="_toggleEl" @onclick="Toggle">
                    <FlareIconView Value="@FlareIcons.CalendarMonth" />
                </button>
            }
        </div>

        @if (_open && !Inline)
        {
            <div class="@Css.Classes.Picker.Scrim" @onclick="Close" aria-hidden="true"></div>
        }
        @if (_open || Inline)
        {
        <div class="@Css.Classes.Picker.Panel @(Inline ? Css.Classes.Picker.PanelInline : null) @Css.Classes.DatePicker.Panel"
             role="@(Inline ? null : "dialog")" aria-modal="@(Inline ? null : _popup.FromField ? "false" : "true")" aria-label="@HeaderLabel" @ref="_panelEl"
             @onkeydown="HandlePanelKeyDown" @onkeydown:stopPropagation="@(!Inline)">
            <div class="@Css.Classes.DatePicker.Header">
                @PickerButtons.Icon(this, PrevView, FlareStrings.Picker_Previous, FlareIcons.ChevronLeft, Disabled || !CanPrev)
                <button class="@($"{Css.Classes.DatePicker.MonthLabel} {Css.Classes.DatePicker.MonthLabelClickable}")"
                        type="button" aria-live="polite" title="@ViewSwitchHint" @onclick="CycleCalendarView" @onclick:stopPropagation>
                    @HeaderLabel
                </button>
                @PickerButtons.Icon(this, NextView, FlareStrings.Picker_Next, FlareIcons.ChevronRight, Disabled || !CanNext)
            </div>

            @if (_calView == PickerView.Day)
            {
                <FlareMonthGrid @ref="_grid" ViewYear="_view.Year" ViewMonth="_view.Month" Culture="_culture" Today="Today"
                                FirstDayOfWeek="FirstDayOfWeek" ShowWeekNumbers="ShowWeekNumbers"
                                AriaLabel="@HeaderLabel"
                                Selected="@(d => d == Value)"
                                Disabled="IsDayUnavailable"
                                FocusedDate="@FocusedCursor"
                                FocusedDateChanged="@(d => _focusedDate = d)"
                                DayClass="ComposeDayClass"
                                DayContent="DayTemplate"
                                OnDayClick="SelectDay"
                                OnKeyDown="HandleGridKeyDown" />
            }
            else
            {
                <FlareMonthYearGrid View="@(_calView == PickerView.Month ? MonthYearGridView.Months : MonthYearGridView.Years)"
                                    Year="_viewYear" SelectedMonth="_viewMonth" SelectedYear="_viewYear"
                                    Culture="_culture" Today="Today" Min="Min" Max="Max" Disabled="Disabled" AriaLabel="@HeaderLabel"
                                    OnPick="PickInView" OnKeyDown="HandleViewKeyDown" />
            }

            <div class="@Css.Classes.DatePicker.Footer">
                @if (ShowClearButton)
                {
                    <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" disabled="@(Disabled || ReadOnly)" @onclick="ClearValue" @onclick:stopPropagation>@(ClearText ?? FlareStrings.Picker_Clear)</button>
                }
                @if (ShowTodayButton)
                {
                    <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" disabled="@Disabled" @onclick="GoToToday" @onclick:stopPropagation>@(TodayText ?? FlareStrings.DatePicker_Today)</button>
                }
            </div>
        </div>
        }
    </Field>
</FlareFieldChrome>

