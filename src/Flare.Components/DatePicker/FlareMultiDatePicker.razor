@namespace Flare.Components
@inherits FlareFieldBase
@using System.Globalization
@inject TimeProvider TimeProvider
@inject Flare.Components.Services.IOverlayJsService Overlay

@* A field for several dates (TASK-183): the day grid toggles days on the calendar the picker shows; the field lists
   the dates (or counts them) and takes a list typed with ';' between the dates. *@
<FlareFieldChrome ComponentClass="@Css.Classes.MultiDatePicker.Root"
                  Variant="Variant" Size="Size"
                  Invalid="@_invalid"
                  Disabled="Disabled" ReadOnly="ReadOnly"
                  Label="@Label" LabelContent="@LabelContent" LabelFor="@ControlId"
                  HelperText="@HelperText" HelperId="@HelperId"
                  ErrorText="@DisplayedErrorText" ErrorId="@ErrorId"
                  Class="@Class" Style="@Style" Attributes="AdditionalAttributes">
    <Field>
        <div class="@Css.Classes.Input.Field @Css.Classes.Picker.Field" @ref="_fieldEl">
            <input class="@Css.Classes.Input.Control"
                   id="@ControlId"
                   @ref="_inputEl"
                   style="@(Typo is { } _t ? FlareTypography.FontStyle(_t) : null)"
                   type="text"
                   value="@_text"
                   readonly="@(!AllowInput || ReadOnly)"
                   required="@Required"
                   placeholder="@(Placeholder ?? _format)"
                   disabled="@Disabled"
                   aria-label="@(Label ?? Placeholder)"
                   aria-required="@(Required ? "true" : null)"
                   aria-invalid="@(_invalid ? "true" : null)"
                   aria-describedby="@SupportDescribedBy"
                   @onfocus="HandleFocus"
                   @onclick="OpenFromField"
                   @onkeydown="FieldKeyDown"
                   @oninput="HandleInput"
                   @onchange="HandleTextChange"
                   @onblur="HandleBlur"
                   @attributes="InputAttributes" />
            @if (AllowPicker && !Inline)
            {
                <button type="button" class="@Css.Classes.Input.Toggle @Css.Classes.Input.Icon @Css.Classes.Input.IconTrailing"
                        disabled="@(Disabled || ReadOnly)" aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")"
                        aria-label="@FlareStrings.MultiDatePicker_Open" @ref="_toggleEl" @onclick="Toggle">
                    <FlareIconView Value="@FlareIcons.CalendarMonth" />
                </button>
            }
        </div>

        @if (_open && !Inline)
        {
            <div class="@Css.Classes.Picker.Scrim" @onclick="Close" aria-hidden="true"></div>
        }
        @if (_open || Inline)
        {
        <div class="@Css.Classes.Picker.Panel @(Inline ? Css.Classes.Picker.PanelInline : null) @Css.Classes.DatePicker.Panel"
             role="@(Inline ? null : "dialog")" aria-modal="@(Inline ? null : _popup.FromField ? "false" : "true")" aria-label="@_views.HeaderLabel" @ref="_panelEl"
             @onkeydown="HandlePanelKeyDown" @onkeydown:stopPropagation="@(!Inline)">
            <div class="@Css.Classes.DatePicker.Header">
                @PickerButtons.Icon(this, _views.Prev, FlareStrings.Picker_Previous, FlareIcons.ChevronLeft, Disabled || !_views.CanPrev)
                <button class="@($"{Css.Classes.DatePicker.MonthLabel} {Css.Classes.DatePicker.MonthLabelClickable}")"
                        type="button" aria-live="polite" title="@_views.SwitchHint" @onclick="_views.Cycle" @onclick:stopPropagation>
                    @_views.HeaderLabel
                </button>
                @PickerButtons.Icon(this, _views.Next, FlareStrings.Picker_Next, FlareIcons.ChevronRight, Disabled || !_views.CanNext)
            </div>

            @if (_views.View == PickerView.Day)
            {
                <FlareMonthGrid @ref="_grid" ViewYear="_views.Shown.Year" ViewMonth="_views.Shown.Month" Culture="_culture" Today="Today"
                                FirstDayOfWeek="FirstDayOfWeek" ShowWeekNumbers="ShowWeekNumbers" MultiSelectable="true"
                                AriaLabel="@_views.HeaderLabel"
                                Selected="IsSelected"
                                Disabled="IsDayUnavailable"
                                FocusedDate="@FocusedCursor"
                                FocusedDateChanged="@(d => _focusedDate = d)"
                                DayClass="ComposeDayClass"
                                DayContent="DayTemplate"
                                OnDayClick="ToggleDay"
                                OnKeyDown="HandleGridKeyDown" />
            }
            else
            {
                <FlareMonthYearGrid View="_views.GridView" Year="_views.Year" SelectedMonth="_views.Month" SelectedYear="_views.Year"
                                    Culture="_culture" Today="Today" Min="Min" Max="Max" Disabled="Disabled" AriaLabel="@_views.HeaderLabel"
                                    OnPick="_views.Pick" OnKeyDown="_views.PageKey" />
            }

            <div class="@Css.Classes.DatePicker.Footer">
                @if (ShowClearButton)
                {
                    <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" disabled="@(Disabled || ReadOnly || _dates.Count == 0)" @onclick="ClearValue" @onclick:stopPropagation>@(ClearText ?? FlareStrings.Picker_Clear)</button>
                }
                @if (!Inline)
                {
                    <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" @onclick="Close" @onclick:stopPropagation>@(DoneText ?? FlareStrings.Picker_Done)</button>
                }
            </div>
        </div>
        }
    </Field>
</FlareFieldChrome>
