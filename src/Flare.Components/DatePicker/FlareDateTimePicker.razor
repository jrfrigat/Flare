@namespace Flare.Components
@inherits FlareFieldBase
@implements IFlareField<DateTimeOffset?>
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Web
@inject TimeProvider TimeProvider
@inject Flare.Components.Services.IOverlayJsService Overlay
@inject IBrowserViewportService Viewport
@inject Flare.Components.Services.IElementJsService ElementJs

@* Composes the shared FlareFieldChrome frame (root + label + helper/error). The date-time field owns its
   trigger well (input + calendar/clock toggle) and the anchored combined popup, rendered in the Field slot. *@
<FlareFieldChrome ComponentClass="@Css.Classes.DateTimePicker.Root"
                  Variant="Variant" Size="Size"
                  Invalid="@_invalid"
                  Disabled="Disabled" ReadOnly="ReadOnly"
                  Label="@Label" LabelContent="@LabelContent" LabelFor="@ControlId"
                  HelperText="@HelperText" HelperId="@HelperId"
                  ErrorText="@DisplayedErrorText" ErrorId="@ErrorId"
                  Class="@Class" Style="@Style" Attributes="AdditionalAttributes">
    <Field>
        <div class="@Css.Classes.Input.Field @Css.Classes.Picker.Field" @ref="_fieldRef">
            <input class="@Css.Classes.Input.Control"
                   id="@ControlId"
                   @ref="_inputEl"
                   style="@(Typo is { } _t ? FlareTypography.FontStyle(_t) : null)"
                   type="text"
                   disabled="@Disabled"
                   readonly="@(!AllowInput || ReadOnly)"
                   required="@Required"
                   aria-required="@(Required ? "true" : null)"
                   placeholder="@(Placeholder ?? _numericPattern)"
                   aria-label="@(Label ?? Placeholder)"
                   aria-invalid="@(_invalid ? "true" : null)"
                   aria-describedby="@SupportDescribedBy"
                   value="@_text"
                   @onfocus="HandleFocus"
                   @oninput="HandleInput"
                   @onchange="HandleTextChange"
                   @onblur="HandleBlur"
                   @attributes="InputAttributes" />
            @if (AllowPicker)
            {
                <button type="button" class="@Css.Classes.Input.Toggle @Css.Classes.Input.Icon @Css.Classes.Input.IconTrailing"
                        disabled="@(Disabled || ReadOnly)" aria-haspopup="dialog" aria-expanded="@_open"
                        aria-label="@FlareStrings.DateTimePicker_Open" @ref="_toggleEl" @onclick="TogglePanel">
                    <FlareIconView Value="@FlareIcons.CalendarClock" />
                </button>
            }
        </div>
        @if (_open)
        {
        <div class="@Css.Classes.Picker.Scrim" @onclick="CloseAsync" aria-hidden="true"></div>
        <div class="@Css.Classes.Picker.Panel @Css.Classes.DateTimePicker.Panel @(_panels ? Css.Classes.DateTimePicker.PanelSplit : null)"
             role="dialog" aria-modal="true" aria-label="@FlareStrings.DateTimePicker_Open" @ref="_panelEl"
             @onkeydown="HandlePanelKeyDown" @onkeydown:stopPropagation>
            @if (_panels)
            {
                <div class="@Css.Classes.DateTimePicker.Panes">
                    <div class="@Css.Classes.DateTimePicker.Pane">@_calendar</div>
                    @* The split panel itself is transparent - each pane is its own surface - so the actions
                       live in the time pane, where they have a background. *@
                    <div class="@Css.Classes.DateTimePicker.Pane">@_time @_footer</div>
                </div>
            }
            else
            {
                <div class="@Css.Classes.DateTimePicker.Tabs">
                    <button class="@Css.Classes.DateTimePicker.Tab @(_activeTab == 0 ? Css.Classes.DateTimePicker.TabActive : "")"
                            type="button" @onclick='() => _activeTab = 0'>@(FlareStrings.DateTimePicker_DateTab)</button>
                    <button class="@Css.Classes.DateTimePicker.Tab @(_activeTab == 1 ? Css.Classes.DateTimePicker.TabActive : "")"
                            type="button" @onclick='() => _activeTab = 1'>@(FlareStrings.DateTimePicker_TimeTab)</button>
                </div>
                @if (_activeTab == 0) { @_calendar } else { @_time }
                @_footer
            }
        </div>
        }
    </Field>
</FlareFieldChrome>

@code {
    // Calendar pane (nav + headers + grid) - reused by Tabs and Panels.
    private RenderFragment _calendar => @<text>
        <div class="@Css.Classes.DateTimePicker.Nav">
            <span @onclick:stopPropagation @onclick="() => { }">
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="PrevMonth" AriaLabel="@FlareStrings.Picker_Previous">
                    <LeadingIcon><FlareIconView Value="@FlareIcons.ChevronLeft" /></LeadingIcon>
                </FlareButton>
            </span>
            <span class="@Css.Classes.DateTimePicker.NavLabel">@_viewDate.ToString("MMMM yyyy", _culture)</span>
            <span @onclick:stopPropagation @onclick="() => { }">
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="NextMonth" AriaLabel="@FlareStrings.Picker_Next">
                    <LeadingIcon><FlareIconView Value="@FlareIcons.ChevronRight" /></LeadingIcon>
                </FlareButton>
            </span>
        </div>
        <FlareMonthGrid @ref="_grid" ViewYear="_viewDate.Year" ViewMonth="_viewDate.Month" Culture="_culture" Today="Today"
                        FirstDayOfWeek="FirstDayOfWeek" ShowWeekNumbers="ShowWeekNumbers"
                        AriaLabel="@_viewDate.ToString("MMMM yyyy", _culture)"
                        Selected="@(d => d == _selectedDate)"
                        Disabled="IsDayDisabled"
                        FocusedDate="@FocusedCursor"
                        FocusedDateChanged="@(d => _focusedDate = d)"
                        OnKeyDown="HandleGridKeyDown"
                        DayClass="ComposeDayClass"
                        DayContent="DayTemplate"
                        OnDayClick="SelectDate" />
    </text>;

    // Time pane (clock dial or number inputs) - reused by Tabs and Panels.
    private RenderFragment _footer => @<div class="@Css.Classes.DateTimePicker.Footer">
        <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" @onclick="Clear" @onclick:stopPropagation>@(FlareStrings.Picker_Clear)</button>
        <button class="@($"{Css.Classes.Button.Root} {Css.Classes.Button.Text}")" type="button" disabled="@(!CanConfirm)" @onclick="Confirm" @onclick:stopPropagation>@(FlareStrings.Picker_Ok)</button>
    </div>;

    private RenderFragment _time => @<text>
        @if (TimeVariant == TimePickerVariant.Dial)
        {
            <FlareClockDial Hour="_hour" HourChanged="h => _hour = h"
                            Minute="_minute" MinuteChanged="m => _minute = m"
                            Is24Hour="_is24Hour" />
        }
        else
        {
            <div class="@Css.Classes.DateTimePicker.Time">
                <input type="number" min="0" max="23" step="@_hourStep" class="@Css.Classes.DateTimePicker.TimeInput"
                       aria-label="@FlareStrings.TimePicker_Hours"
                       value="@_hour" @onchange="e => SetHour(e.Value?.ToString())" />
                <span>:</span>
                <input type="number" min="0" max="59" step="@_minuteStep" class="@Css.Classes.DateTimePicker.TimeInput"
                       aria-label="@FlareStrings.TimePicker_Minutes"
                       value="@_minute" @onchange="e => SetMinute(e.Value?.ToString())" />
                @if (ShowSeconds)
                {
                    <span>:</span>
                    <input type="number" min="0" max="59" class="@Css.Classes.DateTimePicker.TimeInput"
                           aria-label="@FlareStrings.TimePicker_Seconds"
                           value="@_second" @onchange="e => SetSecond(e.Value?.ToString())" />
                }
            </div>
        }
    </text>;
}
