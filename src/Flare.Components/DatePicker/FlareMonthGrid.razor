@namespace Flare.Components
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@* Shared month calendar grid used by FlareDatePicker, FlareDateTimePicker and FlareDateRangePicker:
   the weekday header row and the 6x7 day-button grid. Selection/range decoration is supplied by the
   host through DayClass; disabled/keyboard/hover are optional hooks so each picker keeps its own
   behaviour while the markup + date generation (CalendarMath) live here once.
   The grid role wraps the weekday row too, so each day column has its header; the wrapper is a plain block and the
   header row and the day grid keep their own layout. *@

@{ EnsureDayStates(); }
<div role="grid" aria-label="@AriaLabel" aria-multiselectable="@(MultiSelectable ? "true" : null)"
     @onkeydown="HandleKeyDown" @onkeydown:stopPropagation>
<div class="@Css.Classes.Picker.DayHeaders @(ShowWeekNumbers ? Css.Classes.Picker.DayHeadersWeeks : null)" role="row">
    @if (ShowWeekNumbers)
    {
        <span class="@Css.Classes.Picker.WeekNum" role="columnheader" aria-label="@FlareStrings.Picker_Week"></span>
    }
    @{ var dayNames = DayNames(); var dayIndex = 0; }
    @foreach (var h in CalendarMath.DayHeaders(_culture, _firstDayOfWeek))
    {
        <span role="columnheader" aria-label="@dayNames[dayIndex++]">@h</span>
    }
</div>
<div class="@Css.Classes.Picker.Grid @(ShowWeekNumbers ? Css.Classes.Picker.GridWeeks : null)" role="rowgroup">
    @{
        var weeks = _weeks;
        var position = 0;
    }
    @foreach (var week in weeks)
    {
        <div class="@Css.Classes.Picker.Row" role="row">
            @if (ShowWeekNumbers)
            {
                var anchor = week.FirstOrDefault(d => d.HasValue);
                if (anchor is { } a)
                {
                    var weekNo = IsoWeekNumbers ? ISOWeek.GetWeekOfYear(a.ToDateTime(TimeOnly.MinValue)) : CalendarMath.WeekOfYear(a, _culture, _firstDayOfWeek);
                    <span class="@Css.Classes.Picker.WeekNum" role="rowheader"
                          aria-label="@string.Format(FlareStrings.Picker_WeekNumber, weekNo)">
                        @weekNo
                    </span>
                }
                else
                {
                    <span class="@Css.Classes.Picker.WeekNum" aria-hidden="true"></span>
                }
            }
            @foreach (var date in week)
            {
                var index = position++;
                if (date is not { } day)
                {
                    @* Outside the DateOnly range: an empty cell that keeps the weekday columns aligned. *@
                    <span role="gridcell" aria-hidden="true"></span>
                    continue;
                }
                var state = _dayStates[index];
                <button type="button"
                        role="gridcell"
                        tabindex="@(day == _tabTarget ? "0" : "-1")"
                        data-flare-initial-focus="@(day == _tabTarget ? "true" : null)"
                        aria-selected="@(state.Selected ? "true" : "false")"
                        aria-current="@(day == Today ? "date" : null)"
                        aria-label="@_labels[index]"
                        class="@state.Css"
                        disabled="@state.Disabled"
                        @ref="_cells[index]"
                        @onclick="@(() => ClickDay(day))"
                        @onclick:stopPropagation
                        @onmouseenter="HoverFor(day)">
                    @if (DayContent is null) { @state.Number } else { @DayContent(day) }
                </button>
            }
        </div>
    }
</div>
</div>

@code {
    /// <summary>The year of the displayed month, numbered on the grid's calendar: 1405 on the Persian calendar,
    /// the Gregorian year for Gregorian, Thai Buddhist and Japanese cultures.</summary>
    [Parameter, EditorRequired] public int ViewYear { get; set; }
    /// <summary>The month displayed, numbered on the grid's calendar (1-12, or 1-13 in a Hebrew leap year).</summary>
    [Parameter, EditorRequired] public int ViewMonth { get; set; }
    /// <summary>Culture for the weekday headers, the first day of week and the calendar. Defaults to the current UI
    /// culture. The grid follows the culture's calendar: Persian months for fa-IR, Um al-Qura months for ar-SA;
    /// Thai Buddhist and Japanese cultures keep the Gregorian months and write their own years.
    /// To change the names, pass a new culture object: names edited on the object already passed are not picked up.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }
    /// <summary>The calendar to draw the grid on instead of the culture's own, for example a
    /// <see cref="GregorianCalendar"/> for fa-IR or a <see cref="HebrewCalendar"/> for he-IL. Only a calendar the
    /// culture offers among its optional calendars is used; any other is ignored. Null (the default) uses the
    /// culture's calendar.</summary>
    [Parameter] public Calendar? Calendar { get; set; }
    /// <summary>Overrides the culture's first day of week when set (null = use the culture's).</summary>
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }
    /// <summary>Shows a leading week-of-year number column.</summary>
    [Parameter] public bool ShowWeekNumbers { get; set; }
    /// <summary>Today's date, marked with the today indicator.</summary>
    [Parameter] public DateOnly Today { get; set; }
    /// <summary>Predicate marking a day <c>aria-selected</c>; the visible selection style is supplied via <see cref="DayClass"/>.</summary>
    [Parameter] public Func<DateOnly, bool>? Selected { get; set; }
    /// <summary>Predicate disabling a day (sets the <c>disabled</c> attribute and the disabled day class).</summary>
    [Parameter] public Func<DateOnly, bool>? Disabled { get; set; }
    /// <summary>Extra CSS class(es) per day for component-specific selection or range-highlight decoration.</summary>
    [Parameter] public Func<DateOnly, string>? DayClass { get; set; }
    /// <summary>Content rendered inside a day button instead of the day number. The grid keeps the button, its
    /// full-date label, roving focus, disabled state and selection.</summary>
    [Parameter] public RenderFragment<DateOnly>? DayContent { get; set; }
    /// <summary>Numbers the week column by ISO 8601 (weeks from Monday, week 1 holds the first Thursday) instead of the
    /// culture's week rule. Pair it with a Monday <see cref="FirstDayOfWeek"/>, so each row is one ISO week.</summary>
    [Parameter] public bool IsoWeekNumbers { get; set; }
    /// <summary>Tells assistive tech that several days can be selected at once (<c>aria-multiselectable</c>), for a
    /// host that toggles days instead of picking one.</summary>
    [Parameter] public bool MultiSelectable { get; set; }
    /// <summary>Accessible label for the grid (usually the displayed month and year).</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>Raised when a day cell is clicked.</summary>
    [Parameter] public EventCallback<DateOnly> OnDayClick { get; set; }
    /// <summary>Raised when the pointer enters a day cell (for range hover preview).</summary>
    [Parameter] public EventCallback<DateOnly> OnDayHover { get; set; }
    /// <summary>Raised on keydown over the grid, so the host can own roving keyboard navigation.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    /// <summary>The keyboard cursor: the day that carries the single <c>tabindex="0"</c> (roving focus) and
    /// receives focus when a key press moves it. A cursor outside the displayed month or on a disabled day
    /// falls back to <see cref="Today"/>, then to the first available day of the month.</summary>
    [Parameter] public DateOnly? FocusedDate { get; set; }
    /// <summary>Raised with the day the keyboard cursor actually sits on when it is not <see cref="FocusedDate"/>:
    /// a clicked day, or - before <see cref="OnKeyDown"/> - the fallback day the grid made tabbable because
    /// <see cref="FocusedDate"/> left the displayed month or became disabled. The host moves its cursor there so
    /// the key press starts from the day the user sees focused.</summary>
    [Parameter] public EventCallback<DateOnly> FocusedDateChanged { get; set; }

    // The culture on the calendar the grid is drawn on (TASK-182).
    private CultureInfo _culture => CalendarMath.PickerCulture(Culture ?? CultureInfo.CurrentUICulture, Calendar);
    private DayOfWeek _firstDayOfWeek => FirstDayOfWeek ?? _culture.DateTimeFormat.FirstDayOfWeek;

    // The day of month on the grid's calendar: 11 for 3 October 2026 on the Persian one.
    private int DayNumber(DateOnly day) => _month.Calendar.GetDayOfMonth(day.ToDateTime(TimeOnly.MinValue));

    private string DayCss(DateOnly day, bool outside, bool disabled)
    {
        var css = Css.Classes.Picker.Day;
        if (outside) css = string.Concat(css, " ", Css.Classes.Picker.DayOutside);
        if (day == Today) css = string.Concat(css, " ", Css.Classes.Picker.DayToday);
        if (disabled) css = string.Concat(css, " ", Css.Classes.Picker.DayDisabled);
        var extra = DayClass?.Invoke(day);
        return string.IsNullOrEmpty(extra) ? css : string.Concat(css, " ", extra);
    }

    // The full weekday names in header order, read by assistive tech in place of the short visible ones.
    private string[] DayNames()
    {
        var first = (int)_firstDayOfWeek;
        var names = new string[7];
        for (var i = 0; i < 7; i++) names[i] = _culture.DateTimeFormat.GetDayName((DayOfWeek)((first + i) % 7));
        return names;
    }
    // Roving tabindex: exactly one available cell of the displayed month is reachable by Tab.
    private DateOnly? _tabTarget;
    internal bool HasFocusableDay => _tabTarget.HasValue;
    // Day buttons by grid position. Blazor captures a reference only when the element is created and keeps
    // the element across renders, so a position (not a date, which changes with the month) identifies it.
    private readonly ElementReference[] _cells = new ElementReference[42];
    // Set by a key press: after the next render, focus follows the cursor when the host moved it.
    private bool _followFocus;
    private DateOnly? _focusBefore;
    // The 42-day grid grouped into 6 rows of 7 (so an optional week-number cell can lead each row), and
    // each cell's full-date label. Rebuilt only when the month, first weekday or culture changes, not on
    // every render (TASK-115).
    private DateOnly?[][] _weeks = [];
    private string?[] _labels = [];
    private (int Year, int Month, DayOfWeek First)? _gridKey;
    // The displayed month on the grid's calendar.
    private CalendarMonth _month;
    // The culture by reference: a clone with other day names keeps the Name (TASK-164).
    private CultureInfo? _gridCulture;

    protected override void OnParametersSet()
    {
        var key = (ViewYear, ViewMonth, _firstDayOfWeek);
        var culture = _culture;
        if (_gridKey != key || !ReferenceEquals(_gridCulture, culture))
        {
            _gridKey = key;
            _gridCulture = culture;
            var data = MonthGridData.Get(culture, ViewYear, ViewMonth, _firstDayOfWeek);
            _month = data.Month;
            _weeks = data.Weeks;
            _labels = data.Labels;
        }
        UpdateRenderState();
    }

    // Hover is wired only for a host that listens (the range picker): the others render no handler.
    private EventCallback HoverFor(DateOnly day) =>
        OnDayHover.HasDelegate ? EventCallback.Factory.Create(this, () => OnDayHover.InvokeAsync(day)) : default;

    private DateOnly? ResolveTabTarget(DateOnly?[][] weeks)
    {
        var start = _month.Start;
        var end = _month.End;
        bool Available(DateOnly d) => d >= start && d <= end &&
            Array.Exists(_dayStates, state => state.Day == d && !state.Disabled);
        if (FocusedDate is { } f && Available(f)) return f;
        if (Available(Today)) return Today;
        foreach (var week in weeks)
            foreach (var d in week)
                if (d is { } day && Available(day)) return day;
        return null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        _followFocus = true;
        _focusBefore = _tabTarget;
        if (_tabTarget is { } cursor && cursor != FocusedDate) await FocusedDateChanged.InvokeAsync(cursor);
        await OnKeyDown.InvokeAsync(e);
    }

    /// <summary>Moves keyboard focus onto the day carrying the roving <c>tabindex="0"</c> (best-effort; does
    /// nothing before the grid is rendered or when no day of the month is available).</summary>
    public async Task FocusCursorAsync()
    {
        if (_tabTarget is not { } target) return;
        var index = Array.IndexOf(_weeks.SelectMany(w => w).ToArray(), target);
        if (index < 0) return;
        try { await _cells[index].FocusAsync(); }
        catch (JSException) { }
        catch (InvalidOperationException) { /* not attached yet */ }
    }

    private async Task ClickDay(DateOnly day)
    {
        if (day != FocusedDate) await FocusedDateChanged.InvokeAsync(day);
        await OnDayClick.InvokeAsync(day);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_followFocus) return;
        _followFocus = false;
        // Move DOM focus onto the new cursor, so the native click of Enter/Space lands on the day the
        // cursor shows rather than on the cell the focus was left on (TASK-124).
        if (_tabTarget is not { } target || target == _focusBefore) return;
        var index = Array.IndexOf(_weeks.SelectMany(w => w).ToArray(), target);
        if (index >= 0)
        {
            try { await _cells[index].FocusAsync(); }
            catch (JSException) { }
            catch (InvalidOperationException) { /* not attached yet */ }
        }
    }
}
