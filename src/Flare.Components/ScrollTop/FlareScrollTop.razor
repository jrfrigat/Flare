@* Requires interactive render mode (not compatible with static SSR). *@
@namespace Flare.Components
@inherits FlareComponentBase
@inject IScrollService Scroll
@implements IAsyncDisposable

@* Watches through IScrollService rather than its own JS listener, so the visibility check is throttled
   before it crosses interop and shares the service's teardown instead of owning a second one. *@

<button class="@BuildCssClass(_visibleClass)"
        type="button"
        aria-label="@(FlareStrings.Nav_BackToTop)"
        style="@Style"
        @onclick="BackToTopAsync"
        @attributes="AdditionalAttributes">
    <FlareIconView Value="FlareIcons.KeyboardArrowUp" />
</button>

@code {
    /// <summary>Scroll distance in pixels before the button appears.</summary>
    [Parameter] public int Threshold { get; set; } = 200;

    /// <summary>
    /// CSS selector of the scroll container to watch (e.g. an app-shell content panel). When null
    /// (the default) the page itself is used.
    /// </summary>
    [Parameter] public string? Selector { get; set; }

    /// <summary>
    /// Minimum gap, in milliseconds, between scroll checks. Default 100. The button only has to cross
    /// one threshold, so there is nothing to gain from watching every frame.
    /// </summary>
    [Parameter] public int ThrottleMs { get; set; } = 100;

    protected override string ComponentCssClass => Css.Classes.Scroll.Top;

    private bool _visible;
    private IAsyncDisposable? _sub;

    private string _visibleClass => _visible ? Css.Classes.Scroll.TopVisible : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _sub = await Scroll.SubscribeAsync(
            OnScrolled, Selector, new ScrollSubscribeOptions { ThrottleMs = ThrottleMs });
    }

    private Task OnScrolled(ScrollChange change)
    {
        var visible = change.Top > Threshold;
        if (visible == _visible) return Task.CompletedTask;
        _visible = visible;
        return InvokeAsync(StateHasChanged);
    }

    private Task BackToTopAsync() => Scroll.ScrollToTopAsync(Selector).AsTask();

    public override async ValueTask DisposeAsync()
    {
        if (_sub is not null) await _sub.DisposeAsync();
        await base.DisposeAsync();
    }
}
