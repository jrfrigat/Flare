@namespace Flare.Components
@inherits FlareComponentBase

@* A span, not a div: a chip is an inline run - a tag beside prose, a label in a table cell - and a div
   inside a <p> is invalid. It has always painted as inline-flex, so nothing moves.

   A static chip drops the role, the tab stop, the handlers and the state layers rather than switching
   them off: a control that announces itself and then refuses is worse than no control. *@
<span class="@BuildCssClass(_resolvedSelectedClass, _disabledClass, _sizeClass, _variantClass, _colorClass, _staticClass, _hoverLayerClass, _focusLayerClass, _pressedLayerClass)" style="@_chipStyle" @attributes="AdditionalAttributes" role="@(_isInteractive ? "button" : null)" aria-disabled="@(_isInteractive && Disabled ? "true" : null)" tabindex="@(_isInteractive ? (Disabled ? -1 : 0) : default(int?))" @onclick="HandleClick" @onkeydown="HandleKeyDown">
    @if (AvatarContent is not null)
    {
        <span class="@Css.Classes.Chip.Avatar">@AvatarContent</span>
    }
    else if (LeadingIcon is not null)
    {
        <span class="@Css.Classes.Chip.Icon @Css.Classes.Chip.IconLeading">@LeadingIcon</span>
    }
    @* Content between the tags wins over the string. A component that renders caller text and has no
       ChildContent does not fail to compile - AdditionalAttributes captures the fragment as an unmatched
       attribute and it is dropped - so the slot has to exist for the natural spelling to mean anything. *@
    <span class="@Css.Classes.Chip.Label">@if (ChildContent is not null) { @ChildContent } else { @Label }</span>
    @if (Closeable || Closable)
    {
        <button class="@Css.Classes.Chip.Close" type="button" disabled="@Disabled" @onclick="HandleClose" @onclick:stopPropagation="true" aria-label="@(FlareStrings.Chip_Delete)">
            &#x2715;
        </button>
    }
</span>

@code {
    /// <summary>Text label displayed inside the chip. Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Markup rendered in the label slot instead of <see cref="Label"/>, for a chip whose content is
    /// more than a string. Writing the content between the tags - <c>&lt;FlareChip&gt;42&lt;/FlareChip&gt;</c>
    /// - binds here.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Value used by FlareChipGroup to identify this chip.</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Icon content rendered before the chip label.</summary>
    [Parameter] public RenderFragment? LeadingIcon { get; set; }
    /// <summary>Avatar content rendered at the leading edge (takes precedence over <see cref="LeadingIcon"/>).</summary>
    [Parameter] public RenderFragment? AvatarContent { get; set; }
    /// <summary>Size of the chip.</summary>
    [Parameter] public ChipSize Size { get; set; } = ChipSize.Md;
    /// <summary>Whether the chip is in a selected/active state.</summary>
    [Parameter] public bool Selected { get; set; }
    /// <summary>Callback raised when the selected state toggles.</summary>
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }
    /// <summary>Shows a close button to remove the chip.</summary>
    [Parameter] public bool Closeable { get; set; }
    /// <summary>Shows a close button to remove the chip. Alias for <see cref="Closeable"/>.</summary>
    [Parameter] public bool Closable { get; set; }
    /// <summary>Callback raised when the close button is clicked.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Callback raised when the chip body is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }
    /// <summary>Color of the chip. Role -> shared color class; custom -> inline tokens. Default = theme default.</summary>
    [Parameter] public FlareColor Color { get; set; } = FlareColor.Default;
    /// <summary>Visual style of the chip: <see cref="ChipVariant.Outlined"/> (default, bordered),
    /// <see cref="ChipVariant.Filled"/> (solid surface fill) or <see cref="ChipVariant.Elevated"/>
    /// (filled with a shadow). Setting <see cref="Elevated"/> is equivalent to
    /// <see cref="ChipVariant.Elevated"/> and takes precedence over this parameter when true.</summary>
    [Parameter] public ChipVariant Variant { get; set; } = ChipVariant.Outlined;
    /// <summary>Renders the chip as an elevated chip (filled surface with a shadow, no border). Convenience
    /// shorthand for <c>Variant="ChipVariant.Elevated"</c>; when true it overrides <see cref="Variant"/>.</summary>
    [Parameter] public bool Elevated { get; set; }
    /// <summary>Dims the chip and stops it responding: no click, keyboard or close callback fires, and it
    /// leaves the tab order. A chip inside a <see cref="FlareChipGroup"/> also stops taking part in
    /// selection, so a disabled chip can neither be selected nor cleared.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>
    /// Whether the chip is something to press or something to read. <see cref="ChipInteraction.Auto"/>
    /// (the default) reads it off what the chip is wired to: bound <see cref="OnClick"/> or
    /// <see cref="SelectedChanged"/>, or membership of a <see cref="FlareChipGroup"/>, makes it a
    /// control, and anything else is a tag with no role and no tab stop.
    /// <para>
    /// Set <see cref="ChipInteraction.Button"/> when the handler arrives by attribute splatting rather
    /// than through a parameter - that is the one wiring <see cref="ChipInteraction.Auto"/> cannot see.
    /// </para>
    /// </summary>
    [Parameter] public ChipInteraction Interaction { get; set; } = ChipInteraction.Auto;

    /// <summary>Parent chip group context providing selection state management.</summary>
    [CascadingParameter] public FlareChipGroupContext? GroupContext { get; set; }

    protected override string ComponentCssClass => Css.Classes.Chip.Root;

    private bool _isSelected => GroupContext is not null
        ? GroupContext.SelectedValues.Contains(Value ?? "")
        : Selected;

    private string _resolvedSelectedClass => _isSelected ? Css.Classes.Chip.Selected : string.Empty;
    private string _disabledClass => Disabled ? Css.Classes.Chip.Disabled : string.Empty;

    // A chip is a control when something is wired to it. Closeable does not count: the close button is
    // its own control with its own focus, and the body around it is still only a label.
    private bool _isInteractive => Interaction switch
    {
        ChipInteraction.Button => true,
        ChipInteraction.Static => false,
        _ => OnClick.HasDelegate || SelectedChanged.HasDelegate || GroupContext is not null,
    };

    private string _staticClass => _isInteractive ? string.Empty : Css.Classes.Chip.Static;
    // The state layers answer a pointer and a focus ring the static chip does not have.
    private string _hoverLayerClass => _isInteractive ? Css.Classes.State.LayerHover : string.Empty;
    private string _focusLayerClass => _isInteractive ? Css.Classes.State.LayerFocus : string.Empty;
    private string _pressedLayerClass => _isInteractive ? Css.Classes.State.LayerPressed : string.Empty;
    // Elevated bool is a back-compat shorthand for Variant=Elevated and wins when set.
    private ChipVariant _effectiveVariant => Elevated ? ChipVariant.Elevated : Variant;
    private string _variantClass => _effectiveVariant switch
    {
        ChipVariant.Filled   => Css.Classes.Chip.Filled,
        ChipVariant.Elevated => Css.Classes.Chip.Elevated,
        _                    => string.Empty, // Outlined is the base style
    };
    private string _colorClass => Color.CssClass ?? string.Empty;

    // Custom/dynamic -> inline --fc-main (fg/border/selected-bg) + --fc-on (selected text).
    private string? _chipStyle => Color.StyleMainOn() is { } t ? t + Style : Style;
    private string _sizeClass => Size switch
    {
        ChipSize.Xs => Css.Classes.Chip.SizeXs,
        ChipSize.Sm => Css.Classes.Chip.SizeSm,
        ChipSize.Lg => Css.Classes.Chip.SizeLg,
        ChipSize.Xl => Css.Classes.Chip.SizeXl,
        _           => Css.Classes.Chip.SizeMd,   // Md is the default and now names itself
    };

    private async Task HandleClick()
    {
        // pointer-events:none already stops the mouse, but a click can still be
        // raised programmatically or by an assistive technology.
        if (Disabled || !_isInteractive) return;

        if (GroupContext is not null)
        {
            await GroupContext.Toggle(Value ?? "");
        }
        else
        {
            await SelectedChanged.InvokeAsync(!Selected);
        }
        await OnClick.InvokeAsync();
    }

    private async Task HandleClose()
    {
        if (Disabled) return;
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await HandleClick();
    }
}
