@namespace Flare.Components
@inherits FlareComponentBase

@if (!Morphing)
{
    @BuildEffective(Value).Render()
}
else
{
    <span class="@WrapperClass">
        @* Both slots MUST come from this one element rather than from two branches of an @@if. Blazor
           diffs attributes by their sequence number, and two source elements have two sets of them: the
           retained node then loses the class it had and is handed the other branch's attributes instead,
           so the outgoing glyph ends up with no exit animation and stays painted at full opacity on top
           of its replacement. One source element, one sequence, and the swap diffs correctly. *@
        @for (var i = _outgoing is null ? 1 : 0; i < 2; i++)
        {
            var exiting = i == 0;
            <span class="@SlotClass(exiting)" aria-hidden="@(exiting ? "true" : null)" @key="_swapCount - 1 + i">@BuildEffective(exiting ? _outgoing : Value).Render()</span>
        }
    </span>
}

@code {
    /// <summary>
    /// The icon descriptor to render - any provider (<see cref="FlareSvgIcon"/>, or an add-on pack type).
    /// Icons are values: build one directly (<c>FlareIcons.Home</c>, <c>MaterialDesign3Icons.Regular.Home</c>,
    /// <c>new FlareSvgIcon { Data = "..." }</c>). There is no lookup by icon name - that is what keeps the
    /// SVG icon packages trimmable (only the icons you reference statically are published).
    /// </summary>
    [Parameter] public FlareIcon? Value { get; set; }

    /// <summary>Icon size as any CSS length (e.g. <c>"3rem"</c>). Overrides <see cref="Value"/>'s size when set.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>Convenience pixel size (e.g. <c>48</c> -&gt; <c>"48px"</c>). Ignored when <see cref="Size"/> is set.</summary>
    [Parameter] public int? SizePx { get; set; }

    /// <summary>Icon color. Overrides <see cref="Value"/>'s color when not <see cref="FlareColor.Default"/>.</summary>
    [Parameter] public FlareColor Color { get; set; } = FlareColor.Default;

    /// <summary>Accessible label; sets aria-label + role=img. Overrides <see cref="Value"/>'s label when set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// How a change of <see cref="Value"/> is animated. At <see cref="FlareIconMorph.None"/> the swap is
    /// instant and the view renders the icon element alone, exactly as it does without this parameter; any
    /// other mode wraps the icon so the outgoing and incoming glyphs can share one box while they trade
    /// places. The first value to arrive never animates - there is nothing for it to replace.
    /// </summary>
    /// <remarks>
    /// Left unset, the mode is inherited from the enclosing scope - <c>FlareThemeProvider.IconMorph</c>, or
    /// any <c>CascadingValue</c> of this type - so an app turns icon transitions on for the whole library,
    /// its own chrome included, without touching call sites. Setting it here overrides that either way,
    /// including back to <see cref="FlareIconMorph.None"/>.
    /// </remarks>
    [Parameter] public FlareIconMorph? Morph { get; set; }

    // The scope's default, which an explicit Morph overrides. Cascaded by FlareThemeProvider.
    [CascadingParameter] private FlareIconMorph? MorphScope { get; set; }

    // This component renders the icon element directly (no wrapper of its own) unless a morph is asked for.
    protected override string ComponentCssClass => string.Empty;

    private FlareIconMorph EffectiveMorph => Morph ?? MorphScope ?? FlareIconMorph.None;

    // Whether this render needs the two-slot machinery. A FlareMorphIcon is excluded on purpose: it
    // transitions its own outline in place, and cross-fading it would mean REPLACING the very element whose
    // `d` is being interpolated - the two mechanisms cancel each other out. So the icon's own type decides,
    // which keeps the rule stateless and easy to state: a morph icon is never cross-faded.
    private bool Morphing => EffectiveMorph != FlareIconMorph.None && Value is not FlareMorphIcon;

    // The glyph that was replaced. It is NOT removed when its exit animation finishes: the animation's fill
    // mode parks it at zero opacity, so it costs one hidden element and the NEXT swap is what recycles it.
    // That is the whole reason this component needs no timer, no animation-end callback and no JS - the
    // teardown a cross-fade normally needs is exactly the work the next render already does.
    private FlareIcon? _outgoing;
    // The value the last render displayed, which is what an incoming Value is compared against.
    private FlareIcon? _settled;
    private bool _initialized;
    // Whether the glyph on screen arrived by a swap. Only then does it carry the enter animation: a first
    // paint has nothing to transition from, and an icon that animated itself in on page load would be noise.
    private bool _swapped;
    // Bumped once per swap and used as the slot @key. The key is the whole mechanism: without it Blazor's
    // sequence diff patches the new path data into the existing DOM node, and a CSS animation cannot fire on
    // an element that was never inserted. With it, the old node is retained (and re-classed to run the exit)
    // while the new one is genuinely inserted.
    private int _swapCount;

    private const string SlotIdle = Css.Classes.Icon.MorphSlot;
    private const string SlotEnter = Css.Classes.Icon.MorphSlot + " " + Css.Classes.Icon.MorphSlotEnter;
    private const string SlotExit = Css.Classes.Icon.MorphSlot + " " + Css.Classes.Icon.MorphSlotExit;
    private const string WrapperFade = Css.Classes.Icon.Morph + " " + Css.Classes.Icon.MorphFade;
    private const string WrapperScale = Css.Classes.Icon.Morph + " " + Css.Classes.Icon.MorphScale;
    private const string WrapperRotate = Css.Classes.Icon.Morph + " " + Css.Classes.Icon.MorphRotate;

    private string SlotClass(bool exiting) => exiting ? SlotExit : _swapped ? SlotEnter : SlotIdle;

    private string WrapperClass => EffectiveMorph switch
    {
        FlareIconMorph.Scale => WrapperScale,
        FlareIconMorph.Rotate => WrapperRotate,
        _ => WrapperFade,
    };

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (!Morphing)
        {
            // Nothing is cross-fading and nothing will, so drop any history: the value stays current so that
            // turning the morph on later starts from what is on screen instead of animating a stale pair.
            _outgoing = null;
            _swapped = false;
            _settled = Value;
            _initialized = true;
            return;
        }

        if (!_initialized)
        {
            _settled = Value;
            _initialized = true;
            return;
        }

        // Record equality, so this compares the icon's CONTENT: a re-render passing the same descriptor - or
        // a freshly built but identical one - is not a change and must not restart the animation.
        if (Equals(_settled, Value)) return;

        _outgoing = _settled;
        _settled = Value;
        _swapped = true;
        _swapCount++;
    }

    // Merge the caller-facing overrides onto the descriptor. A view-level value wins over the descriptor's;
    // an unset view value keeps the descriptor's. A null icon renders an empty icon.
    private FlareIcon BuildEffective(FlareIcon? value)
    {
        var icon = value ?? FlareIcons.Empty;
        return icon with
        {
            Size = _sizeCss ?? icon.Size,
            Color = Color.IsDefault ? icon.Color : Color,
            AriaLabel = AriaLabel ?? icon.AriaLabel,
            Class = Class ?? icon.Class,
            Style = Style ?? icon.Style,
            Attributes = AdditionalAttributes ?? icon.Attributes,
        };
    }

    private string? _sizeCss => Size ?? (SizePx is int px ? $"{px}px" : null);
}
