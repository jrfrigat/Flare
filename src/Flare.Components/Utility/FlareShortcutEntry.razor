@namespace Flare.Components
@implements IDisposable

@code {
    [CascadingParameter] public FlareShortcuts? Shortcuts { get; set; }
    [Parameter, EditorRequired] public string Keys { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback OnActivated { get; set; }
    [Parameter] public string? Description { get; set; }

    private FlareShortcuts? _owner;
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_owner, Shortcuts)) return;
        _owner?.Unregister(this);
        _owner = Shortcuts;
        _owner?.Register(this);
    }

    public void Dispose()
    {
        _owner?.Unregister(this);
        _owner = null;
    }
}
