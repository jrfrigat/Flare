@namespace Flare.Components
@inherits FlareComponentBase

<li class="@Css.Classes.TableOfContents.Item" style="@($"{Css.Tokens.LocalVars.TocDepth}:{Math.Max(0, Level)}")">
    <a class="@BuildCssClass(_activeClass)"
       href="@_safeHref"
       style="@Style"
       aria-current="@(Active ? "true" : null)"
       @attributes="AdditionalAttributes">@ChildContent</a>
</li>

@code {
    /// <summary>Anchor target, e.g. <c>"#section"</c> or a full path plus fragment.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Marks this link as the active (current) entry.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Indent depth (0 = top level). Each level adds one indent step.</summary>
    [Parameter] public int Level { get; set; }

    /// <summary>Link text/content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Inline style applied to the link itself - the element the consumer sees and styles.
    /// The indent set by <see cref="Level"/> stays on the list item.</summary>
    [Parameter] public override string? Style { get; set; }

    protected override string ComponentCssClass => Css.Classes.TableOfContents.Link;

    private string? _activeClass => Active ? Css.Classes.TableOfContents.LinkActive : null;

    // The other link components refuse a script-bearing scheme the same way; null stays null so the
    // attribute is still omitted when no target was given.
    private string? _safeHref => Href is null || CssValidator.IsHrefSafe(Href) ? Href : "about:blank";
}
