@namespace Flare.Components
@inherits FlareComponentBase

@* The row joins the shared drag model by attribute, not by wrapper: a div between a ul and its li is
   markup the browser rearranges. What went with the HTML5 handlers - dragstart, dragover, dragleave,
   drop, dragend - is a per-dragover interop round trip that had to be coalesced to stay usable, four
   fields of drag state, three drop-indicator classes, and the reason none of this worked on a phone. *@
<li class="@BuildCssClass(_draggableClass)" role="treeitem"
    aria-expanded="@(HasChildren ? _expanded.ToString().ToLowerInvariant() : null)"
    aria-selected="@Selected.ToString().ToLowerInvariant()"
    aria-level="@Level"
    tabindex="@(Selected ? 0 : -1)"
    style="@Style"
    data-flare-drag="@(Draggable ? _dragId : null)"
    data-flare-drag-group="@(Draggable ? FlareTreeView.DragGroup : null)"
    @onkeydown="HandleKeyDownAsync"
    @attributes="AdditionalAttributes">
    @* An expanded li is as tall as its whole subtree, so the thirds a drop resolves against have to be
       measured on the ROW; this marks it. Without it every point in a 300px branch is in its top third. *@
    <div class="@Css.Classes.Tree.ItemRow @(Selected ? Css.Classes.TreeView.Row : "")"
         data-flare-drag-hit="@(Draggable ? "true" : null)"
         @onclick="HandleRowClickAsync">
        @if (HasChildren)
        {
            <button type="button"
                    class="@Css.Classes.TreeView.Toggle"
                    @onclick="ToggleAsync"
                    @onclick:stopPropagation="true"
                    tabindex="-1"
                    aria-label="@(_expanded ? (FlareStrings.Tree_Collapse) : (FlareStrings.Tree_Expand))">
                <FlareIconView Value="@(_expanded ? FlareIcons.ExpandMore : FlareIcons.ChevronRight)" />
            </button>
        }
        else
        {
            <span class="@Css.Classes.TreeView.TogglePlaceholder"></span>
        }
        @if (Icon is not null)
        {
            <FlareIconView Value="Icon" Class="@Css.Classes.Tree.ItemIcon" />
        }
        <span class="@Css.Classes.TreeView.Label">@Label</span>
        @if (Draggable)
        {
            <FlareIconView Value="FlareIcons.DragIndicator" Class="@Css.Classes.TreeView.DragHandle" />
        }
    </div>
    @if (_expanded && HasChildren)
    {
        @* A branch is its own drop zone, so a node dropped between two children lands among THEM and
           not among their parent's siblings. *@
        <ul class="@Css.Classes.TreeView.Children" role="group"
            data-flare-drop="@(Draggable ? _dragId : null)"
            data-flare-drag-group="@(Draggable ? FlareTreeView.DragGroup : null)"
            data-flare-drop-placement="both">
            @* Children learn who their parent is, which is the only way the tree can answer "is this
               zone inside the node being dragged". *@
            <CascadingValue Value="this" IsFixed="true">
                <CascadingValue Value="@(Level + 1)" Name="Level" IsFixed="false">
                    @ChildContent
                </CascadingValue>
            </CascadingValue>
        </ul>
    }
</li>

@code {
    /// <summary>Child tree items nested under this item.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Text label displayed for this tree item.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Icon shown beside the label - any provider (a bare string is a Material Symbols name).</summary>
    [Parameter] public FlareIcon? Icon { get; set; }
    /// <summary>Whether this item is currently selected.</summary>
    [Parameter] public bool Selected { get; set; }
    /// <summary>Callback raised when the selected state changes.</summary>
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }
    /// <summary>Whether the item starts in an expanded state.</summary>
    [Parameter] public bool Expanded { get; set; }
    /// <summary>Callback raised when the item row is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }
    /// <summary>Optional data object associated with this item for drag-and-drop events.</summary>
    [Parameter] public object? ItemData { get; set; }
    /// <summary>Current nesting depth of this item; propagated automatically via CascadingValue.
    /// Level 1 is the top-most level (root items inside FlareTreeView).</summary>
    [CascadingParameter(Name = "Level")] public int Level { get; set; } = 1;

    /// <summary>Group-wide tree state (drag config and registry) from <see cref="FlareTreeView"/>.</summary>
    [CascadingParameter] private FlareTreeContext? TreeContext { get; set; }

    /// <summary>The item this one is nested in, or null for a top-level item.</summary>
    [CascadingParameter] private FlareTreeItem? ParentItem { get; set; }

    private bool Draggable => TreeContext?.Draggable == true;

    protected override string ComponentCssClass => Css.Classes.TreeView.Item;

    private bool _expanded;
    private bool _expandedInitialized;
    private readonly string _dragId = $"ft-{Guid.NewGuid():N}";
    private TreeDragRegistry? _registeredWith;

    // Also the id of the drop zone this item's expanded branch declares: one node, one id, which is
    // what lets a refusal name a whole subtree.
    internal string DragId => _dragId;

    private string? _draggableClass => Draggable ? Css.Classes.Drag.Item : null;

    private bool HasChildren => ChildContent is not null;

    protected override void OnParametersSet()
    {
        if (!_expandedInitialized)
        {
            _expanded = Expanded;
            _expandedInitialized = true;
        }

        var registry = Draggable ? TreeContext?.DragRegistry : null;
        if (ReferenceEquals(registry, _registeredWith)) return;
        _registeredWith?.Unregister(_dragId);
        registry?.Register(_dragId, ItemData ?? this, ParentItem?.DragId);
        _registeredWith = registry;
    }

    private async Task ToggleAsync()
    {
        _expanded = !_expanded;
        await Task.CompletedTask;
    }

    private async Task HandleRowClickAsync()
    {
        if (!Selected)
            await SelectedChanged.InvokeAsync(true);
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
        if (HasChildren) await ToggleAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
            case " ":
                await SelectedChanged.InvokeAsync(!Selected);
                if (HasChildren) await ToggleAsync();
                break;
            case "ArrowRight":
                if (HasChildren && !_expanded)
                    await ToggleAsync();
                break;
            case "ArrowLeft":
                if (HasChildren && _expanded)
                    await ToggleAsync();
                break;
        }
    }

    /// <summary>Removes this item from its tree's drag registry.</summary>
    public override ValueTask DisposeAsync()
    {
        _registeredWith?.Unregister(_dragId);
        return base.DisposeAsync();
    }
}
