@namespace Flare.Components
@inherits FlareLocalizedComponentBase

@* The row joins the shared drag model by attribute, not by wrapper: a div between a ul and its li is
   markup the browser rearranges. What went with the HTML5 handlers - dragstart, dragover, dragleave,
   drop, dragend - is a per-dragover interop round trip that had to be coalesced to stay usable, four
   fields of drag state, three drop-indicator classes, and the reason none of this worked on a phone. *@
<li class="@BuildCssClass(_draggableClass)" role="treeitem"
    aria-label="@(LabelContent is not null ? Label : null)"
    aria-expanded="@(HasChildren ? _expanded.ToString().ToLowerInvariant() : null)"
    aria-selected="@Selected.ToString().ToLowerInvariant()"
    aria-level="@Level"
    tabindex="@(Selected ? 0 : -1)"
    style="@Style"
    data-flare-drag="@(Draggable ? _dragId : null)"
    data-flare-drag-group="@(Draggable ? FlareTreeView.DragGroup : null)"
    @onkeydown="HandleKeyDownAsync"
    @attributes="AdditionalAttributes">
    @* An expanded li is as tall as its whole subtree, so the thirds a drop resolves against have to be
       measured on the ROW; this marks it. Without it every point in a 300px branch is in its top third. *@
    <div class="@Css.Classes.Tree.ItemRow @(Selected ? Css.Classes.TreeView.Row : "")"
         data-flare-drag-hit="@(Draggable ? "true" : null)"
         @onclick="HandleRowClickAsync"
         @ondblclick="HandleRowDoubleClickAsync"
         @oncontextmenu="HandleRowContextMenuAsync"
         @oncontextmenu:preventDefault="@(OnContextMenu.HasDelegate && PreventContextMenuDefault)">
        @if (HasChildren)
        {
            <button type="button"
                    class="@Css.Classes.TreeView.Toggle"
                    @onclick="ToggleAsync"
                    @onclick:stopPropagation="true"
                    tabindex="-1"
                    aria-label="@(_expanded ? (CoreText["Tree_Collapse"]) : (CoreText["Tree_Expand"]))">
                <FlareIconView Value="@(_expanded ? FlareIcons.ExpandMore : FlareIcons.ChevronRight)" />
            </button>
        }
        else
        {
            <span class="@Css.Classes.TreeView.TogglePlaceholder"></span>
        }
        @if (Icon is not null)
        {
            <FlareIconView Value="Icon" Class="@Css.Classes.Tree.ItemIcon" />
        }
        <span class="@Css.Classes.TreeView.Label">
            @if (LabelContent is not null)
            {
                @LabelContent
            }
            else
            {
                @Label
            }
        </span>
        @TrailingContent
        @if (Draggable)
        {
            <FlareIconView Value="FlareIcons.DragIndicator" Class="@Css.Classes.TreeView.DragHandle" />
        }
    </div>
    @if (_expanded && HasChildren)
    {
        @* A branch is its own drop zone, so a node dropped between two children lands among THEM and
           not among their parent's siblings. *@
        <ul class="@Css.Classes.TreeView.Children" role="group"
            data-flare-drop="@(Draggable ? _dragId : null)"
            data-flare-drag-group="@(Draggable ? FlareTreeView.DragGroup : null)"
            data-flare-drop-placement="both">
            @* Children learn who their parent is, which is the only way the tree can answer "is this
               zone inside the node being dragged". *@
            <CascadingValue Value="this" IsFixed="true">
                <CascadingValue Value="@(Level + 1)" Name="Level" IsFixed="false">
                    @ChildContent
                </CascadingValue>
            </CascadingValue>
        </ul>
    }
</li>

@code {
    /// <summary>Child tree items nested under this item.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Content rendered inside the row after the label and before the drag handle, for per-row
    /// actions or a status indicator. The host owns click propagation for its controls: a click inside the
    /// slot bubbles to the row and selects or expands the item unless the control stops it with
    /// <c>onclick:stopPropagation</c>. The slot adds no tab order or accessible name of its own, so controls
    /// stay focusable and keep the labels the host gives them.</summary>
    [Parameter] public RenderFragment? TrailingContent { get; set; }
    /// <summary>Text label displayed for this tree item.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Non-interactive content rendered inside the item's label span
    /// (<c>flare-tree-item__label</c>) in place of the visible <see cref="Label"/> text. <see cref="Label"/>
    /// remains the accessible name of the item - the row carries it as <c>aria-label</c> while this slot is
    /// set - and stays the default visible text when the slot is null. The host owns any controls inside the
    /// slot, including stopping their clicks from reaching the row.</summary>
    [Parameter] public RenderFragment? LabelContent { get; set; }
    /// <summary>Icon shown beside the label - any provider (a bare string is a Material Symbols name).</summary>
    [Parameter] public FlareIcon? Icon { get; set; }
    /// <summary>Whether this item is currently selected.</summary>
    [Parameter] public bool Selected { get; set; }
    /// <summary>Callback raised when the selected state changes.</summary>
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }
    /// <summary>Whether the item is expanded. When a parent listens to <see cref="ExpandedChanged"/> the
    /// parameter is authoritative (<c>@bind-Expanded</c>); without a listener the item keeps its own state
    /// and adopts a real change of the parameter.</summary>
    [Parameter] public bool Expanded { get; set; }
    /// <summary>Raised when a user gesture changes the expanded state - a row click, the toggle button,
    /// Enter or Space, or the Left/Right arrows - enabling <c>@bind-Expanded</c>.</summary>
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    /// <summary>Callback raised when the item row is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }
    /// <summary>Callback raised when the row is double-clicked. The browser raises the row click twice
    /// before it, so <see cref="OnClick"/> and single-click selection run first. When this callback is set,
    /// the second click of the gesture does not toggle expansion again, so a parent row does not expand and
    /// immediately collapse.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnDoubleClick { get; set; }
    /// <summary>Callback raised when this row is right-clicked. It fires for the row only - a child row
    /// raises its own - and does not select, expand or raise <see cref="OnClick"/>. When
    /// <see cref="PreventContextMenuDefault"/> is true the browser's own menu is suppressed.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnContextMenu { get; set; }
    /// <summary>Suppresses the browser's own context menu while <see cref="OnContextMenu"/> is handled, so a
    /// custom menu can replace it. Set to false to keep the native menu alongside the callback. Has no
    /// effect when no context-menu callback is set.</summary>
    [Parameter] public bool PreventContextMenuDefault { get; set; } = true;
    /// <summary>Optional data object associated with this item for drag-and-drop events.</summary>
    [Parameter] public object? ItemData { get; set; }
    /// <summary>Current nesting depth of this item; propagated automatically via CascadingValue.
    /// Level 1 is the top-most level (root items inside FlareTreeView).</summary>
    [CascadingParameter(Name = "Level")] public int Level { get; set; } = 1;

    /// <summary>Group-wide tree state (drag config and registry) from <see cref="FlareTreeView"/>.</summary>
    [CascadingParameter] private FlareTreeContext? TreeContext { get; set; }

    /// <summary>The item this one is nested in, or null for a top-level item.</summary>
    [CascadingParameter] private FlareTreeItem? ParentItem { get; set; }

    private bool Draggable => TreeContext?.Draggable == true;

    protected override string ComponentCssClass => Css.Classes.TreeView.Item;

    private bool _expanded;
    private bool _lastExpanded;
    private readonly string _dragId = $"ft-{Guid.NewGuid():N}";
    private TreeDragRegistry? _registeredWith;

    // Also the id of the drop zone this item's expanded branch declares: one node, one id, which is
    // what lets a refusal name a whole subtree.
    internal string DragId => _dragId;

    private string? _draggableClass => Draggable ? Css.Classes.Drag.Item : null;

    private bool HasChildren => ChildContent is not null;

    protected override void OnParametersSet()
    {
        // Two-way state contract (docs/ru/component-conventions.md): controlled follows the parameter;
        // uncontrolled follows local state until the parameter itself changes. _lastExpanded mirrors the
        // PARAMETER, so it is assigned here and never from an event handler.
        if (ExpandedChanged.HasDelegate)
            _expanded = Expanded;
        else if (Expanded != _lastExpanded)
            _expanded = Expanded;
        _lastExpanded = Expanded;

        var registry = Draggable ? TreeContext?.DragRegistry : null;
        if (ReferenceEquals(registry, _registeredWith)) return;
        _registeredWith?.Unregister(_dragId);
        registry?.Register(_dragId, ItemData ?? this, ParentItem?.DragId);
        _registeredWith = registry;
    }

    private async Task ToggleAsync()
    {
        _expanded = !_expanded;
        await ExpandedChanged.InvokeAsync(_expanded);
    }

    private async Task HandleRowClickAsync(MouseEventArgs e)
    {
        if (!Selected)
            await SelectedChanged.InvokeAsync(true);
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
        if (HasChildren && !IsSecondClickOfDoubleClick(e)) await ToggleAsync();
    }

    // A double-click raises two clicks before dblclick. When the host uses the double-click callback,
    // the second click must not undo the expansion the first one made.
    private bool IsSecondClickOfDoubleClick(MouseEventArgs e) =>
        e.Detail > 1 && OnDoubleClick.HasDelegate;

    private async Task HandleRowDoubleClickAsync(MouseEventArgs e)
    {
        if (OnDoubleClick.HasDelegate)
            await OnDoubleClick.InvokeAsync(e);
    }

    private async Task HandleRowContextMenuAsync(MouseEventArgs e)
    {
        if (OnContextMenu.HasDelegate)
            await OnContextMenu.InvokeAsync(e);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (await HandleKeyboardReorderAsync(e)) return;

        switch (e.Key)
        {
            case "Enter":
            case " ":
                await SelectedChanged.InvokeAsync(!Selected);
                if (HasChildren) await ToggleAsync();
                break;
            case "ArrowRight":
                if (HasChildren && !_expanded)
                    await ToggleAsync();
                break;
            case "ArrowLeft":
                if (HasChildren && _expanded)
                    await ToggleAsync();
                break;
        }
    }

    // A tree item's plain Space/Enter and the arrows already select, expand and collapse, so its
    // reorder gesture adds Alt: Alt+ArrowUp/Down moves it one place among its siblings and raises the
    // same OnItemDrop the pointer path uses. Alt+Space is left alone - Windows opens the window menu on it.
    private async Task<bool> HandleKeyboardReorderAsync(KeyboardEventArgs e)
    {
        if (TreeContext is not { KeyboardReorder: true } context) return false;
        if (!e.AltKey || e.Key is not ("ArrowUp" or "ArrowDown")) return false;

        var direction = e.Key == "ArrowUp" ? -1 : 1;
        if (!context.DragRegistry.TryGetSibling(_dragId, direction, out var sibling, out var position, out var count))
            return true;

        await context.OnItemDrop.InvokeAsync(new TreeDropEventArgs
        {
            SourceItem = ItemData ?? this,
            TargetItem = sibling,
            Position = direction < 0 ? TreeDropPosition.Before : TreeDropPosition.After,
        });
        context.Announce("Drag_Position", [position, count]);
        return true;
    }

    /// <summary>Removes this item from its tree's drag registry.</summary>
    public override ValueTask DisposeAsync()
    {
        _registeredWith?.Unregister(_dragId);
        return base.DisposeAsync();
    }
}
