@namespace Flare.Components
@inherits FlareComponentBase

@* The tree's own drag-and-drop is gone: it is a FlareDragContext now, and every branch is a drop zone
   with Both placement - the thirds of a row, which is where before/inside/after came from in the first
   place. The zone attributes go on the ul rather than on a FlareDropZone, because a div between a ul
   and its li is markup the browser rearranges. *@
<FlareDragContext TPayload="object"
                  Group="@DragGroup"
                  ResolveItem="TryResolveDragItem"
                  RefusedTargets="RefusedZones"
                  OnDrop="HandleDropAsync"
                  OnDragStart="HandleDragStartAsync"
                  OnDragEnd="HandleDragEndAsync">
    <ul class="@BuildCssClass()" role="tree"
        aria-label="@AriaLabel"
        aria-multiselectable="@(MultiSelect ? "true" : null)"
        style="@Style"
        data-flare-drop="@(Draggable ? RootZone : null)"
        data-flare-drag-group="@(Draggable ? DragGroup : null)"
        data-flare-drop-placement="both"
        @attributes="AdditionalAttributes">
        <CascadingValue Value="1" Name="Level" IsFixed="true">
            <CascadingValue Value="_treeContext" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </CascadingValue>
    </ul>
</FlareDragContext>

@code {
    /// <summary>Tree items rendered inside the tree view.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Accessible label for the tree, forwarded as aria-label.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>When true, multiple tree items may be selected simultaneously.
    /// Exposes aria-multiselectable="true" on the tree root for assistive technologies.</summary>
    [Parameter] public bool MultiSelect { get; set; }
    /// <summary>Enables drag-and-drop reordering of tree items.</summary>
    [Parameter] public bool Draggable { get; set; }
    /// <summary>Callback raised when an item is dropped on a valid target. Contains source item and target item.</summary>
    [Parameter] public EventCallback<TreeDropEventArgs> OnItemDrop { get; set; }
    /// <summary>Callback raised when an item drag starts.</summary>
    [Parameter] public EventCallback<TreeDragEventArgs> OnItemDragStart { get; set; }
    /// <summary>Callback raised when an item drag ends.</summary>
    [Parameter] public EventCallback OnItemDragEnd { get; set; }

    internal const string DragGroup = "flare-tree";
    private const string RootZone = "flare-tree-root";

    protected override string ComponentCssClass => Css.Classes.TreeView.Root;

    // Shared with every descendant FlareTreeItem, which registers itself under the id it writes into
    // the DOM. This is what lets the model report a real item rather than an element id.
    private readonly TreeDragRegistry _dragRegistry = new();

    // Single cascading context for the whole tree (drag config + callbacks + registry). Built once;
    // [Parameter]s are applied before OnInitialized, and the cascade is fixed, matching the prior behaviour.
    private FlareTreeContext _treeContext = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _treeContext = new FlareTreeContext
        {
            Draggable = Draggable,
            DragRegistry = _dragRegistry,
        };
    }

    private bool TryResolveDragItem(string id, out object item) => _dragRegistry.TryGet(id, out item);

    // A node cannot land inside itself. Every branch under it is a drop zone whose id IS the id of the
    // node that owns it, so refusing the dragged node's subtree is naming those ids: its own branch
    // (which would make it its own child) and every branch below (which would take the whole subtree
    // out of the tree with it, and nothing in the UI puts it back).
    //
    // A refusal rather than CanDrop because the tree's zones are markup on its own `ul` elements: the
    // context has no list of them to ask a predicate about, only the browser does.
    private IEnumerable<string> RefusedZones(object item) =>
        _dragRegistry.TryGetId(item, out var id) ? _dragRegistry.Branches(id) : [];

    private Task HandleDragStartAsync(object item) =>
        OnItemDragStart.HasDelegate
            ? OnItemDragStart.InvokeAsync(new TreeDragEventArgs { Item = item })
            : Task.CompletedTask;

    private Task HandleDragEndAsync() =>
        OnItemDragEnd.HasDelegate ? OnItemDragEnd.InvokeAsync() : Task.CompletedTask;

    // The drop is reported against the item under the pointer, which is exactly what TreeDropEventArgs
    // has always described. A drop on the empty part of a branch has no target item and is ignored -
    // the same outcome the HTML5 handler produced, since it only ever fired on a row.
    private Task HandleDropAsync(FlareDropEventArgs<object> e)
    {
        if (!e.HasOverPayload || e.OverPayload is null || !OnItemDrop.HasDelegate) return Task.CompletedTask;

        return OnItemDrop.InvokeAsync(new TreeDropEventArgs
        {
            SourceItem = e.Payload,
            TargetItem = e.OverPayload,
            Position = e.Edge switch
            {
                DropEdge.Before => TreeDropPosition.Before,
                DropEdge.After => TreeDropPosition.After,
                _ => TreeDropPosition.Inside,
            },
        });
    }
}
