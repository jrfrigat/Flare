@namespace Flare.Components
@typeparam TItem
@inherits FlareDataGridControl<TItem>
@using Flare.Components.Resources

@* A standalone global search box for a FlareDataGrid: typing filters rows where any visible column
   contains the text (case-insensitive). Place it in the grid's ToolbarContent or anywhere, bound via
   Context or Grid. Debounced. *@
<FlareField TValue="string" Type="search" Size="@Size" Immediate="true"
            Placeholder="@(Placeholder ?? FlareStrings.DataGrid_Search)"
            Value="@_text" ValueChanged="OnChanged" />

@code {
    protected override DataGridChange Observes => DataGridChange.Filter;

    /// <summary>Placeholder text for the search box (defaults to the localized "Search").</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Field size of the search box.</summary>
    [Parameter] public FieldSize Size { get; set; } = FieldSize.Sm;
    /// <summary>Debounce delay in milliseconds before the filter is applied (default 250).</summary>
    [Parameter] public int DebounceMs { get; set; } = 250;

    private string _text = "";
    private Timer? _debounce;

    // The box shows the grid's quick filter, not just what was typed here: a Clear-filters command from
    // another control has to empty it too. Skipped while a keystroke is still debouncing, so the field
    // does not fight the user's typing.
    protected override void OnGridStateChanged(DataGridChange change)
    {
        if (_debounce is null)
        {
            var current = Owner?.QuickFilterText ?? "";
            if (current != _text) _text = current;
        }
        base.OnGridStateChanged(change);
    }

    private void OnChanged(string? value)
    {
        _text = value ?? "";
        _debounce?.Dispose();
        if (DebounceMs <= 0)
        {
            _ = Apply();
            return;
        }
        _debounce = new Timer(_ => _ = InvokeAsync(ApplyAndSettle), null, DebounceMs, Timeout.Infinite);
    }

    private async Task ApplyAndSettle()
    {
        _debounce?.Dispose();
        _debounce = null;
        await Apply();
    }

    private async Task Apply()
    {
        if (Owner is not null) await Owner.SetQuickFilterAsync(_text);
    }

    /// <inheritdoc />
    public override void Dispose()
    {
        _debounce?.Dispose();
        base.Dispose();
    }
}
