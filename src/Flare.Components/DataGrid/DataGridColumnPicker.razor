@namespace Flare.Components
@typeparam TItem
@inherits FlareDataGridControl<TItem>
@implements IAsyncDisposable
@inject Flare.Components.Services.IOverlayJsService Overlay

<div class="@Css.Classes.DataGrid.ColumnPickerWrap" @ref="_wrapRef">
    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="Toggle" AriaLabel="@FlareStrings.DataGrid_ToggleColumns">
        <LeadingIcon><FlareIconView Value="FlareIcons.ViewColumn" Class="@Css.Classes.DataGrid.BtnIcon" /></LeadingIcon>
        <ChildContent>@(Label ?? FlareStrings.DataGrid_ColumnsLabel)</ChildContent>
    </FlareButton>
    @if (_open)
    {
        <div class="@Css.Classes.DataGrid.ColumnPicker @Css.Classes.DataGrid.ColumnPickerOpen" role="menu" @ref="_panelRef">
            @foreach (var col in _columns)
            {
                var key = col.Key;
                <div class="@Css.Classes.DataGrid.ColumnPickerItem">
                    <FlareCheckbox Value="@(!_hidden.Contains(key))" Label="@col.Title"
                                   ValueChanged="@(_ => ToggleAsync(key))" />
                </div>
            }
        </div>
        <div class="@Css.Classes.DataGrid.Backdrop" @onclick="Close" aria-hidden="true"></div>
    }
</div>

@code {
    protected override DataGridChange Observes => DataGridChange.Columns;

    /// <summary>Label shown on the picker button. Defaults to a localized "Columns".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Optional explicit pickable columns as (Key, Title) pairs. When null, the bound grid's
    /// non-composite columns are used.</summary>
    [Parameter] public IReadOnlyList<(string Key, string Title)>? Columns { get; set; }

    /// <summary>Optional explicit set of hidden column keys. When null, the bound grid's
    /// <see cref="DataGridContext{TItem}.HiddenColumnKeys"/> are used.</summary>
    [Parameter] public IReadOnlyCollection<string>? Hidden { get; set; }

    /// <summary>Optional notification raised with a column key when its visibility is toggled. The
    /// bound grid is updated automatically; use this only to observe the change.</summary>
    [Parameter] public EventCallback<string> OnToggle { get; set; }

    private bool _open;
    private ElementReference _wrapRef;
    private ElementReference _panelRef;
    private readonly AnchoredLayer _layer = new();

    // The picker lives in the grid's toolbar, so the grid's own scroll container never reached it - but a
    // card around the grid does, and the panel opens downwards into exactly that clip.
    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await _layer.SyncAsync(Overlay, _open, _wrapRef, _panelRef,
            new AnchoredPanelOptions { Placement = PanelPlacement.BottomEnd });
    }

    /// <summary>Releases the panel's placement listeners.</summary>
    /// <returns>A task that completes when the layer has been released.</returns>
    public ValueTask DisposeAsync() => _layer.ReleaseAsync(Overlay);

    private IReadOnlyList<(string Key, string Title)> _columns =>
        Columns ?? Owner?.PickableColumns ?? [];
    private IReadOnlyCollection<string> _hidden => Hidden ?? Owner?.HiddenColumnKeys ?? [];

    private async Task ToggleAsync(string key)
    {
        if (Owner is not null) await Owner.ToggleColumnAsync(key);
        if (OnToggle.HasDelegate) await OnToggle.InvokeAsync(key);
    }

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;
}
