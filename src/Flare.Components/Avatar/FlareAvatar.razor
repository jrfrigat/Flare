@namespace Flare.Components
@inherits FlareComponentBase
@using Flare.Components.Security

@if (_visible)
{
    <div class="@BuildCssClass(_sizeClass, _shapeClass, Color.CssClass)"
         style="@_colorStyle @Style"
         title="@(string.IsNullOrEmpty(Alt) ? Text : Alt)"
         role="img"
         aria-label="@(string.IsNullOrEmpty(Alt) ? null : Alt)"
         aria-hidden="@(string.IsNullOrEmpty(Alt) ? "true" : null)"
         @attributes="AdditionalAttributes">
        @if (_safeImage is not null)
        {
            <img class="@Css.Classes.Avatar.Img" src="@_safeImage" alt="@Alt" @onerror="HandleImageError" />
        }
        else if (!string.IsNullOrEmpty(Text))
        {
            <span class="@Css.Classes.Avatar.Initials" aria-label="@Text">@_initials</span>
        }
        else if (FallbackContent is not null)
        {
            @FallbackContent
        }
        else
        {
            <FlareIconView Value="FallbackIcon" Class="@Css.Classes.Avatar.Icon" />
        }
    </div>
}

@code {
    /// <summary>URL of the image displayed as the avatar.</summary>
    [Parameter] public string? Src { get; set; }
    /// <summary>Name or initials text used when no image is provided.</summary>
    [Parameter] public string? Text { get; set; }
    /// <summary>Alt text for the avatar image element.</summary>
    [Parameter] public string? Alt { get; set; }
    /// <summary>Background color of the avatar. Role -> shared class (tonal); custom -> inline tokens. Default = a stable color picked from the text.</summary>
    [Parameter] public FlareColor Color { get; set; } = FlareColor.Default;
    /// <summary>Size variant controlling the avatar dimensions.</summary>
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Md;
    /// <summary>Shape of the avatar: Circle, Square, or Rounded.</summary>
    [Parameter] public AvatarShape Shape { get; set; } = AvatarShape.Circle;
    /// <summary>Icon shown when the avatar has no image and no text - any provider. Defaults to the
    /// built-in person icon. Ignored when <see cref="FallbackContent"/> is set.</summary>
    [Parameter] public FlareIcon FallbackIcon { get; set; } = FlareIcons.Person;
    /// <summary>Custom content rendered when the avatar has no image and no text, in place of the
    /// default <see cref="FallbackIcon"/> (e.g. a custom <c>FlareIcon</c>, an emoji, or an SVG).</summary>
    [Parameter] public RenderFragment? FallbackContent { get; set; }

    /// <summary>Parent avatar group that manages max-visible and overflow counting.</summary>
    [CascadingParameter] public FlareAvatarGroup? Group { get; set; }
    // Changes whenever the group resets its counters, which is what makes an avatar re-register even
    // when its own parameters are unchanged - Blazor skips such a child otherwise.
    [CascadingParameter(Name = "FlareAvatarGroupVersion")] private int GroupVersion { get; set; }

    protected override string ComponentCssClass => Css.Classes.Avatar.Root;

    private bool _visible = true;
    private bool _imageFailed;
    private string? _lastSrc;

    // Deliberately no ShouldRender memo. The avatar used to skip a render when a key built from its
    // content parameters was unchanged, which also suppressed every later change to Class, Style and
    // unmatched attributes - and kept a group-hidden avatar hidden after Max grew. One div is cheaper
    // to render than a complete key (which would have to hash the attribute dictionary) is to build.
    protected override void OnParametersSet()
    {
        _visible = Group is null || Group.RegisterAvatar();
        // A failed image gets another chance only when the URL itself changes; the group's version
        // cascades through this method too, and resetting on every call would retry a dead URL forever.
        if (!string.Equals(_lastSrc, Src, StringComparison.Ordinal))
        {
            _lastSrc = Src;
            _imageFailed = false;
        }
    }

    private void HandleImageError()
    {
        _imageFailed = true;
        StateHasChanged();
    }

    private static readonly (string bg, string fg)[] _palette =
    [
        ($"var({Css.Tokens.Color.PrimaryContainer})", $"var({Css.Tokens.Color.OnPrimaryContainer})"),
        ($"var({Css.Tokens.Color.SecondaryContainer})", $"var({Css.Tokens.Color.OnSecondaryContainer})"),
        ($"var({Css.Tokens.Color.TertiaryContainer})", $"var({Css.Tokens.Color.OnTertiaryContainer})"),
        ($"var({Css.Tokens.Color.ErrorContainer})", $"var({Css.Tokens.Color.OnErrorContainer})"),
    ];

    private string _sizeClass => SizeClass(Size);

    // Shared with FlareAvatarGroup, whose overflow bubble is the same circle at the same size. It used
    // to build the name from a suffix, which is a name Flare.CssAudit cannot read.
    internal static string SizeClass(AvatarSize size) => size switch
    {
        AvatarSize.Xs => Css.Classes.Avatar.SizeXs,
        AvatarSize.Sm => Css.Classes.Avatar.SizeSm,
        AvatarSize.Lg => Css.Classes.Avatar.SizeLg,
        AvatarSize.Xl => Css.Classes.Avatar.SizeXl,
        _             => Css.Classes.Avatar.SizeMd
    };

    private string _shapeClass => Shape switch
    {
        AvatarShape.Square  => Css.Classes.Avatar.Square,
        AvatarShape.Rounded => Css.Classes.Avatar.Rounded,
        _                   => string.Empty
    };

    private string? _safeImage => !_imageFailed && CssValidator.IsImageSrcSafe(Src) ? Src : null;

    // All paths feed the shared --fc-container/--fc-on-container tokens (avatar is tonal):
    // custom -> inline value + contrast; default -> stable palette pick; role -> null (class sets them).
    private string? _colorStyle
    {
        get
        {
            if (Color.StyleContainerSolid() is { } tokens) return tokens;   // custom or dynamic
            if (Color.IsRole) return null;
            if (string.IsNullOrEmpty(Text)) return null;
            var idx = Math.Abs(Text.Aggregate(0, (a, c) => a + c)) % _palette.Length;
            var (bg, fg) = _palette[idx];
            return $"{Css.Tokens.LocalColor.Container}:{bg};{Css.Tokens.LocalColor.OnContainer}:{fg};";
        }
    }

    // Splits on any whitespace, so repeated spaces, tabs and outer padding never become an initial,
    // and takes whole text elements so a surrogate pair or a combining mark is never cut in half.
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        var first = FirstTextElement(parts[0]);
        if (parts.Length == 1) return first.ToUpperInvariant();
        return (first + FirstTextElement(parts[1])).ToUpperInvariant();
    }

    private static string FirstTextElement(string value)
    {
        var elements = System.Globalization.StringInfo.GetTextElementEnumerator(value);
        return elements.MoveNext() ? elements.GetTextElement() : string.Empty;
    }

    private string _initials => GetInitials(Text);
}
