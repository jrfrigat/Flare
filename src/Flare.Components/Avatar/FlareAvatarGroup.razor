@namespace Flare.Components
@inherits FlareComponentBase

<div class="@BuildCssClass()"
     style="@_groupStyle"
     @attributes="AdditionalAttributes">
    @* The version tells the avatars that the registration counters were reset. Without it a child whose
       own parameters did not change is skipped by Blazor's diff after Max grows, so a previously hidden
       avatar never re-registers and stays hidden. *@
    <CascadingValue Value="@this" IsFixed="true">
        <CascadingValue Value="_registrationVersion" Name="FlareAvatarGroupVersion">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
    @if (_overflow > 0)
    {
        <div class="@Css.Classes.Avatar.GroupOverflow @Css.Classes.Avatar.Root @_sizeClass"
             role="img"
             aria-label="@_overflowLabel"
             title="@_overflowLabel">
            <span class="@Css.Classes.Avatar.Initials" aria-hidden="true">+@_overflow</span>
        </div>
    }
</div>

@code {
    /// <summary>Avatar items to render in the group.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Maximum number of avatars to display before showing an overflow badge.</summary>
    [Parameter] public int Max { get; set; } = 5;
    /// <summary>Size shared by the overflow badge (child avatars set their own size).</summary>
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Md;
    /// <summary>Negative margin applied between avatars, e.g. "-0.75rem". Null uses the theme's value
    /// (the <c>--flare-avatar-group-spacing</c> token); an explicit value wins over the theme.</summary>
    [Parameter] public string? Spacing { get; set; }

    protected override string ComponentCssClass => Css.Classes.Avatar.Group;

    private int _overflow;
    private int _visibleCount;
    private int _registrationVersion;

    // Only a caller-set Spacing becomes an inline variable; otherwise the stylesheet reads the theme's
    // token. The value is a length, so it goes through the same sanitiser as every other inline length.
    private string? _groupStyle
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(Spacing))
                parts.Add($"{Css.Tokens.AvatarField.GroupSpacing}:{Flare.Components.Security.CssValidator.StripDangerous(Spacing)}");
            if (!string.IsNullOrEmpty(Style)) parts.Add(Style);
            return parts.Count > 0 ? string.Join(';', parts) : null;
        }
    }

    private string _overflowLabel =>
        string.Format(FlareStrings.Avatar_OverflowMore, _overflow);

    private string _sizeClass => FlareAvatar.SizeClass(Size);

    /// <summary>Called by child FlareAvatar; returns true if the avatar should be visible.</summary>
    internal bool RegisterAvatar()
    {
        _visibleCount++;
        if (_visibleCount > Max)
        {
            _overflow++;
            InvokeAsync(StateHasChanged);
            return false;
        }
        return true;
    }

    protected override void OnParametersSet()
    {
        _overflow = 0;
        _visibleCount = 0;
        _registrationVersion++;
    }
}
