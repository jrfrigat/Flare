@namespace Flare.Components
@inherits FlareComponentBase

<li class="@BuildCssClass(_clickableClass, _selectedClass, _disabledClass)"
    aria-current="@(Selected && !OnClick.HasDelegate ? "true" : null)"
    style="@Style"
    @attributes="AdditionalAttributes">
    @* The slots hold the row's own actions; they sit above the stretched action (list.css), so their
       clicks never reach it and the row itself stays a plain listitem. *@
    @if (Leading is not null)
    {
        <div class="@Css.Classes.List.Leading">@Leading</div>
    }
    <div class="@Css.Classes.List.Content" id="@_contentId">
        @if (!string.IsNullOrEmpty(Primary))
        {
            <span class="@_primaryClass">@Primary</span>
        }
        @if (!string.IsNullOrEmpty(Secondary))
        {
            <span class="@_secondaryClass">@Secondary</span>
        }
        @ChildContent
    </div>
    @if (Trailing is not null)
    {
        <div class="@Css.Classes.List.Trailing">@Trailing</div>
    }
    @* A native button stretched over the row: the li keeps listitem semantics, while Enter/Space,
       disabled and focus behave as they do on any button. *@
    @if (OnClick.HasDelegate)
    {
        <button class="@Css.Classes.List.Action" type="button" disabled="@Disabled"
                aria-labelledby="@_contentId" aria-pressed="@(Selected ? "true" : "false")"
                @onclick="HandleClick"></button>
    }
</li>

@code {
    /// <summary>Additional content rendered inside the item body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Content rendered at the start of the item. On a clickable item, clicks and key presses inside
    /// it do not activate the item, so the slot can hold the item's own controls.</summary>
    [Parameter] public RenderFragment? Leading { get; set; }
    /// <summary>Content rendered at the end of the item. On a clickable item, clicks and key presses inside it
    /// do not activate the item, so the slot can hold the item's own actions.</summary>
    [Parameter] public RenderFragment? Trailing { get; set; }
    /// <summary>Primary text label displayed in the item.</summary>
    [Parameter] public string? Primary { get; set; }
    /// <summary>Secondary text displayed below the primary label.</summary>
    [Parameter] public string? Secondary { get; set; }
    /// <summary>Renders the primary and secondary text in the monospace font, so an identifier keeps the
    /// item's title slot and row typography instead of falling back to <see cref="ChildContent"/>.</summary>
    [Parameter] public bool Mono { get; set; }
    /// <summary>Whether the item is in a selected state.</summary>
    [Parameter] public bool Selected { get; set; }
    /// <summary>Prevents the item from being interacted with.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Callback raised when the item is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    protected override string ComponentCssClass => Css.Classes.List.Item;

    private readonly string _contentId = "flare-list-item-content-" + Guid.NewGuid().ToString("N")[..8];

    private string _primaryClass => Mono
        ? $"{Css.Classes.List.Primary} {Css.Classes.Text.Mono}"
        : Css.Classes.List.Primary;

    private string _secondaryClass => Mono
        ? $"{Css.Classes.List.Secondary} {Css.Classes.Text.Mono}"
        : Css.Classes.List.Secondary;

    private string _clickableClass => OnClick.HasDelegate ? Css.Classes.List.Clickable : string.Empty;
    private string _selectedClass  => Selected  ? Css.Classes.List.Selected  : string.Empty;
    private string _disabledClass  => Disabled  ? Css.Classes.List.Disabled  : string.Empty;

    private async Task HandleClick()
    {
        if (!Disabled && OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }
}
