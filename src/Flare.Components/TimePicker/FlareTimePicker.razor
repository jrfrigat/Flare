@namespace Flare.Components
@inherits FlareFieldBase
@implements IFlareField<TimeOnly?>
@using System
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject Flare.Components.Services.IOverlayJsService Overlay
@inject Flare.Components.Services.IElementJsService ElementJs

@* Composes the shared FlareFieldChrome frame (root + label + helper/error). The time field owns its
   trigger well (input + clock toggle) and the anchored clock/dropdown popup, rendered in the Field slot. *@
<FlareFieldChrome @ref="_chrome" ComponentClass="@Css.Classes.TimePicker.Root"
                  Variant="Variant" Size="Size"
                  Invalid="@_invalid"
                  Disabled="Disabled" ReadOnly="ReadOnly"
                  Label="@Label" LabelContent="@LabelContent" LabelFor="@ControlId"
                  HelperText="@HelperText" HelperId="@HelperId"
                  ErrorText="@DisplayedErrorText" ErrorId="@ErrorId"
                  Class="@Class" Style="@Style" Attributes="AdditionalAttributes">
    <Field>
        <div class="@Css.Classes.Input.Field" @ref="_fieldEl">
            <input class="@Css.Classes.Input.Control"
                   id="@ControlId"
                   @ref="_inputEl"
                   style="@(Typo is { } _t ? FlareTypography.FontStyle(_t) : null)"
                   type="text"
                   inputmode="numeric"
                   maxlength="@(ShowSeconds ? 8 : 5)"
                   value="@_text"
                   placeholder="@(Placeholder ?? (ShowSeconds ? "HH:mm:ss" : "HH:mm"))"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   aria-required="@(Required ? "true" : null)"
                   aria-label="@(Label ?? FlareStrings.TimePicker_FieldLabel)"
                   aria-invalid="@(_invalid ? "true" : null)"
                   aria-describedby="@SupportDescribedBy"
                   role="@(_isList ? "combobox" : null)"
                   aria-haspopup="@(_isList ? "listbox" : null)"
                   aria-expanded="@(_isList ? (_open ? "true" : "false") : null)"
                   aria-controls="@(_isList ? _listId : null)"
                   aria-activedescendant="@_listActiveId"
                   aria-autocomplete="@(_isList ? "none" : null)"
                   autocomplete="@(_isList ? "off" : null)"
                   @onkeydown="HandleInputKeyDown"
                   @oninput="HandleInput"
                   @onchange="HandleCommitText"
                   @onfocus="@(() => _focused = true)"
                   @onblur="HandleBlur"
                   @attributes="InputAttributes" />
            <button type="button" class="@Css.Classes.Input.Toggle @Css.Classes.Input.Icon @Css.Classes.Input.IconTrailing"
                    disabled="@(Disabled || ReadOnly)" aria-haspopup="@(_isList ? "listbox" : "dialog")" aria-expanded="@_open"
                    aria-label="@FlareStrings.TimePicker_Open" @ref="_toggleEl" @onclick="Toggle">
                <FlareIconView Value="@FlareIcons.Schedule" />
            </button>
        </div>

        @if (_isList && _chrome is not null)
        {
            <FlarePopup @ref="_listPopup" Open="_open" Anchor="_fieldEl" DismissRoot="_chrome.Root"
                        OnDismiss="Close" Class="@Css.Classes.Select.Dropdown">
                <FlareOptionList TItem="TimeOnly" Id="@_listId" Rows="ListRows"
                                 HighlightedIndex="_listActive" IsSelected="ListSelected" Label="ListLabel"
                                 ShowCheck="true" OptionClass="@Css.Classes.Select.Option"
                                 OnSelect="SelectListAsync" OnHighlight="i => _listActive = i"
                                 PreventMouseDownDefault="true" />
            </FlarePopup>
        }
        else if (_open)
        {
        <div class="@Css.Classes.Picker.Scrim" @onclick="Close" aria-hidden="true"></div>
        <div class="@($"{Css.Classes.Picker.Panel} {Css.Classes.TimePicker.Panel} {(PopupVariant == TimePickerVariant.Dial ? Css.Classes.TimePicker.PanelDial : Css.Classes.TimePicker.PanelDropdown)}")"
             @ref="_panelEl" role="dialog" aria-modal="true" aria-label="@_headline"
             @onkeydown="HandlePanelKeyDown" @onkeydown:stopPropagation>
            <div class="@Css.Classes.TimePicker.PanelHeadline">@_headline</div>

            @if (PopupVariant == TimePickerVariant.Dial && _keyboardEntry)
            {
                <FlareTimeEntry Hour="_tempHour" HourChanged="h => _tempHour = h"
                                Minute="_tempMinute" MinuteChanged="m => _tempMinute = m"
                                Is24Hour="_is24Hour" Submitted="Confirm"
                                ValidityChanged="v => _entryInvalid = !v" />
            }
            else if (PopupVariant == TimePickerVariant.Dial)
            {
                <FlareClockDial Hour="_tempHour" HourChanged="h => _tempHour = h"
                                Minute="_tempMinute" MinuteChanged="m => _tempMinute = m"
                                MinuteSelected="OnDialMinuteSelected"
                                Is24Hour="_is24Hour" />
            }
            else
            {
                <div class="@Css.Classes.TimePicker.Display" aria-hidden="true">
                    <span class="@Css.Classes.TimePicker.DisplayPart @(_dropActive == 0 ? Css.Classes.TimePicker.DisplayPartActive : "")">@_tempHour.ToString("00")</span>
                    <span class="@Css.Classes.TimePicker.DisplaySep">:</span>
                    <span class="@Css.Classes.TimePicker.DisplayPart @(_dropActive == 1 ? Css.Classes.TimePicker.DisplayPartActive : "")">@_tempMinute.ToString("00")</span>
                    @if (ShowSeconds)
                    {
                        <span class="@Css.Classes.TimePicker.DisplaySep">:</span>
                        <span class="@Css.Classes.TimePicker.DisplayPart @(_dropActive == 2 ? Css.Classes.TimePicker.DisplayPartActive : "")">@_tempSecond.ToString("00")</span>
                    }
                </div>
                <div class="@Css.Classes.TimePicker.Columns" tabindex="0" @ref="_dropRef" @onkeydown="OnDropKey"
                     role="group" aria-label="@_headline" aria-activedescendant="@_columnsActiveId">
                    <div class="@Css.Classes.TimePicker.Col" role="listbox" aria-label="@FlareStrings.TimePicker_Hours">
                        @for (var h = 0; h < 24; h += _hourStep)
                        {
                            var hour = h;
                            <button type="button"
                                    id="@CellId('h', hour)" class="@CellClass(hour == _tempHour, 0)"
                                    role="option" aria-selected="@(hour == _tempHour)" disabled="@HourDisabled(hour)"
                                    @onclick="@(() => _tempHour = hour)">@hour.ToString("00")</button>
                        }
                    </div>
                    <div class="@Css.Classes.TimePicker.ColumnsSep">:</div>
                    <div class="@Css.Classes.TimePicker.Col" role="listbox" aria-label="@FlareStrings.TimePicker_Minutes">
                        @for (var m = 0; m < 60; m += MinuteStep)
                        {
                            var min = m;
                            <button type="button"
                                    id="@CellId('m', min)" class="@CellClass(min == _tempMinute, 1)"
                                    role="option" aria-selected="@(min == _tempMinute)" disabled="@MinuteDisabled(min)"
                                    @onclick="@(() => SelectMinute(min))">@min.ToString("00")</button>
                        }
                    </div>
                    @if (ShowSeconds)
                    {
                        <div class="@Css.Classes.TimePicker.ColumnsSep">:</div>
                        <div class="@Css.Classes.TimePicker.Col" role="listbox" aria-label="@FlareStrings.TimePicker_Seconds">
                            @for (var s = 0; s < 60; s++)
                            {
                                var sec = s;
                                <button type="button"
                                        id="@CellId('s', sec)" class="@CellClass(sec == _tempSecond, 2)"
                                        role="option" aria-selected="@(sec == _tempSecond)" disabled="@SecondDisabled(sec)"
                                        @onclick="@(() => SelectSecond(sec))">@sec.ToString("00")</button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="@Css.Classes.TimePicker.Actions">
                @if (_showKeyboardToggle)
                {
                    <span class="@Css.Classes.TimePicker.ActionsLead">
                        <FlareIconButton Icon="@(_keyboardEntry ? FlareIcons.Schedule : FlareIcons.Keyboard)"
                                         AriaLabel="@(_keyboardEntry ? FlareStrings.TimePicker_SwitchToDial : FlareStrings.TimePicker_SwitchToKeyboard)"
                                         Size="ButtonSize.Sm" OnClick="ToggleKeyboardEntry" />
                    </span>
                }
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="Close">@(CancelText ?? FlareStrings.Picker_Cancel)</FlareButton>
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="Confirm" Disabled="@(!CanConfirm)">@(OkText ?? FlareStrings.Picker_Ok)</FlareButton>
            </div>
        </div>
        }
    </Field>
</FlareFieldChrome>

