@namespace Flare.Components
@inject IMessageBoxService MessageBoxService
@inject IOverlayJsService Overlay
@inject IScrollService Scroll
@implements IDisposable
@implements IAsyncDisposable

@if (MessageBoxService.Current is { } req)
{
    <div class="@Css.Classes.Msgbox.Scrim" @onclick="@(() => Respond(req, req.Kind == MessageBoxKind.Alert))">
        <div class="@Css.Classes.Msgbox.Root" @onclick:stopPropagation="true"
             @onkeydown="@(e => OnKeyDown(req, e))"
             role="@(req.Kind == MessageBoxKind.Alert ? "alertdialog" : "dialog")"
             aria-modal="true"
             aria-labelledby="@_titleId"
             aria-describedby="@_contentId"
             tabindex="-1"
             @ref="_dialogEl">
            <div class="@Css.Classes.Msgbox.Header">
                <h2 id="@_titleId" class="@Css.Classes.Msgbox.Title">@req.Title</h2>
            </div>
            <div class="@Css.Classes.Msgbox.Content" id="@_contentId">
                @if (req.Kind == MessageBoxKind.Prompt)
                {
                    @if (!string.IsNullOrEmpty(req.Label))
                    {
                        <label class="@Css.Classes.Msgbox.Label" for="@_inputId">@req.Label</label>
                    }
                    <input id="@_inputId"
                           class="@Css.Classes.Msgbox.Input"
                           type="text"
                           value="@_value"
                           @oninput="@(e => SetValue(req, e))"
                           @onkeyup="@(e => OnInputKeyUp(req, e))"
                           placeholder="@req.DefaultValue" />
                }
                else if (!string.IsNullOrEmpty(req.Label))
                {
                    <p class="@Css.Classes.Msgbox.Message">@req.Label</p>
                }
            </div>
            <div class="@Css.Classes.Msgbox.Actions">
                @if (req.Kind != MessageBoxKind.Alert)
                {
                    <button type="button" class="@Css.Classes.Msgbox.Btn @Css.Classes.Msgbox.BtnCancel" @onclick="@(() => Respond(req, false))">@req.CancelLabel</button>
                }
                <button type="button" class="@Css.Classes.Msgbox.Btn @Css.Classes.Msgbox.BtnConfirm" @onclick="@(() => Respond(req, true))">@req.ConfirmLabel</button>
            </div>
        </div>
    </div>
}

@code {
    private string _value = "";

    // Unique IDs prevent aria attribute clashes when multiple dialogs exist in the DOM.
    private readonly string _instanceId = Guid.NewGuid().ToString("N")[..8];
    private string _titleId  => $"flare-mb-title-{_instanceId}";
    private string _contentId => $"flare-mb-content-{_instanceId}";
    private string _inputId  => $"flare-mb-input-{_instanceId}";

    private ElementReference _dialogEl;
    private MessageBoxRequest? _focusedRequest;
    private MessageBoxRequest? _valueRequest;
    private readonly SemaphoreSlim _focusSync = new(1, 1);
    private bool _disposed;
    private IAsyncDisposable? _scrollLock;

    protected override void OnInitialized()
    {
        MessageBoxService.OnStateChanged += HandleStateChanged;
    }

    protected override void OnParametersSet()
    {
        if (MessageBoxService.Current is { } req && !ReferenceEquals(req, _valueRequest))
        {
            _value = req.DefaultValue;
            _valueRequest = req;
        }
    }

    private void HandleStateChanged()
    {
        OnParametersSet();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _focusSync.WaitAsync();
        try
        {
            if (_disposed) return;
            var request = MessageBoxService.Current;
            if (ReferenceEquals(request, _focusedRequest) && (request is not null || _scrollLock is null)) return;
            if (request is null)
                await ReleaseModalAsync();
            else if (_focusedRequest is null)
            {
                _scrollLock ??= await Scroll.LockAsync();
                await Overlay.TrapFocusAsync(_instanceId, _dialogEl);
            }
            else
                await Overlay.FocusFirstAsync(_dialogEl);
            _focusedRequest = request;
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        finally { _focusSync.Release(); }
    }

    private void Respond(MessageBoxRequest request, bool confirm)
    {
        if (_disposed || !ReferenceEquals(MessageBoxService.Current, request)) return;
        MessageBoxService.Respond(confirm
            ? request.Kind == MessageBoxKind.Prompt ? _value : "confirmed"
            : null);
    }

    private void SetValue(MessageBoxRequest request, ChangeEventArgs e)
    {
        if (!_disposed && ReferenceEquals(MessageBoxService.Current, request))
            _value = e.Value?.ToString() ?? string.Empty;
    }

    // Keyboard handler on the dialog container (catches Escape for close).
    private void OnKeyDown(MessageBoxRequest request, KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Respond(request, request.Kind == MessageBoxKind.Alert);
        }
    }

    // Commit on release so returning focus cannot activate the launcher with the same Enter press.
    private void OnInputKeyUp(MessageBoxRequest request, KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Respond(request, true);
    }

    public void Dispose()
    {
        MessageBoxService.OnStateChanged -= HandleStateChanged;
    }

    private async ValueTask ReleaseModalAsync()
    {
        try { await Overlay.ReleaseFocusTrapAsync(_instanceId); }
        finally
        {
            var held = _scrollLock;
            _scrollLock = null;
            if (held is not null) await held.DisposeAsync();
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _disposed = true;
        Dispose();
        await _focusSync.WaitAsync();
        try
        {
            if (_focusedRequest is not null || _scrollLock is not null)
                await ReleaseModalAsync();
            _focusedRequest = null;
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        finally { _focusSync.Release(); }
    }
}
