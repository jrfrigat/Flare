@namespace Flare.Components
@inherits FlareComponentBase
@implements IFlareButton

<div class="@BuildCssClass(_sizeClass, _openedClass, _fullClass)" style="@Style" @attributes="_wrapperAttributes">
    <FlareButton @ref="_main" Class="@Css.Classes.SplitButton.Main"
                 Variant="Variant" Color="Color" Size="Size"
                 Disabled="Disabled" Loading="Loading"
                 Href="@Href" Target="@Target" Rel="@Rel"
                 AriaLabel="@_mainAriaLabel" aria-labelledby="@_mainAriaLabelledBy"
                 OnClick="OnClick">
        @ChildContent
    </FlareButton>
    <FlareMenu @ref="_menu" Anchor="Placement" AriaLabel="@_menuAriaLabel" Class="@Css.Classes.SplitButton.Menu" OnToggle="ToggleMenuState">
        <Activator>
            @* The caret is the button a screen reader reaches, so the menu's ARIA rides on it. *@
            <FlareButton Class="@Css.Classes.SplitButton.Trigger"
                         Variant="Variant" Color="Color" Size="Size"
                         Disabled="Disabled" AriaLabel="@_menuAriaLabel"
                         @attributes="context.Attributes">
                <FlareIconView Value="FlareIcons.ExpandMore" Class="@Css.Classes.SplitButton.Caret" />
            </FlareButton>
        </Activator>
        <ChildContent>
            @MenuItems
        </ChildContent>
    </FlareMenu>
</div>

@code {
    /// <summary>Label/content of the primary action button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>FlareMenuItem entries shown in the dropdown opened by the trigger.</summary>
    [Parameter] public RenderFragment? MenuItems { get; set; }
    /// <summary>Visual style variant applied to both the main and trigger buttons.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Filled;
    /// <summary>Size applied to both buttons.</summary>
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Md;
    /// <summary>Semantic color applied to both buttons.</summary>
    [Parameter] public FlareColor Color { get; set; } = FlareColor.Default;
    /// <summary>Disables the whole split button.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Shows a spinner on the primary action button and disables it.</summary>
    [Parameter] public bool Loading { get; set; }
    /// <summary>Stretches the split button to the full width of its container (the primary action grows).</summary>
    [Parameter] public bool FullWidth { get; set; }
    /// <summary>When set, the primary action button renders as a link (&lt;a&gt;) to this URL.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>Target for the primary link (e.g. "_blank"). Only used with <see cref="Href"/>.</summary>
    [Parameter] public string? Target { get; set; }
    /// <summary>The primary link's <c>rel</c> (link mode); null + <see cref="Target"/> <c>_blank</c> defaults to
    /// <c>noopener noreferrer</c>.</summary>
    [Parameter] public string? Rel { get; set; }
    /// <summary>Corner of the trigger the dropdown menu aligns to. Defaults to <see cref="MenuAnchor.BottomRight"/>.</summary>
    [Parameter] public MenuAnchor Placement { get; set; } = MenuAnchor.BottomRight;
    /// <summary>Callback invoked when the primary action button is clicked.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    /// <summary>Accessible name of the primary action button, for a child that is only an icon. The
    /// dropdown trigger has its own name (<see cref="MenuAriaLabel"/>), so a screen reader announces the
    /// two halves differently. An <c>aria-label</c> passed as an unmatched attribute names the primary
    /// action too; this parameter wins when both are set.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>Id (or space-separated ids) of the element that names the primary action. Forwarded as
    /// <c>aria-labelledby</c>; an unmatched <c>aria-labelledby</c> on the component works the same way.</summary>
    [Parameter] public string? AriaLabelledBy { get; set; }
    /// <summary>Accessible label for the dropdown trigger and menu. Null uses the localized default.
    /// It does not name the primary action - use <see cref="AriaLabel"/> for that.</summary>
    [Parameter] public string? MenuAriaLabel { get; set; }

    protected override string ComponentCssClass => Css.Classes.SplitButton.Root;

    private bool _menuOpen;
    private FlareButton? _main;
    private FlareMenu? _menu;

    /// <summary>Sets keyboard focus to the primary action button.</summary>
    public ValueTask FocusAsync() => _main?.FocusAsync() ?? ValueTask.CompletedTask;

    /// <summary>Opens the dropdown menu programmatically.</summary>
    public Task Open() => _menu?.OpenAsync() ?? Task.CompletedTask;

    /// <summary>Closes the dropdown menu programmatically.</summary>
    public Task Close() => _menu?.CloseAsync() ?? Task.CompletedTask;

    private string _fullClass => FullWidth ? Css.Classes.SplitButton.Full : string.Empty;
    private string _menuAriaLabel => MenuAriaLabel ?? FlareStrings.Aria_MoreActions;

    // The wrapper has no role, so a name left on it announces nothing. A caller's aria-label /
    // aria-labelledby is therefore the primary action's name: the explicit parameters win, and the two
    // keys are removed from the wrapper's copy of the attributes rather than painted twice.
    private string? _unmatchedAttribute(string name) =>
        AdditionalAttributes?.TryGetValue(name, out var value) == true ? value?.ToString() : null;

    private string? _mainAriaLabel => AriaLabel ?? _unmatchedAttribute("aria-label");
    private string? _mainAriaLabelledBy => AriaLabelledBy ?? _unmatchedAttribute("aria-labelledby");

    private IReadOnlyDictionary<string, object>? _wrapperAttributes
    {
        get
        {
            if (AdditionalAttributes is null) return null;
            if (!AdditionalAttributes.ContainsKey("aria-label") && !AdditionalAttributes.ContainsKey("aria-labelledby"))
                return AdditionalAttributes;

            var copy = new Dictionary<string, object>(AdditionalAttributes);
            copy.Remove("aria-label");
            copy.Remove("aria-labelledby");
            return copy;
        }
    }

    private void ToggleMenuState(bool opened)
    {
        _menuOpen = opened;
    }
    
    // Size mapping for the split-button CSS isolation
    private string _sizeClass => Size switch
    {
        ButtonSize.Xs => Css.Classes.SplitButton.SizeXs,
        ButtonSize.Sm => Css.Classes.SplitButton.SizeSm,
        ButtonSize.Md => Css.Classes.SplitButton.SizeMd,
        ButtonSize.Lg => Css.Classes.SplitButton.SizeLg,
        ButtonSize.Xl => Css.Classes.SplitButton.SizeXl,
        _ => Css.Classes.SplitButton.SizeMd,
    };

    private string _openedClass => _menuOpen ? Css.Classes.SplitButton.Opened : string.Empty;
}
