@namespace Flare.Components
@inherits FlareComponentBase
@inject Flare.Components.Services.IUiJsService Ui

<div @ref="_list"
     class="@BuildCssClass(_sideClass, _alignClass, _open ? Css.Classes.FabMenu.ListOpen : null)"
     style="@Style"
     @attributes="AdditionalAttributes"
     id="@FabContext?.MenuId"
     role="menu"
     aria-labelledby="@FabContext?.TriggerId"
     aria-hidden="@((!_open).ToString().ToLowerInvariant())">
    @ChildContent
</div>

@code {
    /// <summary>The <see cref="FlareFloatingActionMenuItem"/> entries.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Which side of the FAB the actions open on, and how they line up along it - the same
    /// <see cref="Components.Placement"/> a <see cref="FlarePopover"/> takes. A bare side centres the
    /// actions on the FAB; <c>Start</c> and <c>End</c> line up an edge instead, which is what keeps a
    /// speed dial pinned to a screen corner from hanging half off the screen.
    /// </summary>
    [Parameter] public Placement Placement { get; set; } = Placement.Top;

    [CascadingParameter] private FabMenuContext? FabContext { get; set; }
    private bool Open => FabContext?.Open == true;

    protected override string ComponentCssClass => Css.Classes.FabMenu.List;

    private bool _open => Open;

    private ElementReference _list;
    private bool _keyboardRegistered;

    // The actions move focus in .NET; the browser's own handling of the arrows would scroll the page
    // under them. The listener is registered once, not per open: items are always mounted and only
    // become focusable while the list is visible.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_keyboardRegistered) return;

        try
        {
            await Ui.RegisterFabMenuKeyboardAsync(_list);
            _keyboardRegistered = true;
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    /// <inheritdoc />
    public override async ValueTask DisposeAsync()
    {
        if (_keyboardRegistered)
        {
            try { await Ui.RemoveFabMenuKeyboardAsync(_list); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
        await base.DisposeAsync();
    }

    private string _sideClass => Placement switch
    {
        Placement.Bottom or Placement.BottomStart or Placement.BottomEnd => Css.Classes.FabMenu.Down,
        Placement.Left or Placement.LeftStart or Placement.LeftEnd       => Css.Classes.FabMenu.Left,
        Placement.Right or Placement.RightStart or Placement.RightEnd    => Css.Classes.FabMenu.Right,
        _                                                               => Css.Classes.FabMenu.Up,
    };

    // A bare side centres, which is the side class's own layout, so it needs no second class.
    private string? _alignClass => Placement switch
    {
        Placement.TopStart or Placement.BottomStart or Placement.LeftStart or Placement.RightStart => Css.Classes.FabMenu.AlignStart,
        Placement.TopEnd or Placement.BottomEnd or Placement.LeftEnd or Placement.RightEnd         => Css.Classes.FabMenu.AlignEnd,
        _                                                                                           => null,
    };
}
