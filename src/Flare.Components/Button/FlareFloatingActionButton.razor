@namespace Flare.Components
@inherits FlareComponentBase
@inject Flare.Components.Services.IOverlayJsService Overlay

@if (ChildContent is not null)
{
    @* Speed-dial mode: the FAB is the trigger for a child FlareFloatingActionMenu. The trigger comes
       first in the DOM so Tab leaves the popup instead of landing back on it. *@
    <div class="@_menuWrapperClass" style="@(Position == FabPosition.Static ? Style : null)">
        @RenderFab(isTrigger: true)
        <CascadingValue Value="Context">
            @ChildContent
        </CascadingValue>
    </div>
}
else if (Position != FabPosition.Static)
{
    <div class="@Css.Classes.Fab.Anchor @_anchorClass">
        @RenderFab(isTrigger: false)
    </div>
}
else
{
    @RenderFab(isTrigger: false)
}

@code {
    /// <summary>The icon content rendered inside the FAB.</summary>
    [Parameter] public RenderFragment? IconContent { get; set; }

    /// <summary>Optional label text. When set, renders as an extended FAB.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Accessible label forwarded as aria-label.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Size of the FAB; <c>Md</c> is the baseline and the default. Each theme decides what a step
    /// measures.</summary>
    [Parameter] public FabSize Size { get; set; } = FabSize.Md;

    /// <summary>Color of the FAB (tonal container). Role -> shared color class; custom -> inline tokens. Default = theme default (primary-container).</summary>
    [Parameter] public FlareColor Color { get; set; } = FlareColor.Default;

    /// <summary>Positioning mode (BottomRight, BottomLeft, or Static for inline flow).</summary>
    [Parameter] public FabPosition Position { get; set; } = FabPosition.BottomRight;

    /// <summary>Disables the FAB (blocks activation and dims it via the shared button disabled state).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback invoked when the FAB is clicked (ignored in speed-dial mode - the FAB toggles the menu instead).</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Optional <see cref="FlareFloatingActionMenu"/>. When present the FAB becomes a speed-dial trigger.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override string ComponentCssClass => Css.Classes.Fab.Root;

    private bool _open;
    private ElementReference _element;
    private DotNetObjectReference<FlareFloatingActionButton>? _selfRef;
    private bool _escapeLayerRegistered;
    private readonly string _escapeLayerId = "flare-fab-menu-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _triggerId = "flare-fab-trigger-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _menuId = "flare-fab-list-" + Guid.NewGuid().ToString("N")[..8];
    private readonly FabMenuItems _items = new();
    private bool _focusFirstOnOpen;
    private bool _focusLastOnOpen;

    private FabMenuContext Context => new(_open, Close, _menuId, _triggerId, _items);

    /// <summary>Sets keyboard focus to the FAB element.</summary>
    public ValueTask FocusAsync() => _element.FocusAsync();

    // The speed dial is a dismissible popup. The menu is passive markup and the button owns the open state,
    // so the button registers the layer: while open, Escape reaches the newest layer and a dialog under it
    // stays open.
    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && !_escapeLayerRegistered)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            try
            {
                await Overlay.PushPopupLayerAsync(_escapeLayerId, _selfRef, nameof(CloseFromEscape));
                _escapeLayerRegistered = true;
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        else if (!_open && _escapeLayerRegistered)
        {
            try { await Overlay.RemovePopupLayerAsync(_escapeLayerId); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            _escapeLayerRegistered = false;
        }

        if (_focusOnClose && !_open)
        {
            _focusOnClose = false;
            try { await _element.FocusAsync(preventScroll: true); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }

        // After the open class has made the list visible: a focus on an item while the list still
        // carries content-visibility: hidden goes nowhere.
        if (_open && (_focusFirstOnOpen || _focusLastOnOpen))
        {
            var first = _focusFirstOnOpen;
            _focusFirstOnOpen = _focusLastOnOpen = false;
            await _items.FocusEdgeAsync(first);
        }
    }

    /// <summary>Closes the speed-dial menu when the overlay layer receives Escape.</summary>
    [JSInvokable]
    public Task CloseFromEscape() => InvokeAsync(() => Close(true));

    /// <inheritdoc />
    public override async ValueTask DisposeAsync()
    {
        if (_escapeLayerRegistered)
        {
            try { await Overlay.RemovePopupLayerAsync(_escapeLayerId); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        _selfRef?.Dispose();
        await base.DisposeAsync();
    }

    private string? _sizeClass => Size switch
    {
        FabSize.Sm => Css.Classes.Fab.SizeSm,
        FabSize.Lg => Css.Classes.Fab.SizeLg,
        _          => Css.Classes.Fab.SizeMd,   // Md is the default and now names itself
    };

    // Anchor CSS modifier for the current position (Static has no anchor).
    private string? _anchorClass => Position switch
    {
        FabPosition.BottomLeft  => Css.Classes.Fab.AnchorBottomLeft,
        FabPosition.BottomRight => Css.Classes.Fab.AnchorBottomRight,
        _                       => null,
    };

    // Role -> shared color class; custom -> inline tonal tokens.
    private string? _colorClass => Color.CssClass;

    private string? _colorTokens => Color.StyleContainer();

    private string? CombineStyle(string? extra)
    {
        if (_colorTokens is null) return extra;
        if (string.IsNullOrEmpty(extra)) return _colorTokens;
        return extra.TrimEnd().EndsWith(';') ? _colorTokens + extra : _colorTokens + ";" + extra;
    }

    private string _menuWrapperClass
    {
        get
        {
            var cls = Css.Classes.FabMenu.Wrapper;
            if (Position != FabPosition.Static)
                cls += $" {Css.Classes.Fab.Anchor} {_anchorClass}";
            if (_open)
                cls += $" {Css.Classes.FabMenu.Open}";
            return cls;
        }
    }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (ChildContent is not null)
        {
            if (_open)
            {
                Close(true);
                return;
            }

            // A keyboard activation reports detail 0; a pointer click leaves focus on the trigger.
            _focusFirstOnOpen = e.Detail == 0;
            _focusLastOnOpen = false;
            _open = true;
        }
        else if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (ChildContent is null || Disabled) return;

        switch (e.Key)
        {
            case "ArrowDown":
                if (_open) await _items.FocusEdgeAsync(first: true);
                else OpenWithFocus(first: true);
                break;
            case "ArrowUp":
                if (_open) await _items.FocusEdgeAsync(first: false);
                else OpenWithFocus(first: false);
                break;
            case "Home" when _open:
                await _items.FocusEdgeAsync(first: true);
                break;
            case "End" when _open:
                await _items.FocusEdgeAsync(first: false);
                break;
        }
    }

    private void OpenWithFocus(bool first)
    {
        _focusFirstOnOpen = first;
        _focusLastOnOpen = !first;
        _open = true;
        StateHasChanged();
    }

    private bool _focusOnClose;

    private void Close(bool restoreFocus)
    {
        if (!_open) return;
        _open = false;
        _focusFirstOnOpen = _focusLastOnOpen = false;
        _focusOnClose = restoreFocus;
        StateHasChanged();
    }

    private RenderFragment RenderFab(bool isTrigger) => __builder =>
    {
        <button @ref="_element"
                class="@BuildCssClass(Css.Classes.Button.Root, _sizeClass, _colorClass, isTrigger && _open ? Css.Classes.FabMenu.TriggerOpen : null)"
                style="@CombineStyle(isTrigger ? null : Style)"
                id="@(isTrigger ? _triggerId : null)"
                aria-label="@AriaLabel"
                aria-haspopup="@(isTrigger ? "menu" : null)"
                aria-controls="@(isTrigger ? _menuId : null)"
                aria-expanded="@(isTrigger ? _open.ToString().ToLowerInvariant() : null)"
                type="button"
                disabled="@Disabled"
                @onclick="HandleClick"
                @onkeydown="HandleTriggerKeyDown"
                @attributes="AdditionalAttributes">
            @if (IconContent is not null)
            {
                <span class="@Css.Classes.Fab.Icon">@IconContent</span>
            }
            @if (!string.IsNullOrEmpty(Label))
            {
                <span class="@Css.Classes.Fab.Label">@Label</span>
            }
        </button>
    };
}
