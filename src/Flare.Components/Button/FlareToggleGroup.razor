@namespace Flare.Components
@inherits FlareComponentBase
@typeparam TValue

<CascadingValue Value="_context" IsFixed="false">
    <div class="@BuildCssClass(_orientationClass, _fullWidthClass)" style="@Style" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// Selected value when <see cref="MultiSelect"/> is false.
    /// <para>
    /// A value type has to be nullable - <c>TValue="int?"</c>, <c>MyEnum?</c>, <c>Guid?</c> - because a
    /// non-nullable one cannot tell "nothing is selected" from its own default: an unset
    /// <c>Value</c> would silently show <c>0</c> (or the enum's first member) as chosen, and the group
    /// could never be cleared. A reference type such as <c>string</c> needs nothing special; null is
    /// already the empty state. The group throws when a single-select type cannot express "nothing".
    /// </para>
    /// </summary>
    [Parameter] public TValue? Value { get; set; }
    /// <summary>Callback raised when the single selection changes.</summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    /// <summary>Selected values when MultiSelect is true.</summary>
    [Parameter] public IReadOnlyList<TValue?>? Values { get; set; }
    /// <summary>Callback raised when the multi-selection changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<TValue?>> ValuesChanged { get; set; }
    /// <summary>Allows multiple buttons to be active simultaneously.</summary>
    [Parameter] public bool MultiSelect { get; set; }
    /// <summary>Child FlareToggleButton components.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>"horizontal" (default) or "vertical".</summary>
    [Parameter] public string Orientation { get; set; } = "horizontal";
    /// <summary>Size cascaded to every child <c>FlareToggleButton</c>. When null (default) each button keeps its own <c>Size</c>.</summary>
    [Parameter] public ButtonSize? Size { get; set; }
    /// <summary>Color cascaded to every child <c>FlareToggleButton</c> (tints the selected state). When null (default) each button keeps its own <c>Color</c>.</summary>
    [Parameter] public FlareColor? Color { get; set; }
    /// <summary>When true, disables every child <c>FlareToggleButton</c> in the group.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Single-select only: when true the active button cannot be deselected by clicking it (one
    /// selection is always kept). Default false - single-select is deselectable (a "toggle" selection).
    /// The value type still has to be nullable (see <see cref="Value"/>); Mandatory only stops the user
    /// from clearing a selection that was made, it does not invent one.</summary>
    [Parameter] public bool Mandatory { get; set; }
    /// <summary>Shows a leading checkmark on each selected button.</summary>
    [Parameter] public bool CheckMark { get; set; }
    /// <summary>Stretches the group across its container and gives every button an equal share of the width.
    /// A label longer than its share is shortened with an ellipsis instead of making the group scroll.
    /// Default false: the group is as wide as its buttons and scrolls when the container is narrower.</summary>
    [Parameter] public bool FullWidth { get; set; }

    protected override string ComponentCssClass => Css.Classes.ToggleGroup.Root;

    private string _orientationClass =>
        Orientation == "vertical" ? Css.Classes.ToggleGroup.Vertical : string.Empty;

    private string _fullWidthClass => FullWidth ? Css.Classes.ToggleGroup.Full : string.Empty;

    private HashSet<object?> _selected = new();
    private FlareToggleGroupContext _context = null!;
    // Tracks the last cascaded settings so the context is rebuilt when they change (not only on selection change).
    private (ButtonSize? Size, FlareColor? Color, bool Disabled, bool CheckMark) _lastCascade;

    // Closed-generic statics: the answer is fixed by TValue, so it is computed once per instantiation.
    private static readonly bool LacksEmptyValue =
        typeof(TValue).IsValueType && Nullable.GetUnderlyingType(typeof(TValue)) is null;

    protected override void OnParametersSet()
    {
        // A single selection has to be able to say "nothing is selected". For a non-nullable value type
        // the parameter and the callback are that same type, so "nothing" has no representation and the
        // group would silently treat default(TValue) as chosen - the hidden selection this guard exists
        // to stop.
        if (!MultiSelect && LacksEmptyValue)
        {
            throw new InvalidOperationException(
                $"FlareToggleGroup<{typeof(TValue).Name}> cannot represent \"no selection\": a non-nullable " +
                $"value type makes an unset Value and default({typeof(TValue).Name}) the same value, so the " +
                "group would keep that button selected and could never be cleared. Use a nullable value " +
                "type (for example TValue=\"int?\" or MyEnum?), a reference type such as string, or MultiSelect.");
        }

        var newSelected = MultiSelect
            ? new HashSet<object?>(Values?.Cast<object?>() ?? Enumerable.Empty<object?>())
            : Value is not null ? new HashSet<object?> { Value } : new HashSet<object?>();

        var cascade = (Size, Color, Disabled, CheckMark);
        // Rebuild the context when the selection set OR a cascaded setting changed, to avoid
        // forcing a full subtree re-render on every unrelated parent parameter set.
        if (_context is null || !newSelected.SetEquals(_selected) || cascade != _lastCascade)
        {
            _selected = newSelected;
            _lastCascade = cascade;
            _context = BuildContext(_selected);
        }
    }

    private FlareToggleGroupContext BuildContext(IEnumerable<object?> selected)
        => new(new HashSet<object?>(selected), MultiSelect, HandleToggle, Size, Color, Disabled, CheckMark);

    private async Task HandleToggle(object? value)
    {
        if (MultiSelect)
        {
            if (!_selected.Add(value))
                _selected.Remove(value);

            _context = BuildContext(_selected);
            await ValuesChanged.InvokeAsync(_selected.Cast<TValue?>().ToList());
        }
        else
        {
            // Single-select: clicking the active item deselects it, unless Mandatory keeps one always selected.
            if (Mandatory && _selected.Contains(value)) return;
            var next = _selected.Contains(value) ? default : (TValue?)value;
            _selected = next is not null ? new HashSet<object?> { next } : new HashSet<object?>();
            _context = BuildContext(_selected);
            await ValueChanged.InvokeAsync(next);
        }

        StateHasChanged();
    }
}
