@namespace Flare.Components
@typeparam TItem
@inherits FlareComponentBase

<div class="@Css.Classes.Table.Container @(_stickyClass)">
    <table class="@BuildCssClass(_stripedClass, _hoverClass, _borderedClass, _denseClass)"
           style="@Style"
           @attributes="AdditionalAttributes">

        @if (!string.IsNullOrEmpty(Caption))
        {
            <caption>@Caption</caption>
        }

        @* --- Simple (non-typed) usage: consumer provides raw thead/tbody/tfoot --- *@
        @if (Items is null)
        {
            @ChildContent
        }
        else
        {
            @* --- Typed usage: component manages thead, grouped tbody, and tfoot --- *@
            <thead class="@Css.Classes.Table.THead">
                @if (Columns is not null)
                {
                    <tr>
                        @foreach (var column in Columns)
                        {
                            <th scope="col">@column.Header</th>
                        }
                    </tr>
                }
                else
                {
                    @HeaderContent
                }
            </thead>

            @if (GroupBy is null)
            {
                <tbody>
                    @RenderRows(Items)
                </tbody>
            }
            else
            {
                @foreach (var group in BuildGroups(Items, GroupBy))
                {
                    var collapsed = _collapsedGroups.Contains(group.Key);
                    <tbody>
                        <tr class="@Css.Classes.Table.GroupRow @(collapsed ? Css.Classes.Table.GroupRowCollapsed : "")">
                            <td colspan="@_groupColSpan">
                                <button type="button" class="@Css.Classes.Table.GroupToggle"
                                        aria-expanded="@(collapsed ? "false" : "true")"
                                        @onclick="() => ToggleGroup(group.Key)">
                                    <FlareIconView Value="@(collapsed ? FlareIcons.ChevronRight : FlareIcons.ExpandMore)"
                                                   Class="@Css.Classes.Table.GroupChevron" />
                                    @group.Key
                                </button>
                            </td>
                        </tr>
                        @if (!collapsed)
                        {
                            @RenderRows(group.Items)
                        }
                    </tbody>
                }
            }

            @if (ShowFooter)
            {
                <tfoot class="@Css.Classes.Table.TFoot">
                    @if (Columns is not null && FooterCells is not null)
                    {
                        <tr>
                            @foreach (var cell in FooterCells(Items))
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                    else
                    {
                        @FooterContent?.Invoke(Items)
                    }
                </tfoot>
            }
        }
    </table>
</div>

@code {

    /// <summary>Raw table content for simple (non-typed) usage.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }


    /// <summary>
    /// Accessible caption rendered as a &lt;caption&gt; element inside the table.
    /// Provides a text summary of the table's purpose - not supported by MudBlazor or Blazorise.
    /// </summary>
    [Parameter] public string? Caption { get; set; }


    /// <summary>The data items to display. When set, the component manages rendering.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Renders the header row(s) inside &lt;thead&gt;.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Renders a single data row for each item.</summary>
    [Parameter] public RenderFragment<TItem>? RowTemplate { get; set; }

    /// <summary>
    /// Describes the table by columns instead of raw <c>thead</c>/<c>tr</c>/<c>td</c> markup. When set
    /// together with <see cref="Items"/>, the component renders the header and every body row itself;
    /// <see cref="HeaderContent"/> and <see cref="RowTemplate"/> are then ignored. This is the path a
    /// page uses when it has no business writing table markup.
    /// </summary>
    [Parameter] public IReadOnlyList<FlareTableColumn<TItem>>? Columns { get; set; }

    /// <summary>
    /// Footer cells for the column path, computed from all items - a total or a count under each
    /// column. Null falls back to <see cref="FooterContent"/>; the two are not combined.
    /// </summary>
    [Parameter] public Func<IEnumerable<TItem>, IReadOnlyList<RenderFragment>>? FooterCells { get; set; }

    /// <summary>Renders the footer row(s) inside &lt;tfoot&gt; receiving all items.</summary>
    [Parameter] public RenderFragment<IEnumerable<TItem>>? FooterContent { get; set; }

    /// <summary>When non-null, groups items by the returned string key.</summary>
    [Parameter] public Func<TItem, string>? GroupBy { get; set; }

    /// <summary>Number of columns a group row spans when the rows come from <see cref="RowTemplate"/>.
    /// With <see cref="Columns"/> the group row spans the column count instead.</summary>
    [Parameter] public int ColSpan { get; set; } = 100;

    /// <summary>When true, renders a &lt;tfoot&gt; using FooterContent.</summary>
    [Parameter] public bool ShowFooter { get; set; }


    /// <summary>Alternates row background colors for readability.</summary>
    [Parameter] public bool Striped { get; set; }

    /// <summary>Highlights the row under the cursor.</summary>
    [Parameter] public bool Hover { get; set; } = true;

    /// <summary>Adds borders around all cells.</summary>
    [Parameter] public bool Bordered { get; set; }

    /// <summary>Reduces cell padding for a denser layout (consistent with other components' Dense).</summary>
    [Parameter] public bool Dense { get; set; }

    /// <summary>Pins the table header while the body scrolls.</summary>
    [Parameter] public bool StickyHeader { get; set; }


    protected override string ComponentCssClass => Css.Classes.Table.Root;

    private readonly HashSet<string?> _collapsedGroups = new(StringComparer.Ordinal);
    private readonly Dictionary<GroupKey, int> _groupIndices = [];
    private readonly List<(string? Key, List<TItem> Items)> _groups = [];

    private readonly record struct GroupKey(string? Value);

    protected override void OnParametersSet()
    {
        if (Items is not null && GroupBy is not null) return;
        _groupIndices.Clear();
        _groups.Clear();
    }

    // Re-enumerate on every render, including group toggles. The same list or selector can
    // produce different results without changing the parameter reference.
    private List<(string? Key, List<TItem> Items)> BuildGroups(IEnumerable<TItem> items, Func<TItem, string> keySelector)
    {
        _groupIndices.Clear();
        foreach (var group in _groups) group.Items.Clear();

        foreach (var item in items)
        {
            var key = keySelector(item);
            if (!_groupIndices.TryGetValue(new GroupKey(key), out var index))
            {
                index = _groupIndices.Count;
                _groupIndices.Add(new GroupKey(key), index);
                if (index == _groups.Count) _groups.Add((key, []));
                else _groups[index] = (key, _groups[index].Items);
            }
            _groups[index].Items.Add(item);
        }

        _groups.RemoveRange(_groupIndices.Count, _groups.Count - _groupIndices.Count);
        return _groups;
    }

    private string _stripedClass  => Striped     ? Css.Classes.Table.Striped  : string.Empty;
    private string _hoverClass    => Hover        ? Css.Classes.Table.Hover    : string.Empty;
    private string _borderedClass => Bordered     ? Css.Classes.Table.Bordered : string.Empty;
    private string _denseClass    => Dense        ? Css.Classes.Table.Dense    : string.Empty;
    private string _stickyClass   => StickyHeader ? Css.Classes.Table.StickyContainer : string.Empty;

    private void ToggleGroup(string? key)
    {
        if (!_collapsedGroups.Remove(key))
            _collapsedGroups.Add(key);
    }

    private int _groupColSpan => Columns?.Count ?? ColSpan;

    private RenderFragment RenderRows(IEnumerable<TItem> items) => @<text>
        @foreach (var item in items)
        {
            if (Columns is { } columns)
            {
                <tr>
                    @foreach (var column in columns)
                    {
                        <td>
                            @if (column.Cell is { } cell)
                            {
                                @cell(item)
                            }
                            else
                            {
                                @(column.Field?.Invoke(item)?.ToString())
                            }
                        </td>
                    }
                </tr>
            }
            else
            {
                @RowTemplate?.Invoke(item)
            }
        }
    </text>;

}
