@namespace Flare.Components
@inherits FlareComponentBase
@typeparam TValue
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

@* Generic in the value type so the bound property and For are the SAME type, which is the only way the
   two cannot disagree. TValue is bool for an ordinary checkbox and bool? for a tri-state one, where
   null is the indeterminate state - the third state is the value, not a separate flag beside it. *@

<label class="@BuildCssClass(_stateClass, _colorClass, _sizeClass, _labelClass, _iconClass)" style="@_inlineStyle" @attributes="AdditionalAttributes">
    <span class="@Css.Classes.Checkbox.Container">
        <input class="@Css.Classes.Checkbox.Input"
               @attributes="InputAttributes"
               type="checkbox"
               aria-checked="@(_indeterminate ? "mixed" : (_checked ? "true" : "false"))"
               aria-labelledby="@(_hasLabel ? _labelTextId : null)"
               aria-describedby="@(_displayedError is null ? null : _errorId)"
               aria-invalid="@(_displayedError is null ? null : "true")"
               checked="@_checked"
               disabled="@Disabled"
               @onchange="HandleChange" />
        <span class="@Css.Classes.Checkbox.Indicator @(_indeterminate ? Css.Classes.Checkbox.IndicatorIndeterminate : "")" aria-hidden="true">
            @if (_hasIcons)
            {
                @if (_indeterminate)
                {
                    @IndeterminateIcon
                }
                else if (_checked)
                {
                    @CheckedIcon
                }
                else
                {
                    @UncheckedIcon
                }
            }
        </span>
    </span>
    @if (_hasLabel)
    {
        <span id="@_labelTextId" class="@Css.Classes.Checkbox.Label">@if (ChildContent is not null) { @ChildContent } else { @Label }</span>
    }
    @if (!string.IsNullOrEmpty(_displayedError))
    {
        <span id="@_errorId" class="@Css.Classes.Checkbox.ErrorMsg" role="alert">@_displayedError</span>
    }
</label>

@code {
    /// <summary>
    /// Whether the box is checked. <c>TValue</c> is <c>bool</c> for an ordinary two-state box or
    /// <c>bool?</c> for a tri-state one; with <c>bool?</c> the value is tri-state and <c>null</c> is
    /// the indeterminate ("some of the below") state. The type is the caller's choice, so the value
    /// and <see cref="For"/> always describe the same model property.
    /// </summary>
    [Parameter] public TValue Value { get; set; } = default!;
    /// <summary>
    /// Callback invoked when the checked state changes. The callback carries <c>TValue</c>, so pass
    /// the type to a method group (<c>ValueChanged="Handle"</c> with
    /// <c>void Handle(bool value)</c>) or use a typed lambda; otherwise the compiler reports CS1503.
    /// A click always produces true or false - it resolves the indeterminate state rather than
    /// cycling back into it.
    /// </summary>
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    /// <summary>Label text displayed next to the checkbox. Ignored when <see cref="ChildContent"/> is
    /// set.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Markup rendered as the label instead of <see cref="Label"/>, for a label that is more than a
    /// string - a link in a consent line, a unit, an inline badge. Writing it between the tags binds
    /// here.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Overrides validation with a custom error message.</summary>
    [Parameter] public string? ErrorText { get; set; }
    /// <summary>Disables the checkbox when true.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>
    /// Attributes forwarded to the native checkbox input - a form <c>name</c>, <c>required</c>, or an
    /// accessible name for a box without a visible label. The type, checked state and disabled state stay
    /// owned by the component. <see cref="FlareComponentBase.AdditionalAttributes"/> land on the label.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }
    /// <summary>Accent color of the checked indicator (role -> shared class, custom -> inline token). Default = primary.</summary>
    [Parameter] public FlareColor Color { get; set; } = FlareColor.Default;
    /// <summary>Label position relative to the checkbox (End = after, Start = before). Default End.</summary>
    [Parameter] public LabelPlacement LabelPlacement { get; set; } = LabelPlacement.End;
    /// <summary>Control size (Xs..Xl) on the shared scale; medium is the default. Each theme decides what a
    /// step measures.</summary>
    [Parameter] public FieldSize Size { get; set; } = FieldSize.Md;
    /// <summary>Custom icon shown when checked (replaces the default check mark).</summary>
    [Parameter] public RenderFragment? CheckedIcon { get; set; }
    /// <summary>Custom icon shown when unchecked.</summary>
    [Parameter] public RenderFragment? UncheckedIcon { get; set; }
    /// <summary>Custom icon shown when indeterminate.</summary>
    [Parameter] public RenderFragment? IndeterminateIcon { get; set; }
    /// <summary>
    /// Expression naming the model property this box edits, so the enclosing form can validate it and
    /// show the message. It is typed <typeparamref name="TValue"/> like <see cref="Value"/>, so the two
    /// always name the same property - point both at a <c>bool</c> for a consent box
    /// (<c>@bind-Value="Model.Accepted" For="@(() =&gt; Model.Accepted)"</c>).
    /// </summary>
    [Parameter] public Expression<Func<TValue>>? For { get; set; }

    [CascadingParameter] private EditContext? EditContext { get; set; }

    protected override string ComponentCssClass => Css.Classes.Checkbox.Root;

    private readonly string _controlId = $"flare-checkbox-{Guid.NewGuid():N}";
    private string _labelTextId => $"{_controlId}-label";
    private string _errorId => $"{_controlId}-err";
    private bool _hasLabel => ChildContent is not null || !string.IsNullOrEmpty(Label);

    private string _colorClass => Color.CssClass ?? string.Empty;
    private string _sizeClass => Size switch
    {
        FieldSize.Xs => Css.Classes.Checkbox.SizeXs,
        FieldSize.Sm => Css.Classes.Checkbox.SizeSm,
        FieldSize.Lg => Css.Classes.Checkbox.SizeLg,
        FieldSize.Xl => Css.Classes.Checkbox.SizeXl,
        _ => Css.Classes.Checkbox.SizeMd,   // Md is the default and now names itself
    };
    private string _labelClass => LabelPlacement == LabelPlacement.Start ? Css.Classes.Checkbox.LabelStart : string.Empty;
    private bool _hasIcons => CheckedIcon is not null || UncheckedIcon is not null || IndeterminateIcon is not null;
    private string _iconClass => _hasIcons ? Css.Classes.Checkbox.CustomIcon : string.Empty;
    private string? _inlineStyle => Color.IsCustom ? $"{Color.StyleMainOn()}{Style}" : Style;

    // TValue is bool or bool? and nothing else. The check is per instance rather than per render, and it
    // is a throw rather than a silent render because the alternative is a checkbox that draws itself
    // unchecked forever and never says why - the compiler cannot rule the case out, so this does.
    private static readonly bool _valueTypeIsBoolean =
        typeof(TValue) == typeof(bool) || typeof(TValue) == typeof(bool?);

    /// <summary>The checkbox is indeterminate when its value is null, which only a bool? can be.</summary>
    private bool _indeterminate => Value is null;

    private bool _checked => Value is bool b && b;

    private FieldIdentifier _fieldId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!_valueTypeIsBoolean)
            throw new InvalidOperationException(
                $"FlareCheckbox<{typeof(TValue).Name}>: TValue must be bool or bool?. A checkbox holds a "
                + "yes/no answer; use bool? when the third (indeterminate) state is needed.");
        if (EditContext is not null)
            EditContext.OnValidationStateChanged += OnValidationChanged;
    }

    protected override void OnParametersSet()
    {
        if (EditContext is not null && For is not null)
            _fieldId = FieldIdentifier.Create(For);
    }

    private void OnValidationChanged(object? sender, ValidationStateChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public override async ValueTask DisposeAsync()
    {
        if (EditContext is not null)
            EditContext.OnValidationStateChanged -= OnValidationChanged;
        await base.DisposeAsync();
    }

    private string? _validationError =>
        EditContext is not null && For is not null
            ? EditContext.GetValidationMessages(_fieldId).FirstOrDefault()
            : null;

    private string? _displayedError => ErrorText ?? _validationError;

    private string _stateClass =>
        Disabled ? Css.Classes.Checkbox.Disabled :
        !string.IsNullOrEmpty(_displayedError) ? Css.Classes.Checkbox.Error :
        _indeterminate ? Css.Classes.Checkbox.Indeterminate : string.Empty;

    private async Task HandleChange(ChangeEventArgs e)
    {
        // The browser reports the box's new state as a plain bool; it becomes a TValue by boxing, which
        // is the one conversion both bool and bool? accept.
        var val = e.Value is bool b && b;
        await ValueChanged.InvokeAsync((TValue)(object)val);
        if (EditContext is not null && For is not null)
            EditContext.NotifyFieldChanged(_fieldId);
    }
}
