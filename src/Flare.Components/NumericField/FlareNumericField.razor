@namespace Flare.Components
@inherits FlareEditableFieldBase
@implements IFlareField<TValue>
@typeparam TValue
@inject Flare.Components.Services.IElementJsService ElementJs
@using System.ComponentModel
@using System.Linq.Expressions
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@* Composes the shared FlareFieldChrome frame (root + label + helper/error). The numeric input is complex
   (type=number, min/max/step, focus-swap text mode, clamp-on-change-vs-not-on-input), so it keeps its own
   control inside the frame's Field slot rather than the shared FlareTextInput. *@
<FlareFieldChrome Variant="Variant" Size="Size"
                  Invalid="@(!string.IsNullOrEmpty(DisplayedErrorText))"
                  Disabled="Disabled" ReadOnly="ReadOnly"
                  Label="@Label" LabelContent="@LabelContent" LabelFor="@ControlId"
                  HelperText="@HelperText" HelperId="@HelperId"
                  ErrorText="@DisplayedErrorText" ErrorId="@ErrorId"
                  Class="@Class" Style="@Style" Attributes="AdditionalAttributes">
    <Field>
        <div class="@Css.Classes.Input.Field">
            @if (!string.IsNullOrEmpty(Prefix))
            {
                <span class="@Css.Classes.Numericfield.Prefix">@Prefix</span>
            }
            <input class="@Css.Classes.Input.Control"
                   id="@ControlId"
                   style="@(Typo is { } _t ? FlareTypography.FontStyle(_t) : null)"
                   type="@(_useTextMode ? "text" : "number")"
                   inputmode="@_inputMode"
                   value="@_inputDisplay"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   min="@(_useTextMode ? null : _minStr)"
                   max="@(_useTextMode ? null : _maxStr)"
                   step="@(_useTextMode ? null : _stepStr)"
                   aria-invalid="@(!string.IsNullOrEmpty(DisplayedErrorText) ? "true" : null)"
                   aria-describedby="@SupportDescribedBy"
                   @ref="_inputEl"
                   @onfocus="HandleFocus"
                   @onchange="HandleChange"
                   @oninput="HandleInput"
                   @onblur="HandleBlur"
                   @onkeydown="HandleKeyDown"
                   @onkeyup="OnKeyUp"
                   @attributes="InputAttributes" />
            @if (!string.IsNullOrEmpty(Suffix))
            {
                <span class="@Css.Classes.Numericfield.Suffix">@Suffix</span>
            }
            @if (Clearable && _hasValue && !Disabled && !ReadOnly)
            {
                <button type="button"
                        class="@Css.Classes.Input.Clear"
                        aria-label="@(FlareStrings.Input_Clear)"
                        tabindex="-1"
                        @onclick="HandleClear">
                    <span aria-hidden="true">&#x2715;</span>
                </button>
            }
            @if (ShowStepper)
            {
                <span class="@Css.Classes.Numericfield.Stepper">
                    <button type="button" class="@Css.Classes.Numericfield.Step @Css.Classes.Numericfield.StepUp"
                            tabindex="-1" disabled="@(Disabled || ReadOnly)"
                            aria-label="@(FlareStrings.NumericField_Increment)"
                            @onclick="@(() => StepBy(Step ?? 1))">▲</button>
                    <button type="button" class="@Css.Classes.Numericfield.Step @Css.Classes.Numericfield.StepDown"
                            tabindex="-1" disabled="@(Disabled || ReadOnly)"
                            aria-label="@(FlareStrings.NumericField_Decrement)"
                            @onclick="@(() => StepBy(-(Step ?? 1)))">▼</button>
                </span>
            }
        </div>
    </Field>
</FlareFieldChrome>

@code {
    /// <summary>Current numeric value of the field.</summary>
    [Parameter] public TValue? Value { get; set; }
    /// <summary>Callback invoked when the numeric value changes.</summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    /// <summary>Minimum allowed value.</summary>
    [Parameter] public double? Min { get; set; }
    /// <summary>Maximum allowed value.</summary>
    [Parameter] public double? Max { get; set; }
    /// <summary>Increment step used by the number input.</summary>
    [Parameter] public double? Step { get; set; }
    /// <summary>
    /// Display format applied while the field is not focused: standard .NET numeric format
    /// (e.g. "N0" group separators, "C2" currency, "P0" percent). Setting this switches the
    /// control to a text field that shows the formatted value when blurred and a plain editable
    /// number while focused (focus-swap), so separators/currency symbols do not block typing.
    /// </summary>
    [Parameter] public string? Format { get; set; }
    /// <summary>Culture used to render and parse <see cref="Format"/>. Defaults to the current UI culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }
    /// <summary>Non-editable text rendered before the input (e.g. currency symbol).</summary>
    [Parameter] public string? Prefix { get; set; }
    /// <summary>Non-editable text rendered after the input (e.g. unit label).</summary>
    [Parameter] public string? Suffix { get; set; }
    /// <summary>Shows up/down stepper buttons that increment/decrement by <see cref="Step"/> (default 1).</summary>
    [Parameter] public bool ShowStepper { get; set; }
    /// <summary>When true, the value updates on every keystroke (oninput) rather than only on change/blur.</summary>
    [Parameter] public bool Immediate { get; set; }
    /// <summary>Debounce in milliseconds for <see cref="Immediate"/> updates. 0 = no debounce.</summary>
    [Parameter] public int DebounceInterval { get; set; }
    /// <summary>Expression used to bind and validate the field.</summary>
    [Parameter] public Expression<Func<TValue>>? For { get; set; }
    /// <summary>Shows a clear (x) button inside the field when it has a value.</summary>
    [Parameter] public bool Clearable { get; set; }
    /// <summary>Selects the whole value when the field gains focus (so the next keystroke replaces it).</summary>
    [Parameter] public bool SelectAllOnFocus { get; set; }
    /// <summary>Invoked when the input gains focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnFocus { get; set; }
    /// <summary>Invoked when the input loses focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }
    /// <summary>Invoked on keydown in the input, after the built-in ArrowUp/ArrowDown stepping (e.g. to submit the form on Enter).</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    /// <summary>Invoked on keyup in the input.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyUp { get; set; }
    /// <summary>Invoked when the clear (x) button is clicked, after the value has been reset.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClearButtonClick { get; set; }

    protected override string ComponentCssClass => Css.Classes.Input.Root;

    private ElementReference _inputEl;
    private bool _hasValue => Value is not null;

    /// <inheritdoc />
    protected override ValueTask FocusCoreAsync() => _inputEl.FocusAsync();
    /// <summary>Selects (highlights) all the text in the field.</summary>
    public ValueTask SelectAsync() => ElementJs.SelectAsync(_inputEl);
    /// <summary>Removes keyboard focus from the field.</summary>
    public ValueTask BlurAsync() => ElementJs.BlurAsync(_inputEl);
    /// <summary>Increases the value by <see cref="Step"/> (default 1), clamped to <see cref="Min"/>/<see cref="Max"/>.</summary>
    public Task Increment() => StepBy(Step ?? 1);
    /// <summary>Decreases the value by <see cref="Step"/> (default 1), clamped to <see cref="Min"/>/<see cref="Max"/>.</summary>
    public Task Decrement() => StepBy(-(Step ?? 1));

    private async Task HandleClear(MouseEventArgs e)
    {
        _debounceCts.Cancel();
        await ValueChanged.InvokeAsync(default);
        if (_useTextMode) _text = string.Empty;
        NotifyFieldChanged();
        await OnClearButtonClick.InvokeAsync(e);
    }

    // The control/helper/error ids, the computed aria-describedby and the displayed error text are all
    // provided by FlareFieldBase (ControlId/HelperId/ErrorId/SupportDescribedBy/DisplayedErrorText).
    // EditContext subscription, the bound FieldIdentifier and the validation lookup are provided by
    // FlareFieldBase; here we only feed it the For accessor and surface the resolved error.
    protected override void OnParametersSet()
    {
        UpdateFieldIdentifier(For);
        // A pending debounced commit belongs to the value the field was editing. Once the external
        // value changes, or the field becomes non-editable, that commit would resurrect stale text.
        var valueChanged = !_hasLastValue || !EqualityComparer<TValue?>.Default.Equals(_lastValue, Value);
        _hasLastValue = true;
        _lastValue = Value;
        if (valueChanged || Disabled || ReadOnly) _debounceCts.Cancel();
    }

    public override async ValueTask DisposeAsync()
    {
        _debounceCts.Dispose();
        await base.DisposeAsync();
    }

    // Format set -> focus-swap text mode (separators/currency/percent cannot live in type=number).
    private bool _useTextMode => !string.IsNullOrEmpty(Format);

    // The on-screen keyboard, chosen from the TYPE the field is bound to rather than from the input's
    // html type. `type="number"` raises a numeric keypad on its own, but not the same one everywhere -
    // on Android it is `inputmode` that decides whether the decimal separator is on it at all, and a
    // decimal field that cannot type a separator is unusable in every locale that has one. An integral
    // field gets `numeric` for the same reason in reverse: a separator it cannot accept is a key that
    // only produces an error.
    private static readonly HashSet<Type> _integralTypes =
    [
        typeof(byte), typeof(sbyte), typeof(short), typeof(ushort),
        typeof(int), typeof(uint), typeof(long), typeof(ulong),
    ];

    private string _inputMode =>
        _integralTypes.Contains(Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue))
            ? "numeric"
            : "decimal";
    private bool _focused;
    private string _text = string.Empty;
    private TValue? _lastValue;
    private bool _hasLastValue;
    private CultureInfo _fmtCulture => Culture ?? CultureInfo.CurrentCulture;

    // What the input element shows. Number mode: raw invariant value. Text mode: the live edit
    // buffer while focused, the formatted value when blurred.
    private string? _inputDisplay => _useTextMode
        ? (_focused ? _text : _formattedDisplay)
        : (Value is null ? null : Convert.ToString(Value, CultureInfo.InvariantCulture));

    // Blurred display: Value rendered with Format in the chosen culture.
    private string? _formattedDisplay
    {
        get
        {
            if (Value is null) return null;
            try { return ((IFormattable)Value).ToString(Format, _fmtCulture); }
            catch { return Convert.ToString(Value, _fmtCulture); }
        }
    }

    // Focused (editable) display: plain number in the culture, no group separators/symbols.
    private string _rawEditable => Value is null ? string.Empty : (Convert.ToString(Value, _fmtCulture) ?? string.Empty);

    private string? _minStr  => Min?.ToString(CultureInfo.InvariantCulture);
    private string? _maxStr  => Max?.ToString(CultureInfo.InvariantCulture);
    private string? _stepStr => Step?.ToString(CultureInfo.InvariantCulture);

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Built-in stepping runs first (editable only); the consumer's handler always fires so
        // patterns like "Enter to submit" work directly on the numeric field.
        if (!ReadOnly && !Disabled)
        {
            if (e.Key == "ArrowUp") await StepBy(Step ?? 1);
            else if (e.Key == "ArrowDown") await StepBy(-(Step ?? 1));
        }
        await OnKeyDown.InvokeAsync(e);
    }

    private async Task StepBy(double delta)
    {
        if (ReadOnly || Disabled) return;
        _debounceCts.Cancel();

        var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

        // decimal and the integral types must not go through double: a long above 2^53 or a decimal
        // with more than ~15 significant digits is changed by the conversion, not by the step.
        if (targetType == typeof(decimal) || _integralTypes.Contains(targetType))
        {
            decimal current = 0m;
            if (Value is not null)
            {
                try { current = Convert.ToDecimal(Value, CultureInfo.InvariantCulture); }
                catch { }
            }

            decimal next;
            try { next = current + (decimal)delta; }
            catch { return; }

            if (Min.HasValue) { try { next = Math.Max(next, (decimal)Min.Value); } catch { } }
            if (Max.HasValue) { try { next = Math.Min(next, (decimal)Max.Value); } catch { } }
            if (!TryConvertDecimal(next, targetType, out var convertedValue)) return;

            // Keep the editable buffer in sync so a focused text-mode field reflects the step.
            if (_useTextMode && _focused)
                _text = convertedValue is IFormattable formattable
                    ? formattable.ToString(null, _fmtCulture)
                    : next.ToString(_fmtCulture);

            await ValueChanged.InvokeAsync((TValue?)convertedValue);
            NotifyFieldChanged();
            return;
        }

        double currentDouble = 0;
        if (Value is not null)
        {
            try { currentDouble = Convert.ToDouble(Value, CultureInfo.InvariantCulture); }
            catch { }
        }

        double nextDouble = currentDouble + delta;
        if (Min.HasValue && nextDouble < Min.Value) nextDouble = Min.Value;
        if (Max.HasValue && nextDouble > Max.Value) nextDouble = Max.Value;

        TValue? converted = default;
        try
        {
            var converter = InvariantConverter.For(targetType);
            var str = nextDouble.ToString(CultureInfo.InvariantCulture);
            if (converter.CanConvertFrom(typeof(string)))
                converted = (TValue?)converter.ConvertFromInvariantString(str);
        }
        catch { }

        if (_useTextMode && _focused)
            _text = nextDouble.ToString(_fmtCulture);

        await ValueChanged.InvokeAsync(converted);

        NotifyFieldChanged();
    }

    private readonly CancelScope _debounceCts = new();

    private async Task HandleFocus(FocusEventArgs e)
    {
        if (_useTextMode)
        {
            _focused = true;
            _text = _rawEditable; // swap to the plain editable form
        }
        if (SelectAllOnFocus)
        {
            try { await ElementJs.SelectAsync(_inputEl); } catch { /* best-effort */ }
        }
        await OnFocus.InvokeAsync(e);
    }

    private async Task HandleBlur(FocusEventArgs e)
    {
        if (_useTextMode)
        {
            _focused = false;
            await InvokeAsync(StateHasChanged); // re-render the formatted display
        }
        await OnBlur.InvokeAsync(e);
    }

    // change fires on blur/commit -> always clamp to Min/Max.
    private Task HandleChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (_useTextMode) _text = raw ?? string.Empty;
        // Commit the clamped value now; a debounced unclamped commit from the last keystroke must not
        // land afterwards and put the out-of-range value back.
        _debounceCts.Cancel();
        return Commit(raw, clamp: true);
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (_useTextMode) _text = raw ?? string.Empty;
        if (!Immediate) return;
        // While typing, do not clamp (lets the user pass through intermediate values like "-").
        if (DebounceInterval <= 0) { await Commit(raw, clamp: false); return; }
        var token = _debounceCts.Next();
        try
        {
            await Task.Delay(DebounceInterval, token);
            await InvokeAsync(() => Commit(raw, clamp: false));
        }
        catch (TaskCanceledException) { }
    }

    // Parse + (optionally) clamp + convert to TValue + emit. In text mode the raw string may
    // carry culture separators/currency/percent symbols; parse tolerantly. decimal and the integral
    // types are parsed and clamped in decimal so their precision is not narrowed by double.
    private async Task Commit(string? raw, bool clamp)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            await ValueChanged.InvokeAsync(default);
            NotifyFieldChanged();
            return;
        }

        var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        if (targetType == typeof(decimal) || _integralTypes.Contains(targetType))
        {
            if (!TryParseDecimalNumber(raw, out var dec)) return;
            if (clamp)
            {
                if (Min.HasValue) { try { dec = Math.Max(dec, (decimal)Min.Value); } catch { } }
                if (Max.HasValue) { try { dec = Math.Min(dec, (decimal)Max.Value); } catch { } }
            }
            if (!TryConvertDecimal(dec, targetType, out var convertedDecimal)) return;

            await ValueChanged.InvokeAsync((TValue?)convertedDecimal);
            NotifyFieldChanged();
            return;
        }

        if (!TryParseNumber(raw, out var d)) return;
        if (clamp)
        {
            if (Min.HasValue && d < Min.Value) d = Min.Value;
            if (Max.HasValue && d > Max.Value) d = Max.Value;
        }
        var token = (!_useTextMode && !clamp) ? raw : d.ToString(CultureInfo.InvariantCulture);
        var converted = ConvertFromInvariant(token);

        await ValueChanged.InvokeAsync(converted);

        NotifyFieldChanged();
    }

    // A percent format writes 0.25 as "25%"; pasted text carrying the symbol must come back as the
    // fraction. .NET has no percent parse style, so the symbol is removed here and the number scaled.
    private bool _percentFormat => Format is { Length: > 0 } format && IsPercentFormat(format);

    // A standard P/p format (with optional precision digits), or a custom format with an unescaped and
    // unquoted percent placeholder.
    private static bool IsPercentFormat(string format)
    {
        var trimmed = format.Trim();
        if (trimmed.Length > 0 && (trimmed[0] is 'P' or 'p') && trimmed.Skip(1).All(char.IsDigit)) return true;
        for (var i = 0; i < trimmed.Length; i++)
        {
            var ch = trimmed[i];
            if (ch == '\\') { i++; continue; }
            if (ch is '"' or '\'')
            {
                var quote = ch;
                for (i++; i < trimmed.Length && trimmed[i] != quote; i++)
                {
                    if (trimmed[i] == '\\') i++;
                }
                continue;
            }
            if (ch == '%') return true;
        }
        return false;
    }

    // The culture's percent symbol in any position (prefix cultures put it before the number), with the
    // surrounding space a formatted value may carry. Only a percent format scales the result.
    private string StripPercentSymbol(string raw, out bool percent)
    {
        percent = false;
        if (!_useTextMode || !_percentFormat) return raw;
        var symbol = _fmtCulture.NumberFormat.PercentSymbol;
        if (string.IsNullOrEmpty(symbol)) return raw;
        var index = raw.IndexOf(symbol, StringComparison.Ordinal);
        if (index < 0) return raw;
        percent = true;
        return raw.Remove(index, symbol.Length).Trim();
    }

    // Tolerant parse: try the culture (currency/thousands), then a stripped fallback (e.g. percent).
    private bool TryParseNumber(string raw, out double value)
    {
        var c = _useTextMode ? _fmtCulture : CultureInfo.InvariantCulture;
        var text = StripPercentSymbol(raw, out var percent);
        if (double.TryParse(text, NumberStyles.Any, c, out value))
        {
            if (percent) value /= 100d;
            return true;
        }

        var dec = c.NumberFormat.NumberDecimalSeparator;
        var sb = new System.Text.StringBuilder(text.Length);
        foreach (var ch in text)
        {
            if (char.IsDigit(ch) || ch == '-' || ch == '+') sb.Append(ch);
            else if (dec.Length == 1 && ch == dec[0]) sb.Append('.');
        }
        if (!double.TryParse(sb.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out value)) return false;
        if (percent) value /= 100d;
        return true;
    }

    private bool TryParseDecimalNumber(string raw, out decimal value)
    {
        var c = _useTextMode ? _fmtCulture : CultureInfo.InvariantCulture;
        var text = StripPercentSymbol(raw, out var percent);
        if (decimal.TryParse(text, NumberStyles.Any, c, out value))
        {
            if (percent) value /= 100m;
            return true;
        }

        // A well-formed number the decimal parser refused overflowed its range (or asked for a
        // precision it cannot hold). Stripping its characters would invent a different value - "1e100"
        // became "1100" - so the caller keeps the previous value instead.
        if (double.TryParse(text, NumberStyles.Any, c, out _)) { value = default; return false; }

        var dec = c.NumberFormat.NumberDecimalSeparator;
        var sb = new System.Text.StringBuilder(text.Length);
        foreach (var ch in text)
        {
            if (char.IsDigit(ch) || ch == '-' || ch == '+') sb.Append(ch);
            else if (dec.Length == 1 && ch == dec[0]) sb.Append('.');
        }
        if (!decimal.TryParse(sb.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out value)) return false;
        if (percent) value /= 100m;
        return true;
    }

    // Range-checked conversion. An out-of-range or fractional value returns false, so the component
    // keeps the previous value instead of emitting a silent zero.
    private static bool TryConvertDecimal(decimal value, Type targetType, out object? converted)
    {
        converted = null;
        if (targetType == typeof(decimal))
        {
            converted = value;
            return true;
        }
        if (value != decimal.Truncate(value)) return false;
        try
        {
            converted = Convert.ChangeType(value, targetType, CultureInfo.InvariantCulture);
            return true;
        }
        catch (OverflowException) { return false; }
        catch (InvalidCastException) { return false; }
    }

    private static TValue? ConvertFromInvariant(string invariant)
    {
        var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        try
        {
            var converter = InvariantConverter.For(targetType);
            if (converter.CanConvertFrom(typeof(string)))
                return (TValue?)converter.ConvertFromInvariantString(invariant);
        }
        catch { }
        return default;
    }
}
