@namespace Flare.Components
@inherits FlareComponentBase
@inject Flare.Components.Services.IHighlightJsService Highlight
@inject Flare.Components.Services.IOverlayJsService Overlay

<div class="@_rootClass" style="@(_heightStyle + Style)" @attributes="AdditionalAttributes">
    @if (LineNumbers)
    {
        <div class="@Css.Classes.Codeblock.Linenumbers" aria-hidden="true">@_lineNumbersText</div>
    }
    <pre class="@Css.Classes.Codeblock.Highlight" aria-hidden="@(ReadOnly ? null : "true")"><code>@((MarkupString)_highlightedHtml)</code></pre>
    @if (_marked.Count > 0)
    {
        @* Marked spans are drawn on a layer of their own, holding the same text in the same metrics
           so the underlines land under the right characters. Its text is invisible; only the
           decoration shows. *@
        <pre class="@Css.Classes.Codeblock.Markers" aria-hidden="true"><code>@foreach (var part in _marked)
{
    if (part.Marker is null)
    {
        @part.Text
    }
    else
    {
        <span class="@MarkerClass(part.Marker)" title="@part.Marker.Message">@part.Text</span>
    }
}</code></pre>
    }
    @if (!ReadOnly)
    {
        <textarea class="@Css.Classes.Codeblock.Textarea"
                  role="textbox"
                  aria-multiline="true"
                  aria-label="@(Language) code editor"
                  aria-autocomplete="@(SuggestionProvider is null ? null : "list")"
                  aria-expanded="@(SuggestionProvider is null ? null : _open.ToString().ToLowerInvariant())"
                  rows="@Rows"
                  spellcheck="false"
                  autocorrect="off"
                  autocapitalize="off"
                  maxlength="@(MaxLength > 0 ? MaxLength : int.MaxValue)"
                  @oninput="HandleInput"
                  @onkeydown="HandleKeyDown"
                  @onkeydown:preventDefault="_swallowKey"
                  @onkeyup="HandleKeyUp"
                  @onclick="HandleCaretMoved"
                  @onblur="HandleBlur"
                  @ref="_textarea">@_seedText</textarea>
    }
    @if (_open && _suggestions.Count > 0)
    {
        <div class="@Css.Classes.Codeblock.Suggestions" style="@_suggestionsStyle" role="listbox" @ref="_suggestionsRef">
            @for (var i = 0; i < _suggestions.Count; i++)
            {
                var index = i;
                var suggestion = _suggestions[i];
                <div class="@SuggestionClass(index)"
                     role="option"
                     aria-selected="@(index == _selected ? "true" : "false")"
                     @onmousedown:preventDefault="true"
                     @onmousedown="@(() => Accept(suggestion))">
                    <span class="@Css.Classes.Codeblock.SuggestionLabel">@suggestion.Label</span>
                    @if (!string.IsNullOrEmpty(suggestion.Kind))
                    {
                        <span class="@Css.Classes.Codeblock.SuggestionKind">@suggestion.Kind</span>
                    }
                    @if (!string.IsNullOrEmpty(suggestion.Detail))
                    {
                        <span class="@Css.Classes.Codeblock.SuggestionDetail">@suggestion.Detail</span>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>The code string displayed (and edited when <see cref="ReadOnly"/> is false).</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Callback invoked when the user edits the code (ignored while read-only).</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>highlight.js language hint (e.g. "csharp", "javascript").</summary>
    [Parameter] public string Language { get; set; } = "csharp";
    /// <summary>Number of visible rows in edit mode (controls height via line-height).</summary>
    [Parameter] public int Rows { get; set; } = 10;
    /// <summary>Renders a static, non-editable highlighted block when true. Default true.</summary>
    [Parameter] public bool ReadOnly { get; set; } = true;
    /// <summary>Shows line numbers in the left gutter when true.</summary>
    [Parameter] public bool LineNumbers { get; set; }
    /// <summary>Maximum characters accepted/displayed. 0 = unlimited.</summary>
    [Parameter] public int MaxLength { get; set; } = 0;
    /// <summary>Enables Tab indentation and bracket/quote auto-closing in edit mode. Default true.</summary>
    [Parameter] public bool SmartEditing { get; set; } = true;
    /// <summary>Number of spaces inserted by the Tab key when <see cref="SmartEditing"/> is enabled.</summary>
    [Parameter] public int IndentSize { get; set; } = 2;

    /// <summary>
    /// Supplies what could be written at the caret. Null offers nothing, which is the default: what
    /// is worth suggesting is a question about the language being edited, and this component has no
    /// opinion about any language.
    /// </summary>
    [Parameter] public FlareCodeSuggestionProvider? SuggestionProvider { get; set; }

    /// <summary>
    /// Spans worth drawing attention to, such as anything that does not parse. Drawn under the text
    /// they cover, with the message shown when the pointer rests on one.
    /// </summary>
    [Parameter] public IReadOnlyList<FlareCodeMarker>? Markers { get; set; }

    /// <summary>Longest list of suggestions shown at once. Defaults to 8.</summary>
    [Parameter] public int MaxSuggestions { get; set; } = 8;

    /// <summary>
    /// Wraps long lines instead of scrolling sideways. Off by default, since code is usually easier
    /// to follow when a line stays a line; turn it on for generated output that has to be read
    /// rather than edited.
    /// <para>
    /// With <see cref="LineNumbers"/> a wrapped line still gets one number, so the numbers stop
    /// matching the rows on screen.
    /// </para>
    /// </summary>
    [Parameter] public bool Wrap { get; set; }

    protected override string ComponentCssClass => Css.Classes.Codeblock.Root;

    private string _displayValue => MaxLength > 0 && Value?.Length > MaxLength ? Value[..MaxLength] : Value ?? string.Empty;

    // Set once the component is interactive (OnAfterRender does not run during prerender), so the
    // highlighter is only invoked when the JS runtime is actually available.
    private bool _jsReady;
    private ElementReference _textarea;
    private string _highlightedHtml = string.Empty;
    private string _lineNumbersText = string.Empty;

    // Rendered into the textarea once and never again. Assigning a textarea's value moves the caret
    // to the end, so an editor that re-rendered its own text would jump on every keystroke. After
    // the first render the DOM owns the text, and anything arriving from elsewhere is pushed in
    // through script instead.
    private string _seedText = string.Empty;
    private bool _seeded;
    private string _domValue = string.Empty;

    private IReadOnlyList<FlareCodeSuggestion> _suggestions = [];
    private List<(string Text, FlareCodeMarker? Marker)> _marked = [];
    private bool _open;
    private bool _swallowKey;
    private int _selected;
    private int _caret;
    private string _suggestionsStyle = string.Empty;
    private ElementReference _suggestionsRef;
    private readonly AnchoredLayer _suggestLayer = new();
    private double _caretLeft;
    private double _caretTop;
    private (double Left, double Top)? _placedCaret;

    private string _rootClass
    {
        get
        {
            var cls = BuildCssClass();
            cls += ReadOnly ? " " + Css.Classes.Codeblock.Readonly : " " + Css.Classes.Codeblock.Editable;
            if (LineNumbers) cls += " " + Css.Classes.Codeblock.LineNumbers;
            if (Wrap) cls += " " + Css.Classes.Codeblock.Wrap;
            return cls;
        }
    }

    // Read-only blocks size to their content; the editor is Rows rows tall. The row count travels
    // as a custom property rather than a computed height, so the stylesheet works out the geometry
    // from the line height it already sets and the two cannot disagree.
    private string _heightStyle => ReadOnly
        ? string.Empty
        : string.Create(
            System.Globalization.CultureInfo.InvariantCulture, $"--_codeblock-rows:{Rows};");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsReady = true;
                if (!ReadOnly)
                {
                    await Highlight.AttachEditorSyncAsync(_textarea);
                    if (SmartEditing) await Highlight.EnableEditorKeysAsync(_textarea, IndentSize);
                }
            }
            catch { _jsReady = false; /* JS interop not available (prerender) */ }
        }

        // The completion list is anchored to the caret, which the JS side reports in pixels inside the
        // textarea's own box - so it goes to the engine as a pixel offset and is re-measured on scroll.
        // Placing it there rather than absolutely inside the editor is what keeps it readable when the
        // editor is in a card or a panel that hides its overflow, and above whatever is stacked over it.
        // Re-placed on every caret move, which is why the offset is compared first.
        if (_open && _suggestions.Count > 0)
        {
            if (_placedCaret != (_caretLeft, _caretTop))
            {
                _placedCaret = (_caretLeft, _caretTop);
                await _suggestLayer.ForceAsync(Overlay, _textarea, _suggestionsRef, new AnchoredPanelOptions
                {
                    Placement = PanelPlacement.BottomStart,
                    Gap = 0,
                    AnchorOffset = new PanelAnchorOffset(_caretLeft, _caretTop),
                });
            }
        }
        else if (_suggestLayer.Placed)
        {
            _placedCaret = null;
            await _suggestLayer.ReleaseAsync(Overlay);
        }

        var prev = _highlightedHtml;
        await UpdateHighlightAsync();
        if (_highlightedHtml != prev)
            await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_seeded)
        {
            _seedText = _displayValue;
            _domValue = _seedText;
            _seeded = true;
        }
        else if (!ReadOnly && !string.Equals(_domValue, _displayValue, StringComparison.Ordinal))
        {
            // Text the person did not type - a host swapping the query, say. Pushed in rather than
            // rendered, so the caret survives.
            _domValue = _displayValue;
            if (_jsReady)
            {
                try
                {
                    await Highlight.SetTextAsync(_textarea, _domValue);
                    await Highlight.SyncEditorScrollAsync(_textarea);
                }
                catch { /* the text is still what the host asked for; only the DOM lags */ }
            }
        }

        await UpdateHighlightAsync();
        UpdateLineNumbers();
        UpdateMarkers();
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        // Recorded before the host hears about it, so the round trip back is recognised as the same
        // text and nothing is pushed into the DOM on top of what is being typed.
        _domValue = text;
        await ValueChanged.InvokeAsync(text);
        UpdateLineNumbers();
        await UpdateHighlightAsync();
        await SuggestAsync(text);
    }

    /// <summary>
    /// Asks for suggestions at the caret. The text is passed in rather than read back from
    /// <see cref="Value"/>, because a host that re-renders on every keystroke has not necessarily
    /// handed the new text back yet.
    /// </summary>
    private async Task SuggestAsync(string text)
    {
        if (SuggestionProvider is null || !_jsReady) return;

        var previous = _suggestions;
        try
        {
            var caret = await Highlight.GetCaretAsync(_textarea);
            if (caret is null) { Close(); return; }

            _caret = Math.Min(caret.Start, text.Length);
            var offered = await SuggestionProvider(new FlareCodeContext(text, _caret));
            _suggestions = offered.Count > MaxSuggestions
                ? offered.Take(MaxSuggestions).ToList()
                : offered;

            _open = _suggestions.Count > 0;
            // Reset only when the offer actually changed. Re-asking with the same answers and then
            // jumping back to the first one is what makes arrow keys feel broken.
            if (!SameAsOffered(_suggestions, previous)) _selected = 0;
            else _selected = Math.Min(_selected, Math.Max(_suggestions.Count - 1, 0));
            // One line below the caret, so the list never covers what is being typed. The style is where
            // it rests for the frame before the placement engine takes over; the same two numbers go to
            // the engine as an offset inside the textarea.
            _caretLeft = caret.Left;
            _caretTop = caret.Top + caret.LineHeight;
            _suggestionsStyle = _open
                ? string.Create(
                    System.Globalization.CultureInfo.InvariantCulture,
                    $"left:{_caretLeft:0.##}px;top:{_caretTop:0.##}px")
                : string.Empty;
        }
        catch
        {
            // A suggestion that cannot be produced is not worth interrupting typing for.
            Close();
        }
        _swallowKey = _open;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Whether two offers hold the same things, so the chosen one can stay chosen.</summary>
    private static bool SameAsOffered(
        IReadOnlyList<FlareCodeSuggestion> current, IReadOnlyList<FlareCodeSuggestion> previous)
    {
        if (current.Count != previous.Count) return false;
        for (var i = 0; i < current.Count; i++)
        {
            if (!string.Equals(current[i].Text, previous[i].Text, StringComparison.Ordinal)) return false;
        }
        return true;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        // The keys that move through the list are not keys that move the caret, and re-asking on
        // them is what used to throw the choice back to the top.
        if (e.Key is "ArrowDown" or "ArrowUp" or "Enter" or "Tab" or "Escape") return;
        await HandleCaretMoved();
    }

    private async Task HandleCaretMoved()
    {
        if (SuggestionProvider is null || !_open) return;
        await SuggestAsync(_displayValue);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!_open) { _swallowKey = false; return; }

        switch (e.Key)
        {
            case "ArrowDown":
                _selected = (_selected + 1) % _suggestions.Count;
                break;
            case "ArrowUp":
                _selected = (_selected - 1 + _suggestions.Count) % _suggestions.Count;
                break;
            case "Enter":
            case "Tab":
                await Accept(_suggestions[_selected]);
                return;
            case "Escape":
                Close();
                break;
            default:
                // Anything else is ordinary typing, and the input handler will ask again.
                _swallowKey = false;
                return;
        }
        _swallowKey = true;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Puts a suggestion in. The replacement is done here rather than in script so the value the
    /// host is holding and the text on screen cannot drift apart.
    /// </summary>
    private async Task Accept(FlareCodeSuggestion suggestion)
    {
        var text = _displayValue;
        var start = suggestion.ReplaceStart >= 0 ? Math.Min(suggestion.ReplaceStart, text.Length) : _caret;
        var length = Math.Min(Math.Max(suggestion.ReplaceLength, 0), text.Length - start);

        var updated = text.Substring(0, start) + suggestion.Text + text.Substring(start + length);
        Close();

        // Put in through script, since the DOM owns the text; then the host is told.
        if (_jsReady)
        {
            try { await Highlight.SetTextAsync(_textarea, updated); }
            catch { /* the value still travels to the host below */ }
        }
        _domValue = updated;
        await ValueChanged.InvokeAsync(updated);
        UpdateLineNumbers();
        await UpdateHighlightAsync();
        await InvokeAsync(StateHasChanged);

        if (_jsReady)
        {
            try { await Highlight.SetCaretAsync(_textarea, start + suggestion.Text.Length); }
            catch { /* the caret is a nicety; losing it must not break the edit */ }
        }
    }

    // Closing on blur has to survive a click on the list itself, which is why the options suppress
    // mousedown rather than relying on click order.
    private void HandleBlur() => Close();

    private void Close()
    {
        _open = false;
        _swallowKey = false;
        _suggestions = [];
        _suggestionsStyle = string.Empty;
    }

    private string SuggestionClass(int index)
        => index == _selected
            ? Css.Classes.Codeblock.Suggestion + " " + Css.Classes.Codeblock.SuggestionSelected
            : Css.Classes.Codeblock.Suggestion;

    private static string MarkerClass(FlareCodeMarker marker)
        => marker.Severity == FlareCodeSeverity.Warning
            ? Css.Classes.Codeblock.Marker + " " + Css.Classes.Codeblock.MarkerWarning
            : Css.Classes.Codeblock.Marker;

    /// <summary>
    /// Splits the text at the marked spans, so the marker layer can be built out of plain runs and
    /// marked ones. Overlapping or out-of-range markers are trimmed rather than refused: they come
    /// from a parser reading text that is still being typed.
    /// </summary>
    private void UpdateMarkers()
    {
        _marked = [];
        var text = _displayValue;
        if (Markers is null || Markers.Count == 0 || text.Length == 0) return;

        var ordered = Markers
            .Where(marker => marker.Start < text.Length)
            .OrderBy(marker => marker.Start)
            .ToList();

        var at = 0;
        foreach (var marker in ordered)
        {
            var start = Math.Max(marker.Start, at);
            var end = Math.Min(marker.Start + Math.Max(marker.Length, 1), text.Length);
            if (end <= start) continue;

            if (start > at) _marked.Add((text.Substring(at, start - at), null));
            _marked.Add((text.Substring(start, end - start), marker));
            at = end;
        }
        if (at < text.Length) _marked.Add((text.Substring(at), null));
    }

    private async Task UpdateHighlightAsync()
    {
        var display = _displayValue;
        if (!_jsReady)
        {
            _highlightedHtml = System.Web.HttpUtility.HtmlEncode(display);
            return;
        }

        try
        {
            var result = await Highlight.HighlightAsync(display, Language);
            _highlightedHtml = result ?? System.Web.HttpUtility.HtmlEncode(display);
        }
        catch
        {
            _highlightedHtml = System.Web.HttpUtility.HtmlEncode(display);
        }
    }

    private void UpdateLineNumbers()
    {
        if (!LineNumbers) return;
        var lines = _displayValue.Split('\n').Length;
        _lineNumbersText = string.Join('\n', Enumerable.Range(1, lines));
    }

    public override async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsReady && !ReadOnly)
            {
                await Highlight.DetachEditorSyncAsync(_textarea);
                if (SmartEditing) await Highlight.DisableEditorKeysAsync(_textarea);
            }
        }
        catch { /* ignored */ }
        await _suggestLayer.ReleaseAsync(Overlay);
        await base.DisposeAsync();
    }
}
