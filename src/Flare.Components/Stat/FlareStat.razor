@namespace Flare.Components
@inherits FlareComponentBase

@* One metric, not its surface: a tile is this inside a FlareCard, a row of tiles is a FlareGrid of those.
   The group's name reads the metric the way a sighted reader takes it in - "Revenue: 1,200 USD". *@
<div class="@BuildCssClass(_sizeClass)" style="@Style" role="group" aria-label="@AccessibleName"
     @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <div class="@Css.Classes.Stat.Icon" aria-hidden="true">
            <FlareIconView Value="@Icon" />
        </div>
    }
    <div class="@Css.Classes.Stat.Body">
        @if (!string.IsNullOrEmpty(Label))
        {
            <span class="@Css.Classes.Stat.Label">@Label</span>
        }
        <div class="@Css.Classes.Stat.ValueRow">
            <span class="@Css.Classes.Stat.Value">@Value</span>
            @if (!string.IsNullOrEmpty(Unit))
            {
                <span class="@Css.Classes.Stat.Unit">@Unit</span>
            }
            @if (!string.IsNullOrEmpty(Delta))
            {
                <span class="@Css.Classes.Stat.Delta"
                      style="@(DeltaColor.CssValue is { } color ? $"color:{color}" : null)">@Delta</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Caption))
        {
            <span class="@Css.Classes.Stat.Caption">@Caption</span>
        }
    </div>
</div>

@code {
    /// <summary>What the metric measures, shown above the value and used as the start of the accessible name.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The metric's value, already formatted: number format, culture and rounding are the caller's.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Unit shown after the value in a smaller type, such as <c>USD</c>, <c>%</c> or <c>ms</c>.</summary>
    [Parameter] public string? Unit { get; set; }

    /// <summary>Icon shown in a tonal square before the label and value. Decorative: hidden from assistive technology.</summary>
    [Parameter] public FlareIcon? Icon { get; set; }

    /// <summary>Change since the previous period, shown after the value, with its sign as the caller writes it
    /// (for example <c>+12%</c> or <c>-3</c>).</summary>
    [Parameter] public string? Delta { get; set; }

    /// <summary>Color of <see cref="Delta"/>: a role such as <c>FlareColor.Success</c>, <c>Warning</c>, <c>Error</c>
    /// or <c>Info</c> says whether the change is good or bad; a custom color is also accepted. By default the
    /// change uses the muted text color.</summary>
    [Parameter] public FlareColor DeltaColor { get; set; } = FlareColor.Default;

    /// <summary>Supporting line below the value, such as the period or the source of the figure.</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>Size of the value's type: <see cref="FlareSize.Sm"/>, <see cref="FlareSize.Md"/> (default) or
    /// <see cref="FlareSize.Lg"/>. Extra sizes map to the nearest of the three.</summary>
    [Parameter] public FlareSize Size { get; set; } = FlareSize.Md;

    protected override string ComponentCssClass => Css.Classes.Stat.Root;

    private string _sizeClass => Size switch
    {
        FlareSize.Xs or FlareSize.Sm => Css.Classes.Stat.SizeSm,
        FlareSize.Lg or FlareSize.Xl => Css.Classes.Stat.SizeLg,
        _ => Css.Classes.Stat.SizeMd,
    };

    private string AccessibleName
    {
        get
        {
            var value = string.IsNullOrEmpty(Unit) ? Value : $"{Value} {Unit}";
            return string.IsNullOrEmpty(Label) ? value ?? string.Empty : $"{Label}: {value}";
        }
    }
}
