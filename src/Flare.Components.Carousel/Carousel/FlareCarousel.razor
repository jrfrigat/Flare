@namespace Flare.Components
@typeparam TItem
@inherits FlareComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Keyboard navigation is registered by flare-carousel.js: a key from the root or from one of the
   carousel's own controls moves the slides, a key from a field or editor inside a slide stays there. *@
<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes"
     role="region" aria-roledescription="carousel" aria-label="@(FlareStrings.Carousel_Label)"
     tabindex="0"
     @ref="_root"
     @onmouseenter="PauseAutoPlay"
     @onmouseleave="ResumeAutoPlay">
    <div class="@Css.Classes.Carousel.Viewport"
         @onpointerdown="OnPointerDown"
         @onpointerup="OnPointerUp"
         @ontouchstart="OnTouchStart"
         @ontouchend="OnTouchEnd">
        <div class="@Css.Classes.Carousel.Track"
             style="--_carousel-index:@(_current.ToString(System.Globalization.CultureInfo.InvariantCulture))">
            @if (Items != null && ItemTemplate != null)
            {
                @foreach (var item in Items)
                {
                    <div class="@Css.Classes.Carousel.Slide">@ItemTemplate(item)</div>
                }
            }
        </div>
    </div>

    @if (ShowArrows && _count > 1)
    {
        <button type="button" class="@Css.Classes.Carousel.Arrow @Css.Classes.Carousel.ArrowPrev"
                data-flare-carousel-control
                @onclick="Prev"
                aria-label="@(FlareStrings.Carousel_Prev)"
                disabled="@(!Loop && _current == 0)">
            <FlareIconView Value="@FlareIcons.ChevronLeft" />
        </button>
        <button type="button" class="@Css.Classes.Carousel.Arrow @Css.Classes.Carousel.ArrowNext"
                data-flare-carousel-control
                @onclick="Next"
                aria-label="@(FlareStrings.Carousel_Next)"
                disabled="@(!Loop && _current >= _count - 1)">
            <FlareIconView Value="@FlareIcons.ChevronRight" />
        </button>
    }

    @if (ShowDots && _count > 1)
    {
        <div class="@Css.Classes.Carousel.Dots" role="tablist">
            @for (int i = 0; i < _count; i++)
            {
                var idx = i;
                <button type="button" class="@Css.Classes.Carousel.Dot @(_current == idx ? Css.Classes.Carousel.DotActive : "")"
                        data-flare-carousel-control
                        @onclick="@(() => GoTo(idx))"
                        role="tab"
                        aria-selected="@(_current == idx ? "true" : "false")"
                        aria-label="@(string.Format(FlareStrings.Carousel_GoToSlide, idx + 1))">
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Data items to render as carousel slides.</summary>
    [Parameter] public IReadOnlyList<TItem>? Items { get; set; }
    /// <summary>Template used to render each slide's content.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }
    /// <summary>Automatically advances slides on a timer.</summary>
    [Parameter] public bool AutoPlay { get; set; }
    /// <summary>Milliseconds between automatic slide advances.</summary>
    [Parameter] public int AutoPlayIntervalMs { get; set; } = 4000;
    /// <summary>Shows previous and next navigation arrow buttons.</summary>
    [Parameter] public bool ShowArrows { get; set; } = true;
    /// <summary>Shows dot indicators for direct slide navigation.</summary>
    [Parameter] public bool ShowDots { get; set; } = true;
    /// <summary>Wraps from the last slide back to the first.</summary>
    [Parameter] public bool Loop { get; set; } = true;

    protected override string ComponentCssClass => Css.Classes.Carousel.Root;

    private int _current;
    private int _count => Items?.Count ?? 0;
    private System.Threading.Timer? _timer;
    private int _timerInterval;
    private bool _paused;
    private double _dragStartX;
    private ElementReference _root;
    private IJSObjectReference? _keyboardModule;
    private DotNetObjectReference<FlareCarousel<TItem>>? _keyboardRef;
    private bool _keyboardRegistered;

    // The reading direction the theme publishes; the same signal FlareThemeProvider writes to dir.
    private bool IsRtl => Theme?.IsRtl == true;

    protected override void OnParametersSet()
    {
        if (_count == 0) _current = 0;
        else if (_current >= _count) _current = _count - 1;
        else if (_current < 0) _current = 0;

        if (AutoPlay && _count > 1)
        {
            if (_timer == null || _timerInterval != AutoPlayIntervalMs)
            {
                _timer?.Dispose();
                _timerInterval = AutoPlayIntervalMs;
                _timer = new System.Threading.Timer(_ => InvokeAsync(() =>
                {
                    if (_paused) return;
                    Next();
                    StateHasChanged();
                }), null, AutoPlayIntervalMs, AutoPlayIntervalMs);
            }
        }
        else if (_timer != null)
        {
            _timer.Dispose();
            _timer = null;
        }
    }

    private void Prev()
    {
        if (_count == 0) return;
        _current = Loop ? (_current - 1 + _count) % _count : Math.Max(0, _current - 1);
    }

    private void Next()
    {
        if (_count == 0) return;
        _current = Loop ? (_current + 1) % _count : Math.Min(_count - 1, _current + 1);
    }

    private void GoTo(int idx) => _current = _count == 0 ? 0 : Math.Clamp(idx, 0, _count - 1);

    private void PauseAutoPlay() => _paused = true;
    private void ResumeAutoPlay() => _paused = false;

    // A key the carousel's own listener has claimed: it came from the root or from a carousel control.
    // Arrows follow the side the reader sees the neighbouring slide on: in RTL the next slide is to the
    // left, so ArrowLeft advances and ArrowRight goes back.
    [JSInvokable]
    public void OnCarouselKey(string key)
    {
        if (key == "ArrowLeft") { if (IsRtl) Next(); else Prev(); }
        else if (key == "ArrowRight") { if (IsRtl) Prev(); else Next(); }
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPointerDown(PointerEventArgs e) => _dragStartX = e.ClientX;

    private void OnPointerUp(PointerEventArgs e) => ApplySwipe(_dragStartX - e.ClientX);

    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0) _dragStartX = e.Touches[0].ClientX;
    }

    private void OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length > 0)
            ApplySwipe(_dragStartX - e.ChangedTouches[0].ClientX);
    }

    private void ApplySwipe(double delta)
    {
        if (Math.Abs(delta) <= 40) return;
        // Positive delta means the pointer travelled left. That reveals the next slide in LTR, while in
        // RTL the next slide waits on the right, so the same gesture goes back there.
        if (IsRtl) delta = -delta;
        if (delta > 0) Next();
        else Prev();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _keyboardModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Flare.Components.Carousel/js/flare-carousel.js");
            _keyboardRef = DotNetObjectReference.Create(this);
            await _keyboardModule.InvokeVoidAsync("registerKeyboard", _root, _keyboardRef);
            _keyboardRegistered = true;
        }
        catch (InvalidOperationException) { }
        catch (JSException) { }
    }

    public override async ValueTask DisposeAsync()
    {
        if (_keyboardModule is not null)
        {
            try
            {
                if (_keyboardRegistered) await _keyboardModule.InvokeVoidAsync("unregisterKeyboard", _root);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (InvalidOperationException) { }
            try { await _keyboardModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        _keyboardRef?.Dispose();
        _timer?.Dispose();
        await base.DisposeAsync();
    }
}
