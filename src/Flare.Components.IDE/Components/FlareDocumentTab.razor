@namespace Flare.Components.IDE
@using Microsoft.AspNetCore.Components.Rendering
@inherits FlareComponentBase
@implements IDisposable

@{
    var active = Tabs.IsTabActive(this);
    _visited |= active;
}
@if (!Tabs.StripOnly && (active || ShouldKeepAlive))
{
    <div class="@Css.Classes.Ide.DocTabs.Panel" id="@PanelId" role="tabpanel"
         aria-labelledby="@TabButtonId" @attributes="AdditionalAttributes" hidden="@(!active)">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private FlareDocumentTabs Tabs { get; set; } = default!;

    /// <summary>Stable document key used for selection, closing and ordering. Set it for dynamically rendered documents.</summary>
    [Parameter] public string? Key { get; set; }

    /// <summary>Text displayed when no custom header is supplied. Also labels the tab for accessibility and the overflow menu.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>Icon shown in the tab header - any provider. Defaults to the built-in description icon.</summary>
    [Parameter] public FlareIcon? Icon { get; set; } = FlareIcons.Description;

    /// <summary>Non-interactive content displayed in place of the visible title. Supply <see cref="Title"/>
    /// as the accessible name and overflow label. <see cref="Icon"/> is rendered separately.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Whether the document has unsaved changes (shows a dot/asterisk indicator).</summary>
    [Parameter] public bool Modified { get; set; }

    /// <summary>Whether the tab can be closed by the user.</summary>
    [Parameter] public bool Closeable { get; set; } = true;

    /// <summary>Content rendered inside the document panel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override string ComponentCssClass => Css.Classes.Ide.DocTabs.Panel;

    internal string TabId { get; } = Guid.NewGuid().ToString("N")[..8];
    internal string EffectiveKey => string.IsNullOrEmpty(Key) ? TabId : Key;
    internal ElementReference Header { get; set; }
    internal string PanelId => $"flare-doc-panel-{TabId}";

    // The tab strip labels the panel, so both ends of that link are built here. The panel used to have
    // no label at all, which leaves a tab panel unnamed to a screen reader.
    internal string TabButtonId => $"flare-doc-tab-{TabId}";

    private (string?, string, FlareIcon?, bool, bool, bool)? _registration;
    private RenderFragment? _renderHeader;
    private event Action? HeaderChanged;
    private bool _visited;
    internal bool ShouldKeepAlive => Tabs.KeepAlive && _visited;

    internal RenderFragment RenderHeader => _renderHeader ??= builder =>
    {
        builder.OpenComponent<HeaderPresenter>(0);
        builder.AddComponentParameter(1, nameof(HeaderPresenter.Tab), this);
        builder.CloseComponent();
    };

    protected override void OnParametersSet()
    {
        var registration = (Key, Title, Icon, HeaderContent is not null, Modified, Closeable);
        if (_registration == registration)
        {
            HeaderChanged?.Invoke();
            return;
        }

        _registration = registration;
        Tabs.Register(this);
    }

    // Refresh the fragment without rendering the strip again. Rendering the strip can reevaluate
    // the tab declarations and pass a new Razor closure back to this tab.
    private sealed class HeaderPresenter : ComponentBase, IDisposable
    {
        [Parameter, EditorRequired] public FlareDocumentTab Tab { get; set; } = default!;

        public HeaderPresenter() { }

        protected override void OnInitialized() => Tab.HeaderChanged += StateHasChanged;

        protected override void BuildRenderTree(RenderTreeBuilder builder) =>
            builder.AddContent(0, Tab.HeaderContent);

        public void Dispose() => Tab.HeaderChanged -= StateHasChanged;
    }

    public void Dispose()
    {
        Tabs.Unregister(this);
    }

    /// <inheritdoc />
    public override async ValueTask DisposeAsync()
    {
        Dispose();
        await base.DisposeAsync();
    }
}
