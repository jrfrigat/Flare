@namespace Flare.Components.IDE
@inherits FlareComponentBase
@implements IDisposable

@{
    var active = Tabs.IsTabActive(this);
    _visited |= active;
}
@if (!Tabs.StripOnly && (active || ShouldKeepAlive))
{
    <div class="@Css.Classes.Ide.DocTabs.Panel" id="@PanelId" role="tabpanel"
         aria-labelledby="@TabButtonId" @attributes="AdditionalAttributes" hidden="@(!active)">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private FlareDocumentTabs Tabs { get; set; } = default!;

    /// <summary>Stable document key used for selection, closing and ordering. Set it for dynamically rendered documents.</summary>
    [Parameter] public string? Key { get; set; }

    /// <summary>Display title for the document tab.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>Icon shown in the tab header - any provider. Defaults to the built-in description icon.</summary>
    [Parameter] public FlareIcon? Icon { get; set; } = FlareIcons.Description;

    /// <summary>Optional status icon shown between <see cref="Icon"/> and the title, for example the
    /// connection state of a document.</summary>
    [Parameter] public FlareIcon? StatusIcon { get; set; }

    /// <summary>Whether the document has unsaved changes (shows a dot/asterisk indicator).</summary>
    [Parameter] public bool Modified { get; set; }

    /// <summary>Whether the tab can be closed by the user.</summary>
    [Parameter] public bool Closeable { get; set; } = true;

    /// <summary>Content rendered inside the document panel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override string ComponentCssClass => Css.Classes.Ide.DocTabs.Panel;

    internal string TabId { get; } = Guid.NewGuid().ToString("N")[..8];
    internal string EffectiveKey => string.IsNullOrEmpty(Key) ? TabId : Key;
    internal ElementReference Header { get; set; }
    internal string PanelId => $"flare-doc-panel-{TabId}";

    // The tab strip labels the panel, so both ends of that link are built here. The panel used to have
    // no label at all, which leaves a tab panel unnamed to a screen reader.
    internal string TabButtonId => $"flare-doc-tab-{TabId}";

    private (string?, string, FlareIcon?, FlareIcon?, bool, bool)? _registration;
    private bool _visited;
    internal bool ShouldKeepAlive => Tabs.KeepAlive && _visited;

    protected override void OnParametersSet()
    {
        var registration = (Key, Title, Icon, StatusIcon, Modified, Closeable);
        if (_registration == registration) return;
        _registration = registration;
        Tabs.Register(this);
    }

    public void Dispose()
    {
        Tabs.Unregister(this);
    }

    /// <inheritdoc />
    public override async ValueTask DisposeAsync()
    {
        Dispose();
        await base.DisposeAsync();
    }
}
