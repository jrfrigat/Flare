@namespace Flare.Components.IDE
@inherits FlareLocalizedComponentBase

<FlareDragContext TPayload="string" OnDrop="HandleDropAsync" OnDragStart="BeginDrag"
                  OnDragEnd="EndDrag" CanDrop="AllowsDrop" KeyboardReorder="false">
    <div class="@BuildCssClass(_guideClass)" style="@Style" tabindex="-1" @attributes="AdditionalAttributes">
        <div class="@DockCss.Canvas" id="@_canvasId" @ref="_canvas" style="@_geometry.Style"
             data-flare-dock-adaptive-tabs="@(AdaptiveTabCompression || AdaptiveTabCompressionForGroup is not null ? "" : null)">
            @foreach (var entry in _geometry.Entries)
            {
                if (entry.Split is { } split)
                {
                    <div @key="entry.Id" class="@DockCss.Splitter" style="@entry.Style">
                        @if (MayRequest(DockAction.Resize, null, split.Key))
                        {
                            <FlareSplitter Orientation="@(split.Axis == DockAxis.Horizontal
                                    ? FlareSplitter.SplitterOrientation.Horizontal : FlareSplitter.SplitterOrientation.Vertical)"
                                Size="@($"{_gutter}px")" Value="@entry.Size"
                                MinSize="@Pixels(entry.Min)" MaxSize="@Pixels(entry.Max)"
                                ValueScope="@($"#{_canvasId}")" ValueVariable="@DockGeometry.Preview(entry.Id)"
                                OnSizeChanged="@(value => ResizeAsync(entry, value))" />
                        }
                    </div>
                }
                else if (entry.Item is { } key && entry.Group is { } owner && _catalog.TryGetValue(key, out var item))
                {
                    <section @key="PanelId(key)" id="@PanelId(key)" role="tabpanel" tabindex="0"
                             aria-labelledby="@TabId(key)" hidden="@(owner.ActiveKey != key)"
                             class="@DockCss.Pane" style="@entry.Style" data-flare-dock-pane>
                        @if (owner.ActiveKey == key || item.KeepAlive && _activated.Contains(key))
                        {
                            @ContentTemplate?.Invoke(item)
                        }
                    </section>
                }
                else if (entry.Group is { } group)
                {
                    var adaptiveTabs = AdaptiveTabCompressionForGroup?.Invoke(group) ?? AdaptiveTabCompression;
                    <header @key="entry.Id" id="@HeaderId(group.Key)" data-flare-dock-header="@entry.Id"
                            class="@DockCss.Header @Css.Classes.Tabs.Root @Css.Classes.Tabs.BarOnly"
                            data-flare-dock-fit-enabled="@(adaptiveTabs ? "" : null)"
                            style="@entry.Style" tabindex="-1">
                        <FlareScroller Class="@Css.Classes.Tabs.BarWrap" HeaderEnd="@(UseTabContextMenu ? null : GroupActions(group))">
                        <ChildContent>
                        <FlareDropZone Target="@ZoneId(group.Key, "row")" Placement="DropPlacement.Between"
                                       Class="@DockCss.TabZone">
                            <div role="tablist" aria-label="@TabListLabel(group)" class="@DockCss.Tabs @Css.Classes.Tabs.Bar"
                                 data-flare-dock-tabs data-flare-reveal-active>
                                @foreach (var tabKey in group.Items)
                                {
                                    var tab = _catalog[tabKey];
                                    <FlareDraggable @key="tabKey" Id="@DragId(tabKey)" Payload="@tabKey"
                                                    Class="@($"{DockCss.TabWrap} {Css.Classes.Tabs.TabButton} {(group.ActiveKey == tabKey ? Css.Classes.Tabs.TabActive : null)}")">
                                        <button type="button" class="@DockCss.Tab" role="tab" id="@TabId(tabKey)"
                                                aria-label="@tab.Title" title="@(adaptiveTabs ? tab.Title : null)"
                                                aria-controls="@PanelId(tabKey)"
                                                aria-selected="@(group.ActiveKey == tabKey ? "true" : "false")"
                                                aria-haspopup="@(UseTabContextMenu ? "menu" : null)"
                                                @oncontextmenu="TabContextMenuHandler(tabKey)"
                                                @oncontextmenu:preventDefault="@UseTabContextMenu"
                                                data-flare-dock-has-icon="@(adaptiveTabs && tab.Icon is not null ? "" : null)"
                                                tabindex="@TabIndex(group, tabKey)" @onclick="() => ActivateAsync(group, tabKey)"
                                                @onkeydown="args => TabKeyAsync(args, group, tabKey)">
                                            <span @onclick="() => { }" @onclick:stopPropagation="true">
                                                <FlareDragHandle Class="@DockCss.Grip">&#x22EE;</FlareDragHandle>
                                            </span>
                                            @if (TabTemplate is { } template)
                                            {
                                                @if (adaptiveTabs)
                                                {
                                                    @if (tab.Icon is not null)
                                                    {
                                                        <span class="@DockCss.CompactIcon" hidden><FlareIconView Value="tab.Icon" /></span>
                                                    }
                                                    <span class="@DockCss.Label @Css.Classes.Tabs.Label">
                                                        <span class="@DockCss.TabTemplate">@template(tab)</span>
                                                        @if (tab.Icon is null)
                                                        {
                                                            <span class="@DockCss.CompactTitle" hidden>@tab.Title</span>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    @template(tab)
                                                }
                                            }
                                            else
                                            {
                                                @if (tab.Icon is not null)
                                                {
                                                    <FlareIconView Value="tab.Icon" />
                                                }
                                                <span class="@DockCss.Label @Css.Classes.Tabs.Label">
                                                    @if (adaptiveTabs)
                                                    {
                                                        <span>@tab.Title</span>
                                                    }
                                                    else
                                                    {
                                                        @tab.Title
                                                    }
                                                </span>
                                                @if (tab.BadgeDot)
                                                {
                                                    <span class="@Css.Classes.Tabs.Badge @Css.Classes.Tabs.BadgeDot @tab.BadgeColor.CssClass" style="@tab.BadgeColor.StyleMainOn()"></span>
                                                }
                                                else if (!string.IsNullOrEmpty(tab.Badge))
                                                {
                                                    <span class="@Css.Classes.Tabs.Badge @tab.BadgeColor.CssClass" style="@tab.BadgeColor.StyleMainOn()">@tab.Badge</span>
                                                }
                                            }
                                            @if (TabMarkerTemplate is { } markers)
                                            {
                                                @markers(tab)
                                            }
                                        </button>
                                        @if (TabActionsTemplate is { } actions)
                                        {
                                            <div class="@DockCss.TabActions">@actions(tab)</div>
                                        }
                                    </FlareDraggable>
                                }
                            </div>
                        </FlareDropZone>
                        </ChildContent>
                        </FlareScroller>
                    </header>
                }
            }
            @foreach (var entry in _geometry.Entries.Where(item => item.Group is not null && item.Item is null))
            {
                var group = entry.Group!;
                var targetsId = ZoneId(group.Key, "targets");
                <div @key="targetsId" class="@DockCss.Targets" style="@BodyStyle(entry.Id)" aria-hidden="true">
                    @foreach (var zone in BodyZones.Where(AllowsZone))
                    {
                        <FlareDropZone @key="zone" Target="@ZoneId(group.Key, zone)" Class="@DockCss.Target"
                                       data-flare-dock-zone="@zone" />
                    }
                </div>
            }
            <span role="status" class="@DockCss.Status">@_status</span>
        </div>
        @if (UseTabContextMenu)
        {
            <FlareMenu @ref="_tabContextMenu" Class="@DockCss.TabMenu" AriaLabel="@Text("Dock_Actions")"
                       OnToggle="TabContextMenuToggled">
                @if (_contextTab is { } key && _index.Owners.TryGetValue(key, out var group))
                {
                    var hasActions = false;
                    @foreach (var action in TabActions(group, key))
                    {
                        hasActions = true;
                        <FlareMenuItem OnClick="action.Invoke">@action.Label</FlareMenuItem>
                    }
                    @if (CanCloseTab(group, key))
                    {
                        @if (hasActions)
                        {
                            <FlareMenuSeparator />
                        }
                        <FlareMenuItem OnClick="() => CloseAsync(group, key)">@CloseTabLabel(key)</FlareMenuItem>
                    }
                }
            </FlareMenu>
        }
    </div>
</FlareDragContext>

@code {
    private RenderFragment GroupActions(DockGroup group) => @<text>
        @if (group.ActiveKey is { } active)
        {
            <button type="button" class="@DockCss.Control" aria-label="@Text("Dock_Actions")"
                    id="@ActionsToggleId(group.Key)" aria-expanded="@(_openActions == group.Key ? "true" : "false")"
                    aria-controls="@ActionsId(group.Key)" data-flare-dock-actions-toggle
                    @onclick="() => ToggleActions(group.Key)">&#x22EF;</button>
            @if (_openActions == group.Key)
            {
                <div class="@DockCss.Actions" role="group" aria-label="@Text("Dock_Actions")"
                     id="@ActionsId(group.Key)" data-flare-dock-actions @onkeydown="ActionsKeyAsync">
                    @foreach (var action in TabActions(group, active))
                    {
                        <button type="button" @onclick="action.Invoke">@action.Label</button>
                    }
                </div>
            }
            @if (CanCloseTab(group, active))
            {
                <button type="button" class="@DockCss.Control" aria-label="@CloseTabLabel(active)"
                        @onclick="() => CloseAsync(group, active)">&#x00D7;</button>
            }
        }
    </text>;
}
