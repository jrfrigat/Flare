@namespace Flare.Components.IDE
@inherits FlareLocalizedComponentBase

<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes">
    <div class="@Css.Classes.Ide.DocTabs.Strip">
        @if (_overflowing && OverflowBehavior == TabOverflowBehavior.Scroll)
        {
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" Disabled="@_atStart"
                         AriaLabel="@CoreText["Tabs_ScrollBack"]" OnClick="@(() => ScrollAsync(-1))">
                <FlareIconView Value="FlareIcons.ChevronLeft" />
            </FlareButton>
        }
        <div class="@Css.Classes.Ide.DocTabs.Bar" @ref="_bar" role="tablist" aria-label="@Text["DocTabs_Label"]"
             data-flare-reveal-active="" data-flare-tab-reorder="@(Reorderable ? "true" : null)">
            @foreach (var tab in OrderedTabs)
            {
                @if (ContextMenuContent is not null)
                {
                    <FlareMenu @key="tab" Activation="MenuActivation.RightClick">
                        <Activator Context="menu">@RenderTab(tab, menu.Open)</Activator>
                        <ChildContent>@ContextMenuContent(tab.EffectiveKey)</ChildContent>
                    </FlareMenu>
                }
                else
                {
                    @RenderTab(tab, null)
                }
            }
        </div>
        @if (_overflowing && OverflowBehavior == TabOverflowBehavior.Scroll)
        {
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" Disabled="@_atEnd"
                         AriaLabel="@CoreText["Tabs_ScrollForward"]" OnClick="@(() => ScrollAsync(1))">
                <FlareIconView Value="FlareIcons.ChevronRight" />
            </FlareButton>
        }
        else if (_overflowing && OverflowBehavior == TabOverflowBehavior.Dropdown)
        {
            <FlareMenu>
                <Activator Context="menu">
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                                 AriaLabel="@Text["DocTabs_Hidden"]" @attributes="menu.Attributes">
                        <FlareIconView Value="FlareIcons.ExpandMore" />
                    </FlareButton>
                </Activator>
                <ChildContent>
                    @foreach (var tab in OrderedTabs)
                    {
                        <FlareMenuItem @key="tab" OnClick="@(() => ActivateAsync(tab, focus: false))">@tab.Title</FlareMenuItem>
                    }
                </ChildContent>
            </FlareMenu>
        }
    </div>
</div>

<div class="@Css.Classes.Ide.DocTabs.Panels">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private RenderFragment RenderTab(FlareDocumentTab tab, bool? menuOpen) => @<div
        @key="tab" @ref="tab.Header" class="@TabClass(tab)" id="@tab.TabButtonId"
        role="tab" tabindex="@(IsTabActive(tab) ? 0 : -1)" aria-selected="@(IsTabActive(tab) ? "true" : "false")"
        aria-label="@(tab.Modified ? $"{tab.Title} ({Text["DocTabs_Modified"]})" : tab.Title)"
        aria-controls="@(IsTabActive(tab) || tab.ShouldKeepAlive ? tab.PanelId : null)"
        aria-haspopup="@(menuOpen.HasValue ? "menu" : null)"
        aria-expanded="@(menuOpen.HasValue ? menuOpen.Value ? "true" : "false" : null)"
        aria-keyshortcuts="@(Reorderable ? "Alt+ArrowLeft Alt+ArrowRight" : null)"
        data-closeable="@(tab.Closeable ? "true" : null)"
        data-flare-doc-key="@(Dockable ? tab.EffectiveKey : null)"
        draggable="@((Reorderable || Dockable) ? "true" : null)"
        @onclick="@(() => ActivateAsync(tab, focus: false))"
        @onkeydown="@(e => HandleFallbackAsync(tab, e))"
        @ondragstart="@(() => BeginDrag(tab))" @ondragend="@EndDrag"
        @ondragover:preventDefault="@Reorderable" @ondrop="@(() => DropAsync(tab))">
        @if (tab.Icon is not null)
        {
            <FlareIconView Value="tab.Icon" Class="@Css.Classes.Ide.DocTabs.Icon" />
        }
        <span class="@Css.Classes.Ide.DocTabs.Label">@tab.Title</span>
        @if (tab.Modified)
        {
            <span class="@Css.Classes.Ide.DocTabs.Modified" aria-label="@Text["DocTabs_Modified"]">*</span>
        }
        @if (DockTargets is { Count: > 0 } && OnDockRequested.HasDelegate)
        {
            <span class="@Css.Classes.Ide.DocTabs.Move" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <FlareMenu>
                    <Activator Context="dockMenu">
                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" @attributes="dockMenu.Attributes"
                                     AriaLabel="@($"{Text["Dock_Move"]}: {tab.Title}")">
                            <FlareIconView Value="FlareIcons.ExpandMore" />
                        </FlareButton>
                    </Activator>
                    <ChildContent>
                        @foreach (var target in DockTargets!)
                        {
                            <FlareMenuItem @key="target" OnClick="@(() => RequestDockAsync(tab, target))">@target.Label</FlareMenuItem>
                        }
                    </ChildContent>
                </FlareMenu>
            </span>
        }
        @if (tab.Closeable)
        {
            <button type="button" class="@Css.Classes.Ide.DocTabs.Close" @onclick="@(() => CloseAsync(tab))"
                    @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"
                    aria-label="@($"{Text["DocTabs_Close"]}: {tab.Title}")">
                <FlareIconView Value="FlareIcons.Close" Size="0.875rem" />
            </button>
        }
    </div>;
}
