@namespace Flare.Components.IDE
@inherits FlareLocalizedComponentBase
@implements IAsyncDisposable

@* The layout cascades itself so hosted FlareToolPanel components can route their collapse to it.
   A collapsed (or auto-hidden) region renders only a thin rail and frees its docked space.
   Docked, expanded regions get a drag-resize divider between them and the document. *@
<CascadingValue Value="this">
    <div class="@Css.Classes.Ide.Layout.Root" style="@_rootStyle" @attributes="AdditionalAttributes">
        @if (Ribbon is not null)
        {
            <div class="@Css.Classes.Ide.Layout.Ribbon">
                @Ribbon
            </div>
        }
        @if (MenuBar is not null)
        {
            <div class="@Css.Classes.Ide.Layout.MenuBar">
                @MenuBar
            </div>
        }
        <div class="@Css.Classes.Ide.Layout.Body" data-flare-ide-docking="@(Docking ? "true" : null)">
            @if (Docking)
            {
                @foreach (var region in DocumentRegions)
                {
                    if (region == IdeDocumentRegion.Center && CenterDockHeader is not null)
                    {
                        <div class="@Css.Classes.Ide.Layout.CenterHeader" data-region="@region">@CenterDockHeader</div>
                    }
                    else if (region == IdeDocumentRegion.Center
                        ? ShowCenterDockStrip
                        : RegionShowsDockStrip(region))
                    {
                        @RenderDockTabs(region)
                    }
                }
            }
            @if (LeftToolPanel is not null || Docking)
            {
                <div class="@PanelClass(ToolPanelPosition.Left, Css.Classes.Ide.Layout.PanelLeft)">
                    @if (LeftCollapsed)
                    {
                        @RenderRail(ToolPanelPosition.Left)
                    }
                    else
                    {
                        <div class="@Css.Classes.Ide.Layout.PanelBody" inert="@ToolContentCovered(IdeDocumentRegion.Left)">@LeftToolPanel</div>
                    }
                </div>
            }
            @if (ShowResizer(ToolPanelPosition.Left))
            {
                @RenderResizer(ToolPanelPosition.Left)
            }
            <div class="@Css.Classes.Ide.Layout.Main" inert="@ToolContentCovered(IdeDocumentRegion.Center)">
                <div class="@Css.Classes.Ide.Layout.Content">
                    @ChildContent
                </div>
            </div>
            @if (ShowResizer(ToolPanelPosition.Right))
            {
                @RenderResizer(ToolPanelPosition.Right)
            }
            @if (RightToolPanel is not null || Docking)
            {
                <div class="@PanelClass(ToolPanelPosition.Right, Css.Classes.Ide.Layout.PanelRight)">
                    @if (RightCollapsed)
                    {
                        @RenderRail(ToolPanelPosition.Right)
                    }
                    else
                    {
                        <div class="@Css.Classes.Ide.Layout.PanelBody" inert="@ToolContentCovered(IdeDocumentRegion.Right)">@RightToolPanel</div>
                    }
                </div>
            }
            @if (Documents is not null)
            {
                @foreach (var document in Documents)
                {
                    <div @key="document.Key" class="@Css.Classes.Ide.Layout.Document" data-region="@document.Region"
                         hidden="@(!DocumentVisible(document))">
                        @if (DocumentContentMounted(document))
                        {
                            @DocumentContent?.Invoke(document)
                        }
                    </div>
                }
            }
        </div>
        @if (ShowResizer(ToolPanelPosition.Bottom))
        {
            @RenderResizer(ToolPanelPosition.Bottom)
        }
        @if (BottomPanel is not null)
        {
            <div class="@PanelClass(ToolPanelPosition.Bottom, Css.Classes.Ide.Layout.Bottom)">
                @if (BottomCollapsed)
                {
                    @RenderRail(ToolPanelPosition.Bottom)
                }
                else
                {
                    <div class="@Css.Classes.Ide.Layout.PanelBody">@BottomPanel</div>
                }
            </div>
        }
        @if (StatusBar is not null)
        {
            <div class="@Css.Classes.Ide.Layout.StatusBar">
                @StatusBar
            </div>
        }
    </div>
</CascadingValue>

@code {
    private Microsoft.Extensions.Localization.IStringLocalizer<IdeStrings> IdeText => Localizer<IdeStrings>();
    private RenderFragment RenderResizer(ToolPanelPosition position) =>@<FlareSplitter
        Class="@Css.Classes.Ide.Layout.Resizer"
        data-region="@position"
        Orientation="@(position == ToolPanelPosition.Bottom ? FlareSplitter.SplitterOrientation.Vertical : FlareSplitter.SplitterOrientation.Horizontal)"
        Value="@SizePx(position)" ValueTarget="@SizeTarget(position)" ValueVariable="@SizeVariable(position)"
        ValueScope="@($".{Css.Classes.Ide.Layout.Root}")" Reverse="@(position != ToolPanelPosition.Left)"
        MinSize="@($"{MinPanelSize}px")" MaxSize="85%" KeyboardStep="8" KeyboardLargeStep="24" ShowStepButtons="false"
        OnSizeChanged="@(size => ResizePanel(position.ToString(), ParsePx(size, MinPanelSize)))" />;

    private RenderFragment RenderRail(ToolPanelPosition position) =>@<button type="button" class="@RailClass(position)"
            @onclick="@(() => SetCollapsedAsync(position, false))" aria-label="@IdeText["Layout_ExpandPanel"].Value"
            @ondragover:preventDefault="@(DocumentRegionOf(position) is not null)"
            @ondragenter="@(() => SetRailDropTarget(position, true))"
            @ondragleave="@(() => SetRailDropTarget(position, false))"
            @ondrop="@(() => DropOnRailAsync(position))">
        <FlareIconView Value="RailIcon(position)" />
        @foreach (var title in TitlesOf(position))
        {
            <span class="@Css.Classes.Ide.Layout.RailTitle">@title</span>
        }
    </button>;

    private RenderFragment RenderDockTabs(IdeDocumentRegion region) => @<div
        class="@Css.Classes.Ide.Layout.DockTabs" data-region="@region"
        role="group" aria-label="@IdeText[$"Dock_{region}"]"
        @ondragover:preventDefault="true" @ondrop="@(() => DropDocumentAsync(region))">
        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" aria-pressed="@(ActiveDocument(region) is null ? "true" : "false")"
                     OnClick="@(() => SelectDocumentAsync(region, null))">@IdeText[$"Dock_{region}"]</FlareButton>
        @foreach (var document in Documents!.Where(doc => doc.Region == region))
        {
            if (DocumentContextMenu is null)
            {
                @RenderDockTab(document, region, null)
            }
            else
            {
                <FlareMenu @key="document.Key" Activation="MenuActivation.RightClick" PositionAtCursor="true"
                           AriaLabel="@document.Title">
                    <Activator Context="menu">@RenderDockTab(document, region, menu)</Activator>
                    <ChildContent>@DocumentContextMenu(document)</ChildContent>
                </FlareMenu>
            }
        }
    </div>;

    private RenderFragment RenderDockTab(IdeDocument document, IdeDocumentRegion region,
        FlareMenuActivatorContext? menu) => @<div @key="document.Key" class="@Css.Classes.Ide.Layout.DockTab">
        <button type="button" class="@Css.Classes.Ide.Layout.DockSelect" @ref="_documentHeaders[document.Key]"
                draggable="@(OnDocumentMove.HasDelegate ? "true" : null)"
                aria-pressed="@(ActiveDocument(region) == document.Key ? "true" : "false")"
                aria-label="@(document.Modified ? $"{document.Title} ({IdeText["DocTabs_Modified"]})" : document.Title)"
                @attributes="menu?.Attributes ?? EmptyAttributes"
                @onclick="@(() => SelectDocumentAsync(region, document.Key))"
                @ondragstart="@(() => BeginDocumentDrag(document.Key))" @ondragend="@EndDocumentDrag">
            @document.Title
            @if (document.Modified)
            {
                <span class="@Css.Classes.Ide.Layout.DockModified" aria-hidden="true">*</span>
            }
        </button>
        @if (OnDocumentMove.HasDelegate)
        {
            <FlareMenu>
                <Activator Context="moveMenu">
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" @attributes="moveMenu.Attributes"
                                 AriaLabel="@($"{IdeText["Dock_Move"]}: {document.Title}")">
                        <FlareIconView Value="FlareIcons.ExpandMore" />
                    </FlareButton>
                </Activator>
                <ChildContent>
                    @foreach (var destination in DocumentRegions)
                    {
                        if (destination == region) continue;
                        <FlareMenuItem OnClick="@(() => RequestDocumentMoveAsync(document, destination))">
                            @IdeText[$"Dock_{destination}"]
                        </FlareMenuItem>
                    }
                </ChildContent>
            </FlareMenu>
        }
        @if (document.Closeable && OnDocumentCloseRequested.HasDelegate)
        {
            <button type="button" class="@Css.Classes.Ide.Layout.DockClose"
                    @onclick="@(() => RequestDocumentCloseAsync(document))"
                    @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"
                    aria-label="@($"{IdeText["DocTabs_Close"]}: {document.Title}")">
                <FlareIconView Value="FlareIcons.Close" Size="0.875rem" />
            </button>
        }
    </div>;

    private static readonly IReadOnlyDictionary<string, object> EmptyAttributes = new Dictionary<string, object>();
}
