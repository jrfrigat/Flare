@namespace Flare.Components.IDE
@inherits FlareLocalizedComponentBase
@implements IAsyncDisposable

@* The layout cascades itself so hosted FlareToolPanel components can route their collapse to it.
   A collapsed (or auto-hidden) region renders only a thin rail and frees its docked space.
   Docked, expanded regions get a drag-resize divider between them and the document. *@
<CascadingValue Value="this">
    <div class="@Css.Classes.Ide.Layout.Root" style="@_rootStyle"
         data-flare-ide-dock-scope="@_dockScopeId" @attributes="AdditionalAttributes">
        @if (Ribbon is not null)
        {
            <div class="@Css.Classes.Ide.Layout.Ribbon">
                @Ribbon
            </div>
        }
        @if (MenuBar is not null)
        {
            <div class="@Css.Classes.Ide.Layout.MenuBar">
                @MenuBar
            </div>
        }
        <div class="@BodyClass()" data-flare-ide-docking="@(Docking ? "true" : null)">
            @if (Docking)
            {
                @RenderRegionDock(IdeDocumentRegion.Left)
                @RenderRegionDock(IdeDocumentRegion.Center)
                @RenderRegionDock(IdeDocumentRegion.Right)
            }
            @if (LeftRegionVisible && (LeftToolPanel is not null || Docking))
            {
                <div class="@PanelClass(ToolPanelPosition.Left, Css.Classes.Ide.Layout.PanelLeft)">
                    @if (UsesPerToolBody(ToolPanelPosition.Left))
                    {
                        @RenderToolSlot(ToolPanelPosition.Left)
                        <div class="@Css.Classes.Ide.Layout.PanelBody" hidden="@LeftCollapsed"
                             @ref="_panelBodies[ToolPanelPosition.Left]"
                             inert="@ToolContentCovered(IdeDocumentRegion.Left)"
                             @ondragover:preventDefault="@Docking"
                             @ondrop="@(() => DropOnToolPanelAsync(ToolPanelPosition.Left))">@LeftToolPanel</div>
                    }
                    else if (LeftCollapsed)
                    {
                        @RenderRail(ToolPanelPosition.Left)
                    }
                    else
                    {
                        <div class="@Css.Classes.Ide.Layout.PanelBody"
                             @ref="_panelBodies[ToolPanelPosition.Left]"
                             inert="@ToolContentCovered(IdeDocumentRegion.Left)"
                             @ondragover:preventDefault="@Docking"
                             @ondrop="@(() => DropOnToolPanelAsync(ToolPanelPosition.Left))">@LeftToolPanel</div>
                    }
                </div>
            }
            @if (ShowResizer(ToolPanelPosition.Left))
            {
                @RenderResizer(ToolPanelPosition.Left)
            }
            <div class="@Css.Classes.Ide.Layout.Main" inert="@ToolContentCovered(IdeDocumentRegion.Center)">
                <div class="@Css.Classes.Ide.Layout.Content">
                    @ChildContent
                </div>
            </div>
            @if (ShowResizer(ToolPanelPosition.Right))
            {
                @RenderResizer(ToolPanelPosition.Right)
            }
            @if (RightRegionVisible && (RightToolPanel is not null || Docking))
            {
                <div class="@PanelClass(ToolPanelPosition.Right, Css.Classes.Ide.Layout.PanelRight)">
                    @if (UsesPerToolBody(ToolPanelPosition.Right))
                    {
                        @RenderToolSlot(ToolPanelPosition.Right)
                        <div class="@Css.Classes.Ide.Layout.PanelBody" hidden="@RightCollapsed"
                             @ref="_panelBodies[ToolPanelPosition.Right]"
                             inert="@ToolContentCovered(IdeDocumentRegion.Right)"
                             @ondragover:preventDefault="@Docking"
                             @ondrop="@(() => DropOnToolPanelAsync(ToolPanelPosition.Right))">@RightToolPanel</div>
                    }
                    else if (RightCollapsed)
                    {
                        @RenderRail(ToolPanelPosition.Right)
                    }
                    else
                    {
                        <div class="@Css.Classes.Ide.Layout.PanelBody"
                             @ref="_panelBodies[ToolPanelPosition.Right]"
                             inert="@ToolContentCovered(IdeDocumentRegion.Right)"
                             @ondragover:preventDefault="@Docking"
                             @ondrop="@(() => DropOnToolPanelAsync(ToolPanelPosition.Right))">@RightToolPanel</div>
                    }
                </div>
            }
            @if (Documents is not null)
            {
                @foreach (var document in Documents)
                {
                    if (!RegionVisible(document.Region))
                    {
                        continue;
                    }
                    <div @key="document.Key" class="@Css.Classes.Ide.Layout.Document" data-region="@document.Region"
                         hidden="@(!DocumentVisible(document))">
                        @if (DocumentContentMounted(document))
                        {
                            @DocumentContent?.Invoke(document)
                        }
                    </div>
                }
            }
        </div>
        @if (ShowResizer(ToolPanelPosition.Bottom))
        {
            @RenderResizer(ToolPanelPosition.Bottom)
        }
        @if (BottomPanel is not null)
        {
            <div class="@PanelClass(ToolPanelPosition.Bottom, Css.Classes.Ide.Layout.Bottom)">
                @if (ShowsRail(ToolPanelPosition.Bottom))
                {
                    @RenderRail(ToolPanelPosition.Bottom)
                }
                @if (!BottomCollapsed)
                {
                    <div class="@BottomBodyClass()" @ref="_panelBodies[ToolPanelPosition.Bottom]">
                        @if (HasBottomHeader)
                        {
                            <div class="@Css.Classes.Ide.Layout.BottomHeader">
                                @if (BottomHeaderContent is not null)
                                {
                                    <div class="@Css.Classes.Ide.Layout.BottomHeaderContent">@BottomHeaderContent</div>
                                }
                                @if (ShowBottomPin || ShowBottomCollapse)
                                {
                                    <div class="@Css.Classes.Ide.Layout.BottomHeaderActions" role="toolbar"
                                         aria-label="@IdeText["BottomPanel_Actions"].Value">
                                        @if (ShowBottomPin)
                                        {
                                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                                                         OnClick="ToggleBottomPinAsync"
                                                         AriaPressed="@BottomPinned"
                                                         AriaLabel="@IdeText["BottomPanel_Pin"].Value">
                                                <FlareIconView Value="FlareIcons.PushPin" Size="1rem"
                                                               Class="@(BottomPinned
                                                                   ? Css.Classes.Ide.Layout.BottomPinIcon
                                                                   : $"{Css.Classes.Ide.Layout.BottomPinIcon} {Css.Classes.Ide.Layout.BottomPinUnpinned}")" />
                                            </FlareButton>
                                        }
                                        @if (ShowBottomCollapse)
                                        {
                                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                                                         OnClick="@(() => SetCollapsedAsync(ToolPanelPosition.Bottom, true))"
                                                         AriaLabel="@IdeText["ToolPanel_Collapse"].Value">
                                                <FlareIconView Value="FlareIcons.ExpandMore" Size="1rem" />
                                            </FlareButton>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="@Css.Classes.Ide.Layout.BottomContent">@BottomPanel</div>
                        }
                        else
                        {
                            @BottomPanel
                        }
                    </div>
                }
            </div>
        }
        @if (StatusBar is not null)
        {
            <div class="@Css.Classes.Ide.Layout.StatusBar">
                @StatusBar
            </div>
        }
    </div>
</CascadingValue>

@code {
    private Microsoft.Extensions.Localization.IStringLocalizer<IdeStrings> IdeText => Localizer<IdeStrings>();
    private RenderFragment RenderResizer(ToolPanelPosition position) =>@<FlareSplitter
        Class="@Css.Classes.Ide.Layout.Resizer"
        data-region="@position"
        Orientation="@(position == ToolPanelPosition.Bottom ? FlareSplitter.SplitterOrientation.Vertical : FlareSplitter.SplitterOrientation.Horizontal)"
        Value="@SizePx(position)" ValueTarget="@SizeTarget(position)" ValueVariable="@SizeVariable(position)"
        ValueScope="@($".{Css.Classes.Ide.Layout.Root}")" Reverse="@(position != ToolPanelPosition.Left)"
        MinSize="@($"{MinPanelSize}px")" MaxSize="85%" KeyboardStep="8" KeyboardLargeStep="24" ShowStepButtons="false"
        OnSizeChanged="@(size => ResizePanel(position.ToString(), ParsePx(size, MinPanelSize)))" />;

    private RenderFragment RenderRail(ToolPanelPosition position) =>@<button type="button" class="@RailClass(position)"
            @ref="_regionRails[position]"
            @onclick="@(() => ToggleRailAsync(position))"
            aria-label="@(IsCollapsed(position) ? IdeText["Layout_ExpandPanel"].Value : IdeText["ToolPanel_Collapse"].Value)"
            @ondragover:preventDefault="@(DocumentRegionOf(position) is not null)"
            @ondragenter="@(() => RailDragEnter(position))"
            @ondragleave="@(() => RailDragLeave(position))"
            @ondrop="@(() => DropOnRailAsync(position))">
        <FlareIconView Value="RailIcon(position)" />
        @foreach (var title in TitlesOf(position))
        {
            <span class="@Css.Classes.Ide.Layout.RailTitle">@title</span>
        }
    </button>;

    // The rail slot of a per-tool side region is always present so the body beside it keeps its
    // place in the render tree. It is empty while the region is expanded and docked, the region
    // button until the mode is known or when the region hosts no tool group, and the per-tool
    // entries in an auto-hide region with tools.
    private RenderFragment RenderToolSlot(ToolPanelPosition position)
    {
        if (!ShowsRail(position))
        {
            return @<div class="@Css.Classes.Ide.Layout.ToolRail" hidden="true" aria-hidden="true"></div>;
        }
        if (RendersToolRail(position))
        {
            return RenderToolRail(position);
        }
        if (RegionModeKnown(position))
        {
            return RenderRail(position);
        }
        return @<div class="@Css.Classes.Ide.Layout.ToolRail" aria-hidden="true"></div>;
    }

    private RenderFragment RenderToolRail(ToolPanelPosition position) => @<div
        class="@ToolRailClass(position)" role="group"
        @ref="_toolRails[position]"
        aria-label="@IdeText[$"Dock_{DocumentRegionOf(position)}"].Value"
        @ondragover:preventDefault="true"
        @ondragenter="@(() => RailDragEnter(position))"
        @ondragleave="@(() => RailDragLeave(position))"
        @ondrop="@(() => DropOnRailAsync(position))">
        @foreach (var tool in RailToolsOf(position))
        {
            <button @key="tool.Panel" type="button" class="@ToolRailEntryClass(position, tool)"
                    @ref="_railEntries[tool.Panel]"
                    aria-pressed="@(IsActiveRailTool(position, tool) ? "true" : "false")"
                    data-flare-tool-key="@tool.Key"
                    @onclick="@(() => SelectRailToolAsync(position, tool))">
                @if (tool.Icon is not null)
                {
                    <FlareIconView Value="tool.Icon" Size="1rem" />
                }
                <span class="@Css.Classes.Ide.Layout.RailTitle">@ToolRailLabel(tool)</span>
            </button>
        }
    </div>;

    // Each region has its own fixed call site, so a strip that appears or disappears (a side
    // document arriving or leaving) cannot shift the sibling frames that follow it: dropping the
    // strip out of a shared loop position remounted the hosted tool panels.
    private RenderFragment RenderRegionDock(IdeDocumentRegion region)
    {
        if (!RegionVisible(region)) return EmptyFragment;
        if (region == IdeDocumentRegion.Center && CenterDockHeader is not null)
        {
            return @<div class="@Css.Classes.Ide.Layout.CenterHeader" data-region="@region">@CenterDockHeader</div>;
        }
        var showsStrip = region == IdeDocumentRegion.Center
            ? ShowCenterDockStrip
            : RegionShowsDockStrip(region);
        return showsStrip ? RenderDockTabs(region) : EmptyFragment;
    }

    private RenderFragment RenderDockTabs(IdeDocumentRegion region) => @<div
        class="@Css.Classes.Ide.Layout.DockTabs" data-region="@region"
        role="group" aria-label="@IdeText[$"Dock_{region}"]"
        @ondragover:preventDefault="true" @ondrop="@(() => DropDocumentAsync(region))">
        @if (region == IdeDocumentRegion.Center || ActiveDocument(region) is not null)
        {
            @RenderDockCaption(region)
        }
        @foreach (var document in Documents!.Where(doc => doc.Region == region))
        {
            if (DocumentContextMenu is null)
            {
                @RenderDockTab(document, region, null)
            }
            else
            {
                <FlareMenu @key="document.Key" Activation="MenuActivation.RightClick" PositionAtCursor="true"
                           AriaLabel="@document.Title">
                    <Activator Context="menu">@RenderDockTab(document, region, menu)</Activator>
                    <ChildContent>@DocumentContextMenu(document)</ChildContent>
                </FlareMenu>
            }
        }
    </div>;

    // The built-in strips never paint a region caption. The Center strip keeps the control that
    // returns from a covering document to the main content. A side strip exists only while the
    // region has documents, and its compact control appears only while one of them covers the tool
    // group - the row never reserves space for an idle control. The localized region name stays the
    // accessible name in both cases.
    private RenderFragment RenderDockCaption(IdeDocumentRegion region)
    {
        if (region == IdeDocumentRegion.Center)
        {
            return @<FlareIconButton Icon="FlareIcons.Description" Variant="ButtonVariant.Text"
                                     Size="ButtonSize.Xs" AriaLabel="@IdeText[$"Dock_{region}"].Value"
                                     AriaPressed="@(ActiveDocument(region) is null)"
                                     OnClick="@(() => SelectDocumentAsync(region, null))" />;
        }

        return @<FlareIconButton Icon="FlareIcons.ViewColumn" Variant="ButtonVariant.Text"
                                 Size="ButtonSize.Xs" AriaLabel="@IdeText[$"Dock_{region}"].Value"
                                 Tooltip="@IdeText[$"Dock_{region}"].Value"
                                 OnClick="@(() => SelectDocumentAsync(region, null))" />;
    }

    private RenderFragment RenderDockTab(IdeDocument document, IdeDocumentRegion region,
        FlareMenuActivatorContext? menu) => @<div @key="document.Key" class="@Css.Classes.Ide.Layout.DockTab">
        <button type="button" class="@Css.Classes.Ide.Layout.DockSelect" @ref="_documentHeaders[document.Key]"
                draggable="@(OnDocumentMove.HasDelegate ? "true" : null)"
                aria-pressed="@(ActiveDocument(region) == document.Key ? "true" : "false")"
                aria-label="@(document.Modified ? $"{document.Title} ({IdeText["DocTabs_Modified"]})" : document.Title)"
                @attributes="menu?.Attributes ?? EmptyAttributes"
                @onclick="@(() => SelectDocumentAsync(region, document.Key))"
                @ondragstart="@(() => BeginDocumentDrag(document.Key))" @ondragend="@EndDocumentDrag">
            @document.Title
            @if (document.Modified)
            {
                <span class="@Css.Classes.Ide.Layout.DockModified" aria-hidden="true">*</span>
            }
        </button>
        @if (OnDocumentMove.HasDelegate)
        {
            <FlareMenu>
                <Activator Context="moveMenu">
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" @attributes="moveMenu.Attributes"
                                 AriaLabel="@($"{IdeText["Dock_Move"]}: {document.Title}")">
                        <FlareIconView Value="FlareIcons.ExpandMore" />
                    </FlareButton>
                </Activator>
                <ChildContent>
                    @foreach (var destination in DocumentRegions)
                    {
                        if (destination == region) continue;
                        <FlareMenuItem OnClick="@(() => RequestDocumentMoveAsync(document, destination))">
                            @IdeText[$"Dock_{destination}"]
                        </FlareMenuItem>
                    }
                </ChildContent>
            </FlareMenu>
        }
        @if (document.Closeable && OnDocumentCloseRequested.HasDelegate)
        {
            <button type="button" class="@Css.Classes.Ide.Layout.DockClose"
                    @onclick="@(() => RequestDocumentCloseAsync(document))"
                    @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"
                    aria-label="@($"{IdeText["DocTabs_Close"]}: {document.Title}")">
                <FlareIconView Value="FlareIcons.Close" Size="0.875rem" />
            </button>
        }
    </div>;

    private static readonly IReadOnlyDictionary<string, object> EmptyAttributes = new Dictionary<string, object>();
    private static readonly RenderFragment EmptyFragment = _ => { };
}
