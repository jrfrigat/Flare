@namespace Flare.Components.IDE
@inherits FlareLocalizedComponentBase

<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes">
    <FlareStack Row="true" Gap="FlareSpacing.XSmall">
        <div @ref="_capture" data-flare-shortcut-capture="" @onkeydown="CaptureAsync"
             @onfocusin="@BeginCapture" @onfocusout="@CancelCapture" @onpointerdown="@BeginCapture">
            <FlareTextField Label="@FieldLabel" AriaLabel="@FieldAriaLabel" Value="@Value" ReadOnly="true"
                            Placeholder="@Text["Shortcut_Empty"]" Disabled="@Disabled"
                            AriaDescribedBy="@(StatusVisible ? _statusId : null)" />
        </div>
        @if (Compact)
        {
            <FlareIconButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                             Icon="FlareIcons.Close"
                             Tooltip="@Text["Shortcut_Clear"]"
                             AriaLabel="@Text["Shortcut_Clear"]"
                             Disabled="@(Disabled || Value is null)"
                             OnClick="@(() => SetValueAsync(null))" />
        }
        else
        {
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Disabled="@(Disabled || Value is null)"
                         OnClick="@(() => SetValueAsync(null))">@Text["Shortcut_Clear"]</FlareButton>
            @if (ShowReset)
            {
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Disabled="@(Disabled || Value == DefaultValue)"
                             OnClick="@ResetAsync">@Text["Shortcut_Reset"]</FlareButton>
            }
        }
    </FlareStack>
    @if (StatusVisible)
    {
        <FlareText Element="p" Typo="TypographyScale.BodySmall" id="@_statusId" role="status">
            @Text[_message ?? (_recording ? "Shortcut_Record" : "Shortcut_Hint")]
        </FlareText>
    }
</div>
