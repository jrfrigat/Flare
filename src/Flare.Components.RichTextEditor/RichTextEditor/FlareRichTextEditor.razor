@* Requires interactive render mode (not compatible with static SSR). *@
@namespace Flare.Components
@inherits FlareComponentBase
@implements IAsyncDisposable

<div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes">
    <div class="@Css.Classes.Rte.Toolbar">
        @if (ShowHeadings)
        {
            <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("formatBlock", "H1"))" title="Heading 1" aria-label="Heading 1" disabled="@ReadOnly">
                <span style="font-size:.85rem;font-weight:700;">H1</span>
            </button>
            <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("formatBlock", "H2"))" title="Heading 2" aria-label="Heading 2" disabled="@ReadOnly">
                <span style="font-size:.85rem;font-weight:700;">H2</span>
            </button>
            <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("formatBlock", "H3"))" title="Heading 3" aria-label="Heading 3" disabled="@ReadOnly">
                <span style="font-size:.85rem;font-weight:700;">H3</span>
            </button>
            <div class="@Css.Classes.Rte.Separator"></div>
        }
        <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("bold"))" title="Bold" aria-label="Bold" disabled="@ReadOnly">
            <FlareIconView Value="@FlareIcons.FormatBold" />
        </button>
        <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("italic"))" title="Italic" aria-label="Italic" disabled="@ReadOnly">
            <FlareIconView Value="@FlareIcons.FormatItalic" />
        </button>
        <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("underline"))" title="Underline" aria-label="Underline" disabled="@ReadOnly">
            <FlareIconView Value="@FlareIcons.FormatUnderlined" />
        </button>
        <div class="@Css.Classes.Rte.Separator"></div>
        <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("insertUnorderedList"))" title="Bullet list" aria-label="Bullet list" disabled="@ReadOnly">
            <FlareIconView Value="@FlareIcons.FormatListBulleted" />
        </button>
        <button type="button" class="@Css.Classes.Rte.Tool" @onclick="@(() => ExecAsync("insertOrderedList"))" title="Numbered list" aria-label="Numbered list" disabled="@ReadOnly">
            <FlareIconView Value="@FlareIcons.FormatListNumbered" />
        </button>
        @if (ShowLink)
        {
            <div class="@Css.Classes.Rte.Separator"></div>
            <button type="button" class="@Css.Classes.Rte.Tool @(_showLinkInput ? Css.Classes.Rte.ToolActive : "")"
                    @onclick="ToggleLinkInput"
                    title="Insert link" aria-label="Insert link" disabled="@ReadOnly">
                <FlareIconView Value="@FlareIcons.Link" />
            </button>
            @if (_showLinkInput)
            {
                <div class="@Css.Classes.Rte.LinkInputWrap">
                    <input class="@Css.Classes.Rte.LinkInput"
                           type="url"
                           placeholder="https://..."
                           @bind="_linkUrl"
                           @onkeydown="HandleLinkKeyDown" />
                    <button type="button" class="@Css.Classes.Rte.Tool" @onclick="InsertLinkAsync" title="Apply" aria-label="Apply link">
                        <FlareIconView Value="@FlareIcons.Check" />
                    </button>
                </div>
            }
        }
    </div>
    @* contenteditable is rendered here rather than set from the init script. Out of JS it was
       unconditional, so ReadOnly only greyed the toolbar while the surface still took typing and still
       raised ValueChanged; and anything the script sets is absent for the first paint and has to be
       re-pushed by hand whenever the parameter changes. As an attribute it is right from the first
       frame and a re-render is the whole of the runtime sync.

       aria-readonly is spelled out rather than bound to the bool: a bool lands in the DOM as an empty
       attribute, and `aria-readonly=""` is not `true` - the accessibility tree read the read-only
       example as settable. *@
    <div id="@_editorId"
         class="@Css.Classes.Rte.Content"
         role="textbox"
         aria-multiline="true"
         aria-label="@(Label ?? FlareStrings.RTE_Label)"
         contenteditable="@(ReadOnly ? "false" : "true")"
         aria-readonly="@(ReadOnly ? "true" : "false")"
         data-placeholder="@(Placeholder ?? FlareStrings.RTE_Placeholder)"
         style="@_minHeightStyle">
    </div>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>
    /// HTML string representing the current editor content, and the editor's security boundary.
    /// <para>
    /// Whatever is bound here - a stored draft, a server response, a value round-tripped through a
    /// database - is treated as untrusted and filtered against an allowlist before it reaches the page:
    /// formatting, lists, headings, quotes, links and images survive, scripts and event handlers do
    /// not. Pasted markup goes through the same filter. Set <see cref="Sanitize"/> to <c>false</c> only
    /// for markup the application itself produced and has not let a user near.
    /// </para>
    /// <para>
    /// The filtering happens in the browser, on the parsed tree, using the platform's own sanitizer
    /// where the engine has one. That is deliberate: a filter applied to the string in .NET is guessing
    /// at the tree a browser will build from it, and browsers repair malformed markup in ways no
    /// pattern predicts.
    /// </para>
    /// </summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>
    /// Whether <see cref="Value"/> and pasted markup are filtered before being shown. <c>true</c> by
    /// default: an editor whose value survives a round trip through storage is exactly where a script
    /// smuggled into the markup would be executed again on every later view.
    /// <para>
    /// Turning it off is a statement that the markup is trusted, and it is the caller's to make - not a
    /// convenience. The editor's own formatting never needs it: everything the toolbar produces is
    /// inside the allowlist.
    /// </para>
    /// </summary>
    [Parameter] public bool Sanitize { get; set; } = true;
    /// <summary>Callback raised when the editor content changes.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Accessible label for the editor content area.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Minimum CSS height of the editable content area.</summary>
    [Parameter] public string MinHeight { get; set; } = "150px";
    /// <summary>Placeholder text shown when the editor is empty. Defaults to the localized "RTE_Placeholder" string.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Disables editing; content is displayed read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Shows H1/H2/H3 heading buttons in the toolbar.</summary>
    [Parameter] public bool ShowHeadings { get; set; }
    /// <summary>Shows a link-insertion button in the toolbar.</summary>
    [Parameter] public bool ShowLink { get; set; }

    protected override string ComponentCssClass => Css.Classes.Rte.Root;

    private readonly string _editorId = "rte-" + Guid.NewGuid().ToString("N")[..8];
    private string _minHeightStyle => $"min-height:{MinHeight}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<FlareRichTextEditor>? _dotNetRef;
    // The last HTML this component and the editor agreed on. See PushValueIfChangedAsync.
    private string? _lastPushed;

    private bool _showLinkInput;
    private string _linkUrl = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Flare.Components.RichTextEditor/js/richtext.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("init", _editorId, _dotNetRef);
            }

            await PushValueIfChangedAsync();
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>
    /// Sends <see cref="Value"/> to the editor when it differs from what the editor last reported or was
    /// last given. The surface holds the caller's text and a caret inside it, so it is only written when
    /// the value really moved.
    /// <para>
    /// This used to run on the first render alone, which meant the only route from <c>Value</c> to the
    /// DOM closed after the first paint: a controlled binding or a form reset re-rendered the component
    /// and left the old HTML on screen.
    /// </para>
    /// <para>
    /// <c>_lastPushed</c> is what breaks the loop rather than a flag: the editor answers every edit with
    /// <c>OnContentChanged</c>, which sets <c>Value</c>, which would bring the caller's own keystrokes
    /// straight back through here and collapse the caret to the start on every letter.
    /// </para>
    /// </summary>
    private async Task PushValueIfChangedAsync()
    {
        if (_module is null) return;

        var value = Value ?? string.Empty;
        if (string.Equals(value, _lastPushed, StringComparison.Ordinal)) return;

        _lastPushed = value;
        await _module.InvokeVoidAsync(Sanitize ? "setContent" : "setContentUnsafe", _editorId, value);
    }

    private async Task ExecAsync(string command, string? value = null)
    {
        // The toolbar buttons are disabled while read-only, but a command can still arrive from a
        // keyboard shortcut or a caller, and a read-only editor must not be edited by any route.
        if (_module is null || ReadOnly) return;
        try
        {
            await _module.InvokeVoidAsync("execCommand", _editorId, command, value);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private void ToggleLinkInput()
    {
        _showLinkInput = !_showLinkInput;
        if (!_showLinkInput) _linkUrl = string.Empty;
    }

    private async Task InsertLinkAsync()
    {
        var url = _linkUrl?.Trim();
        // Only insert safe URL schemes -- blocks javascript:/data:/vbscript: links that would be
        // stored XSS in the edited HTML. An unsafe or empty URL leaves the input open to be corrected.
        if (string.IsNullOrEmpty(url) || !IsUrlSafe(url))
            return;
        await ExecAsync("insertLink", url);
        _linkUrl = string.Empty;
        _showLinkInput = false;
    }

    // Whitelist of safe URL schemes for an inserted link (relative, fragment, http(s), mailto, tel).
    private static bool IsUrlSafe(string url) =>
        url.StartsWith('/') || url.StartsWith('#')
        || url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        || url.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase)
        || url.StartsWith("tel:", StringComparison.OrdinalIgnoreCase);

    private async Task HandleLinkKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await InsertLinkAsync();
        else if (e.Key == "Escape") ToggleLinkInput();
    }

    [JSInvokable]
    public async Task OnContentChanged(string html)
    {
        // contenteditable="false" already stops typing, so this is the belt to that brace: an input
        // event can still be dispatched programmatically, and a read-only editor must not report a
        // change the caller never allowed.
        if (ReadOnly) return;

        // Recorded before the callback, so the re-render this causes is not read as an external change
        // and does not write the typist's own keystrokes back over the caret.
        _lastPushed = html;
        Value = html;
        await ValueChanged.InvokeAsync(html);
    }

    public override async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("destroy", _editorId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        _dotNetRef?.Dispose();
        await base.DisposeAsync();
    }
}
