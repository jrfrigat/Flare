@namespace Flare.Components
@inherits FlareComponentBase
@using Microsoft.AspNetCore.Components.Web.Virtualization

@* The board no longer owns a drag. It declares one - a context, a zone per column, a draggable per
   card - and the shared model does the rest. What went with it: an HTML5 dragstart/drop pair that fired
   on nothing but a mouse, a hand-written ontouchstart/ontouchend pair to make up for that, a JS
   hit-test helper only this component used, a module import, and a `_dragging` field. *@
<FlareDragContext TPayload="KanbanCard" Group="kanban" OnDrop="MoveCard" KeyboardReorder="@(!ReadOnly)"
                  ResolveItem="ResolveCard">
    <div class="@BuildCssClass()" style="@Style" @attributes="AdditionalAttributes" role="group">
        @if (Columns != null)
        {
            @foreach (var col in Columns)
            {
                var colCards = CardsForColumn(col.Id);
                <FlareDropZone Target="@col.Id"
                               Placement="DropPlacement.Between"
                               Class="@Css.Classes.Kanban.Column"
                               role="region"
                               aria-label="@col.Title">
                    <div class="@Css.Classes.Kanban.ColumnHeader"
                         style="@(col.Color != null ? $"border-top:3px solid {col.Color}" : "")">
                        @if (ColumnTemplate is not null)
                        {
                            @ColumnTemplate(new KanbanColumnTemplateContext(col, colCards))
                        }
                        else
                        {
                            <FlareText Typo="TypographyScale.LabelLarge">@col.Title</FlareText>
                            <span class="@Css.Classes.Kanban.Count" aria-label="@colCards.Count cards">@colCards.Count</span>
                        }
                    </div>
                    <div class="@Css.Classes.Kanban.Cards" role="list">
                        @if (Virtual)
                        {
                            <Virtualize Items="colCards" Context="card" ItemSize="VirtualItemSize"
                                        OverscanCount="OverscanCount">
                                @RenderCard(card)
                            </Virtualize>
                        }
                        else
                        {
                            @foreach (var card in colCards)
                            {
                                @RenderCard(card)
                            }
                        }
                    </div>
                </FlareDropZone>
            }
        }
    </div>
</FlareDragContext>

@code {
    /// <summary>Column definitions that structure the Kanban board.</summary>
    [Parameter] public IReadOnlyList<KanbanColumn>? Columns { get; set; }
    /// <summary>Cards to distribute across the Kanban columns.</summary>
    [Parameter] public IReadOnlyList<KanbanCard>? Cards { get; set; }
    /// <summary>Callback raised when cards are moved between columns.</summary>
    [Parameter] public EventCallback<IReadOnlyList<KanbanCard>> CardsChanged { get; set; }
    /// <summary>Custom content rendered inside each card while Flare retains its surface and drag behavior.</summary>
    [Parameter] public RenderFragment<KanbanCard>? CardTemplate { get; set; }
    /// <summary>Custom content rendered inside each column header while Flare retains the column structure.</summary>
    [Parameter] public RenderFragment<KanbanColumnTemplateContext>? ColumnTemplate { get; set; }
    /// <summary>Disables pointer and keyboard card movement while preserving readable, focusable card content.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Renders only the cards visible in each column, for columns of hundreds of cards. Each column's
    /// card list becomes its own scroll container and the columns stretch to the board's height, so the
    /// board needs a bounded height (for example <c>Style="height:70vh"</c>); without one every card is
    /// visible and nothing is saved. Dragging with a pointer, the drop highlight and auto-scroll work as
    /// without it. Keyboard reordering reaches the cards currently rendered in each column - the visible
    /// ones plus <see cref="OverscanCount"/> on each side - and the end of a column.
    /// </summary>
    [Parameter] public bool Virtual { get; set; }

    /// <summary>Estimated height of one card in pixels, gap included, used by <see cref="Virtual"/> to size
    /// the scroll area before the cards have been measured.</summary>
    [Parameter] public float VirtualItemSize { get; set; } = 72f;

    /// <summary>Number of cards rendered above and below the visible ones when <see cref="Virtual"/> is on.</summary>
    [Parameter] public int OverscanCount { get; set; } = 3;

    protected override string ComponentCssClass =>
        Virtual ? Css.Classes.Kanban.Root + " " + Css.Classes.Kanban.Virtual : Css.Classes.Kanban.Root;

    private List<KanbanCard> _cards = [];

    protected override void OnParametersSet() => _cards = Cards?.ToList() ?? [];

    private List<KanbanCard> CardsForColumn(string colId) =>
        _cards.Where(c => c.ColumnId == colId).ToList();

    private RenderFragment RenderCard(KanbanCard c) => @<text>
        @if (ReadOnly)
        {
            <div @key="c.Id" class="@Css.Classes.Kanban.Card" role="listitem" tabindex="0">
                @RenderCardContent(c)
            </div>
        }
        else
        {
            <FlareDraggable @key="c.Id" Id="@c.Id" Payload="c"
                            Class="@Css.Classes.Kanban.Card" role="listitem">
                @RenderCardContent(c)
            </FlareDraggable>
        }
    </text>;

    private RenderFragment RenderCardContent(KanbanCard c) => @<text>
        @if (CardTemplate is not null)
        {
            @CardTemplate(c)
        }
        else
        {
            @if (c.Tag is not null)
            {
                <span class="@Css.Classes.Kanban.Tag"
                      style="@(c.TagColor != null ? $"background:{c.TagColor}" : "")">@c.Tag</span>
            }
            <FlareText Typo="TypographyScale.BodyMedium">@c.Title</FlareText>
            @if (c.Description is not null)
            {
                <FlareText Typo="TypographyScale.BodySmall"
                           Style="color:var(--flare-color-on-surface-variant);margin-top:0.25rem;">@c.Description</FlareText>
            }
        }
    </text>;

    // A virtualized column disposes the components of cards scrolled out of view, so a card dragged out
    // of the window - or dropped next to one - is no longer a registered draggable. The flat list still
    // has it.
    private bool ResolveCard(string id, out KanbanCard card)
    {
        card = _cards.Find(c => c.Id == id)!;
        return card is not null;
    }

    // Cards live in one flat list and a column is a filter over it, so a move is a remove and an
    // insert at the position the target column's Nth card occupies in that list. The position comes
    // from the card the drop landed beside: the browser's index counts the cards it has rendered, which
    // in a virtualized column start somewhere in the middle. Without a card to land beside, a virtualized
    // column takes the card at its end.
    private async Task MoveCard(FlareDropEventArgs<KanbanCard> e)
    {
        if (ReadOnly)
        {
            return;
        }

        _cards.Remove(e.Payload);
        var moved = e.Payload with { ColumnId = e.TargetId };

        var inColumn = CardsForColumn(e.TargetId);
        var over = e.HasOverPayload && e.Edge != DropEdge.Into ? inColumn.IndexOf(e.OverPayload!) : -1;
        var index = over >= 0
            ? over + (e.Edge == DropEdge.After ? 1 : 0)
            : Virtual ? inColumn.Count : e.Index;
        if (index < 0 || index > inColumn.Count) index = inColumn.Count;
        var insertAt = index < inColumn.Count ? _cards.IndexOf(inColumn[index]) : _cards.Count;

        _cards.Insert(insertAt, moved);
        await CardsChanged.InvokeAsync(_cards.AsReadOnly());
    }
}
