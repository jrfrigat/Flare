@typeparam TItem
@namespace Flare.Components
@inherits FlareComponentBase

@if (Context.Owner.EditorTemplate is { } template) { @template(Context) }
else
{
    <FlareStack Class="@BuildCssClass()" Style="@Style" @attributes="AdditionalAttributes">
        @if (!Context.ScopeOnly)
        {
            <FlareTextField Label="@SchedulerStrings.Title" Value="Context.Draft.Title" ValueChanged="v => Context.Draft = Context.Draft with { Title = v ?? string.Empty }" />
            <FlareCheckbox TValue="bool" Label="@SchedulerStrings.AllDay" @bind-Value="_allDay" />
            @if (_allDay)
            {
                <FlareDatePicker Label="@SchedulerStrings.Start" @bind-Value="_firstDay" Culture="Context.Owner.EffectiveCulture" />
                <FlareDatePicker Label="@SchedulerStrings.End" @bind-Value="_endDay" Culture="Context.Owner.EffectiveCulture" />
            }
            else
            {
                <FlareDateTimePicker Label="@SchedulerStrings.Start" @bind-Value="_start" Culture="Context.Owner.EffectiveCulture" />
                <FlareDateTimePicker Label="@SchedulerStrings.End" @bind-Value="_end" Culture="Context.Owner.EffectiveCulture" />
            }
            <FlareTextField Label="@SchedulerStrings.Description" Value="Context.Draft.Description" ValueChanged="v => Context.Draft = Context.Draft with { Description = v }" />
            @if (Context.Owner.Resources.Count > 0)
            {
                <FlareSelect TValue="string" Label="@SchedulerStrings.Resource" Items="Context.Owner.Resources.Select(r => r.Key)"
                             NullOption="@SchedulerStrings.Unassigned" Value="Context.Draft.ResourceKey"
                             ValueChanged="v => Context.Draft = Context.Draft with { ResourceKey = v }"
                             ItemLabel="key => Context.Owner.Resources.FirstOrDefault(r => r.Key == key)?.Title ?? key" />
            }
        }
        @if (Context.IsRecurring)
        {
            <FlareSelect TValue="SchedulerEditScope" Label="@SchedulerStrings.Scope" @bind-Value="Context.Scope"
                         Items="Enum.GetValues<SchedulerEditScope>()" ItemLabel="ScopeLabel" />
        }
        @if (_message is not null) { <FlareText role="alert">@_message</FlareText> }
        <FlareStack Row="true" Justify="FlareJustifyContent.End">
            <FlareButton OnClick="Context.CancelAsync" Disabled="_saving">@SchedulerStrings.Cancel</FlareButton>
            <FlareButton OnClick="() => Context.SaveAsync()" Disabled="_saving" Variant="ButtonVariant.Filled">
                @(Context.Action == SchedulerEditAction.Delete ? SchedulerStrings.Delete : SchedulerStrings.Save)
            </FlareButton>
        </FlareStack>
    </FlareStack>
}

@code {
    /// <summary>Editor working copy and persistence commands.</summary>
    [Parameter, EditorRequired] public SchedulerEditContext<TItem> Context { get; set; } = default!;
    /// <summary>Dialog handle supplied by the standard Flare dialog provider.</summary>
    [CascadingParameter] public FlareDialogInstance Dialog { get; set; } = default!;
    private bool _allDay, _saving;
    private DateOnly? _firstDay, _endDay;
    private DateTimeOffset? _start, _end;
    private string? _message;
    protected override string ComponentCssClass => Css.Classes.Scheduler.Editor;
    protected override void OnInitialized()
    {
        var data = Context.Draft;
        _allDay = data.AllDay is not null;
        var span = data.AllDay is { } days ? SchedulerClock.Window(days, Context.Owner.TimeZone) : null;
        _start = TimeZoneInfo.ConvertTime(span?.Start ?? data.Start, Context.Owner.TimeZone);
        _end = TimeZoneInfo.ConvertTime(span?.End ?? data.End, Context.Owner.TimeZone);
        _firstDay = data.AllDay?.Start ?? DateOnly.FromDateTime(_start.Value.DateTime);
        _endDay = data.AllDay?.End ?? _firstDay.Value.AddDays(1);
        Context.SaveHandler = SaveAsync;
        Context.CancelHandler = async () => { await Dialog.CancelAsync(); };
    }
    private static string ScopeLabel(SchedulerEditScope scope) => scope switch
    {
        SchedulerEditScope.Following => SchedulerStrings.Following,
        SchedulerEditScope.Series => SchedulerStrings.Series,
        _ => SchedulerStrings.Occurrence
    };
    private async Task<bool> SaveAsync()
    {
        if (_saving) return false;
        _message = null;
        if (!Context.ScopeOnly && Context.Owner.EditorTemplate is null)
        {
            try
            {
                if (_allDay)
                {
                    if (_firstDay is not { } start || _endDay is not { } end || end <= start) throw new ArgumentException();
                    Context.Draft = Context.Draft with { AllDay = new(start, end) };
                }
                else
                {
                    if (_start is not { } start || _end is not { } end) throw new ArgumentException();
                    DateTimeOffset Resolve(DateTimeOffset value) => SchedulerClock.At(DateOnly.FromDateTime(value.DateTime),
                        TimeOnly.FromDateTime(value.DateTime), Context.Owner.TimeZone, value.Offset);
                    Context.Draft = Context.Draft with { AllDay = null, Start = Resolve(start), End = Resolve(end) };
                }
            }
            catch (ArgumentException) { _message = SchedulerStrings.Invalid; StateHasChanged(); return false; }
        }
        var data = Context.Draft;
        if (string.IsNullOrWhiteSpace(data.Title) || (data.AllDay is { } dates ? dates.End <= dates.Start : data.End < data.Start))
        { _message = SchedulerStrings.Invalid; StateHasChanged(); return false; }
        _saving = true;
        try
        {
            var accepted = await Context.Owner.ApplyChangeAsync(Context.Action, Context.Original, data, Context.Scope);
            if (accepted) await Dialog.CloseAsync(data);
            else { _message = SchedulerStrings.Cancelled; StateHasChanged(); }
            return accepted;
        }
        finally { _saving = false; }
    }
}
