@typeparam TItem
@namespace Flare.Components
@inherits FlareSchedulerViewBase<TItem>

<div class="@BuildCssClass(Css.Classes.Scheduler.Timeline)" style="@Style" @attributes="AdditionalAttributes">
<FlareGantt @ref="_timeline" Range="Range" Scale="GanttScale.Hour" Culture="Context.Culture" Virtualize="true"
            AriaLabel="@Context.Owner.AriaLabel">
    <FlareGanttPanel TRow="SchedulerResource" TItem="SchedulerOccurrence<TItem>" Rows="_rows"
                     RowKey="r => r.Key" Items="Context.Occurrences" ItemKey="o => o.Identity"
                     ItemRow="o => o.Data.ResourceKey ?? string.Empty" ItemSpan="o => SchedulerClock.Span(o.Data, Context.Owner.TimeZone)"
                     ItemLabel="o => o.Data.Title" OnItemClick="o => Context.Owner.SelectEventAsync(o)">
        <RowHeader Context="resource">@resource.Title</RowHeader>
        <ItemTemplate Context="occurrence">
            @if (Context.Owner.EventTemplate is { } template) { @template(occurrence) }
            else { @occurrence.Data.Title }
        </ItemTemplate>
    </FlareGanttPanel>
</FlareGantt>
</div>

@code {
    private IReadOnlyList<SchedulerResource> _rows = [];
    private FlareGantt? _timeline;
    private DateOnly? _scrolledDate;
    private GanttSpan Range => new(Context.Window.Dates.Start.ToDateTime(TimeOnly.MinValue), Context.Window.Dates.End.ToDateTime(TimeOnly.MinValue));
    protected override void OnParametersSet()
    {
        var rows = Context.Owner.Resources.ToDictionary(r => r.Key, StringComparer.Ordinal);
        foreach (var key in Context.Occurrences.Select(o => o.Data.ResourceKey ?? string.Empty).Distinct(StringComparer.Ordinal))
            rows.TryAdd(key, new(key, key.Length == 0 ? SchedulerStrings.Unassigned : key));
        _rows = rows.Values.ToArray();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_timeline is not null && _scrolledDate != Context.Date)
        {
            _scrolledDate = Context.Date;
            await _timeline.ScrollTo(Context.Date.ToDateTime(TimeOnly.MinValue));
        }
    }
}
