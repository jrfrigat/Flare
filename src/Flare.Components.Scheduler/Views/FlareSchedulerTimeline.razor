@typeparam TItem
@namespace Flare.Components
@inherits FlareSchedulerViewBase<TItem>

<div class="@BuildCssClass(Css.Classes.Scheduler.Timeline)" style="@Style" @attributes="AdditionalAttributes">
<FlareGantt @ref="_timeline" Range="Range" Scale="GanttScale.Hour" Culture="Context.Culture" Virtualize="true"
            AriaLabel="@Context.AriaLabel">
    <FlareGanttPanel TRow="SchedulerResource" TItem="SchedulerOccurrence<TItem>" Rows="_rows"
                     RowKey="r => r.Key" Items="Context.Occurrences" ItemKey="o => o.Identity"
                     ItemRow="o => o.Data.ResourceKey ?? string.Empty" ItemSpan="o => SchedulerClock.Span(o.Data, Context.TimeZone)"
                     Editable="Context.CanEdit" ScheduleMode="GanttScheduleMode.None" OnChange="ChangeAsync"
                     ItemLabel="o => o.Data.Title" OnItemClick="o => Context.Commands.SelectEventAsync(o)">
        <RowHeader Context="resource">@resource.Title</RowHeader>
        <ItemTemplate Context="occurrence">
            @if (Context.EventTemplate is { } template) { @template(occurrence) }
            else { @occurrence.Data.Title }
        </ItemTemplate>
    </FlareGanttPanel>
</FlareGantt>
</div>

@code {
    private Microsoft.Extensions.Localization.IStringLocalizer<SchedulerStrings> SchedulerText => Localizer<SchedulerStrings>();
    private IReadOnlyList<SchedulerResource> _rows = [];
    private FlareGantt? _timeline;
    private DateOnly? _scrolledDate;
    private GanttSpan Range => new(Context.Window.Dates.Start.ToDateTime(TimeOnly.MinValue), Context.Window.Dates.End.ToDateTime(TimeOnly.MinValue));
    protected override void OnParametersSet()
    {
        var rows = Context.Resources.ToDictionary(r => r.Key, StringComparer.Ordinal);
        foreach (var key in Context.Occurrences.Select(o => o.Data.ResourceKey ?? string.Empty).Distinct(StringComparer.Ordinal))
            rows.TryAdd(key, new(key, key.Length == 0 ? SchedulerText["Unassigned"].Value : key));
        _rows = rows.Values.ToArray();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_timeline is not null && _scrolledDate != Context.Date)
        {
            _scrolledDate = Context.Date;
            await _timeline.ScrollTo(Context.Date.ToDateTime(TimeOnly.MinValue));
        }
    }
    private async Task ChangeAsync(GanttChangeEventArgs args)
    {
        args.Cancel = true;
        var occurrence = Context.Occurrences.FirstOrDefault(o => o.Identity == args.ItemKey);
        var proposed = args.Changes.FirstOrDefault(c => c.ItemKey == args.ItemKey);
        if (occurrence is null || proposed is null) return;
        var data = occurrence.Data;
        if (data.AllDay is not null)
            data = data with { AllDay = new(DateOnly.FromDateTime(proposed.Span.Start), DateOnly.FromDateTime(proposed.Span.End)) };
        else
        {
            if (Context.TimeZone.IsInvalidTime(proposed.Span.Start) || Context.TimeZone.IsInvalidTime(proposed.Span.End)) return;
            DateTimeOffset At(DateTime wall, TimeSpan offset) => SchedulerClock.At(DateOnly.FromDateTime(wall), TimeOnly.FromDateTime(wall), Context.TimeZone, offset);
            data = data with { Start = At(proposed.Span.Start, data.Start.Offset), End = At(proposed.Span.End, data.End.Offset) };
        }
        data = data with { ResourceKey = proposed.RowKey is { } row ? row.Length == 0 ? null : row : data.ResourceKey };
        await Context.Commands.RequestChangeAsync(occurrence, data,
            args.Action == GanttEditAction.Move ? SchedulerEditAction.Move : SchedulerEditAction.Resize);
    }
}
