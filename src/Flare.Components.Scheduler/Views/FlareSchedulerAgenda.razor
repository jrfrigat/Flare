@typeparam TItem
@namespace Flare.Components
@inherits FlareSchedulerViewBase<TItem>

<div class="@BuildCssClass(Css.Classes.Scheduler.Agenda)" style="@Style" @attributes="AdditionalAttributes">
    @if (Context.Occurrences.Count == 0) { <FlareText>@SchedulerStrings.Empty</FlareText> }
    @foreach (var occurrence in Context.Occurrences.OrderBy(e => SchedulerClock.Span(e.Data, Context.Owner.TimeZone).Start))
    {
        <div class="@Css.Classes.Scheduler.AgendaItem" @key="occurrence.Identity">
            <FlareText>@Label(occurrence.Data)</FlareText>
            <FlareSchedulerEvent TItem="TItem" Context="Context" Occurrence="occurrence" />
        </div>
    }
</div>

@code {
    private string Label(SchedulerEventData data) => data.AllDay is { } days
        ? $"{days.Start.ToString("d", Context.Culture)} {SchedulerStrings.AllDay}"
        : TimeZoneInfo.ConvertTime(data.Start, Context.Owner.TimeZone).ToString("g", Context.Culture);
}
