@typeparam TItem
@namespace Flare.Components
@inherits FlareSchedulerViewBase<TItem>
@using Microsoft.JSInterop
@inject Flare.Components.Services.IUiJsService Ui
@inject TimeProvider Clock

@{ _lastDefaultRender = CanReuseRender ? new(Context, Class, Style, Today, LocalizationState) : null; }
<div @ref="_root" class="@RootClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="@Css.Classes.Scheduler.MonthGrid">
        @foreach (var panel in _panels)
        {
            <div class="@Css.Classes.Scheduler.MonthPanel">
                <div class="@Css.Classes.Scheduler.MonthHeader">
                    @if (MonthHeaderTemplate is not null) { @MonthHeaderTemplate(panel.Month) }
                    else { <FlareText Typo="TypographyScale.TitleMedium" aria-live="polite">@MonthTitle(panel.Month)</FlareText> }
                </div>
                <div role="grid" aria-label="@MonthTitle(panel.Month)">
                    <div class="@Css.Classes.Scheduler.MonthWeekdays" role="row">
                        @for (var i = 0; i < 7; i++)
                        {
                            var weekday = (DayOfWeek)(((int)FirstDayOfWeek + i) % 7);
                            <div class="@Css.Classes.Calendar.DayLabel" role="columnheader" aria-label="@Format.GetDayName(weekday)">
                                @if (DayHeaderTemplate is not null) { @DayHeaderTemplate(weekday) }
                                else { @Format.GetShortestDayName(weekday) }
                            </div>
                        }
                    </div>
                    @foreach (var week in panel.Weeks)
                    {
                        <div class="@Css.Classes.Scheduler.MonthWeek" role="row" style="@WeekStyle(week)">
                            <div class="@Css.Classes.Scheduler.MonthBars" role="presentation">
                                @foreach (var bar in week.Bars)
                                {
                                    <div class="@Css.Classes.Scheduler.MonthBar" style="@BarStyle(bar)">
                                        <FlareSchedulerEvent TItem="TItem" Context="Context" Occurrence="bar.Event.Occurrence"
                                                             EventTemplate="EventTemplate"
                                                             TimeText="@(bar.ShowsTime ? bar.Event.TimeText : null)" />
                                    </div>
                                }
                            </div>
                            @for (var d = 0; d < 7; d++)
                            {
                                var date = week.Dates[d];
                                var other = date.Month != panel.Month.Month || date.Year != panel.Month.Year;
                                var selected = SelectedDate == date;
                                <div class="@CellClass(other, date == Today, selected)" role="gridcell"
                                     aria-label="@date.ToString("D", Format)" aria-selected="@(selected ? "true" : "false")"
                                     aria-current="@(date == Today ? "date" : null)" tabindex="0"
                                     @onclick="@(() => SelectDayAsync(date, other))"
                                     @onkeydown="@(e => DayKey(e, date, other))">
                                    @if (DateTemplate is not null) { @DateTemplate(date) }
                                    else { <span class="@Css.Classes.Calendar.DayNum">@date.Day</span> }
                                    <div class="@Css.Classes.Scheduler.MonthCellEvents">
                                        @if (!other)
                                        {
                                            @foreach (var item in week.Days[d])
                                            {
                                                <div class="@EventCssClass(item.Occurrence.Data.Color)"
                                                     style="@item.Occurrence.Data.Color.StyleContainerSolid()"
                                                     @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                    <FlareSchedulerEvent TItem="TItem" Context="Context" Occurrence="item.Occurrence"
                                                                         EventTemplate="EventTemplate" TimeText="@item.TimeText" />
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
