@typeparam TItem
@namespace Flare.Components
@inherits FlareSchedulerViewBase<TItem>

<FlareCalendar Class="@BuildCssClass(Css.Classes.Scheduler.Month)" Style="@Style" @attributes="AdditionalAttributes" ViewDate="Anchor" ShowNavigation="false"
               MonthCount="@(Context.Owner.CurrentView == SchedulerView.Year ? 12 : 1)"
               Culture="Context.Culture" Events="_events" SelectedDateChanged="SelectDayAsync"
               OnEventClick="SelectEventAsync">
    <EventTemplate Context="item">
        @if (Context.Owner.EventTemplate is { } template) { @template(_source[item]) }
        else { @item.Title }
    </EventTemplate>
</FlareCalendar>

@code {
    private readonly Dictionary<CalendarEvent, SchedulerOccurrence<TItem>> _source = new(ReferenceEqualityComparer.Instance);
    private IReadOnlyList<CalendarEvent> _events = [];
    private DateOnly Anchor => Context.Owner.CurrentView == SchedulerView.Year ? new(Context.Date.Year, 1, 1) : Context.Date;
    protected override void OnParametersSet()
    {
        _source.Clear();
        var result = new List<CalendarEvent>();
        foreach (var occurrence in Context.Occurrences)
        {
            var span = SchedulerClock.Span(occurrence.Data, Context.Owner.TimeZone);
            var start = DateOnly.FromDateTime(span.Start);
            var last = DateOnly.FromDateTime(span.End > span.Start ? span.End.AddTicks(-1) : span.End);
            start = start < Context.Window.Dates.Start ? Context.Window.Dates.Start : start;
            last = last >= Context.Window.Dates.End ? Context.Window.Dates.End.AddDays(-1) : last;
            for (var day = start; day <= last; day = day.AddDays(1))
            {
                var item = new CalendarEvent(occurrence.Data.Title, day, occurrence.Data.Color);
                _source.Add(item, occurrence);
                result.Add(item);
            }
        }
        _events = result;
    }
    private Task SelectEventAsync(CalendarEvent item) => Context.Owner.SelectEventAsync(_source[item]);
    private Task SelectDayAsync(DateOnly date)
    {
        var dates = new SchedulerDateRange(date, date.AddDays(1));
        var window = SchedulerClock.Window(dates, Context.Owner.TimeZone);
        return Context.Owner.SelectSlotAsync(new(window.Start, window.End, dates));
    }
}
