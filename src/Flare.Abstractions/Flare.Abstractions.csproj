<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>$(FlareLibTargetFrameworks)</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <PackageId>Flare.Abstractions</PackageId>
    <Description>Flare design-system contracts (ports), design tokens, CSS token/class registry and enums - the dependency-free core every other Flare package builds on.</Description>
    <PackageTags>blazor;components;theming;abstractions;design-tokens;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- An app publishing for WebAssembly trims what it does not use out of this assembly. -->
    <IsTrimmable>true</IsTrimmable>
    <!-- Public API must stay fully XML-documented (drives the generated API docs). -->
    <NoWarn>$(NoWarn.Replace('CS1591',''))</NoWarn>
    <!-- BL0016: the JS interop exception policy is audited in TASK-815; this base class either guards
         the call at a boundary the analyzer cannot see through or lets the caller decide. -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure security utilities (HtmlSanitizer/CssValidator) stay internal; the presentation and
         theming layers consume them directly without widening the public API surface.
         Flare.Infrastructure builds the component-dialog handles (internal ctors on
         FlareDialogInstance / DialogReference) when implementing IDialogService. -->
    <InternalsVisibleTo Include="Flare.Components" />
    <InternalsVisibleTo Include="Flare.Theming" />
    <InternalsVisibleTo Include="Flare.Infrastructure" />
    <!-- The upload queue's state transitions are internal on purpose - an application reads them, it does
         not fabricate them - so the tests that assert on them need the same view the components have. -->
    <InternalsVisibleTo Include="Flare.Components.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
  </ItemGroup>

</Project>
