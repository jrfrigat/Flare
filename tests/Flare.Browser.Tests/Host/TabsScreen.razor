@page "/tabs-fallback"

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main>
        <FlareTabs @bind-ActiveIndex="_active" Reorderable="true">
            <FlareTab Key="one" Label="One" />
            <FlareTab Key="two" Label="Two" />
            <FlareTab Key="three" Label="Three" />
        </FlareTabs>
        <output id="active">@_active</output>
    </main>
</FlareThemeProvider>

@code {
    private int _active;
}
