@page "/disclosure-menu"
@inject IThemeService ThemeService

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main style="padding:8px;max-inline-size:720px">
        <FlareAccordion id="acc" AllowMultiple="true">
            <FlareAccordionPanel Header="@_longHeader">Accordion body</FlareAccordionPanel>
            <FlareAccordionPanel Header="@_hebrewHeader">Hebrew body</FlareAccordionPanel>
        </FlareAccordion>

        <FlareCollapse id="collapse" Header="@_longHeader">Collapse body</FlareCollapse>

        <FlareMenu AriaLabel="Actions" id="menu">
            <Activator>
                <FlareButton @attributes="context.Attributes">Actions</FlareButton>
            </Activator>
            <ChildContent>
                <FlareMenuItem>An item whose label is long enough to fill the row</FlareMenuItem>
                <FlareSubMenu Label="More options">
                    <FlareMenuItem>Nested</FlareMenuItem>
                </FlareSubMenu>
            </ChildContent>
        </FlareMenu>

        <div style="display:flex;gap:8px;margin-block-start:16px">
            <button id="rtl" @onclick="EnableRtl">RTL</button>
            <button id="ltr" @onclick="EnableLtr">LTR</button>
            <button id="fluent" @onclick="UseFluent">Fluent 2</button>
            <button id="md3e" @onclick="UseMd3e">Material 3 Expressive</button>
        </div>
    </main>
</FlareThemeProvider>

@code {
    private const string _longHeader =
        "A deliberately long disclosure header that has to wrap onto a second line so the start edge of every line can be measured in both writing directions";

    // Hebrew, escaped so the source stays ASCII: the same header in a right-to-left script, where a
    // bidi paragraph reorders the run inside every line without moving the line's start edge.
    private const string _hebrewHeader =
        "\u05D4\u05DB\u05D5\u05EA\u05E8\u05EA\u0020\u05D4\u05D0\u05E8\u05D5\u05DB\u05D4\u0020\u05D4\u05D6\u05D0\u05EA\u0020\u05D7\u05D9\u05D9\u05D1\u05EA\u0020\u05DC\u05D4\u05D9\u05E9\u05D1\u05E8\u0020\u05DC\u05E9\u05EA\u05D9\u0020\u05E9\u05D5\u05E8\u05D5\u05EA\u0020\u05DB\u05D3\u05D9\u0020\u05E9\u05D0\u05E4\u05E9\u05E8\u0020\u05D9\u05D4\u05D9\u05D4\u0020\u05DC\u05DE\u05D3\u05D5\u05D3\u0020\u05D0\u05EA\u0020\u05E7\u05E6\u05D4\u0020\u05D4\u05D4\u05EA\u05D7\u05DC\u05D4\u0020\u05E9\u05DC\u0020\u05DB\u05DC\u0020\u05E9\u05D5\u05E8\u05D4\u0020\u05D1\u05E9\u05EA\u05D9\u0020\u05DB\u05D9\u05D5\u05D5\u05E0\u05D9\u0020\u05D4\u05DB\u05EA\u05D9\u05D1\u05D4\u0020\u05D5\u05DC\u05DB\u05DF\u0020\u05D4\u05D9\u05D0\u0020\u05DE\u05DE\u05E9\u05D9\u05DB\u05D4\u0020\u05E2\u05D5\u05D3\u0020\u05E7\u05E6\u05EA\u0020\u05E2\u05DD\u0020\u05DE\u05D9\u05DC\u05D9\u05DD\u0020\u05E0\u05D5\u05E1\u05E4\u05D5\u05EA";

    private Task EnableRtl() => ThemeService.SetRtlAsync(true);
    private Task EnableLtr() => ThemeService.SetRtlAsync(false);
    private Task UseFluent() => ThemeService.SetThemeAsync("fluent2");
    private Task UseMd3e() => ThemeService.SetThemeAsync("md3-expressive");
}
