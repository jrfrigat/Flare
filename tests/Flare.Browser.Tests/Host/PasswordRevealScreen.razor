@page "/password-reveal"

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main style="padding:16px;display:flex;flex-direction:column;gap:16px;align-items:flex-start">
        <FlarePasswordField id="normal" Label="Normal" Value="@_secret" />
        <FlarePasswordField id="readonly" Label="Read only" Value="@_secret" ReadOnly="true" />
        <FlarePasswordField id="disabled" Label="Disabled" Value="@_secret" Disabled="true" />
        <span id="after">after</span>
    </main>
</FlareThemeProvider>

@code {
    private const string _secret = "s3cret";
}
