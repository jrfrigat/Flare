@page "/switch"

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main>
        <div id="ltr">
            <FlareSwitch Value="true" Label="On" />
        </div>
        <div id="rtl" dir="rtl">
            <FlareSwitch Value="true" Label="On" />
        </div>
        <div id="rtl-off" dir="rtl">
            <FlareSwitch Label="Off" />
        </div>
    </main>
</FlareThemeProvider>
