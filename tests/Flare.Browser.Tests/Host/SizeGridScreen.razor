@page "/size-grid"
@using Flare.Abstractions.Tokens

@* One row per size: the same Flare Size step must give a button and a field the same height in the
   theme under test. The rows are read by SizeGridTests through data-size. *@
<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <FlareThemeScope Theme="fluent2" Palette="fluent-blue" Mode="ThemeMode.Light">
        <div id="size-grid-fluent2">@SizeRows</div>
    </FlareThemeScope>
    <FlareThemeScope Theme="md3" Mode="ThemeMode.Light">
        <div id="size-grid-md3">@SizeRows</div>
    </FlareThemeScope>
    <FlareThemeScope Theme="md3-expressive" Mode="ThemeMode.Light">
        <div id="size-grid-md3e">@SizeRows</div>
    </FlareThemeScope>
    <FlareThemeScope Theme="md2" Mode="ThemeMode.Light">
        <div id="size-grid-md2">@SizeRows</div>
    </FlareThemeScope>
    <FlareThemeScope Theme="aero" Mode="ThemeMode.Light">
        <div id="size-grid-aero">@SizeRows</div>
    </FlareThemeScope>
    <FlareThemeScope Theme="liquid-glass" Mode="ThemeMode.Light">
        <div id="size-grid-liquidglass">@SizeRows</div>
    </FlareThemeScope>
    <FlareThemeScope Theme="visualstudio" Mode="ThemeMode.Dark">
        <div id="size-grid-visualstudio">@SizeRows</div>
    </FlareThemeScope>
</FlareThemeProvider>

@code {
    private static readonly RenderFragment SizeRows = @<text>
        <div class="size-row" data-size="xs" style="display:flex;gap:8px;align-items:center;margin:4px 0">
            <FlareButton Size="FlareSize.Xs">Button</FlareButton>
            <FlareSelect TValue="string" Size="FlareSize.Xs" Placeholder="Field" />
        </div>
        <div class="size-row" data-size="sm" style="display:flex;gap:8px;align-items:center;margin:4px 0">
            <FlareButton Size="FlareSize.Sm">Button</FlareButton>
            <FlareSelect TValue="string" Size="FlareSize.Sm" Placeholder="Field" />
        </div>
        <div class="size-row" data-size="md" style="display:flex;gap:8px;align-items:center;margin:4px 0">
            <FlareButton Size="FlareSize.Md">Button</FlareButton>
            <FlareSelect TValue="string" Size="FlareSize.Md" Placeholder="Field" />
        </div>
        <div class="size-row" data-size="lg" style="display:flex;gap:8px;align-items:center;margin:4px 0">
            <FlareButton Size="FlareSize.Lg">Button</FlareButton>
            <FlareSelect TValue="string" Size="FlareSize.Lg" Placeholder="Field" />
        </div>
        <div class="size-row" data-size="xl" style="display:flex;gap:8px;align-items:center;margin:4px 0">
            <FlareButton Size="FlareSize.Xl">Button</FlareButton>
            <FlareSelect TValue="string" Size="FlareSize.Xl" Placeholder="Field" />
        </div>
    </text>;
}
