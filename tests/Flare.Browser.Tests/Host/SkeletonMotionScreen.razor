@page "/skeleton-motion"

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <div style="display:flex;gap:8px;padding:8px">
        <FlareSkeleton id="wave" Width="120px" Height="24px" Animation="SkeletonAnimation.Wave" />
        <FlareSkeleton id="pulse" Width="120px" Height="24px" Animation="SkeletonAnimation.Pulse" />
        <FlareSkeleton id="none" Width="120px" Height="24px" Animation="SkeletonAnimation.None" />
    </div>
</FlareThemeProvider>
