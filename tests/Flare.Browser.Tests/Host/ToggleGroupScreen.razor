@page "/toggle-group"

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main>
        <div id="narrow" style="inline-size:295px;">
            <FlareToggleGroup TValue="string" FullWidth="Full" Size="ButtonSize.Md" id="group">
                <FlareToggleButton Value="@("today")">Today</FlareToggleButton>
                <FlareToggleButton Value="@("week")">This week</FlareToggleButton>
                <FlareToggleButton Value="@("month")">This month and everything before it</FlareToggleButton>
            </FlareToggleGroup>
        </div>
        <FlareToggleGroup TValue="string" MultiSelect="true" id="named" AriaLabel="Text alignment">
            <FlareToggleButton Value="@("left")">Left</FlareToggleButton>
            <FlareToggleButton Value="@("right")">Right</FlareToggleButton>
        </FlareToggleGroup>
    </main>
</FlareThemeProvider>

@code {
    [Parameter, SupplyParameterFromQuery] public bool Full { get; set; }
}
