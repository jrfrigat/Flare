@page "/bottomnav-safe-area"

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <div id="page" style="height:900px;--flare-bottom-nav-bar-height:80px;--flare-bottom-nav-safe-area-padding:34px">
        <FlareBottomNav id="nav" Position="BottomNavPosition.Sticky">
            <FlareBottomNavItem id="item-home" Href="#home">Home</FlareBottomNavItem>
            <FlareBottomNavItem id="item-settings" Href="#settings">Settings</FlareBottomNavItem>
        </FlareBottomNav>
    </div>
</FlareThemeProvider>
