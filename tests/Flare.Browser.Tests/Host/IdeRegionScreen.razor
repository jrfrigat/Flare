@page "/ide-region"
@using Flare.Components.IDE

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main>
        <FlareIdeLayout id="two" Style="height:400px;">
            <ChildContent><p>Document</p></ChildContent>
            <RightToolPanel>
                <FlareToolPanel Title="Properties" Position="ToolPanelPosition.Right"><p id="props">Name</p></FlareToolPanel>
                <FlareToolPanel Title="Screens" Position="ToolPanelPosition.Right">
                    <ul id="screens">
                        @for (var i = 1; i <= 30; i++) { <li>Screen @i</li> }
                    </ul>
                </FlareToolPanel>
            </RightToolPanel>
        </FlareIdeLayout>
        <FlareIdeLayout id="one" Style="height:300px;">
            <ChildContent><p>Document</p></ChildContent>
            <RightToolPanel>
                <FlareToolPanel Title="Properties" Position="ToolPanelPosition.Right"><p>Name</p></FlareToolPanel>
            </RightToolPanel>
        </FlareIdeLayout>
        <FlareIdeLayout id="resize" Height="500px" LeftPanelWidth="180px" RightPanelWidth="18rem" BottomPanelHeight="160px">
            <LeftToolPanel><FlareToolPanel Title="Left" Position="ToolPanelPosition.Left" /></LeftToolPanel>
            <RightToolPanel><FlareToolPanel Title="Right" Position="ToolPanelPosition.Right" /></RightToolPanel>
            <BottomPanel><FlareToolPanel Title="Bottom" Position="ToolPanelPosition.Bottom" /></BottomPanel>
            <ChildContent><button id="rerender" @onclick="() => _renders++">Render @_renders</button></ChildContent>
        </FlareIdeLayout>
    </main>
</FlareThemeProvider>

@code { private int _renders; }
