@page "/stepper"
@inject IThemeService Theme

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main data-ready-theme="@_readyTheme">
        <select aria-label="Theme" @onchange="ChangeTheme">
            @foreach (var theme in Theme.Themes) { <option value="@theme.Id">@theme.Id</option> }
        </select>
        <select aria-label="Width" @bind="_width"><option>280</option><option>900</option></select>
        <select aria-label="Circle size" @bind="_size"><option>24</option><option>32</option><option>48</option></select>
        @foreach (var vertical in new[] { false, true })
        {
            <div data-testid="@(vertical ? "vertical" : "horizontal")" dir="@(Rtl ? "rtl" : "ltr")" style="width:@(_width)px">
                <FlareStepper NonLinear Orientation="@(vertical ? StepperOrientation.Vertical : StepperOrientation.Horizontal)"
                              Style="@($"{Css.Tokens.Stepper.CircleSize}:{_size}px;{Css.Tokens.Stepper.ConnectorThickness}:3px")">
                    <FlareStep Label="@LongLabel" Description="@LongLabel" />
                    <FlareStep Label="@LongWord" Optional />
                    <FlareStep Label="Review" HasError ErrorText="@LongLabel" />
                    <FlareStep Label="OK"><IconContent><span aria-hidden="true">+</span></IconContent></FlareStep>
                </FlareStepper>
            </div>
        }
    </main>
</FlareThemeProvider>

@code {
    [Parameter, SupplyParameterFromQuery] public bool Rtl { get; set; }
    [Parameter, SupplyParameterFromQuery] public bool Russian { get; set; }
    private int _width = 280;
    private int _size = 24;
    private string _readyTheme = "";
    private string LongLabel => Russian
        ? "\u041E\u0447\u0435\u043D\u044C \u0434\u043B\u0438\u043D\u043D\u0430\u044F \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430"
        : "A very long step label for testing wrapping in a narrow container";
    private string LongWord => Russian
        ? "\u0414\u043B\u0438\u043D\u043D\u0430\u044F\u041D\u0435\u0440\u0430\u0437\u0440\u044B\u0432\u043D\u0430\u044F\u041F\u043E\u0434\u043F\u0438\u0441\u044C\u0428\u0430\u0433\u0430\u0412\u0423\u0437\u043A\u043E\u043C\u041A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0435"
        : "AnUnbrokenStepLabelThatMustWrapInsideANarrowContainer";
    private async Task ChangeTheme(ChangeEventArgs e)
    {
        var id = (string)e.Value!;
        await Theme.SetThemeAsync(id);
        _readyTheme = id;
    }
}
