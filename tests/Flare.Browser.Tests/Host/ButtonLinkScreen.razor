@page "/button-link"

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <main style="padding:16px">
        <FlareButton id="pressed-link" Href="#pressed" AriaPressed="true" Selected="true">Pressed link</FlareButton>
        <FlareButton id="unpressed-link" Href="#unpressed" AriaPressed="false">Unpressed link</FlareButton>
        <FlareButton id="disabled-link" Href="#disabled" AriaPressed="true" Disabled="true">Disabled link</FlareButton>
    </main>
</FlareThemeProvider>
