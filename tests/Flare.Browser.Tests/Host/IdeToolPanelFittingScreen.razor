@page "/ide-toolpanel-fitting"
@using Flare.Components.IDE
@using Flare.Icons

<FlareThemeProvider ManageSplash="false" RespectSystemColorScheme="false">
    <div id="fitting" style="width:100%;min-height:420px;display:flex;flex-direction:column;gap:1rem">
        <p id="document">Document</p>
        <div id="top-group" style="width:var(--flare-ide-left-width,400px);max-width:100%;min-width:0">
            <FlareToolPanelGroup Position="ToolPanelPosition.Left">
                <FlareToolPanel Title="Solution Explorer" Key="explorer-top" Icon="@FlareIcons.Folder">
                    <p>Explorer body</p>
                </FlareToolPanel>
                <FlareToolPanel Title="File System" Key="files-top" Icon="@FlareIcons.FolderOpen">
                    <p>Files body</p>
                </FlareToolPanel>
            </FlareToolPanelGroup>
        </div>
        <div id="bottom-group" style="width:100%;max-width:100%;min-width:0">
            <FlareToolPanelGroup Position="ToolPanelPosition.Bottom"
                                 TabStripPlacement="TabStripPlacement.Bottom">
                <FlareToolPanel Title="Solution Explorer" Key="explorer-bottom" Icon="@FlareIcons.Folder">
                    <p>Bottom explorer body</p>
                </FlareToolPanel>
                <FlareToolPanel Title="File System" Key="files-bottom" Icon="@FlareIcons.FolderOpen">
                    <p>Bottom files body</p>
                </FlareToolPanel>
            </FlareToolPanelGroup>
        </div>
    </div>
</FlareThemeProvider>
