@page "/date-ux"
@inject IThemeService Theme
@using Flare.Abstractions.Tokens

<FlareThemeProvider RespectSystemColorScheme="false">
    <main style="padding:16px;max-width:600px" data-ready-theme="@_readyTheme" data-ready-mode="@_readyMode">
        <select aria-label="Theme" @onchange="ChangeTheme">
            @foreach (var theme in Theme.Themes) { <option value="@theme.Id">@theme.Id</option> }
        </select>
        <select aria-label="Mode" @onchange="ChangeMode"><option>Light</option><option>Dark</option></select>
        <button id="before">Before</button>
        <div data-testid="subject">
            <FlareDatePicker Label="Date" @bind-Value="_value" Inline="Inline" PreRenderCalendar="PreRender"
                             ReadOnly="ReadOnly" IsDateDisabled="@(Unavailable ? _ => true : null)"
                             Culture="@(CultureInfo.GetCultureInfo("en-US"))" ShowClearButton="true" />
        </div>
        <output data-testid="value">@_value?.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture)</output>
        <button id="after">After</button>
        <div data-testid="rich-placeholder">
            <FlareDatePicker Placeholder="MM/DD/YYYY"><LabelContent><span>Arrival date</span></LabelContent></FlareDatePicker>
        </div>
        <div data-testid="rich-label">
            <FlareDatePicker Label="Unused label" Placeholder="MM/DD/YYYY"><LabelContent><span>Departure date</span></LabelContent></FlareDatePicker>
        </div>
        <div data-testid="name-fallback"><FlareDatePicker Placeholder="Booking date" /></div>
        <div data-testid="name-override">
            <FlareDatePicker Label="Date" InputAttributes="@(new Dictionary<string,object> { ["aria-label"] = "Custom date" })" />
        </div>
        <div data-testid="outside-states" style="background:var(--flare-picker-panel-bg)">
            <FlareMonthGrid ViewYear="2026" ViewMonth="9" Culture="@(CultureInfo.GetCultureInfo("en-US"))"
                            Today="@(new DateOnly(2026, 10, 3))"
                            Selected="@(day => day == new DateOnly(2026, 10, 1))"
                            Disabled="@(day => day == new DateOnly(2026, 10, 2))"
                            DayClass="@(day => day == new DateOnly(2026, 10, 1) ? Css.Classes.Picker.DaySelected : null)" />
        </div>
    </main>
</FlareThemeProvider>

@code {
    [Parameter, SupplyParameterFromQuery] public bool Inline { get; set; }
    [Parameter, SupplyParameterFromQuery] public bool PreRender { get; set; } = true;
    [Parameter, SupplyParameterFromQuery] public bool ReadOnly { get; set; }
    [Parameter, SupplyParameterFromQuery] public bool Unavailable { get; set; }
    private DateOnly? _value = new(2026,10,15);
    private string _readyTheme = "";
    private string _readyMode = "";
    private async Task ChangeTheme(ChangeEventArgs e)
    {
        var id = (string)e.Value!;
        await Theme.SetThemeAsync(id);
        await Theme.SetPaletteAsync(Theme.Themes.First(theme => theme.Id == id).DefaultPaletteId);
        _readyTheme = id;
    }
    private async Task ChangeMode(ChangeEventArgs e)
    {
        var mode = (string)e.Value!;
        await Theme.SetModeAsync(Enum.Parse<ThemeMode>(mode));
        _readyMode = mode;
    }
}
