<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests that READ the repository rather than run it: CSS, Razor, generated sources, JS module
       exports, XML docs. They assert conventions and architecture - that a component names its classes
       from the registry, that nothing caps a panel in static vh, that a hover-revealed control is gated
       on a fine pointer. Nothing here renders a component, which is why it needs neither bUnit nor the
       multi-targeting the render suite has: a guard reads the same file whichever runtime it runs on. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flare.Abstractions\Flare.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Flare.Theming\Flare.Theming.csproj" />
    <ProjectReference Include="..\..\src\Flare.Components\Flare.Components.csproj" />
    <ProjectReference Include="..\..\src\Flare.Infrastructure\Flare.Infrastructure.csproj" />
    <!-- Every in-box theme: ThemeIndependenceTests reflects over ITheme rather than keeping a list by
         hand, so a new theme package is covered the moment it is referenced. -->
    <ProjectReference Include="..\..\src\Flare.Theme.Aero\Flare.Theme.Aero.csproj" />
    <ProjectReference Include="..\..\src\Flare.Theme.FluentUI2\Flare.Theme.FluentUI2.csproj" />
    <ProjectReference Include="..\..\src\Flare.Theme.LiquidGlass\Flare.Theme.LiquidGlass.csproj" />
    <ProjectReference Include="..\..\src\Flare.Theme.MaterialDesign2\Flare.Theme.MaterialDesign2.csproj" />
    <ProjectReference Include="..\..\src\Flare.Theme.MaterialDesign3\Flare.Theme.MaterialDesign3.csproj" />
    <ProjectReference Include="..\..\src\Flare.Theme.MaterialDesign3Expressive\Flare.Theme.MaterialDesign3Expressive.csproj" />
    <ProjectReference Include="..\..\src\Flare.Theme.VisualStudio\Flare.Theme.VisualStudio.csproj" />
  </ItemGroup>

</Project>
