<Project>
  <!--
    Central Package Management (CPM). Every NuGet package version used anywhere in the repo is
    declared ONCE here; individual .csproj files reference packages WITHOUT a Version attribute
    (CPM supplies it). To bump a dependency, edit this file only - no per-project edits, no
    rebuild churn across 30 projects. Dependabot updates this single file too.

    - GlobalPackageReference: injected into EVERY project automatically (build/pack tooling).
    - PackageVersion: the version a project gets when it lists the package via <PackageReference>.
    - Per-target-framework versions are selected here with TargetFramework conditions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Build/versioning/pack tooling needed by every project (replaces the MinVer + SourceLink
       PackageReferences that used to be injected via Directory.Build.props and then re-pinned in
       each csproj). GlobalPackageReference implies PrivateAssets="all". -->
  <ItemGroup>
    <PackageVersion Include="Ical.Net" Version="5.2.4" />
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>
  <ItemGroup>
    <!-- Roslyn source generator (samples/Flare.Gallery.Generators). These two are CEILINGED by the
         SDK, not free to float: a generator may not reference a Roslyn newer than the compiler that
         loads it. Exceed it and the SDK drops the analyzer with CS9057 - only a WARNING - so the
         generated code silently disappears and the build fails somewhere else entirely, with CS0103
         on the generated types. Keep them at or below the Roslyn shipped by the SDK floor in
         global.json (11.0.100 -> 5.1200.26.53018); raising them means raising that floor first. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- Library dependencies use a stable minimum, so pack does not turn the newest installed
         patch into a requirement for every consumer. Applications can select newer patches. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <!-- Gallery-only dependencies do not flow into the published libraries. The Gallery targets
         net11.0, so its WebAssembly runtime is the .NET 11 one. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.0" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.0" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <!-- Querio: the query model the visual designer is built on. It lives in its own repository and
         ships from NuGet, so Flare consumes it the way any other consumer does. Only the model and
         its text language are needed by the designer; the Gallery adds two renderers to demo one
         spec becoming several dialects. 0.2.0 adds the net11.0 asset and marks every package except
         Querio.Linq AOT-compatible. -->
    <PackageVersion Include="Querio" Version="0.2.0" />
    <PackageVersion Include="Querio.Language" Version="0.2.0" />
    <PackageVersion Include="Querio.Sql" Version="0.2.0" />
    <PackageVersion Include="Querio.OneC" Version="0.2.0" />
    <!-- Test stack (tests/Flare.*.Tests). xunit.v3 4.0.2 makes the test projects
         Microsoft.Testing.Platform applications, which global.json selects as the "dotnet test"
         runner. Under MTP a TRX report is an opt-in extension rather than a built-in logger, so it
         takes a package: without it the report flag in ci.yml is just an unknown option and CI
         uploads no test results. Keep it on the MTP version the platform itself resolves to. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <!-- Build-time only: the FluentIconGen tool reads real Fluent UI System Icons SVG data from this package
         and generates a curated FluentUIIcons catalog. Not referenced by any shipped package. -->
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.1" />
  </ItemGroup>
</Project>
