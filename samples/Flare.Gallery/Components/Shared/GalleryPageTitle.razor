@namespace Flare.Gallery.Components.Shared
@inject NavigationManager Nav
@inject Flare.Components.IFlareClipboard Clipboard

<FlareStack Gap="FlareSpacing.None" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="2rem">
    <FlareStack Gap="FlareSpacing.None" PaddingBlockEnd="FlareSpacing.Custom" PaddingBlockEndValue="1rem">
        <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Start">
            <FlareStack Gap="FlareSpacing.XXSmall" FlexGrow="1" MinWidth="18rem">
                @ChildContent
            </FlareStack>
            @foreach (var api in _apis)
            {
                <FlareButton Variant="ButtonVariant.Outlined" Shape="ButtonShape.Circular"
                             Href="@($"api/{api}")">
                    <LeadingIcon><FlareIconView Value="@FlareIcons.DataObject" /></LeadingIcon>
                    <ChildContent>@(_apis.Length > 1 ? api : GalleryStrings.Nav_Api)</ChildContent>
                    <TrailingIcon><FlareIconView Value="@FlareIcons.OpenInNew" /></TrailingIcon>
                </FlareButton>
            }
        </FlareStack>
        @* NuGet package this component/service ships in - click to copy the install command. *@
        <FlareStack Row MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.6rem">
            <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm"
                         OnClick="CopyInstallAsync" Tooltip="@($"dotnet add package {_package}")">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Package2" /></LeadingIcon>
                <ChildContent><FlareCode>@_package</FlareCode></ChildContent>
                <TrailingIcon><FlareIconView Value="@(_copied ? FlareIcons.Check : FlareIcons.ContentCopy)" /></TrailingIcon>
            </FlareButton>
        </FlareStack>
    </FlareStack>
    <FlareDivider />
</FlareStack>

@code {
    /// <summary>Page heading content (title and subtitle).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional component type name (e.g. <c>FlareButton</c>). When set, renders an
    /// "API" link to <c>/api/{Api}</c> in the page header. A page documenting more than one
    /// component may list them comma-separated, and then each link is labelled with its type name
    /// rather than the generic "API".
    /// </summary>
    [Parameter] public string? Api { get; set; }

    private string[] _apis =>
        string.IsNullOrWhiteSpace(Api)
            ? []
            : Api.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>Overrides the auto-detected NuGet package id for this page.</summary>
    [Parameter] public string? Package { get; set; }

    private string _package = "Flare.Components";
    private bool _copied;

    protected override void OnParametersSet() => _package = Package ?? ResolvePackage();

    // The standalone libraries map by route; everything else ships in Flare.Components.
    private string ResolvePackage()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        var seg = path.Contains('/') ? path[(path.LastIndexOf('/') + 1)..] : path;
        return seg switch
        {
            "ide" => "Flare.Components.IDE",
            "carousel" => "Flare.Components.Carousel",
            "kanban" => "Flare.Components.Kanban",
            "qrcode" => "Flare.Components.QrCode",
            "rich-text-editor" => "Flare.Components.RichTextEditor",
            "transfer" => "Flare.Components.Transfer",
            "signaturepad" or "videoplayer" => "Flare.Components.Media",
            _ => "Flare.Components",
        };
    }

    private async Task CopyInstallAsync()
    {
        await Clipboard.CopyAsync($"dotnet add package {_package}");
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
        StateHasChanged();
    }
}
