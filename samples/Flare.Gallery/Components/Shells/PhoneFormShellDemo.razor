@* A form at phone width, which is the viewport the density complaint was filed against. The left frame
   is the default field size, the right one is Size="FieldSize.Sm" - the parameter that turned out to be
   the answer, rather than a spacing scope. The submit row is pinned to the bottom of the frame so it
   stays reachable above a keyboard. *@
<FlareStack Row Wrap Gap="FlareSpacing.Large">
    @foreach (var size in new[] { FieldSize.Md, FieldSize.Sm })
    {
        <FlareStack Gap="FlareSpacing.XSmall">
            <FlareText Typo="TypographyScale.LabelLarge">
                @(size == FieldSize.Md ? GalleryStrings.MobileShells_Comfortable : GalleryStrings.MobileShells_Compact)
            </FlareText>

            <FlareCard Variant="CardVariant.Outlined"
                       Width="min(360px, 100%)" Height="460px" Padding="FlareSpacing.Custom" PaddingValue="0" Overflow="hidden">
                <FlareStack Height="100%" Gap="FlareSpacing.None">
                    <FlareStack FlexGrow="1" Overflow="auto" Padding="FlareSpacing.Custom" PaddingValue="1rem">
                        <FlareStack Gap="FlareSpacing.Small">
                            <FlareTextField Label="@GalleryStrings.MobileShells_FullName" Size="size" Placeholder="Ada Lovelace" />
                            <FlareTextField Label="@GalleryStrings.MobileShells_Email" Size="size" Placeholder="ada@example.com" />
                            <FlareTextField Label="@GalleryStrings.MobileShells_Phone" Size="size" Placeholder="+7 000 000-00-00" />
                            <FlareSelect TValue="string" Label="@GalleryStrings.MobileShells_City" Size="size"
                                         Items="_cities" ItemLabel="CityLabel" />
                            <FlareTextArea Label="@GalleryStrings.MobileShells_Comment" Size="size" Rows="3" />
                            <FlareCheckbox TValue="bool" Label="@GalleryStrings.MobileShells_Consent" Size="size" />
                        </FlareStack>
                    </FlareStack>

                    @* Stacked actions, pinned: on a phone a side-by-side pair is two small targets, and a
                       submit that scrolls away is a submit nobody finds. *@
                    <FlareDivider />
                    <FlareStack Gap="FlareSpacing.XSmall" Padding="FlareSpacing.Custom" PaddingValue="0.75rem">
                        <FlareButton Variant="ButtonVariant.Filled" FullWidth="true">@GalleryStrings.MobileShells_Save</FlareButton>
                        <FlareButton Variant="ButtonVariant.Text" FullWidth="true">@GalleryStrings.MobileShells_Cancel</FlareButton>
                    </FlareStack>
                </FlareStack>
            </FlareCard>
        </FlareStack>
    }
</FlareStack>

@code {
    private static readonly string[] _cities = ["msk", "spb"];

    private static string CityLabel(string city) => city == "msk" ? "Moscow" : "Saint Petersburg";
}