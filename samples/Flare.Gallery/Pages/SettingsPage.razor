@page "/settings"
@inherits LocalizedPage
@inject IThemeService ThemeService
@inject Flare.Gallery.Services.RailLabelService RailLabels
@using Flare.Theming

<PageTitle>@GalleryStrings.Settings_Title - Flare</PageTitle>

@* Dedicated settings page (replaces the cramped drawer dialog): theme axes and language are split
   across tabs so nothing has to scroll, and the page has room to breathe. Built only from Flare
   primitives + tokens. *@
<FlareStack MaxWidth="56rem">
    <FlareStack Gap="FlareSpacing.XSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.5rem">
        <FlareText Typo="TypographyScale.HeadlineMedium">@GalleryStrings.Settings_Title</FlareText>
        <FlareText Typo="TypographyScale.BodyLarge" Color="FlareColor.OnSurfaceVariant">@GalleryStrings.Settings_Subtitle</FlareText>
    </FlareStack>

    <FlareTabs Variant="TabsVariant.Primary">

        <FlareTab Label="@GalleryStrings.Settings_TabTheme">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Contrast" Size="1.1rem" /></LeadingIcon>
            <ChildContent>
                <FlareStack Gap="FlareSpacing.Large" PaddingBlockStart="FlareSpacing.Custom" PaddingBlockStartValue="1.25rem">
                    <FlareStack Gap="FlareSpacing.None">
                        <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem" Block>@GalleryStrings.Theme_DesignSystem</FlareText>
                        <FlareStack Row Wrap Gap="FlareSpacing.Small">
                            @foreach (var t in ThemeService.Themes)
                            {
                                var id = t.Id;
                                <FlareButton Variant="@(ThemeService.CurrentTheme.Id == id ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                                             OnClick="@(() => SetThemeAsync(id))">
                                    @t.DisplayName
                                </FlareButton>
                            }
                        </FlareStack>
                    </FlareStack>

                    <FlareStack Gap="FlareSpacing.None">
                        <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem" Block>@GalleryStrings.Theme_Mode</FlareText>
                        <FlareStack Row Wrap Gap="FlareSpacing.Small">
                            <FlareButton Variant="@ModeVariant(ThemeMode.Light)" OnClick="@(() => SetModeAsync(ThemeMode.Light))">
                                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.LightMode" /></LeadingIcon>
                                <ChildContent>@GalleryStrings.Theme_ModeLight</ChildContent>
                            </FlareButton>
                            <FlareButton Variant="@ModeVariant(ThemeMode.Dark)" OnClick="@(() => SetModeAsync(ThemeMode.Dark))">
                                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.DarkMode" /></LeadingIcon>
                                <ChildContent>@GalleryStrings.Theme_ModeDark</ChildContent>
                            </FlareButton>
                            <FlareButton Variant="@ModeVariant(ThemeMode.Auto)" OnClick="@(() => SetModeAsync(ThemeMode.Auto))">
                                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.BrightnessAuto" /></LeadingIcon>
                                <ChildContent>@GalleryStrings.Theme_ModeAuto</ChildContent>
                            </FlareButton>
                        </FlareStack>
                    </FlareStack>
                </FlareStack>
            </ChildContent>
        </FlareTab>

        <FlareTab Label="@GalleryStrings.Theme_Palette">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Palette" Size="1.1rem" /></LeadingIcon>
            <ChildContent>
                <FlareStack Gap="FlareSpacing.Large" PaddingBlockStart="FlareSpacing.Custom" PaddingBlockStartValue="1.25rem">
                    <FlareStack Gap="FlareSpacing.None">
                        @foreach (var group in ThemeService.Palettes.GroupBy(p => p.Source ?? GalleryStrings.Theme_PaletteOther))
                        {
                            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" Margin="FlareSpacing.Custom" MarginValue="0.5rem 0 0.5rem" Block>@group.Key</FlareText>
                            <FlareStack Row Wrap Gap="FlareSpacing.Small" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem">
                                @foreach (var p in group)
                                {
                                    var id = p.Id;
                                    var swatch = ThemeService.IsDark ? p.Dark.Primary : p.Light.Primary;
                                    <FlareButton Size="ButtonSize.Sm"
                                                 Variant="@(ThemeService.CurrentPalette.Id == id ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                                                 OnClick="@(() => SetPaletteAsync(id))">
                                        <LeadingIcon>
                                            <FlareBadge Dot="true" Standalone="true" Color="@FlareColor.Custom(swatch)" />
                                        </LeadingIcon>
                                        <ChildContent>@p.Name</ChildContent>
                                    </FlareButton>
                                }
                            </FlareStack>
                        }
                    </FlareStack>

                    <FlareStack Gap="FlareSpacing.None">
                        <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem" Block>@GalleryStrings.Theming_GenerateTitle</FlareText>
                        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem" Block MaxWidth="36rem">@GalleryStrings.Theming_GenerateDesc</FlareText>
                        <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Start">
                            <FlareColorPicker @bind-Value="_seed" Inline="true" />
                            <FlareButton Variant="ButtonVariant.Tonal" OnClick="GenerateAsync">
                                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Stars" /></LeadingIcon>
                                <ChildContent>@GalleryStrings.Theming_GenerateBtn</ChildContent>
                            </FlareButton>
                        </FlareStack>
                    </FlareStack>
                </FlareStack>
            </ChildContent>
        </FlareTab>

        <FlareTab Label="@GalleryStrings.Settings_TabNavigation">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.DockToRight" Size="1.1rem" /></LeadingIcon>
            <ChildContent>
                <FlareStack Gap="FlareSpacing.Medium" PaddingBlockStart="FlareSpacing.Custom" PaddingBlockStartValue="1.25rem" MaxWidth="36rem">
                    <FlareStack Gap="FlareSpacing.None">
                        <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.25rem" Block>@GalleryStrings.Nav_Drawer_Title</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" Block>@GalleryStrings.Nav_Drawer_Desc</FlareText>
                    </FlareStack>
                    <FlareStack Gap="FlareSpacing.XSmall">
                        <FlareButton Variant="@(RailLabels.ShowLabels ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                                     OnClick="@(() => SetRailLabelsAsync(true))"
                                     FullWidth="true">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ViewSidebar" /></LeadingIcon>
                            <ChildContent>@GalleryStrings.Nav_Rail_Labeled</ChildContent>
                        </FlareButton>
                        <FlareButton Variant="@(RailLabels.ShowLabels ? ButtonVariant.Outlined : ButtonVariant.Filled)"
                                     OnClick="@(() => SetRailLabelsAsync(false))"
                                     FullWidth="true">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.DockToRight" /></LeadingIcon>
                            <ChildContent>@GalleryStrings.Nav_Rail_IconsOnly</ChildContent>
                        </FlareButton>
                    </FlareStack>
                </FlareStack>
            </ChildContent>
        </FlareTab>

        <FlareTab Label="@GalleryStrings.Settings_Language">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Translate" Size="1.1rem" /></LeadingIcon>
            <ChildContent>
                <FlareStack Gap="FlareSpacing.Medium" PaddingBlockStart="FlareSpacing.Custom" PaddingBlockStartValue="1.25rem">
                    <FlareText Typo="TypographyScale.LabelLarge">@GalleryStrings.Settings_Language</FlareText>
                    <FlareStack Row Wrap Gap="FlareSpacing.Small">
                        @foreach (var (code, displayName) in LanguageService.SupportedCultures)
                        {
                            var c = code;
                            <FlareButton Variant="@(Lang.CurrentCulture == c ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                                         OnClick="@(() => Lang.SetCultureAsync(c))">
                                @displayName
                            </FlareButton>
                        }
                    </FlareStack>
                </FlareStack>
            </ChildContent>
        </FlareTab>

    </FlareTabs>
</FlareStack>

@code {
    private string _seed = "#7B1FA2";

    private async Task SetRailLabelsAsync(bool showLabels)
    {
        await RailLabels.SetShowLabelsAsync(showLabels);
        StateHasChanged();
    }

    private async Task GenerateAsync()
    {
        var hex = string.IsNullOrWhiteSpace(_seed) ? "#7B1FA2" : _seed.Trim();
        var id = "gen-" + new string(hex.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        if (ThemeService.Palettes.All(p => p.Id != id))
            ThemeService.RegisterPalette(ThemeService.GeneratePalette(
                id, hex, new PaletteSeed(hex), GalleryStrings.Theme_PaletteGenerated));
        await ThemeService.SetPaletteAsync(id);
        StateHasChanged();
    }

    private ButtonVariant ModeVariant(ThemeMode m) =>
        ThemeService.Mode == m ? ButtonVariant.Filled : ButtonVariant.Outlined;

    private async Task SetThemeAsync(string id)
    {
        await ThemeService.SetThemeAsync(id);
        StateHasChanged();
    }

    private async Task SetPaletteAsync(string id)
    {
        await ThemeService.SetPaletteAsync(id);
        StateHasChanged();
    }

    private async Task SetModeAsync(ThemeMode m)
    {
        await ThemeService.SetModeAsync(m);
        StateHasChanged();
    }
}
