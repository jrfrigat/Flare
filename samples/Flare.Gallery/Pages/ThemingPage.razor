@page "/theming"
@inject IThemeService ThemeService
@inherits LocalizedPage
@using Flare.Abstractions.Tokens
@using Flare.Theming
@using Flare.Theme.MaterialDesign3.Tokens

<PageTitle>@GalleryStrings.Theming_Title - Flare</PageTitle>

<GalleryPageTitle>
    <FlareText Typo="TypographyScale.HeadlineMedium">@GalleryStrings.Theming_Title</FlareText>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyLarge">@GalleryStrings.Theming_Subtitle</FlareText>
</GalleryPageTitle>

<FlareStack Gap="FlareSpacing.Large">

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Palette" Title="@GalleryStrings.Theming_LiveSwitcher" />
    <FlareStack Gap="FlareSpacing.Medium">

        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">
            @GalleryStrings.Theming_Active: <FlareText Element="strong" Inherit>@ThemeService.CurrentTheme.DisplayName</FlareText> · @ThemeService.CurrentPalette.Name · @ThemeService.Mode
        </FlareText>

        @* Design system (theme) -- the component look & feel, independent of colors. *@
        <FlareCard Variant="CardVariant.Outlined">
            <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem" Block>@GalleryStrings.Theme_DesignSystem</FlareText>
            <FlareStack Row Wrap Gap="FlareSpacing.Small">
                @foreach (var t in ThemeService.Themes)
                {
                    var tid = t.Id;
                    <FlareButton Variant="@(ThemeService.CurrentTheme.Id == tid ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                                 OnClick="@(() => ThemeService.SetThemeAsync(tid))">
                        @t.DisplayName
                    </FlareButton>
                }
            </FlareStack>
        </FlareCard>

        @* Palette -- just the colors. The swatch makes it obvious these are color sets, not themes. *@
        <FlareCard Variant="CardVariant.Outlined">
            <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem" Block>@GalleryStrings.Theme_Palette</FlareText>
            <FlareStack Row Wrap Gap="FlareSpacing.Small">
                @foreach (var p in ThemeService.Palettes)
                {
                    var pid = p.Id;
                    var swatch = ThemeService.IsDark ? p.Dark.Primary : p.Light.Primary;
                    <FlareButton Variant="@(ThemeService.CurrentPalette.Id == pid ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                                 OnClick="@(() => ThemeService.SetPaletteAsync(pid))">
                        <LeadingIcon>
                            <FlareBadge Dot="true" Standalone="true" Color="@FlareColor.Custom(swatch)" />
                        </LeadingIcon>
                        <ChildContent>@p.Name</ChildContent>
                    </FlareButton>
                }
            </FlareStack>
        </FlareCard>

        @* Mode -- light / dark / auto. The third independent axis. *@
        <FlareCard Variant="CardVariant.Outlined">
            <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem" Block>@GalleryStrings.Theme_Mode</FlareText>
            <FlareStack Row Wrap Gap="FlareSpacing.Small">
                <FlareButton Variant="@(ThemeService.Mode == ThemeMode.Light ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                             OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Light))">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.LightMode" /></LeadingIcon>
                    <ChildContent>@GalleryStrings.Theme_ModeLight</ChildContent>
                </FlareButton>
                <FlareButton Variant="@(ThemeService.Mode == ThemeMode.Dark ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                             OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Dark))">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.DarkMode" /></LeadingIcon>
                    <ChildContent>@GalleryStrings.Theme_ModeDark</ChildContent>
                </FlareButton>
                <FlareButton Variant="@(ThemeService.Mode == ThemeMode.Auto ? ButtonVariant.Filled : ButtonVariant.Outlined)"
                             OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Auto))">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.BrightnessAuto" /></LeadingIcon>
                    <ChildContent>@GalleryStrings.Theme_ModeAuto</ChildContent>
                </FlareButton>
            </FlareStack>
        </FlareCard>

    </FlareStack>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.DarkMode" Title="@GalleryStrings.Theming_AutoDarkMode" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem">
            @GalleryStrings.Theming_AutoDarkModeDesc
        </FlareText>
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">
            @GalleryStrings.Theming_AutoDarkModeNote
        </FlareText>
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Code" Title="@GalleryStrings.Theming_HowItWorks" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
            @GalleryStrings.Theming_HowItWorksDesc
        </FlareText>
        <FlareCodeBlock Value="@_howItWorksCode" Language="razor" />
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Brush" Title="@GalleryStrings.Theming_CreateTheme" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
            @GalleryStrings.Theming_CustomThemeDesc
        </FlareText>
        <FlareCodeBlock Value="@_createThemeCode" Language="csharp" />
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.TableChart" Title="@GalleryStrings.Theming_TokenReference" />
    <FlareCard Padding="FlareSpacing.Custom" PaddingValue="0" Overflow="hidden">
        <FlareDataGrid TItem="TokenRow" Items="_tokenRows" RowKey="@(r => r.Token)" Hoverable="false">
            <Columns>
                <FlareColumn Title="@GalleryStrings.Theming_TokenCol" Field="@(r => r.Token)">
                    <Template Context="row">
                        <FlareCode>@row.Token</FlareCode>
                    </Template>
                </FlareColumn>
                <FlareColumn Title="@GalleryStrings.Theming_PurposeCol" Field="@(r => r.Purpose)" />
                <FlareColumn Title="@GalleryStrings.Theming_ExampleCol" Field="@(r => r.Example)" />
            </Columns>
        </FlareDataGrid>
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Stars" Title="@GalleryStrings.Theming_GenerateTitle" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
            @GalleryStrings.Theming_GenerateDesc
        </FlareText>
        <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Center">
            <FlareColorPicker @bind-Value="_seed" />
            <FlareButton Variant="ButtonVariant.Filled" OnClick="GenerateAsync">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Palette" /></LeadingIcon>
                <ChildContent>@GalleryStrings.Theming_GenerateBtn</ChildContent>
            </FlareButton>
        </FlareStack>
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Contrast" Title="@GalleryStrings.Theming_ScopeTitle" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
            @GalleryStrings.Theming_ScopeDesc
        </FlareText>
        <FlareStack Row Wrap Gap="FlareSpacing.Large">
            <FlareThemeScope Mode="ThemeMode.Dark">
                <FlareCard MinWidth="14rem">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareText Typo="TypographyScale.LabelLarge">@GalleryStrings.Theming_ScopeDark</FlareText>
                        <FlareStack Row Gap="FlareSpacing.Small">
                            <FlareButton>Filled</FlareButton>
                            <FlareButton Variant="ButtonVariant.Tonal">Tonal</FlareButton>
                        </FlareStack>
                        <FlareChip Color="FlareColor.Primary">Chip</FlareChip>
                    </FlareStack>
                </FlareCard>
            </FlareThemeScope>
            <FlareThemeScope Mode="ThemeMode.Light">
                <FlareCard MinWidth="14rem">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareText Typo="TypographyScale.LabelLarge">@GalleryStrings.Theming_ScopeLight</FlareText>
                        <FlareStack Row Gap="FlareSpacing.Small">
                            <FlareButton>Filled</FlareButton>
                            <FlareButton Variant="ButtonVariant.Tonal">Tonal</FlareButton>
                        </FlareStack>
                        <FlareChip Color="FlareColor.Primary">Chip</FlareChip>
                    </FlareStack>
                </FlareCard>
            </FlareThemeScope>
        </FlareStack>
    </FlareCard>
</FlareSection>
</FlareStack>

@code {
    private string _seed = "#7B1FA2";

    private sealed record TokenRow(string Token, string Purpose, string Example);

    private readonly TokenRow[] _tokenRows =
    [
        new("--flare-color-primary", GalleryStrings.Theming_Token_Primary, "#6750a4"),
        new("--flare-color-on-primary", GalleryStrings.Theming_Token_OnPrimary, "#ffffff"),
        new("--flare-color-primary-container", GalleryStrings.Theming_Token_PrimaryContainer, "#eaddff"),
        new("--flare-color-secondary", GalleryStrings.Theming_Token_Secondary, "#625b71"),
        new("--flare-color-surface", GalleryStrings.Theming_Token_Surface, "#fffbfe"),
        new("--flare-color-surface-container", GalleryStrings.Theming_Token_SurfaceContainer, "#f3edf7"),
        new("--flare-color-on-surface", GalleryStrings.Theming_Token_OnSurface, "#1c1b1f"),
        new("--flare-color-on-surface-variant", GalleryStrings.Theming_Token_OnSurfaceVariant, "#49454f"),
        new("--flare-color-outline", GalleryStrings.Theming_Token_Outline, "#79747e"),
        new("--flare-color-error", GalleryStrings.Theming_Token_Error, "#b3261e"),
        new("--flare-shape-small", GalleryStrings.Theming_Token_ShapeSmall, "8px"),
        new("--flare-shape-medium", GalleryStrings.Theming_Token_ShapeMedium, "12px"),
        new("--flare-shape-full", GalleryStrings.Theming_Token_ShapeFull, "9999px"),
        new("--flare-state-hover-opacity", GalleryStrings.Theming_Token_StateOpacity, "0.08"),
        new("--flare-motion-duration-state-change", GalleryStrings.Theming_Token_Motion, "100ms"),
        new("--flare-typescale-body-large-font", GalleryStrings.Theming_Token_BodyFont, "Roboto, sans-serif"),
    ];

    private const string _howItWorksCode =
        """
        // Three independent axes: theme (design system), palette (colors), mode
        @inject IThemeService ThemeService

        await ThemeService.SetThemeAsync("fluent2");       // design system
        await ThemeService.SetPaletteAsync("fluent-blue"); // colors
        await ThemeService.SetModeAsync(ThemeMode.Dark);   // Light / Dark / Auto

        // Read current selection
        var theme   = ThemeService.CurrentTheme;
        var palette = ThemeService.CurrentPalette;
        var isDark  = ThemeService.IsDark;
        """;

    private const string _createThemeCode =
        """
        using Flare.Abstractions.Tokens;

        // A palette is just colors (light + dark) - reuse a built-in design system,
        // only swap the colors. Register it without touching any theme.
        var ocean = new Palette
        {
            Id = "ocean",
            Name = "Ocean",
            Light = MaterialDesign3Tokens.LightColors with { Primary = "#006782", PrimaryContainer = "#BCE9FF" },
            Dark  = MaterialDesign3Tokens.DarkColors  with { Primary = "#5DD5FC", PrimaryContainer = "#004E63" },
        };

        // Or generate a whole palette from one brand color:
        var brand = PaletteFactory.Brand("brand", "Brand", MaterialDesign3Tokens.LightColors, MaterialDesign3Tokens.DarkColors, "#7B1FA2");

        // Override ANY design token (shape, typography, ...) from the reference:
        var design = MaterialDesign3Tokens.Design with
        {
            Shape = MaterialDesign3Tokens.Design.Shape with { Medium = "10px" },
        };

        // Register at startup...
        builder.Services.AddFlare(opts => opts.DefaultPalette = ocean);

        // ...or at runtime, then switch on the fly
        themeService.RegisterPalette(ocean);
        await themeService.SetPaletteAsync("ocean");
        """;

    private async Task GenerateAsync()
    {
        var hex = string.IsNullOrWhiteSpace(_seed) ? "#7B1FA2" : _seed.Trim();
        var id = "gen-" + new string(hex.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        if (ThemeService.Palettes.All(p => p.Id != id))
            ThemeService.RegisterPalette(ThemeService.GeneratePalette(
                id, hex, new PaletteSeed(hex), GalleryStrings.Theme_PaletteGenerated));
        await ThemeService.SetPaletteAsync(id);
    }
}
