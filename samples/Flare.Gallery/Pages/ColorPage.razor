@page "/color"
@inherits LocalizedPage

<PageTitle>@GalleryStrings.Color_Title - Flare</PageTitle>

<GalleryPageTitle>
    <FlareText Typo="TypographyScale.HeadlineMedium">@GalleryStrings.Color_Title</FlareText>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyLarge">@GalleryStrings.Color_Subtitle</FlareText>
</GalleryPageTitle>

<FlareStack Gap="FlareSpacing.Large">

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Palette" Title="@GalleryStrings.Color_RolesTitle" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.25rem">
            @GalleryStrings.Color_RolesDesc
        </FlareText>
        <FlareGrid MinColumnWidth="150px" Gap="FlareSpacing.Custom" GapValue="0.75rem">
            @foreach (var role in _roles)
            {
                <FlareCard Background="role.Color" Padding="FlareSpacing.None" MinHeight="84px">
                    <FlareStack Padding="FlareSpacing.Custom" PaddingValue="0.875rem 1rem"
                                MinHeight="84px" Gap="FlareSpacing.Small"
                                Justify="FlareJustifyContent.SpaceBetween">
                        <FlareText Element="strong" Inherit>@role.Name</FlareText>
                        <FlareText Element="code" Mono Typo="TypographyScale.LabelSmall">FlareColor.@role.Name</FlareText>
                    </FlareStack>
                </FlareCard>
            }
        </FlareGrid>
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Layers" Title="@GalleryStrings.Color_PlanesTitle" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.25rem">
            @GalleryStrings.Color_PlanesDesc
        </FlareText>
        <FlareGrid MinColumnWidth="130px" Gap="FlareSpacing.Custom" GapValue="0.75rem">
            @foreach (var plane in _planes)
            {
                <FlareCard Variant="CardVariant.Outlined" Background="@PlaneColor(plane)"
                           Foreground="FlareColor.OnSurface"
                           Padding="FlareSpacing.Custom" PaddingValue="0.875rem 1rem"
                           MinHeight="84px">
                    <FlareStack MinHeight="52px" Justify="FlareJustifyContent.End">
                        <FlareText Element="code" Mono Typo="TypographyScale.LabelSmall">@plane.Replace("--flare-color-", "")</FlareText>
                    </FlareStack>
                </FlareCard>
            }
        </FlareGrid>
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.FormatColorText" Title="@GalleryStrings.Color_TextTonesTitle" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
            @GalleryStrings.Color_TextTonesDesc
        </FlareText>
        <FlareStack Gap="FlareSpacing.XSmall">
            <FlareText Color="FlareColor.OnSurface" Typo="TypographyScale.BodyLarge">@GalleryStrings.Color_TextToneOnSurface</FlareText>
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyLarge">@GalleryStrings.Color_TextToneVariant</FlareText>
            <FlareText Color="FlareColor.OnSurfaceVariant2" Typo="TypographyScale.BodyLarge">@GalleryStrings.Color_TextToneVariant2</FlareText>
        </FlareStack>
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Code" Title="@GalleryStrings.Color_UsageTitle" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
            @GalleryStrings.Color_UsageDesc
        </FlareText>
        <FlareCodeBlock Value="@_usageCode" Language="razor" />
    </FlareCard>
</FlareSection>

<FlareSection>
    <GallerySectionHeader Icon="@MaterialDesign3Icons.Regular.Stars" Title="@GalleryStrings.Color_GeneratorsTitle" />
    <FlareCard Variant="CardVariant.Outlined">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.25rem">
            @GalleryStrings.Color_GeneratorsDesc
        </FlareText>

        <FlareStack Row Wrap Gap="FlareSpacing.Medium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.5rem" Align="FlareAlignItems.Center">
            <FlareCard Variant="CardVariant.Outlined" Background="_current"
                       Width="88px" Height="88px" Padding="FlareSpacing.None" />
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelMedium">@GalleryStrings.Color_CurrentLabel</FlareText>
                <FlareText Element="code" Mono Typo="TypographyScale.TitleMedium">@_current.Value</FlareText>
            </FlareStack>
            <FlareStack Row Gap="FlareSpacing.Small">
                <FlareButton Variant="ButtonVariant.Filled" OnClick="RandomColor">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Casino" /></LeadingIcon>
                    <ChildContent>@GalleryStrings.Color_RandomBtn</ChildContent>
                </FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="NextColor">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.SkipNext" /></LeadingIcon>
                    <ChildContent>@GalleryStrings.Color_NextBtn</ChildContent>
                </FlareButton>
            </FlareStack>
        </FlareStack>

        <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem">@GalleryStrings.Color_SequenceTitle</FlareText>
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem">@GalleryStrings.Color_SequenceDesc</FlareText>
        <FlareStack Row Wrap Gap="FlareSpacing.Custom" GapValue="0.5rem"
                    MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.5rem">
            @foreach (var c in Sequence())
            {
                <FlareCard Variant="CardVariant.Outlined" Background="c" title="@c.Value"
                           Width="48px" Height="48px" Padding="FlareSpacing.None" />
            }
        </FlareStack>

        <FlareText Typo="TypographyScale.LabelLarge" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem">@GalleryStrings.Color_AppliedTitle</FlareText>
        <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Center">
            <FlareButton Variant="ButtonVariant.Filled" Color="_current">Button</FlareButton>
            <FlareChip Color="_current">Chip</FlareChip>
            <FlareStack MinWidth="200px">
                <FlareProgressLinear Color="_current" Value="65" />
            </FlareStack>
        </FlareStack>

        @* FlareColorCustomizer: pick a primary from presets or the native picker. The WCAG contrast
           preview ("Aa" + ratio + AA/AAA/Fail badge) shows whether readable text on it is accessible. *@
        <FlareStack MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="1.5rem"
                    MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.5rem">
            <FlareDivider />
        </FlareStack>
        <FlareColorCustomizer />
    </FlareCard>
</FlareSection>

</FlareStack>

@code {
    private const string _usageCode =
        """
        @* Semantic role -> shared, cached theme class (theme-aware) *@
        <FlareButton Color="FlareColor.Primary">Primary</FlareButton>
        <FlareProgressLinear Color="FlareColor.Success" Value="70" />

        @* Arbitrary CSS color -> inline tokens (sanitized) *@
        <FlareSlider Color="FlareColor.Custom("#E91E63")" @bind-Value="_v" />

        @* Implicit conversion from string also works *@
        <FlareChip Color="@Colors.Tertiary">Tag</FlareChip>

        @* Generators *@
        var random = FlareColor.Random();   // arbitrary #RRGGBB
        var next   = random.Next();         // next hue (golden angle)
        """;

    private sealed record RoleInfo(string Name, FlareColor Color);

    // Furthest from the content first, so the strip reads as the ladder it is. Named from the token
    // registry rather than spelled out, which is what makes a renamed plane a compile error here.
    private static readonly string[] _planes =
    [
        Css.Tokens.Color.SurfaceContainerLowest,
        Css.Tokens.Color.SurfaceContainerLow,
        Css.Tokens.Color.SurfaceContainer,
        Css.Tokens.Color.SurfaceContainerHigh,
        Css.Tokens.Color.SurfaceContainerHighest,
        Css.Tokens.Color.Surface,
    ];

    private static readonly RoleInfo[] _roles =
    [
        new("Primary", FlareColor.Primary),
        new("Secondary", FlareColor.Secondary),
        new("Tertiary", FlareColor.Tertiary),
        new("Success", FlareColor.Success),
        new("Warning", FlareColor.Warning),
        new("Error", FlareColor.Error),
        new("Info", FlareColor.Info),
    ];

    private FlareColor _current = FlareColor.Custom("#3366CC");

    private static FlareColor PlaneColor(string token) => FlareColor.Custom($"var({token})");

    private void RandomColor() => _current = FlareColor.Random();
    private void NextColor() => _current = _current.Next();

    // The current color plus its next five Next() steps, to visualize the sequence.
    private IEnumerable<FlareColor> Sequence()
    {
        var c = _current;
        for (var i = 0; i < 6; i++)
        {
            yield return c;
            c = c.Next();
        }
    }
}
