@inherits LocalizedPage

<FlareStack Gap="FlareSpacing.Large" Style="max-width:40rem;">
    <FlareStack Row Wrap Gap="FlareSpacing.Large">
        <FlareTimePicker @bind-Value="_dial" Label="@GalleryStrings.TpDemo_DialLabel"
                         HelperText="@GalleryStrings.TpDemo_DialHelper" Style="flex:1;min-width:12rem;" />
        <FlareTimePicker @bind-Value="_dial24" Label="@GalleryStrings.TpDemo_Dial24Label"
                         Use24Hour="true"
                         HelperText="@GalleryStrings.TpDemo_Dial24Helper" Style="flex:1;min-width:12rem;" />
        <FlareTimePicker @bind-Value="_columns" Label="@GalleryStrings.TpDemo_DropdownLabel"
                         PopupVariant="TimePickerVariant.Dropdown" MinuteStep="5"
                         HelperText="@GalleryStrings.TpDemo_DropdownHelper" Style="flex:1;min-width:12rem;" />
        <FlareTimePicker @bind-Value="_list" Label="@GalleryStrings.TpDemo_ListLabel"
                         PopupVariant="TimePickerVariant.List" MinuteStep="30"
                         HelperText="@GalleryStrings.TpDemo_ListHelper" Style="flex:1;min-width:12rem;" />
        <FlareTimePicker Label="@GalleryStrings.TpDemo_DisabledLabel" Disabled Style="flex:1;min-width:12rem;" />
        <FlareTimePicker @bind-Value="_required" Label="@GalleryStrings.TpDemo_RequiredLabel" Required="true"
                         ErrorText="@(_required is null ? GalleryStrings.TpDemo_RequiredError : null)"
                         Style="flex:1;min-width:12rem;" />
    </FlareStack>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">@GalleryStrings.TpDemo_KeyboardNote</FlareText>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
        @string.Format(GalleryStrings.TpDemo_Summary, _dial?.ToString("HH:mm") ?? "-", _columns?.ToString("HH:mm") ?? "-")
    </FlareText>
</FlareStack>

@code {
    private TimeOnly? _dial;
    private TimeOnly? _dial24;
    private TimeOnly? _columns;
    private TimeOnly? _list;
    private TimeOnly? _required;
}
