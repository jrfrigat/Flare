@inherits LocalizedPage

<FlareStack Gap="FlareSpacing.Large" Style="max-width:24rem;">
    <FlareTimePicker @bind-Value="_time"
                     Label="@GalleryStrings.TpDemo_AdvancedLabel"
                     PopupVariant="TimePickerVariant.Dropdown"
                     ShowSeconds="true"
                     MinuteStep="15"
                     Min="@(new TimeOnly(9, 0))"
                     Max="@(new TimeOnly(17, 0))"
                     AutoClose="true" />

    <FlareTimePicker @bind-Value="_dialTime"
                     Label="@GalleryStrings.TpDemo_DialAutoCloseLabel"
                     HelperText="@GalleryStrings.TpDemo_DialAutoCloseHelper"
                     AutoClose="true" />

    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
        @string.Format(GalleryStrings.TpDemo_Value, _time?.ToString("HH:mm:ss") ?? "-")
    </FlareText>
</FlareStack>

@code {
    private TimeOnly? _time = new(9, 30, 0);
    private TimeOnly? _dialTime;
}
