<FlareStack MaxWidth="36rem">
    <FlareRichTextEditor Label="@GalleryStrings.RichTextEditor_Placeholder" ValueChanged="v => _html = v" />
    @if (!string.IsNullOrEmpty(_html))
    {
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.75rem">
            @GalleryStrings.RichTextEditor_Output
        </FlareText>
        <FlareCard Background="@Surface"
                   Padding="FlareSpacing.Custom" PaddingValue="0.5rem"
                   MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.25rem">
            <FlareCodeBlock Value="@_html" Language="html" ReadOnly="true" Wrap="true" />
        </FlareCard>
    }
</FlareStack>

@code {
    private string? _html;

    private static readonly FlareColor Surface = FlareColor.Custom("var(--flare-color-surface-container)");
}
