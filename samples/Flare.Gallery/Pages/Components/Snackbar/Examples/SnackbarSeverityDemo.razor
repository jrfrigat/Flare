@inject ISnackbarService Snackbar

<FlareStack Row Wrap Gap="FlareSpacing.Small">
    <FlareButton OnClick="@(() => Snackbar.Show(GalleryStrings.Snackbar_DefaultMessage))">@GalleryStrings.Snackbar_SeverityDefault</FlareButton>
    <FlareButton OnClick="@(() => Snackbar.Show(GalleryStrings.Snackbar_SuccessMessage, SnackbarSeverity.Success))">@GalleryStrings.Snackbar_SeveritySuccess</FlareButton>
    <FlareButton OnClick="@(() => Snackbar.Show(GalleryStrings.Snackbar_WarningMessage, SnackbarSeverity.Warning))">@GalleryStrings.Snackbar_SeverityWarning</FlareButton>
    <FlareButton OnClick="@(() => Snackbar.Show(GalleryStrings.Snackbar_ErrorMessage, SnackbarSeverity.Error))">@GalleryStrings.Snackbar_SeverityError</FlareButton>
    <FlareButton OnClick="@(() => Snackbar.Show(GalleryStrings.Snackbar_InfoMessage, SnackbarSeverity.Info))">@GalleryStrings.Snackbar_SeverityInfo</FlareButton>
</FlareStack>
