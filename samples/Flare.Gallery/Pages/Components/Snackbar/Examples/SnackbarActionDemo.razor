@inject ISnackbarService Snackbar

<FlareStack Row Wrap Gap="FlareSpacing.Small">
    <FlareButton OnClick="ShowWithAction">@GalleryStrings.Snackbar_WithAction</FlareButton>
    <FlareButton OnClick="@(() => Snackbar.Show(GalleryStrings.Snackbar_TenSeconds, SnackbarSeverity.Info, durationMs: 10000))">@GalleryStrings.Snackbar_LongDuration</FlareButton>
    <FlareButton OnClick="@(() => Snackbar.Show(GalleryStrings.Snackbar_NoCloseMessage, SnackbarSeverity.Normal, showClose: false))">@GalleryStrings.Snackbar_NoClose</FlareButton>
</FlareStack>

<FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelMedium" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.75rem">
    @string.Format(GalleryStrings.Snackbar_LastAction, _lastAction)
</FlareText>

@code {
    private string _lastAction = GalleryStrings.Snackbar_None;

    private void ShowWithAction()
        => Snackbar.Show(GalleryStrings.Snackbar_ItemDeleted, SnackbarSeverity.Success,
            actionText: GalleryStrings.Snackbar_Undo,
            onAction: () => { _lastAction = GalleryStrings.Snackbar_UndoClicked; InvokeAsync(StateHasChanged); return Task.CompletedTask; });
}
