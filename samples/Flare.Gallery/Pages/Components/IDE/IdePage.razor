@page "/components/ide"
@inherits LocalizedPage

<PageTitle>@GalleryStrings.Ide_Title - Flare</PageTitle>

<GalleryPageTitle Api="FlareDockWorkspace">
    <FlareText Typo="TypographyScale.HeadlineMedium">@GalleryStrings.Ide_Title</FlareText>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyLarge">@GalleryStrings.Ide_Subtitle</FlareText>
</GalleryPageTitle>

<FlareStack Gap="FlareSpacing.Medium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.5rem">
    <FlareText Typo="TypographyScale.BodyMedium">
        <FlareText Element="strong" Inherit>FlareDockWorkspace</FlareText> is the shell of the optional <FlareText Element="strong" Inherit>Flare.Components.IDE</FlareText>
        package. It arranges docked groups and splits dynamically, and the rest of the chrome - ribbon,
        menu bar, tool panels, status bar - is composed around it from the other IDE components. Every
        visual value comes from the active theme; the workspace adds layout and behavior only.
    </FlareText>

    <FlareStack Gap="FlareSpacing.Small">
        <FlareText Element="p" Inherit><FlareText Element="strong" Inherit>Layout model</FlareText> - a tree of <FlareCode>DockSplit</FlareCode> and
            <FlareCode>DockGroup</FlareCode> nodes; each group owns its tabs, selection and keep-alive items.
            The application accepts or rejects changes through <FlareCode>OnChangeRequested</FlareCode>.</FlareText>
        <FlareText Element="p" Inherit><FlareText Element="strong" Inherit>Docking</FlareText> - drag a tab to a group edge to split, move it
            between groups, or use the group actions menu and keyboard; the workspace keeps the accepted
            layout and never changes it on its own.</FlareText>
        <FlareText Element="p" Inherit><FlareText Element="strong" Inherit>Tool panels</FlareText> - <FlareCode>FlareToolPanelGroup</FlareCode> adds
            a tabbed tool window with pin, collapse and placement; the panels stay ordinary Flare
            components.</FlareText>
    </FlareStack>

    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
        Install: <FlareCode>dotnet add package Flare.Components.IDE</FlareCode> and reference
        <FlareCode>_content/Flare.Components.IDE/css/flare-ide.css</FlareCode>.
    </FlareText>
</FlareStack>

<FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
    The examples below compose the workspace with the rest of the IDE chrome.
</FlareText>

<AutoDemoSection Title="Editor Breadcrumb Bar" DemoType="typeof(Examples.IdeEditorBreadcrumbDemo)"
    Description="The 22px editor breadcrumb/toolbar row: host-supplied dropdown segments with a 16px icon, a 12px label, a chevron and 1px separators. The active segment sits on the editor surface, and the trailing action area carries the host's error count and layout commands. Open a segment to see its menu." />

<AutoDemoSection Title="@GalleryStrings.Ide_Caption_Title" DemoType="typeof(Examples.IdeCaptionButtonsDemo)"
    Description="@GalleryStrings.Ide_Caption_Desc" />

<AutoDemoSection Title="@GalleryStrings.DockDemo_Title" DemoType="typeof(Examples.DynamicDockDemo)"
    Description="@GalleryStrings.DockDemo_Description" />
