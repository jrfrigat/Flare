@page "/components/ide"
@inherits LocalizedPage

<PageTitle>@GalleryStrings.Ide_Title - Flare</PageTitle>

<GalleryPageTitle Api="FlareIdeLayout">
    <FlareText Typo="TypographyScale.HeadlineMedium">@GalleryStrings.Ide_Title</FlareText>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyLarge">@GalleryStrings.Ide_Subtitle</FlareText>
</GalleryPageTitle>

<FlareStack Gap="FlareSpacing.Medium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1.5rem">
    <FlareText Typo="TypographyScale.BodyMedium">
        <FlareText Element="strong" Inherit>FlareIdeLayout</FlareText> is the shell of the optional <FlareText Element="strong" Inherit>Flare.Components.IDE</FlareText>
        package - it arranges the chrome (ribbon, menus, dockable panels, document area, status bar)
        into a desktop-IDE layout, built entirely on the core Flare components and design tokens with no
        custom theming. Each individual part has its own page in the <FlareText Element="strong" Inherit>IDE</FlareText> group of the
        navigation; this page covers the layout itself.
    </FlareText>

    <FlareStack Gap="FlareSpacing.Small">
        <FlareText Element="p" Inherit><FlareText Element="strong" Inherit>Named slots</FlareText> - <FlareCode>Ribbon</FlareCode>, <FlareCode>MenuBar</FlareCode>,
            <FlareCode>LeftToolPanel</FlareCode>, <FlareCode>ChildContent</FlareCode> (the document area),
            <FlareCode>RightToolPanel</FlareCode>, <FlareCode>BottomPanel</FlareCode>, and <FlareCode>StatusBar</FlareCode>.</FlareText>
        <FlareText Element="p" Inherit><FlareText Element="strong" Inherit>Region resizing</FlareText> - drag the divider between a docked panel and the document
            (or focus it and use the arrow keys); configured via the layout's <FlareCode>*Resizable</FlareCode> /
            <FlareCode>MinPanelSize</FlareCode> parameters. For arbitrary layouts use the standalone
            <FlareText Element="strong" Inherit>FlareSplitter</FlareText> between any two flex siblings.</FlareText>
        <FlareText Element="p" Inherit><FlareText Element="strong" Inherit>Docked panels</FlareText> - collapsing a docked <FlareCode>FlareToolPanel</FlareCode> frees its
            space (the region shrinks to a thin rail); <FlareCode>Mode="IdePanelMode.AutoHide"</FlareCode> makes it
            fly out over the content instead of taking space.</FlareText>
    </FlareStack>

    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
        Install: <FlareCode>dotnet add package Flare.Components.IDE</FlareCode> and reference
        <FlareCode>_content/Flare.Components.IDE/css/flare-ide.css</FlareCode>.
    </FlareText>
</FlareStack>

<FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
    The examples below compose the parts into complete application shells.
</FlareText>

<AutoDemoSection Title="Full IDE Layout" DemoType="typeof(Examples.IdeLayoutDemo)"
    Description="Ribbon, explorer, document tabs, properties, a tabbed Output/Error/Terminal panel, and a status bar composed with FlareIdeLayout. Drag the dividers between regions to resize them (or focus a divider and use the arrow keys); collapse the explorer to a rail and try the auto-hide Properties flyout." />

<AutoDemoSection Title="Office shell (Word / Excel)" DemoType="typeof(Examples.IdeOfficeDemo)"
    Description="Quick-access toolbar, a ribbon with a dropdown gallery and separator, a backstage (File) overlay, a formula bar, an Excel-like grid with cell selection, and a sheet-tab strip. Click File to open the backstage." />

<AutoDemoSection Title="Studio shell (Visual Studio / Access)" DemoType="typeof(Examples.IdeStudioDemo)"
    Description="Menu bar + icon toolbar, a Solution/Navigation tree, document tabs hosting a datasheet, a Properties sheet with editable values, an output panel, and a status bar." />
