@using Flare.Components.IDE
@inherits LocalizedPage

<FlareStack Gap="FlareSpacing.Medium">
    <FlareDocumentTabs ActiveKey="_stripActive" ActiveKeyChanged="SelectFromStrip"
                        Reorderable="true" Dockable="true" OnCloseRequested="CloseDocumentKey"
                        DockTargets="DockTargets" OnDockRequested="DockFromTab">
        <ContextMenuContent Context="key">
            <FlareMenuItem OnClick="@(() => SelectFromStrip(key))">@GalleryStrings.IdeWorkspace_Activate</FlareMenuItem>
            <FlareMenuItem OnClick="@(() => CloseDocumentKey(key))">@GalleryStrings.IdeWorkspace_Close</FlareMenuItem>
        </ContextMenuContent>
        <ChildContent>
            @foreach (var document in _documents)
            {
                <FlareDocumentTab @key="document.Key" Key="@document.Key" Title="@document.Title"
                                  Modified="@document.Modified" />
            }
        </ChildContent>
    </FlareDocumentTabs>
    <FlareIdeLayout Height="34rem" LeftPanelWidth="18rem" RightPanelWidth="12rem" BottomPanelHeight="15rem"
                    Documents="_documents" ActiveDocuments="_activeDocuments"
                    OnActiveDocumentChanged="SelectionChanged" OnDocumentMove="MoveDocument"
                    OnDocumentCloseRequested="CloseDocument" DocumentContextMenu="DocumentMenu"
                    DocumentMounting="IdeDocumentMounting.ActiveOnly"
                    RetainDocumentContent="KeepDocumentMounted" CenterDockHeader="CenterHeader">
        <MenuBar>
            <FlareToolbar Groups="Groups" @bind-GroupOrder="_groupOrder" Reorderable="true" />
        </MenuBar>
        <LeftToolPanel>
            <FlareToolPanelGroup Position="ToolPanelPosition.Left">
                <FlareToolPanel Title="@GalleryStrings.IdeWorkspace_Commands">
                    <FlareShortcutEditor @bind-Value="_shortcut" DefaultValue="ctrl+shift+p"
                                         AssignedShortcuts="@(new[] { "ctrl+shift+k" })" />
                </FlareToolPanel>
                <FlareToolPanel Title="@GalleryStrings.IdeWorkspace_Open">
                    <FlareTextField Label="@GalleryStrings.IdeWorkspace_Notes" />
                </FlareToolPanel>
            </FlareToolPanelGroup>
        </LeftToolPanel>
        <ChildContent>
            <FlareStack Padding="FlareSpacing.Large">
                <FlareText>@GalleryStrings.IdeWorkspace_MainContent</FlareText>
            </FlareStack>
        </ChildContent>
        <DocumentContent Context="document">
            <FlareTextField Label="@document.Title" />
        </DocumentContent>
        <BottomPanel>
            <FlareToolPanel Position="ToolPanelPosition.Bottom" Title="@GalleryStrings.IdeWorkspace_Diagnostics">
                <FlareDiagnosticList Items="Diagnostics" Height="9rem" OnDiagnosticSelected="@OpenDiagnostic" />
            </FlareToolPanel>
        </BottomPanel>
        <StatusBar>
            <FlareStatusBar LeftContent="@StatusContent" />
        </StatusBar>
    </FlareIdeLayout>
</FlareStack>

@code {
    private string? _shortcut = "ctrl+shift+p";
    private IReadOnlyList<string>? _groupOrder;
    private IdeDiagnostic? _selected;
    private string? _stripActive = "main";
    private IdeDocument[] _documents =
        [new("main", "Main.cs"), new("guide", "Guide.md", IdeDocumentRegion.Right, Modified: true)];
    private Dictionary<IdeDocumentRegion, string?> _activeDocuments =
        new() { [IdeDocumentRegion.Center] = "main" };

    private IReadOnlyList<FlareDocumentDockTarget> DockTargets =>
    [
        new("left", GalleryStrings.IdeWorkspace_Left),
        new("right", GalleryStrings.IdeWorkspace_Right)
    ];

    private RenderFragment CenterHeader => @<FlareStack Row="true" Align="FlareAlignItems.Center" StretchLast="true"
        Gap="FlareSpacing.XSmall" Padding="FlareSpacing.XSmall">
        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                     OnClick="ShowMain">@GalleryStrings.IdeWorkspace_Main</FlareButton>
        <FlareDocumentTabs StripOnly="true" ActiveKey="@_stripActive" ActiveKeyChanged="SelectFromStrip"
                            Reorderable="true" Dockable="true" OnCloseRequested="CloseDocumentKey"
                            DockTargets="DockTargets" OnDockRequested="DockFromTab">
            <ContextMenuContent Context="key">
                <FlareMenuItem OnClick="@(() => SelectFromStrip(key))">@GalleryStrings.IdeWorkspace_Activate</FlareMenuItem>
                <FlareMenuItem OnClick="@(() => CloseDocumentKey(key))">@GalleryStrings.IdeWorkspace_Close</FlareMenuItem>
            </ContextMenuContent>
            <ChildContent>
                @foreach (var document in _documents.Where(item => item.Region == IdeDocumentRegion.Center))
                {
                    <FlareDocumentTab @key="document.Key" Key="@document.Key" Title="@document.Title"
                                      Modified="@document.Modified" />
                }
            </ChildContent>
        </FlareDocumentTabs>
    </FlareStack>;

    private IReadOnlyList<IdeToolbarGroup> Groups =>
    [
        new("open", GalleryStrings.IdeWorkspace_Open, OpenGroup),
        new("run", GalleryStrings.IdeWorkspace_Run, RunGroup)
    ];

    private IReadOnlyList<IdeDiagnostic> Diagnostics =>
    [
        new("parse", "main", "Main.cs", 13, 5, IdeDiagnosticSeverity.Error, GalleryStrings.IdeWorkspace_ParseError),
        new("heading", "guide", "Guide.md", 2, 1, IdeDiagnosticSeverity.Warning, GalleryStrings.IdeWorkspace_HeadingError)
    ];

    private RenderFragment OpenGroup => @<FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
        OnClick="@(() => _selected = null)">@GalleryStrings.IdeWorkspace_Open</FlareButton>;
    private RenderFragment RunGroup => @<FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
        OnClick="@(() => _selected = Diagnostics[0])">@GalleryStrings.IdeWorkspace_Run</FlareButton>;
    private RenderFragment StatusContent => @<FlareText>@(_selected is { } entry
        ? $"{entry.DocumentTitle}:{entry.Line}:{entry.Column}" : GalleryStrings.IdeWorkspace_Ready)</FlareText>;

    private void MoveDocument(IdeDocumentMove request)
    {
        _documents = _documents
            .Select(document => document.Key == request.Document.Key ? document with { Region = request.Destination } : document)
            .ToArray();
        SelectionChanged(new IdeDocumentSelection(request.Destination, request.Document.Key));
    }

    private bool KeepDocumentMounted(IdeDocument document) => document.Key == "guide";

    private void SelectionChanged(IdeDocumentSelection selection) =>
        _activeDocuments = new Dictionary<IdeDocumentRegion, string?>(_activeDocuments)
        {
            [selection.Region] = selection.Key
        };

    private void ShowMain() => SelectionChanged(new IdeDocumentSelection(IdeDocumentRegion.Center, null));

    private void SelectFromStrip(string key)
    {
        _stripActive = key;
        if (_documents.FirstOrDefault(document => document.Key == key) is { } document)
            SelectionChanged(new IdeDocumentSelection(document.Region, document.Key));
    }

    private void DockFromTab(FlareDocumentDockRequest request)
    {
        if (_documents.FirstOrDefault(document => document.Key == request.DocumentKey) is not { } document)
            return;
        var destination = request.Target.Key == "left" ? IdeDocumentRegion.Left : IdeDocumentRegion.Right;
        MoveDocument(new IdeDocumentMove(document, destination));
    }

    private void CloseDocumentKey(string key)
    {
        if (_documents.FirstOrDefault(document => document.Key == key) is { } document)
            CloseDocument(document);
    }

    private void CloseDocument(IdeDocument document)
    {
        _documents = _documents.Where(item => item.Key != document.Key).ToArray();
        _activeDocuments = _activeDocuments.ToDictionary(
            pair => pair.Key,
            pair => pair.Value == document.Key ? null : pair.Value);
        if (_stripActive == document.Key)
            _stripActive = _documents.FirstOrDefault()?.Key;
    }

    private RenderFragment<IdeDocument> DocumentMenu => document => @<FlareMenuItem OnClick="@(() => CloseDocument(document))">
        @GalleryStrings.IdeWorkspace_Close
    </FlareMenuItem>;

    private void OpenDiagnostic(IdeDiagnostic diagnostic) => _selected = diagnostic;
}
