@using Flare.Components.IDE

<FlareCard Variant="CardVariant.Outlined" Padding="FlareSpacing.None" Overflow="hidden">
<FlareIdeLayout Height="460px">
    <Ribbon>
        <FlareRibbon OnTabChanged="OnRibbonTab">
            <FlareRibbonTab Title="Home">
                <FlareRibbonGroup Label="Clipboard">
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.ContentPaste" Label="Paste" Tooltip="Paste" IsLarge="true"
                                       OnClick="@(() => Set("Pasted"))" />
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.ContentCut" Tooltip="Cut" OnClick="@(() => Set("Cut"))" />
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.ContentCopy" Tooltip="Copy" OnClick="@(() => Set("Copied"))" />
                </FlareRibbonGroup>
                <FlareRibbonGroup Label="Edit">
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.Undo" Tooltip="Undo" />
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.Redo" Tooltip="Redo" />
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.Search" Tooltip="Find" />
                </FlareRibbonGroup>
            </FlareRibbonTab>
            <FlareRibbonTab Title="View">
                <FlareRibbonGroup Label="Zoom">
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.ZoomIn" Label="Zoom In" Tooltip="Zoom in" IsLarge="true" />
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.ZoomOut" Label="Zoom Out" Tooltip="Zoom out" IsLarge="true" />
                </FlareRibbonGroup>
                <FlareRibbonGroup Label="Show">
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.GridOn" Tooltip="Grid lines" />
                    <FlareRibbonButton Icon="@MaterialDesign3Icons.Regular.WrapText" Tooltip="Word wrap" />
                </FlareRibbonGroup>
            </FlareRibbonTab>
        </FlareRibbon>
    </Ribbon>

    <LeftToolPanel>
        <FlareToolPanel Title="Explorer">
            <FlareTreeView AriaLabel="Explorer">
                <FlareTreeItem Label="src" Icon="@FlareIcons.Folder" Expanded="true">
                    <FlareTreeItem Label="Program.cs" Icon="@FlareIcons.Description" />
                    <FlareTreeItem Label="Startup.cs" Icon="@FlareIcons.Description" />
                </FlareTreeItem>
                <FlareTreeItem Label="wwwroot" Icon="@FlareIcons.Folder" />
                <FlareTreeItem Label="README.md" Icon="@MaterialDesign3Icons.Regular.Article" />
            </FlareTreeView>
        </FlareToolPanel>
    </LeftToolPanel>

    <ChildContent>
        <FlareDocumentTabs OnTabChanged="OnDocTab">
            <FlareDocumentTab Title="Program.cs" Icon="@MaterialDesign3Icons.Regular.Description" Modified="true">
                <FlareText Element="pre" Typo="TypographyScale.BodySmall" Mono Block
                           Margin="FlareSpacing.None" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">var builder = WebApplication.CreateBuilder(args);
builder.Services.AddFlare();

var app = builder.Build();
app.MapRazorComponents&lt;App&gt;();
app.Run();</FlareText>
            </FlareDocumentTab>
            <FlareDocumentTab Title="README.md" Icon="@MaterialDesign3Icons.Regular.Article">
                <FlareStack Gap="FlareSpacing.XXSmall" Padding="FlareSpacing.Custom" PaddingValue="0.75rem">
                    <FlareText Typo="TypographyScale.TitleMedium">Flare IDE</FlareText>
                    <FlareText Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                        A desktop-style shell built from Flare components.
                    </FlareText>
                </FlareStack>
            </FlareDocumentTab>
            <FlareDocumentTab Title="App.razor" Icon="@MaterialDesign3Icons.Regular.Code" Closeable="false">
                <FlareText Element="pre" Typo="TypographyScale.BodySmall" Mono Block
                           Margin="FlareSpacing.None" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">&lt;FlareThemeProvider&gt;
    &lt;Routes /&gt;
&lt;/FlareThemeProvider&gt;</FlareText>
            </FlareDocumentTab>
        </FlareDocumentTabs>
    </ChildContent>

    <RightToolPanel>
        <FlareToolPanel Title="Properties" Position="ToolPanelPosition.Right" Mode="IdePanelMode.AutoHide">
            <FlareDescriptionList>
                <FlareDescriptionItem Label="Name">Program.cs</FlareDescriptionItem>
                <FlareDescriptionItem Label="Type">C# Source</FlareDescriptionItem>
                <FlareDescriptionItem Label="Size">1.2 KB</FlareDescriptionItem>
            </FlareDescriptionList>
        </FlareToolPanel>
    </RightToolPanel>

    <BottomPanel>
        <FlareToolPanel Title="Output" Position="ToolPanelPosition.Bottom">
            <FlareTabs>
                <FlareTab Label="Output">
                    <FlareText Element="pre" Typo="TypographyScale.BodySmall" Mono Block
                               Margin="FlareSpacing.None" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">Build started...
Build succeeded. 0 errors, 0 warnings.</FlareText>
                </FlareTab>
                <FlareTab Label="Error List" Badge="2">
                    <FlareStack Gap="FlareSpacing.XXSmall" Padding="FlareSpacing.Custom" PaddingValue="0.25rem 0.5rem">
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@FlareIcons.Error" Color="FlareColor.Error" />
                            <FlareText Typo="TypographyScale.BodySmall">CS0103: The name 'foo' does not exist (Program.cs, 12)</FlareText>
                        </FlareStack>
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@FlareIcons.Warning" Color="FlareColor.Tertiary" />
                            <FlareText Typo="TypographyScale.BodySmall">CS0168: Variable 'x' is declared but never used (Startup.cs, 8)</FlareText>
                        </FlareStack>
                    </FlareStack>
                </FlareTab>
                <FlareTab Label="Terminal">
                    <FlareText Element="pre" Typo="TypographyScale.BodySmall" Mono Block
                               Margin="FlareSpacing.None" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">PS C:\src&gt; dotnet run
Listening on http://localhost:5000</FlareText>
                </FlareTab>
            </FlareTabs>
        </FlareToolPanel>
    </BottomPanel>

    <StatusBar>
        <FlareStatusBar>
            <LeftContent>Ln 4, Col 18</LeftContent>
            <CenterContent>@_status</CenterContent>
            <RightContent>UTF-8 &nbsp;|&nbsp; C#</RightContent>
        </FlareStatusBar>
    </StatusBar>
</FlareIdeLayout>
</FlareCard>

@code {
    private string _status = "Ready";

    private void Set(string action) => _status = action;
    private void OnRibbonTab(string? title) => _status = $"Ribbon: {title}";
    private void OnDocTab(string title) => _status = $"Opened {title}";
}
