@using Flare.Components.IDE
@using Flare.Icons
@inherits LocalizedPage

<FlareStack Gap="FlareSpacing.Medium">
    <FlareSelect TValue="DockDropZones" @bind-Value="_dropZones" Items="_zoneModes"
                 ItemLabel="ZoneLabel" Label="@GalleryStrings.DockDemo_DropTargets"
                 data-testid="dock-drop-zones" />
    <FlareCheckbox TValue="bool" @bind-Value="_showDropGuide" Label="@GalleryStrings.DockDemo_ShowGuide" />
    <FlareStack Height="24rem">
        <FlareDockWorkspace id="dynamic-dock-demo" Layout="_layout" Items="Items" DropZones="_dropZones"
                            ShowDropGuide="_showDropGuide" AdaptiveTabCompression="true"
                            OnChangeRequested="Apply" GroupLabel="DescribeGroup">
            <ContentTemplate Context="item">
            @switch (item.Key)
            {
                case "data":
                    <FlareDataGrid Items="Rows" PageSize="8">
                        <Columns>
                            <FlareColumn Title="@GalleryStrings.DockDemo_Quarter" Field="@(row => row.Quarter)" />
                            <FlareColumn Title="@GalleryStrings.DockDemo_Total" Field="@(row => row.Total)" Sortable="true" />
                        </Columns>
                    </FlareDataGrid>
                    break;
                case "chart":
                    <FlareChart Type="ChartType.Bar" Title="@GalleryStrings.DockDemo_Chart" Data="Chart" />
                    break;
                case "draft":
                    <DockDraftDemo Label="@GalleryStrings.DockDemo_DraftLabel" />
                    break;
            }
        </ContentTemplate>
        </FlareDockWorkspace>
    </FlareStack>
</FlareStack>

@code {
    private static readonly ReportRow[] Rows = [new("Q1", 45), new("Q2", 62), new("Q3", 58), new("Q4", 71)];
    private static readonly ChartData Chart = new([new ChartSeries("2026", [45, 62, 58, 71])], ["Q1", "Q2", "Q3", "Q4"]);

    private const DockDropZones HorizontalZones = DockDropZones.Into | DockDropZones.Start | DockDropZones.End;
    private const DockDropZones EdgesZones =
        DockDropZones.Start | DockDropZones.End | DockDropZones.Top | DockDropZones.Bottom;
    private static readonly DockDropZones[] _zoneModes =
        [DockDropZones.All, HorizontalZones, EdgesZones, DockDropZones.None];

    private DockDropZones _dropZones = DockDropZones.All;
    private bool _showDropGuide = true;

    private DockNode _layout = new DockSplit("workspace", DockAxis.Horizontal,
        new DockGroup("reports", ["data", "draft"], "data"),
        new DockGroup("visuals", ["chart"], "chart"), 0.57);

    private IReadOnlyList<DockItem> Items =>
    [
        new("data", GalleryStrings.DockDemo_Data, Icon: FlareIcons.Table),
        new("chart", GalleryStrings.DockDemo_Chart, Icon: FlareIcons.GridOn),
        new("draft", GalleryStrings.DockDemo_Draft, KeepAlive: true)
    ];

    private void Apply(DockLayoutChange change)
    {
        if (ReferenceEquals(change.Previous, _layout))
            _layout = change.Proposed;
    }

    private string DescribeGroup(DockGroup group) =>
        group.Items.Length > 0 ? Items.First(item => item.Key == group.Items[0]).Title : GalleryStrings.DockDemo_Empty;

    private string ZoneLabel(DockDropZones zones) => zones switch
    {
        DockDropZones.All => GalleryStrings.DockDemo_ZonesAll,
        HorizontalZones => GalleryStrings.DockDemo_ZonesHorizontal,
        EdgesZones => GalleryStrings.DockDemo_ZonesEdges,
        _ => GalleryStrings.DockDemo_ZonesNone
    };

    private sealed record ReportRow(string Quarter, int Total);
}
