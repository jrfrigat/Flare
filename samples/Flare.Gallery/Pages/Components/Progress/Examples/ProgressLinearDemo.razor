@* The bare linear indicator. Anything a theme adds on top of it - MD3 Expressive's wave, say -
   is demonstrated in its own section, so this one shows what every theme gives you. *@
<FlareStack Gap="FlareSpacing.Large" MaxWidth="28rem">
    <FlareStack Gap="FlareSpacing.None">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem">25%</FlareText>
        <FlareProgressLinear aria-label="@GalleryStrings.Progress_Loading" Value="25" />
    </FlareStack>
    <FlareStack Gap="FlareSpacing.None">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem">@_value%</FlareText>
        <FlareProgressLinear aria-label="@GalleryStrings.Progress_Loading" Value="@_value" data-testid="progress-linear" />
    </FlareStack>
    <FlareStack Gap="FlareSpacing.None">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem">90%</FlareText>
        <FlareProgressLinear aria-label="@GalleryStrings.Progress_Loading" Value="90" Color="FlareColor.Success" />
    </FlareStack>
    <FlareStack Gap="FlareSpacing.None">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem">@GalleryStrings.Progress_Indeterminate</FlareText>
        <FlareProgressLinear aria-label="@GalleryStrings.Progress_Loading" data-testid="progress-linear-indeterminate" />
    </FlareStack>
    <FlareStack Gap="FlareSpacing.None">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem">@GalleryStrings.Progress_Thick</FlareText>
        <FlareProgressLinear aria-label="@GalleryStrings.Progress_Loading" Value="50" Size="TrackSize.Xl" />
    </FlareStack>
    <FlareStack Row="true" Align="FlareAlignItems.Start">
        <FlareButton OnClick="@(() => _value = _value == 70 ? 25 : 70)" data-testid="progress-linear-update">@GalleryStrings.Progress_UpdateValue</FlareButton>
    </FlareStack>
</FlareStack>

@code {
    private double _value = 70;
}
