@* Size is one step on the shared TrackSize scale - the same one FlareSlider and FlareMeter use. A single
   step drives BOTH variants: the circular diameter (and its stroke) and the linear track thickness. The
   steps are labels, not measurements: the theme owns what each is worth, so switching the theme rescales
   these. Md is the default, and the ramp runs both ways from it - a progress indicator wants room to go
   finer (an inline spinner in a table row) as readily as heavier. *@
<FlareStack Gap="FlareSpacing.Large">
    <FlareButton OnClick="@(() => _value = _value == 65 ? 25 : 65)" data-testid="progress-update">@GalleryStrings.Progress_UpdateValue</FlareButton>
    <FlareStack Row Gap="FlareSpacing.Large" Wrap Align="FlareAlignItems.Center">
        @foreach (var step in _steps)
        {
            <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                <FlareProgressCircular Value="@_value" Size="@step.Size" data-testid="progress-size" />
                <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@step.Label</FlareText>
            </FlareStack>
        }
    </FlareStack>

    <FlareStack Row Gap="FlareSpacing.Large" Wrap Align="FlareAlignItems.Center">
        @foreach (var step in _steps)
        {
            <FlareProgressCircular Size="@step.Size" data-testid="progress-spin-size" />
        }
    </FlareStack>
    <FlareText Color="FlareColor.OnSurfaceVariant">@GalleryStrings.Progress_SizeOverride</FlareText>
    <FlareStack Row Gap="FlareSpacing.Large" Wrap Style="--flare-progress-circular-size-md:calc(6rem + 4px);">
        <FlareProgressCircular Value="@_value" data-testid="progress-enlarged" />
        <FlareProgressCircular Class="@Flare.Css.Classes.Md3e.Progress.Wave" Value="@_value" data-testid="progress-wave-enlarged" />
        <FlareProgressCircular data-testid="progress-spin-enlarged" />
    </FlareStack>

    <FlareStack Gap="FlareSpacing.Medium" Style="max-width:30rem;">
        @foreach (var step in _steps)
        {
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@step.Label</FlareText>
                <FlareProgressLinear Value="65" Size="@step.Size" />
            </FlareStack>
        }
    </FlareStack>
</FlareStack>

@code {
    private double _value = 65;
    private readonly (TrackSize Size, string Label)[] _steps =
    [
        (TrackSize.Xs, "Xs"),
        (TrackSize.Sm, "Sm"),
        (TrackSize.Md, "Md"),
        (TrackSize.Lg, "Lg"),
        (TrackSize.Xl, "Xl"),
    ];
}
