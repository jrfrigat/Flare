<FlareStack Row Gap="FlareSpacing.Medium" Wrap>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgress Variant="ProgressVariant.Circular" Value="40" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">40%</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgress Variant="ProgressVariant.Circular" Value="75" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">75%</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgress Variant="ProgressVariant.Circular" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@GalleryStrings.Progress_Indeterminate</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgress Variant="ProgressVariant.Circular" Class="@Flare.Css.Classes.Md3e.Progress.Wave" Value="65" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@GalleryStrings.Progress_Wavy - 65%</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgress Variant="ProgressVariant.Circular" Class="@Flare.Css.Classes.Md3e.Progress.Wave" data-testid="progress-circular-wave-indeterminate" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@GalleryStrings.Progress_Wavy - @GalleryStrings.Progress_Indeterminate</FlareText>
    </FlareStack>
</FlareStack>
