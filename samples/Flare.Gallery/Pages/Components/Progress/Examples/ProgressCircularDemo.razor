@* The bare ring. The wave a theme can draw on it lives in its own section. *@
<FlareStack Row Gap="FlareSpacing.Medium" Wrap>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgressCircular Value="40" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">40%</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgressCircular Value="75" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">75%</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgressCircular data-testid="progress-circular-indeterminate" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@GalleryStrings.Progress_Indeterminate</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareProgressCircular Value="60" Color="FlareColor.Success" />
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">60%</FlareText>
    </FlareStack>
</FlareStack>
