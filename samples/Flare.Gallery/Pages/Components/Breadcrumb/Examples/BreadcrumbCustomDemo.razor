@* An item may carry an icon, so a trail starts with a home glyph without hand-written list markup. *@
<FlareBreadcrumb AriaLabel="@GalleryStrings.Breadcrumb_Custom_Aria" Items="_items" />

@code {
    private static readonly BreadcrumbItem[] _items =
    [
        new(GalleryStrings.Breadcrumb_Custom_Home, "", Icon: MaterialDesign3Icons.Regular.Home),
        new(GalleryStrings.Breadcrumb_Custom_Current),
    ];
}
