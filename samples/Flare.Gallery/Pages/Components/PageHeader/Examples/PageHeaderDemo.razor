@* HeadingLevel 2 keeps the demo out of this page's outline; a real page keeps the default h1.
   Narrow the window: the title gets smaller and the actions move under the text. *@
<FlarePageHeader Eyebrow="@GalleryStrings.PageHeader_Eyebrow" Title="@GalleryStrings.PageHeader_DemoTitle"
                 Description="@GalleryStrings.PageHeader_DemoDescription" HeadingLevel="2">
    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.PageHeader_Export</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled">@GalleryStrings.PageHeader_NewProject</FlareButton>
    </ActionsContent>
</FlarePageHeader>
