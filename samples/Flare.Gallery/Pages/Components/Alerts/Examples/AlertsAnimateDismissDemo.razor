@if (_showAnimatedAlert)
{
    <FlareAlert Severity="AlertSeverity.Info" Title="@GalleryStrings.AlertDemo_AnimateTitle" AnimateDismiss="true"
                Dismissible="true" OnClose="@(() => _showAnimatedAlert = false)">
        @GalleryStrings.AlertDemo_AnimateBody
    </FlareAlert>
}
else
{
    <FlareButton OnClick="@(() => _showAnimatedAlert = true)">@GalleryStrings.AlertDemo_Reset</FlareButton>
}

@code
{
    private bool _showAnimatedAlert = true;
}
