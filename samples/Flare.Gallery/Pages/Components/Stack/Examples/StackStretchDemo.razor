@* StretchItems: every child shares the row equally. StretchFirst: only the first child grows.
   StretchLast: only the last child grows (a fixed leading control + a pane that fills the rest). *@
<FlareStack Gap="FlareSpacing.Large">
    <FlareStack Row Wrap StretchItems Gap="FlareSpacing.Small">
        <FlarePaper Elevation="1" Padding="FlareSpacing.Small"><FlareText Align="TextAlign.Center">A</FlareText></FlarePaper>
        <FlarePaper Elevation="1" Padding="FlareSpacing.Small"><FlareText Align="TextAlign.Center">B</FlareText></FlarePaper>
        <FlarePaper Elevation="1" Padding="FlareSpacing.Small"><FlareText Align="TextAlign.Center">C</FlareText></FlarePaper>
    </FlareStack>

    <FlareStack Row Wrap StretchFirst Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
        <FlareTextField Placeholder="Grows to fill the row" />
        <FlareButton Variant="ButtonVariant.Filled">Send</FlareButton>
    </FlareStack>

    <FlareStack Row Wrap StretchLast Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
        <FlareButton Variant="ButtonVariant.Outlined">Filter</FlareButton>
        <FlareTextField Placeholder="Fills the rest of the row" />
    </FlareStack>
</FlareStack>
