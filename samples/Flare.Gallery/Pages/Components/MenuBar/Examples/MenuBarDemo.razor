@using Flare.Components.IDE

@* FlareMenuBar: a real top-level menu bar. The bar coordinates its FlareMenu activators: one menu is
   open at a time, and clicking or hovering another title switches straight to it in one step. *@
<FlareStack Gap="FlareSpacing.Small">
    <FlareCard Variant="CardVariant.Outlined" Padding="FlareSpacing.None">
        <FlareMenuBar>
            <FlareMenu Anchor="MenuAnchor.BottomLeft" AriaLabel="File menu">
                <Activator>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" @attributes="context.Attributes">File</FlareButton>
                </Activator>
                <ChildContent>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.NoteAdd" Shortcut="Ctrl+N" OnClick="@(() => Set("File > New"))">New</FlareMenuItem>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.FolderOpen" Shortcut="Ctrl+O" OnClick="@(() => Set("File > Open"))">Open</FlareMenuItem>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Save" Shortcut="Ctrl+S" OnClick="@(() => Set("File > Save"))">Save</FlareMenuItem>
                    <FlareMenuSeparator />
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Logout" Shortcut="Alt+F4" OnClick="@(() => Set("File > Exit"))">Exit</FlareMenuItem>
                </ChildContent>
            </FlareMenu>
            <FlareMenu Anchor="MenuAnchor.BottomLeft" AriaLabel="Edit menu">
                <Activator>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" @attributes="context.Attributes">Edit</FlareButton>
                </Activator>
                <ChildContent>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.ContentCut" Shortcut="Ctrl+X" OnClick="@(() => Set("Edit > Cut"))">Cut</FlareMenuItem>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.ContentCopy" Shortcut="Ctrl+C" OnClick="@(() => Set("Edit > Copy"))">Copy</FlareMenuItem>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.ContentPaste" Shortcut="Ctrl+V" OnClick="@(() => Set("Edit > Paste"))">Paste</FlareMenuItem>
                </ChildContent>
            </FlareMenu>
            <FlareMenu Anchor="MenuAnchor.BottomLeft" AriaLabel="View menu">
                <Activator>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" @attributes="context.Attributes">View</FlareButton>
                </Activator>
                <ChildContent>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.AccountTree" OnClick="@(() => Set("View > Solution Explorer"))">Solution Explorer</FlareMenuItem>
                    <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Terminal" OnClick="@(() => Set("View > Terminal"))">Terminal</FlareMenuItem>
                    <FlareMenuSeparator />
                    <FlareMenuItem Checked="_wordWrap" AutoClose="false" Shortcut="Alt+Z" OnClick="@(() => _wordWrap = !_wordWrap)">Word wrap</FlareMenuItem>
                </ChildContent>
            </FlareMenu>
        </FlareMenuBar>
    </FlareCard>

    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
        Last command: <FlareText Element="strong" Inherit>@_status</FlareText>
    </FlareText>
</FlareStack>

@code {
    private string _status = "(none)";
    private bool _wordWrap;

    private void Set(string action) => _status = action;
}
