@implements IDisposable
@* A local state machine, no request: error -> loading -> loaded. Retry ends with focus on the result, so
   a keyboard user does not land back on the page body when the error block disappears. *@
<FlareStack Row Wrap Justify="FlareJustifyContent.Center" Style="padding:2rem 1rem;">
    @if (_state == LoadState.Error)
    {
        <FlareEmptyState Title="@GalleryStrings.EmptyState_ErrorTitle"
                         Description="@GalleryStrings.EmptyState_ErrorBody">
            <IconContent>
                <FlareIconView Size="3rem" Color="FlareColor.Error" Value="@MaterialDesign3Icons.Regular.Error" />
            </IconContent>
            <ActionContent>
                <FlareButton @ref="_retryButton" Variant="ButtonVariant.Outlined" OnClick="RetryAsync">@GalleryStrings.EmptyState_Retry</FlareButton>
            </ActionContent>
        </FlareEmptyState>
    }
    else if (_state == LoadState.Loading)
    {
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
            <FlareProgressCircular />
            <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.EmptyState_Loading</FlareText>
        </FlareStack>
    }
    else
    {
        <FlareStack @ref="_loaded" tabindex="-1" Style="outline:none;width:100%;max-width:32rem">
            <FlareStack Gap="FlareSpacing.Small">
                <FlareText Typo="TypographyScale.TitleMedium">@GalleryStrings.EmptyState_LoadedTitle</FlareText>
                @foreach (var item in _items)
                {
                    <FlareText Typo="TypographyScale.BodyMedium">@item</FlareText>
                }
                <FlareButton Variant="ButtonVariant.Text" OnClick="SimulateFailure">@GalleryStrings.EmptyState_FailAgain</FlareButton>
            </FlareStack>
        </FlareStack>
    }
</FlareStack>

@code {
    private enum LoadState { Error, Loading, Loaded }

    private static readonly string[] _items = ["Row 12", "Row 18", "Row 21"];

    private LoadState _state = LoadState.Error;
    private bool _focusLoaded;
    private bool _focusRetry;
    private bool _disposed;
    private FlareStack? _loaded;
    private FlareButton? _retryButton;

    private async Task RetryAsync()
    {
        _state = LoadState.Loading;
        await Task.Delay(500);
        if (_disposed) return;
        _state = LoadState.Loaded;
        _focusLoaded = true;
    }

    private void SimulateFailure()
    {
        _state = LoadState.Error;
        _focusRetry = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLoaded)
        {
            _focusLoaded = false;
            try { if (_loaded is not null) await _loaded.FocusAsync(); }
            catch (JSException) { }
        }
        if (_focusRetry)
        {
            _focusRetry = false;
            try { if (_retryButton is not null) await _retryButton.FocusAsync(); }
            catch (JSException) { }
        }
    }

    public void Dispose() => _disposed = true;
}
