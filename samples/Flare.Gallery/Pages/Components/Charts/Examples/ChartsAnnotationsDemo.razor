@inherits LocalizedPage
@* Annotations are placed in DATA coordinates and follow a zoom. Threshold and Band answer "where is
   the line"; Arrow, Segment and At answer "what happened here". Colors are FlareColor, so a semantic
   role resolves through the theme instead of freezing a literal. *@
<FlareStack Gap="FlareSpacing.Large">
    <FlareChart Data="_data" Annotations="_annotations" Height="280" ShowMarkers="true"
                Title="@GalleryStrings.ChartsDemo_Annotations" />

    <FlareChart Type="ChartType.Bar" Data="_data" Annotations="_bandOnly" Height="220"
                Title="@GalleryStrings.ChartsDemo_Band" />

    @* Layer decides which side of the data the overlay is on. A translucent band over the values
       washes them out; the same band behind them reads as the background of the period. *@
    <FlareGrid Gap="FlareSpacing.Large">
        <FlareCol Xs="12" Md="6">
            <FlareChart Type="ChartType.Bar" Data="_data" Annotations="_bandOver" Height="220"
                    Title="@GalleryStrings.ChartsDemo_Over" />
        </FlareCol>
        <FlareCol Xs="12" Md="6">
            <FlareChart Type="ChartType.Bar" Data="_data" Annotations="_bandUnder" Height="220"
                    Title="@GalleryStrings.ChartsDemo_Under" />
        </FlareCol>
    </FlareGrid>
</FlareStack>
