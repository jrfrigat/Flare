@implements IDisposable

<FlareStack Gap="FlareSpacing.Large">
    <FlareStack Row="true" Gap="FlareSpacing.Large" Wrap="true" Align="FlareAlignItems.Center">
        <FlareSwitch @bind-Value="_running" Label="@GalleryStrings.Charts_UpdatesLive" />
        <FlareSwitch @bind-Value="_showAnimate" Label="@GalleryStrings.Charts_UpdatesEnter" />
        <FlareButton OnClick="UpdateData" data-testid="chart-update-data">@GalleryStrings.Charts_UpdateData</FlareButton>
    </FlareStack>

    <FlareGrid Gap="FlareSpacing.Large">
        <FlareCol Xs="12" Md="@(_showAnimate ? 4 : 6)">
            <FlareChart Type="ChartType.Line" Height="220" StickyDomain="true"
                        Title="@GalleryStrings.Charts_UpdatesInstant" Data="@_data" data-testid="chart-instant" />
        </FlareCol>
        <FlareCol Xs="12" Md="@(_showAnimate ? 4 : 6)">
            <FlareChart Type="ChartType.Line" Height="220" StickyDomain="true" AnimateUpdates="true"
                        Title="@GalleryStrings.Charts_UpdatesMoving" Data="@_data" data-testid="chart-moving" />
        </FlareCol>
        @if (_showAnimate)
        {
            <FlareCol Xs="12" Md="4">
                <FlareChart Type="ChartType.Line" Height="220" StickyDomain="true" Animate="true"
                            Title="@GalleryStrings.Charts_UpdatesRedraw" Data="@_data" />
            </FlareCol>
        }
    </FlareGrid>

    <FlareChart Type="ChartType.Bar" Height="200" StickyDomain="true" AnimateUpdates="true"
                Title="@GalleryStrings.Charts_UpdatesBars"
                Data="@_data" ShowValues="true" data-testid="chart-moving-bars" />
    <FlareChart Type="ChartType.Line" Sparkline="true" Height="80" StickyDomain="true" AnimateUpdates="true"
                Title="@GalleryStrings.Charts_UpdatesSparkline" Data="@_data" data-testid="chart-moving-sparkline" />
</FlareStack>

@code {
    private const int Window = 12;

    private Timer? _timer;
    private bool _running = true;
    private bool _showAnimate;
    private readonly Random _random = new(11);
    private readonly List<double> _values = [];
    private ChartData? _data;

    protected override void OnInitialized()
    {
        for (var i = 0; i < Window; i++) _values.Add(Next());
        Rebuild();
        _timer = new Timer(_ => Tick(), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private void Tick()
    {
        if (!_running) return;
        _ = InvokeAsync(() => { UpdateData(); StateHasChanged(); });
    }

    private void UpdateData()
    {
        for (var i = 0; i < _values.Count; i++) _values[i] = Next();
        Rebuild();
    }

    private double Next() => 30 + _random.Next(70);

    private void Rebuild() =>
        _data = new ChartData(
            [new ChartSeries("req/s", [.. _values])],
            [.. Enumerable.Range(1, _values.Count).Select(i => i.ToString())]);

    public void Dispose() => _timer?.Dispose();
}
