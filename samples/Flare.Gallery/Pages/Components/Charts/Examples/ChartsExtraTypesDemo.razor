@inherits LocalizedPage
<FlareStack Gap="FlareSpacing.Large">
    <FlareChart Type="ChartType.Combo" Title="@GalleryStrings.ChartsDemo_Combo" Data="_combo" Annotations="_targets" />

    <FlareGrid Gap="FlareSpacing.Large">
        <FlareCol Xs="12" Md="6">
            <FlareChart Type="ChartType.Rose" Title="@GalleryStrings.ChartsDemo_Rose" Data="_radial" />
        </FlareCol>
        <FlareCol Xs="12" Md="6">
            <FlareChart Type="ChartType.PolarArea" Title="@GalleryStrings.ChartsDemo_Polar" Data="_radial" />
        </FlareCol>
    </FlareGrid>

    <FlareGrid Gap="FlareSpacing.Large">
        <FlareCol Xs="12" Md="6">
            <FlareChart Type="ChartType.Bubble" Title="@GalleryStrings.ChartsDemo_Bubble" Data="_bubble" />
        </FlareCol>
        <FlareCol Xs="12" Md="6">
            <FlareChart Type="ChartType.Line" Title="@GalleryStrings.ChartsDemo_Trend" Data="_trend" TrendLine="true" />
        </FlareCol>
    </FlareGrid>
</FlareStack>
