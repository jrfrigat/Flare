@* Virtual renders only the cards in view; the board's own height bounds the columns. *@
<FlareStack Gap="FlareSpacing.Small">
    <FlareStack Height="420px">
        <FlareKanban Columns="_columns" @bind-Cards="_cards" Virtual="true" Class="@Css.Classes.Fill.Root" />
    </FlareStack>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
        @string.Format(GalleryStrings.Kanban_Virtual_Hint, _cards.Count)
    </FlareText>
</FlareStack>

@code {
    private readonly List<KanbanColumn> _columns =
    [
        new("backlog", GalleryStrings.Kanban_Templates_Backlog, "#94a3b8"),
        new("done", GalleryStrings.Kanban_Templates_Done, "#10b981"),
    ];

    private IReadOnlyList<KanbanCard> _cards = Enumerable.Range(1, 600)
        .Select(i => new KanbanCard($"V-{i}", i % 3 == 0 ? "done" : "backlog",
            string.Format(GalleryStrings.Kanban_Virtual_Card, i)))
        .ToList();
}
