<FlareCarousel TItem="SlideData" Items="_slides" AutoPlay="true" AutoPlayIntervalMs="2500">
    <ItemTemplate Context="slide">
        <FlareStack Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Center" Gap="FlareSpacing.Small"
                    Padding="FlareSpacing.Custom" PaddingValue="3rem 1rem" MinHeight="200px"
                    Background="@(FlareColor.Custom(slide.Color))">
            <FlareIconView Size="3rem" Color="FlareColor.OnSurface" Value="@GalleryIcons.Resolve(slide.Icon)" />
            <FlareText Typo="TypographyScale.TitleMedium">@slide.Label</FlareText>
        </FlareStack>
    </ItemTemplate>
</FlareCarousel>
<FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">
    Auto-advances every 2.5 seconds.
</FlareText>