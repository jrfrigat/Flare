@* No image and no text: the avatar shows a fallback. Default is "person"; FallbackIcon picks any
   Material Symbol, and FallbackContent supplies fully custom content. *@
<FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Center">
    <FlareAvatar Size="FlareSize.Lg" />
    <FlareAvatar Size="FlareSize.Lg" FallbackIcon="@MaterialDesign3Icons.Regular.Group" Color="@Colors.Secondary" />
    <FlareAvatar Size="FlareSize.Lg" FallbackIcon="@MaterialDesign3Icons.Regular.SmartToy" Color="@Colors.Tertiary" />
    <FlareAvatar Size="FlareSize.Lg" Color="@Colors.Primary">
        <FallbackContent><FlareIconView Value="@MaterialDesign3Icons.Regular.RocketLaunch" /></FallbackContent>
    </FlareAvatar>
</FlareStack>
