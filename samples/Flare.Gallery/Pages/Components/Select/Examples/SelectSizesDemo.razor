<FlareStack Gap="FlareSpacing.Medium" MaxWidth="28rem">
    <FlareSelect TValue="string" Size="FieldSize.Xs" Label="Extra small (xs)" @bind-Value="_xs" Items="_options" ItemLabel="OptionLabel" />
    <FlareSelect TValue="string" Size="FieldSize.Sm" Label="Small (sm)" @bind-Value="_sm" Items="_options" ItemLabel="OptionLabel" />
    <FlareSelect TValue="string" Size="FieldSize.Md" Label="Medium (md, default)" @bind-Value="_md" Items="_options" ItemLabel="OptionLabel" />
    <FlareSelect TValue="string" Size="FieldSize.Lg" Label="Large (lg)" @bind-Value="_lg" Items="_options" ItemLabel="OptionLabel" />
    <FlareSelect TValue="string" Size="FieldSize.Xl" Label="Extra large (xl)" @bind-Value="_xl" Items="_options" ItemLabel="OptionLabel" />
</FlareStack>

@code {
    private string? _xs;
    private string? _sm;
    private string? _md;
    private string? _lg;
    private string? _xl;

    private static readonly string[] _options = ["a", "b"];

    private static string OptionLabel(string option) => option == "a" ? "Option A" : "Option B";
}
