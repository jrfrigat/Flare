@* NullOption adds a selectable "no value" row: the filter case ("All", "Any") without a sentinel item
   of type T leaking into the model. The row is pinned, so typing in a searchable select never hides it,
   and the closed field shows its text instead of looking empty. *@
<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row Wrap Gap="FlareSpacing.Medium" MaxWidth="38rem">
        <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="14rem">
            <FlareSelect TValue="string" @bind-Value="_ingredient"
                         Items="_ingredients"
                         NullOption="All ingredients"
                         Label="Ingredient" />
        </FlareStack>

        <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="14rem">
            <FlareSelect TValue="string" @bind-Value="_cake"
                         Items="_cakes"
                         NullOption="Any cake"
                         Searchable Clearable
                         Label="Cake (searchable)" />
        </FlareStack>
    </FlareStack>

    @* A nullable value type works the same way; a non-nullable one throws, because default(int) is 0. *@
    <FlareStack MaxWidth="18rem">
        <FlareSelect TValue="int?" @bind-Value="_servings"
                     Items="_servingOptions"
                     NullOption="Any size"
                     Label="Servings" />
    </FlareStack>

    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
        Filter: @(_ingredient ?? "all") / @(_cake ?? "any") / @(_servings?.ToString() ?? "any")
    </FlareText>
</FlareStack>

@code {
    private string? _ingredient;
    private string? _cake;
    private int? _servings;

    private static readonly string[] _ingredients = ["Flour", "Sugar", "Butter", "Eggs", "Cocoa"];
    private static readonly string[] _cakes = ["Napoleon", "Medovik", "Sacher", "Red velvet", "Carrot"];
    private static readonly int?[] _servingOptions = [4, 6, 8, 12];
}
