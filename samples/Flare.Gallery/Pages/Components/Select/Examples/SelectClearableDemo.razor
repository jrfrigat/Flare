@* A short value in a wide field: the clear button belongs next to the arrow at the trailing edge,
   not in the free space between the value and the buttons. *@
<FlareStack Gap="FlareSpacing.Medium" MaxWidth="26rem">
    <FlareSelect TValue="string" @bind-Value="_status"
                 Items="_statuses"
                 Clearable="true"
                 Label="Status" />

    <FlareSelect TValue="string" @bind-Value="_searchable"
                 Items="_statuses"
                 Clearable="true"
                 Searchable="true"
                 Label="Status (searchable)" />

    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
        Selected: @(_status ?? "-") / @(_searchable ?? "-")
    </FlareText>
</FlareStack>

@code {
    private string? _status = "Active";
    private string? _searchable = "Paused";

    private static readonly string[] _statuses = ["Active", "Paused", "Closed"];
}
