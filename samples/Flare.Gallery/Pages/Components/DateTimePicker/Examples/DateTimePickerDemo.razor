@inherits LocalizedPage

<FlareStack Gap="FlareSpacing.Large" Style="max-width:24rem;">
    <FlareDateTimePicker @bind-Value="_value" Label="@GalleryStrings.DtpDemo_AutoLabel"
                         Placeholder="@GalleryStrings.DtpDemo_Placeholder"
                         HelperText="@GalleryStrings.DtpDemo_AutoHelper" />

    <FlareDateTimePicker @bind-Value="_tabsFields" Label="@GalleryStrings.DtpDemo_TabsFieldsLabel"
                         Mode="DateTimeVariant.Tabs" TimeVariant="TimePickerVariant.Dropdown" />

    <FlareDateTimePicker @bind-Value="_tabsDial" Label="@GalleryStrings.DtpDemo_TabsDialLabel"
                         Mode="DateTimeVariant.Tabs" TimeVariant="TimePickerVariant.Dial" />

    <FlareDateTimePicker @bind-Value="_panelsDial" Label="@GalleryStrings.DtpDemo_PanelsDialLabel"
                         Mode="DateTimeVariant.Panels" TimeVariant="TimePickerVariant.Dial" />

    <FlareDateTimePicker @bind-Value="_panelsFields" Label="@GalleryStrings.DtpDemo_PanelsFieldsLabel"
                         Mode="DateTimeVariant.Panels" TimeVariant="TimePickerVariant.Dropdown" />

    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
        @string.Format(GalleryStrings.DtpDemo_Selected, _value?.ToString("g") ?? GalleryStrings.DtpDemo_None)
    </FlareText>
</FlareStack>

@code {
    private DateTimeOffset? _value;
    private DateTimeOffset? _tabsFields;
    private DateTimeOffset? _tabsDial;
    private DateTimeOffset? _panelsDial;
    private DateTimeOffset? _panelsFields;
}
