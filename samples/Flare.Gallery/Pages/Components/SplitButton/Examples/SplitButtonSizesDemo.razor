<FlareStack Row Gap="FlareSpacing.Large" Wrap Align="FlareAlignItems.Center">
    @foreach (var (size, label) in _sizes)
    {
        <FlareSplitButton Variant="ButtonVariant.Filled" Size="size">
            <ChildContent>@label</ChildContent>
            <MenuItems>
                <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.SaveAs">@GalleryStrings.SplitButton_SaveAs</FlareMenuItem>
                <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Download">@GalleryStrings.SplitButton_Export</FlareMenuItem>
            </MenuItems>
        </FlareSplitButton>
    }
</FlareStack>

@code {
    private readonly (ButtonSize Size, string Label)[] _sizes =
    [
        (ButtonSize.Xs, GalleryStrings.IconButton_AriaXSmall),
        (ButtonSize.Sm, GalleryStrings.ButtonExtras_AriaSmall),
        (ButtonSize.Md, GalleryStrings.ButtonExtras_AriaMedium),
        (ButtonSize.Lg, GalleryStrings.ButtonExtras_AriaLarge),
        (ButtonSize.Xl, GalleryStrings.IconButton_AriaXLarge),
    ];
}
