@inherits LocalizedPage

<FlareStack Row Wrap Gap="FlareSpacing.Large" MaxWidth="36rem">
    <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="14rem">
        <FlareDatePicker @bind-Value="_date" Label="@GalleryStrings.DpDemo_ThisMonthLabel"
                         Min="_min" Max="_max"
                         HelperText="@GalleryStrings.DpDemo_ThisMonthHelper"
                         TodayText="@GalleryStrings.DpDemo_TodayText" ClearText="@GalleryStrings.DpDemo_ClearText"
                         ShowTodayButton="true" ShowClearButton="true" />
    </FlareStack>
    <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="14rem">
        <FlareDatePicker @bind-Value="_weekday" Label="@GalleryStrings.DpDemo_WeekdaysLabel"
                         IsDateDisabled="@(d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)"
                         HelperText="@GalleryStrings.DpDemo_WeekdaysHelper" />
    </FlareStack>
    <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="14rem">
        <FlareDatePicker @bind-Value="_localized" Label="@GalleryStrings.DpDemo_GermanLabel"
                         Culture="_deCulture"
                         HelperText="@GalleryStrings.DpDemo_GermanHelper" />
    </FlareStack>
    <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="14rem">
        <FlareDatePicker @bind-Value="_required" Label="@GalleryStrings.DpDemo_RequiredLabel"
                         ErrorText="@(_required is null ? GalleryStrings.DpDemo_RequiredError : null)" HasError="_required is null" />
    </FlareStack>
</FlareStack>

@code {
    private DateOnly? _date;
    private DateOnly? _weekday;
    private DateOnly? _localized;
    private DateOnly? _required;
    private readonly System.Globalization.CultureInfo _deCulture = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    private readonly DateOnly _min = DateOnly.FromDateTime(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1));
    private readonly DateOnly _max = DateOnly.FromDateTime(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1));
}
