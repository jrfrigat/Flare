<FlareStack Gap="FlareSpacing.Small">
    <FlareText Typo="TypographyScale.BodyMedium">Above divider</FlareText>
    <FlareStack MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.75rem"
                MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.75rem">
        <FlareDivider />
    </FlareStack>
    <FlareText Typo="TypographyScale.BodyMedium">Below divider</FlareText>
    <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Center" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.75rem" Height="2rem">
        <FlareText Typo="TypographyScale.BodyMedium">Left</FlareText>
        <FlareDivider Vertical="true" />
        <FlareText Typo="TypographyScale.BodyMedium">Right</FlareText>
    </FlareStack>
</FlareStack>
