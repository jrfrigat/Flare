<FlareStack MaxWidth="32rem">
    <FlareCard Variant="CardVariant.Outlined" Height="380px" Padding="FlareSpacing.Custom" PaddingValue="0" Overflow="auto">
        <FlareInfiniteScroll OnLoadMore="LoadMore" HasMore="@_hasMore" RootMargin="120px">
            <ChildContent>
                <FlareList TItem="object">
                    @foreach (var item in _feed)
                    {
                        <FlareListItem Primary="@item.Title" Secondary="@item.Time">
                            <Leading><FlareAvatar FallbackIcon="@MaterialDesign3Icons.Regular.Article" Color="FlareColor.Primary" /></Leading>
                        </FlareListItem>
                    }
                </FlareList>
            </ChildContent>
            <LoadingContent>
                <FlareStack Row Wrap Gap="FlareSpacing.Small" Align="FlareAlignItems.Center" Padding="FlareSpacing.Custom" PaddingValue="1rem" Justify="FlareJustifyContent.Center">
                    <FlareProgressCircular Size="TrackSize.Xs" />
                    <FlareText Typo="TypographyScale.BodySmall">Loading more…</FlareText>
                </FlareStack>
            </LoadingContent>
            <EndContent>
                <FlareText Typo="TypographyScale.BodySmall" Align="TextAlign.Center" Padding="FlareSpacing.Custom" PaddingValue="1rem" Block>You've reached the end</FlareText>
            </EndContent>
        </FlareInfiniteScroll>
    </FlareCard>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">
        Scroll to the bottom to load more. @_feed.Count items loaded.
    </FlareText>
</FlareStack>

@code {
    record FeedItem(string Title, string Time);

    private List<FeedItem> _feed = [];
    private bool _hasMore = true;
    private int _page;

    protected override void OnInitialized()
    {
        _feed = Enumerable.Range(1, 15)
            .Select(i => new FeedItem($"Article #{i}", $"{i} min ago"))
            .ToList();
        _page = 1;
    }

    private async Task LoadMore()
    {
        await Task.Delay(800);
        _page++;
        int start = (_page - 1) * 15 + 1;
        _feed.AddRange(Enumerable.Range(start, 15)
            .Select(i => new FeedItem($"Article #{i}", $"{i} min ago")));
        if (_page >= 4) _hasMore = false;
    }
}
