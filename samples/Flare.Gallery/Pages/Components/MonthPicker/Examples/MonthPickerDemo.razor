@using System.Globalization
@inherits LocalizedPage

<FlareStack Row Wrap Gap="FlareSpacing.Large" MaxWidth="48rem">
    <FlareStack Gap="FlareSpacing.Large" FlexGrow="1" MinWidth="16rem">
        <FlareMonthPicker @bind-Value="_period" Label="@GalleryStrings.MpDemo_PeriodLabel"
                          HelperText="@GalleryStrings.MpDemo_PeriodHelper" />
        <FlareMonthPicker @bind-Value="_expiry" Label="@GalleryStrings.MpDemo_ExpiryLabel"
                          HelperText="@GalleryStrings.MpDemo_ExpiryHelper" Min="_thisMonth" Max="_inTenYears" />
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
            @string.Format(GalleryStrings.MpDemo_Value, _period?.ToString("yyyy-MM-dd") ?? "-")
        </FlareText>
    </FlareStack>
    <FlareStack FlexGrow="1" MinWidth="16rem">
        <FlareMonthPicker @bind-Value="_persian" Label="@GalleryStrings.MpDemo_PersianLabel"
                          HelperText="@GalleryStrings.MpDemo_PersianHelper" Culture="_fa" Inline="true" />
    </FlareStack>
</FlareStack>

@code {
    private static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    private readonly DateOnly _thisMonth = new(Today.Year, Today.Month, 1);
    private readonly DateOnly _inTenYears = new(Today.Year + 10, 12, 31);
    private readonly CultureInfo _fa = CultureInfo.GetCultureInfo("fa-IR");
    private DateOnly? _period;
    private DateOnly? _expiry;
    private DateOnly? _persian = new(2026, 10, 3);
}
