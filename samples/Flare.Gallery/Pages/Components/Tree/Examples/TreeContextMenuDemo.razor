@using System.Globalization

@* The menu belongs to the page, not to a row: every row raises OnContextMenu with the pointer
   position and the host opens the one shared panel there with OpenAtAsync. The panel takes focus as
   any menu does, and closing it returns focus to the row the user right-clicked. *@
<FlareStack Gap="FlareSpacing.Small">
    <FlareText Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
        @GalleryStrings.Tree_ContextMenuHint
    </FlareText>

    <FlareTreeView AriaLabel="@GalleryStrings.Tree_ContextMenuTree">
        <FlareTreeItem Label="Sales" Icon="@MaterialDesign3Icons.Regular.TableChart"
                       OnContextMenu="@(e => OpenContextMenu("Sales", e))" />
        <FlareTreeItem Label="Orders" Icon="@MaterialDesign3Icons.Regular.TableChart"
                       OnContextMenu="@(e => OpenContextMenu("Orders", e))" />
        <FlareTreeItem Label="Customers" Icon="@MaterialDesign3Icons.Regular.TableChart">
            <ChildContent>
                <FlareTreeItem Label="Contacts" Icon="@MaterialDesign3Icons.Regular.TableChart"
                               OnContextMenu="@(e => OpenContextMenu("Contacts", e))" />
            </ChildContent>
        </FlareTreeItem>
    </FlareTreeView>

    <FlareMenu @ref="_menu" AriaLabel="@GalleryStrings.Tree_ContextMenu">
        <ChildContent>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Edit"
                           OnClick="@(() => ReportAction(GalleryStrings.Tree_ContextMenuRename))">@GalleryStrings.Tree_ContextMenuRename</FlareMenuItem>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.ContentCopy"
                           OnClick="@(() => ReportAction(GalleryStrings.Tree_ContextMenuDuplicate))">@GalleryStrings.Tree_ContextMenuDuplicate</FlareMenuItem>
            <FlareDivider />
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Delete"
                           OnClick="@(() => ReportAction(GalleryStrings.Tree_ContextMenuDelete))">@GalleryStrings.Tree_ContextMenuDelete</FlareMenuItem>
        </ChildContent>
    </FlareMenu>

    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
        @(_message ?? GalleryStrings.Tree_ContextMenuEmpty)
    </FlareText>
</FlareStack>

@code {
    private FlareMenu? _menu;
    private string? _row;
    private string? _message;

    private async Task OpenContextMenu(string row, MouseEventArgs e)
    {
        _row = row;
        _message = string.Format(CultureInfo.CurrentCulture, GalleryStrings.Tree_ContextMenuOpened, row);
        if (_menu is not null) await _menu.OpenAtAsync(e.ClientX, e.ClientY);
    }

    private void ReportAction(string action) =>
        _message = string.Format(CultureInfo.CurrentCulture, GalleryStrings.Tree_ContextMenuAction, _row, action);
}
