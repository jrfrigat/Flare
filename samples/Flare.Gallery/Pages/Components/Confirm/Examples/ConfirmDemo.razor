<FlareStack Gap="FlareSpacing.Small" dir="@(_rtl ? "rtl" : "ltr")">
<FlareSwitch @bind-Value="_rtl" Label="@GalleryStrings.ReviewDialog_Rtl" />
<FlareConfirmDialogProvider @ref="_provider">
    <FlareButton Variant="ButtonVariant.Outlined" OnClick="ShowConfirm">Delete item</FlareButton>
    <FlareButton Variant="ButtonVariant.Outlined" OnClick="ShowLongConfirm">@GalleryStrings.ReviewDialog_Long</FlareButton>
</FlareConfirmDialogProvider>
</FlareStack>

@if (_result.HasValue)
{
    <FlareStack MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.75rem">
        <FlareAlert Severity="@(_result.Value ? AlertSeverity.Success : AlertSeverity.Info)">
            Result: @(_result.Value ? "Confirmed" : "Cancelled")
        </FlareAlert>
    </FlareStack>
}

@code {
    private FlareConfirmDialogProvider? _provider;
    private bool? _result;
    private bool _rtl;

    private async Task ShowLongConfirm()
    {
        if (_provider is null) return;
        _result = await _provider.ConfirmAsync(GalleryStrings.ReviewDialog_LongTitle,
            string.Join("\n\n", Enumerable.Repeat(GalleryStrings.ReviewDialog_LongBody, 80)),
            GalleryStrings.ReviewDialog_LongYes, GalleryStrings.ReviewDialog_LongNo);
    }

    private async Task ShowConfirm()
    {
        if (_provider is not null)
            _result = await _provider.ConfirmAsync(
                "Delete item",
                "Are you sure you want to delete this item? This cannot be undone.",
                confirmLabel: "Delete",
                cancelLabel: "Keep");
    }
}
