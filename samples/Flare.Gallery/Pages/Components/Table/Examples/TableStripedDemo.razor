<FlareStack Padding="FlareSpacing.Custom" PaddingValue="0" Overflow="hidden">
    <FlareTable TItem="Person" Items="_people" Columns="_columns" Striped="true" Dense="true" />
</FlareStack>

@code {
    private sealed record Person(string Name, string Role, string City, int Score);

    private static readonly IReadOnlyList<FlareTableColumn<Person>> _columns =
    [
        new() { Header = "Name",  Field = p => p.Name },
        new() { Header = "Role",  Field = p => p.Role },
        new() { Header = "City",  Field = p => p.City },
        new() { Header = "Score", Field = p => p.Score },
    ];

    private readonly List<Person> _people =
    [
        new("Alice Johnson",   "Engineer",  "Berlin",     92),
        new("Bob Smith",       "Designer",  "London",     78),
        new("Carol Williams",  "Manager",   "Paris",      85),
        new("David Lee",       "Engineer",  "Tokyo",      91),
        new("Emma Davis",      "QA",        "New York",   74),
        new("Frank Miller",    "DevOps",    "Amsterdam",  88),
    ];
}
