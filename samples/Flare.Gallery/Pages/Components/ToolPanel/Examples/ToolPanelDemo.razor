@using Flare.Components.IDE

@* Standalone FlareToolPanel (outside a layout): a titled, collapsible dockable panel with an
   optional header toolbar (ShowToolbar + ToolbarContent). Collapsing shrinks the panel to a thin
   rail; bind Collapsed to drive it. Inside a FlareIdeLayout the layout owns collapse and the
   auto-hide flyout instead - see the Full IDE Layout example. *@
<FlareStack Row="true" Gap="FlareSpacing.Custom" GapValue="0.75rem" Height="280px" Align="FlareAlignItems.Stretch">
    <FlareCard Variant="CardVariant.Outlined" Width="240px" Padding="FlareSpacing.None">
        <FlareToolPanel Title="Explorer" ShowToolbar="true"
                        @bind-Collapsed="_explorerCollapsed">
            <ToolbarContent>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" AriaLabel="Refresh">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Refresh" />
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs" AriaLabel="Collapse all">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.UnfoldLess" />
            </FlareButton>
        </ToolbarContent>
        <ChildContent>
            <FlareTreeView AriaLabel="Explorer">
                <FlareTreeItem Label="src" Icon="@MaterialDesign3Icons.Regular.Folder" Expanded="true">
                    <FlareTreeItem Label="Program.cs" Icon="@MaterialDesign3Icons.Regular.Description" />
                    <FlareTreeItem Label="App.razor" Icon="@MaterialDesign3Icons.Regular.Code" />
                </FlareTreeItem>
                <FlareTreeItem Label="wwwroot" Icon="@MaterialDesign3Icons.Regular.Folder" />
                <FlareTreeItem Label="README.md" Icon="@MaterialDesign3Icons.Regular.Article" />
            </FlareTreeView>
        </ChildContent>
        </FlareToolPanel>
    </FlareCard>

    <FlareCard Variant="CardVariant.Outlined" Width="240px" Padding="FlareSpacing.None">
        <FlareToolPanel Title="Outline"
                        @bind-Collapsed="_outlineCollapsed">
            <FlareList TItem="object">
                <FlareListItem Primary="Main(string[] args)">
                    <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.DataObject" /></Leading>
                </FlareListItem>
                <FlareListItem Primary="ConfigureServices()">
                    <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.DataObject" /></Leading>
                </FlareListItem>
                <FlareListItem Primary="Configure(app)">
                    <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.DataObject" /></Leading>
                </FlareListItem>
            </FlareList>
        </FlareToolPanel>
    </FlareCard>

    <FlareStack FlexGrow="1">
        <FlarePaper Outlined="true" FillHeight="true">
            <FlareStack FillHeight="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Center"
                        Padding="FlareSpacing.Small">
                <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
                    Collapse a panel with its chevron - it frees space and shrinks to a rail.
                </FlareText>
            </FlareStack>
        </FlarePaper>
    </FlareStack>
</FlareStack>

@code {
    private bool _explorerCollapsed;
    private bool _outlineCollapsed = true;
}
