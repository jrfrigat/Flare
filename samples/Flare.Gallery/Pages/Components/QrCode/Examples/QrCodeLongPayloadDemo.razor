@inherits LocalizedPage

<div style="display:flex; gap:24px; flex-wrap:wrap; align-items:flex-end;">
    @foreach (var sample in Samples)
    {
        <div style="display:flex; flex-direction:column; align-items:center; gap:8px; max-width:200px;">
            <FlareQrCode Value="@sample.Payload" Size="180" />
            <span style="font-size:12px; color:var(--flare-color-on-surface-variant); text-align:center;">
                @sample.Caption &mdash; @sample.Payload.Length @GalleryStrings.QrCode_Bytes
            </span>
        </div>
    }
</div>

@code {
    private record Sample(string Caption, string Payload);

    // The encoder picks the smallest symbol version that fits, so these three
    // render at visibly different module densities from the same component.
    private static readonly Sample[] Samples =
    [
        new("URL", "https://jrfrigat.github.io/Flare/components/qrcode"),
        new("vCard", string.Join('\n',
            "BEGIN:VCARD", "VERSION:3.0", "N:Doe;Jane", "ORG:Example Ltd.",
            "TITLE:Design Engineer", "TEL;TYPE=WORK:+1-555-0100",
            "EMAIL:jane.doe@example.com", "URL:https://example.com/jane", "END:VCARD")),
        new("Wi-Fi + note", "WIFI:T:WPA;S:Flare-Guest;P:correct-horse-battery-staple;H:false;;"
            + " Guest network, please disconnect when you leave the building."),
    ];
}
