@inherits LocalizedPage

<FlareStack Row Wrap Gap="FlareSpacing.Large" Align="FlareAlignItems.End">
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="https://github.com/jrfrigat/Flare"
                     Size="180" CornerRadius="0.25" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">CornerRadius="0.25"</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="https://github.com/jrfrigat/Flare"
                     Size="180" CornerRadius="0.4" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">CornerRadius="0.4"</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="https://github.com/jrfrigat/Flare"
                     Size="180" CornerRadius="0.5"
                     ForeColor="#6750A4" BackColor="#F3EFF7" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">CornerRadius="0.5" (circles)</FlareText>
    </FlareStack>
</FlareStack>
