@inherits LocalizedPage

<FlareStack Row Wrap Gap="FlareSpacing.Large" Align="FlareAlignItems.End">
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="Hello Flare!"
                     Size="160" ErrorCorrectionLevel="QrErrorCorrectionLevel.L" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">L - ~7% recovery</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="Hello Flare!"
                     Size="160" ErrorCorrectionLevel="QrErrorCorrectionLevel.M" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">M - ~15% recovery (default)</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="Hello Flare!"
                     Size="160" ErrorCorrectionLevel="QrErrorCorrectionLevel.Q" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">Q - ~25% recovery</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="Hello Flare!"
                     Size="160" ErrorCorrectionLevel="QrErrorCorrectionLevel.H" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">H - ~30% recovery (use with icons)</FlareText>
    </FlareStack>
</FlareStack>
