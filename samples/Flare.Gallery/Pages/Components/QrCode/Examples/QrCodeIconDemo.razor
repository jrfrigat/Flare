@inherits LocalizedPage

<FlareStack Row Wrap Gap="FlareSpacing.Large" Align="FlareAlignItems.End">
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="https://github.com/jrfrigat/Flare"
                     Size="200"
                     ErrorCorrectionLevel="QrErrorCorrectionLevel.H"
                     IconUrl="favicon.png" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">IconUrl + ErrorCorrectionLevel.H</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="https://github.com/jrfrigat/Flare"
                     Size="200"
                     CornerRadius="0.4"
                     ForeColor="#1B5E20" BackColor="#F1F8E9"
                     ErrorCorrectionLevel="QrErrorCorrectionLevel.H"
                     IconUrl="favicon.png" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">Rounded + Icon + custom colors</FlareText>
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareQrCode Value="https://github.com/jrfrigat/Flare"
                     Size="200"
                     CornerRadius="0.5"
                     ForeColor="#6750A4" BackColor="#F3EFF7"
                     ErrorCorrectionLevel="QrErrorCorrectionLevel.H"
                     IconUrl="icon-192.png"
                     IconSize="44" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">Circle modules + Icon</FlareText>
    </FlareStack>
</FlareStack>
