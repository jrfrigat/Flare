@* One drag model, pointer-based, so it works with a mouse, a pen and a finger alike - native HTML5
   drag-and-drop fires nothing at all on a touch screen. Drag a card within a column to reorder it, or
   across to another column to move it. "Archive" refuses every card through Accepts, so it never lights
   up and never takes a drop.

   The whole handler is three statements, and it can be, because the drop reports the index the card
   ENDS UP at - counted with the dragged card already taken out. *@
<FlareDragContext TPayload="Card" Group="cards" OnDrop="Moved">
    <FlareStack Row="true" Gap="FlareSpacing.Medium" Wrap="true" Align="FlareAlignItems.Start">
        @foreach (var column in _order)
        {
            <FlareStack Width="13rem">
            <FlarePaper Elevation="1" Padding="FlareSpacing.Small">
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareText Typo="TypographyScale.LabelLarge">@column</FlareText>
                    <FlareStack MinHeight="5rem">
                    <FlareDropZone Target="@column"
                                   Placement="DropPlacement.Between"
                                   Accepts="@(_ => column != Archive)">
                        <FlareStack Gap="FlareSpacing.Small">
                            @foreach (var card in _columns[column])
                            {
                                <FlareDraggable @key="card.Id" Id="@card.Id" Payload="card">
                                    <FlareCard Variant="CardVariant.Filled" Padding="FlareSpacing.Custom" PaddingValue="0.5rem 0.75rem">
                                        <FlareText Typo="TypographyScale.BodyMedium">@card.Title</FlareText>
                                    </FlareCard>
                                </FlareDraggable>
                            }
                        </FlareStack>
                    </FlareDropZone>
                    </FlareStack>
                </FlareStack>
            </FlarePaper>
            </FlareStack>
        }
    </FlareStack>
</FlareDragContext>

<FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.75rem">
    @_last
</FlareText>

@code {
    private const string Archive = "Archive";

    private sealed record Card(string Id, string Title);

    private readonly List<string> _order = ["Backlog", "In progress", "Done", Archive];

    private readonly Dictionary<string, List<Card>> _columns = new()
    {
        ["Backlog"] = [new("c1", "Rework the export"), new("c2", "Audit the tokens"), new("c3", "Split the tests")],
        ["In progress"] = [new("c4", "Drag model")],
        ["Done"] = [new("c5", "Sticky domain")],
        [Archive] = [],
    };

    private string _last = "Nothing moved yet.";

    private void Moved(FlareDropEventArgs<Card> e)
    {
        foreach (var list in _columns.Values) list.Remove(e.Payload);
        if (!_columns.TryGetValue(e.TargetId, out var target)) return;
        target.Insert(Math.Clamp(e.Index < 0 ? target.Count : e.Index, 0, target.Count), e.Payload);
        _last = $"\"{e.Payload.Title}\": {e.SourceTargetId} -> {e.TargetId}, position {target.IndexOf(e.Payload) + 1}";
    }
}
