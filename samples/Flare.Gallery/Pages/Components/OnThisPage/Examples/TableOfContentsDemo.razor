@inject NavigationManager Nav

@* Manual block: every link points at a real section of this page. Its look follows the active theme
   (MD3 pill vs FluentUI2 rail). FlareOnThisPage builds this same block automatically. *@
<FlareGrid Columns="12" Gap="FlareSpacing.Large">
    <FlareCol Span="12" Md="8">
        <FlareStack Gap="FlareSpacing.Large">
            <FlareSection>
                <FlareText id="introduction" Typo="TypographyScale.HeadlineSmall">@GalleryStrings.TocDemo_Introduction</FlareText>
                <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.TocDemo_Section</FlareText>
            </FlareSection>
            <FlareSection>
                <FlareText id="installation" Typo="TypographyScale.HeadlineSmall">@GalleryStrings.TocDemo_Installation</FlareText>
                <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.TocDemo_Section</FlareText>
            </FlareSection>
            <FlareSection>
                <FlareText id="configuration" Typo="TypographyScale.HeadlineSmall">@GalleryStrings.TocDemo_Configuration</FlareText>
                <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.TocDemo_Section</FlareText>
            </FlareSection>
            <FlareSection>
                <FlareText id="theming" Typo="TypographyScale.HeadlineSmall">@GalleryStrings.TocDemo_Theming</FlareText>
                <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.TocDemo_Section</FlareText>
            </FlareSection>
            <FlareSection>
                <FlareText id="api" Typo="TypographyScale.HeadlineSmall">@GalleryStrings.TocDemo_Api</FlareText>
                <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.TocDemo_Section</FlareText>
            </FlareSection>
        </FlareStack>
    </FlareCol>
    <FlareCol Span="12" Md="4">
        <FlareStack Sticky="true" StickyTop="1rem">
        <FlareTableOfContents Title="@GalleryStrings.TocDemo_Contents">
            <FlareTocLink Href="@($"{_pagePath}#introduction")" Active="true">@GalleryStrings.TocDemo_Introduction</FlareTocLink>
            <FlareTocLink Href="@($"{_pagePath}#installation")">@GalleryStrings.TocDemo_Installation</FlareTocLink>
            <FlareTocLink Href="@($"{_pagePath}#configuration")">@GalleryStrings.TocDemo_Configuration</FlareTocLink>
            <FlareTocLink Href="@($"{_pagePath}#theming")">@GalleryStrings.TocDemo_Theming</FlareTocLink>
            <FlareTocLink Href="@($"{_pagePath}#api")">@GalleryStrings.TocDemo_Api</FlareTocLink>
        </FlareTableOfContents>
        </FlareStack>
    </FlareCol>
</FlareGrid>

@code {
    // A bare "#id" resolves against the base href, so Blazor would navigate to the site root; the link
    // carries the current page path instead, keeping the jump on this page.
    private string _pagePath
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            var hash = path.IndexOf('#');
            return hash >= 0 ? path[..hash] : path;
        }
    }
}
