<FlareGrid Columns="12" Gap="FlareSpacing.Large">
    <FlareCol Span="12" Md="8">
        @* The marker class is only a scan target for Root below; it carries no styling. *@
        <FlareStack class="toc-demo-content" Gap="FlareSpacing.Medium">
            <FlareText Typo="TypographyScale.HeadlineSmall" id="installation">Installation<SectionAnchor For="installation" /></FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">Add the NuGet package and register the theme provider. This heading carries its own id.</FlareText>
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">Scroll down to watch the active section track in the list on the right.</FlareText>
            <FlareSpacer Height="FlareSpacing.Custom" HeightValue="14rem" />

            <FlareText Typo="TypographyScale.TitleMedium">Prerequisites</FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">No id here - FlareOnThisPage slugifies the text and assigns one automatically.</FlareText>
            <FlareSpacer Height="FlareSpacing.Custom" HeightValue="14rem" />

            <FlareText Typo="TypographyScale.HeadlineSmall" id="usage">Usage<SectionAnchor For="usage" /></FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">Drop the component beside your content; the scroll container is detected automatically.</FlareText>
            <FlareSpacer Height="FlareSpacing.Custom" HeightValue="14rem" />

            <FlareText Typo="TypographyScale.TitleMedium">Configuration</FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">Hover a heading with an id to reveal its "#" - pressing it copies the link to that section.</FlareText>
            <FlareSpacer Height="FlareSpacing.Custom" HeightValue="14rem" />

            <FlareText Typo="TypographyScale.HeadlineSmall">Accessibility</FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">The active section is mirrored with aria-current as you scroll.</FlareText>
            <FlareSpacer Height="FlareSpacing.Custom" HeightValue="14rem" />
        </FlareStack>
    </FlareCol>

    <FlareCol Span="12" Md="4">
        <FlareStack Sticky="true" StickyTop="1rem">
            <FlareOnThisPage Root=".toc-demo-content"
                             HeadingSelector="h4, h5" />
        </FlareStack>
    </FlareCol>
</FlareGrid>

@* FlareOnThisPage scans .toc-demo-content; headings without an id get an auto-generated one. The "#"
   beside a heading is the Gallery's own SectionAnchor, not something FlareText draws. *@
