<FlareStack Row Gap="FlareSpacing.Large" Wrap Align="FlareAlignItems.Start">
    @foreach (var p in _placements)
    {
        <FlarePopover Open="@(_open == p)" OpenChanged="@(isOpen => SetOpen(p, isOpen))"
                      Placement="@p" Arrow="true" MinWidth="10rem" MaxWidth="14rem">
            <AnchorContent>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => _open = _open == p ? null : p)">
                    @p
                </FlareButton>
            </AnchorContent>
            <ChildContent>
                <FlareText Typo="TypographyScale.BodySmall" Style="padding:0.75rem 1rem;">
                    Placement = @p (MinWidth 10rem, MaxWidth 14rem)
                </FlareText>
            </ChildContent>
        </FlarePopover>
    }
</FlareStack>

@code {
    // The component owns dismissal (Escape, outside click) through OpenChanged; the anchor owns opening.
    // One-way Open here would leave the field true and re-open the panel on the next render.
    private Placement? _open;

    private void SetOpen(Placement placement, bool isOpen)
    {
        if (isOpen) _open = placement;
        else if (_open == placement) _open = null;
    }

    private static readonly Placement[] _placements =
    [
        Placement.Top, Placement.Bottom,
        Placement.Left, Placement.Right,
    ];
}
