@inherits LocalizedPage

@* A popover anchored inside another popover's panel: closing the outer one closes the inner one with it,
   while the inner one opens and closes on its own. Both carry the visual arrow so the anchor is obvious. *@
<FlarePopover @bind-Open="_filters" Placement="Placement.BottomStart" Arrow="true" MinWidth="16rem">
    <AnchorContent>
        <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => _filters = !_filters)">@GalleryStrings.Popover_NestedAnchor</FlareButton>
    </AnchorContent>
    <ChildContent>
        <FlareStack Gap="FlareSpacing.XSmall" Style="padding:1rem;">
            <FlareText Typo="TypographyScale.BodySmall">@GalleryStrings.Popover_NestedBody</FlareText>
            <FlarePopover @bind-Open="_options" Placement="Placement.RightStart" Arrow="true">
                <AnchorContent>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => _options = !_options)">@GalleryStrings.Popover_NestedOptions</FlareButton>
                </AnchorContent>
                <ChildContent>
                    <FlareText Typo="TypographyScale.BodySmall" Style="padding:0.75rem 1rem;max-width:14rem;">
                        @GalleryStrings.Popover_NestedOptionsBody
                    </FlareText>
                </ChildContent>
            </FlarePopover>
        </FlareStack>
    </ChildContent>
</FlarePopover>

@code {
    private bool _filters;
    private bool _options;
}
