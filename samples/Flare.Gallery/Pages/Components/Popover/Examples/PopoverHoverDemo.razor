<FlareStack Row Gap="FlareSpacing.Large" Wrap Align="FlareAlignItems.Start">
    @* Hover trigger with a short open delay (not modal - no scrim). *@
    <FlarePopover @bind-Open="_hover" Trigger="PopoverTrigger.Hover" Delay="150" Placement="Placement.Bottom" Arrow="true">
        <AnchorContent>
            <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Popover_HoverAnchor</FlareButton>
        </AnchorContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.XSmall" Padding="FlareSpacing.Custom" PaddingValue="0.75rem 1rem" MaxWidth="16rem">
                <FlareText Typo="TypographyScale.BodySmall">@GalleryStrings.Popover_Subtitle</FlareText>
            </FlareStack>
        </ChildContent>
    </FlarePopover>

    @* MatchAnchorWidth sizes the panel to the trigger, like a dropdown. Trigger=Click already toggles on
       the anchor, so the button must not toggle again on its own. *@
    <FlarePopover @bind-Open="_width" Trigger="PopoverTrigger.Click" MatchAnchorWidth="true" Placement="Placement.BottomStart">
        <AnchorContent>
            <FlareStack MinWidth="16rem">
                <FlareButton Variant="ButtonVariant.Filled">@GalleryStrings.Popover_WidthAnchor</FlareButton>
            </FlareStack>
        </AnchorContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.None" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">
                <FlareText Typo="TypographyScale.BodySmall" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">@GalleryStrings.Menu_ScrollItem 1</FlareText>
                <FlareText Typo="TypographyScale.BodySmall" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">@GalleryStrings.Menu_ScrollItem 2</FlareText>
            </FlareStack>
        </ChildContent>
    </FlarePopover>

    @* MaxHeight caps the panel so long content scrolls inside it. *@
    <FlarePopover @bind-Open="_scroll" Trigger="PopoverTrigger.Click" MaxHeight="12rem" Placement="Placement.BottomStart">
        <AnchorContent>
            <FlareButton Variant="ButtonVariant.Tonal">@GalleryStrings.Popover_ScrollAnchor</FlareButton>
        </AnchorContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.None" Padding="FlareSpacing.Custom" PaddingValue="0.5rem">
                @for (var i = 1; i <= 15; i++)
                {
                    <FlareText Typo="TypographyScale.BodySmall" Padding="FlareSpacing.Custom" PaddingValue="0.4rem 0.75rem">@GalleryStrings.Menu_ScrollItem @i</FlareText>
                }
            </FlareStack>
        </ChildContent>
    </FlarePopover>
</FlareStack>

@code {
    private bool _hover;
    private bool _width;
    private bool _scroll;
}
