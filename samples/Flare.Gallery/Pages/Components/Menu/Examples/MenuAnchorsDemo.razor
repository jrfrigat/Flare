@* Четыре положения панели относительно активатора (MenuAnchor) *@
<FlareStack Row Gap="FlareSpacing.Large" Wrap Padding="FlareSpacing.Custom" PaddingValue="4rem 0">
    <FlareMenu Anchor="MenuAnchor.BottomStart">
        <Activator>
            <FlareButton Variant="ButtonVariant.Outlined" @attributes="context.Attributes">BottomStart ▾</FlareButton>
        </Activator>
        <ChildContent>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.NorthWest">BottomStart</FlareMenuItem>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Check">Option</FlareMenuItem>
        </ChildContent>
    </FlareMenu>

    <FlareMenu Anchor="MenuAnchor.BottomEnd">
        <Activator>
            <FlareButton Variant="ButtonVariant.Outlined" @attributes="context.Attributes">BottomEnd ▾</FlareButton>
        </Activator>
        <ChildContent>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.NorthEast">BottomEnd</FlareMenuItem>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Check">Option</FlareMenuItem>
        </ChildContent>
    </FlareMenu>

    <FlareMenu Anchor="MenuAnchor.TopStart">
        <Activator>
            <FlareButton Variant="ButtonVariant.Outlined" @attributes="context.Attributes">TopStart ▴</FlareButton>
        </Activator>
        <ChildContent>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.SouthWest">TopStart</FlareMenuItem>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Check">Option</FlareMenuItem>
        </ChildContent>
    </FlareMenu>

    <FlareMenu Anchor="MenuAnchor.TopEnd">
        <Activator>
            <FlareButton Variant="ButtonVariant.Outlined" @attributes="context.Attributes">TopEnd ▴</FlareButton>
        </Activator>
        <ChildContent>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.SouthEast">TopEnd</FlareMenuItem>
            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Check">Option</FlareMenuItem>
        </ChildContent>
    </FlareMenu>
</FlareStack>
