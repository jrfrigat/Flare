@inherits LocalizedPage

<FlareStack Row Wrap Gap="FlareSpacing.Large" MaxWidth="48rem">
    <FlareStack Gap="FlareSpacing.Large" FlexGrow="1" FlexBasis="0" MinWidth="16rem">
        <FlareWeekPicker @bind-Value="_sprint" Label="@GalleryStrings.WpDemo_SprintLabel"
                         HelperText="@GalleryStrings.WpDemo_SprintHelper" />
        <FlareWeekPicker @bind-Value="_iso" Label="@GalleryStrings.WpDemo_IsoLabel"
                         HelperText="@GalleryStrings.WpDemo_IsoHelper" IsoWeeks="true" />
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
            @string.Format(GalleryStrings.WpDemo_Value, _iso?.ToString("yyyy-MM-dd") ?? "-")
        </FlareText>
    </FlareStack>
    <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="18rem">
        <FlareWeekPicker @bind-Value="_inline" Label="@GalleryStrings.WpDemo_InlineLabel"
                         HelperText="@GalleryStrings.WpDemo_InlineHelper" Inline="true" />
    </FlareStack>
</FlareStack>

@code {
    private DateOnly? _sprint;
    private DateOnly? _iso;
    private DateOnly? _inline = new(2026, 10, 12);
}
