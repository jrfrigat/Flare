<FlareStack Row Justify="FlareJustifyContent.Center" Gap="FlareSpacing.Small" Wrap Style="padding:3rem 1.5rem;">
    <FlareTooltip Placement="Placement.Bottom">
        <ChildContent>
            <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_RichButton</FlareButton>
        </ChildContent>
        <TooltipContent>
            <FlareStack Gap="FlareSpacing.XSmall" Style="max-width:14rem;">
                <FlareText Typo="TypographyScale.TitleSmall">@GalleryStrings.Tooltip_RichTitle</FlareText>
                <FlareText Typo="TypographyScale.BodySmall">@GalleryStrings.Tooltip_RichBody</FlareText>
            </FlareStack>
        </TooltipContent>
    </FlareTooltip>
</FlareStack>
