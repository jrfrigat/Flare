<FlareStack Gap="FlareSpacing.Large">
    <FlareText Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
        @GalleryStrings.Tooltip_CollisionBody
    </FlareText>

    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            <FlareStack Row Wrap Gap="FlareSpacing.Small" Justify="FlareJustifyContent.Center">
                <FlareTooltip Content="@GalleryStrings.Tooltip_CardContent">
                    <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_TopButton</FlareButton>
                </FlareTooltip>
                <FlareTooltip Content="@GalleryStrings.Tooltip_CardContent" Placement="Placement.Bottom">
                    <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_BottomButton</FlareButton>
                </FlareTooltip>
                <FlareTooltip Content="@GalleryStrings.Tooltip_CardContent" Placement="Placement.Left">
                    <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_LeftButton</FlareButton>
                </FlareTooltip>
                <FlareTooltip Content="@GalleryStrings.Tooltip_CardContent" Placement="Placement.Right">
                    <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_RightButton</FlareButton>
                </FlareTooltip>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>

    <FlareStack Row Wrap Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
        <FlareTooltip Content="@GalleryStrings.Tooltip_ThemeOffsetContent">
            <FlareButton>@GalleryStrings.Tooltip_ThemeOffsetButton</FlareButton>
        </FlareTooltip>
        <FlareTooltip Content="@GalleryStrings.Tooltip_Offset16Content" Offset="16">
            <FlareButton>@GalleryStrings.Tooltip_Offset16Button</FlareButton>
        </FlareTooltip>
        <FlareTooltip Content="@GalleryStrings.Tooltip_ArrowContent" Arrow>
            <FlareButton>@GalleryStrings.Tooltip_ArrowButton</FlareButton>
        </FlareTooltip>
    </FlareStack>
</FlareStack>
