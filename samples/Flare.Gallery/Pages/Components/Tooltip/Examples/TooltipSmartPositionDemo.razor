<FlareStack Gap="FlareSpacing.Large">
    <FlareText Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
        A tooltip is placed against its trigger in the viewport and raised into the browser's top layer,
        so it flips to the opposite side rather than hanging off the screen - and stays readable inside a
        card, a scrolling grid or a dialog, all of which clip what their children paint outside them.
        Nothing to switch on.
    </FlareText>

    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            <FlareStack Row Wrap Gap="FlareSpacing.Small" Justify="FlareJustifyContent.Center">
                <FlareTooltip Content="Readable from inside a card">
                    <FlareButton Variant="ButtonVariant.Outlined">Top</FlareButton>
                </FlareTooltip>
                <FlareTooltip Content="Readable from inside a card" Placement="TooltipPlacement.Bottom">
                    <FlareButton Variant="ButtonVariant.Outlined">Bottom</FlareButton>
                </FlareTooltip>
                <FlareTooltip Content="Readable from inside a card" Placement="TooltipPlacement.Left">
                    <FlareButton Variant="ButtonVariant.Outlined">Left</FlareButton>
                </FlareTooltip>
                <FlareTooltip Content="Readable from inside a card" Placement="TooltipPlacement.Right">
                    <FlareButton Variant="ButtonVariant.Outlined">Right</FlareButton>
                </FlareTooltip>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>

    <FlareStack Row Wrap Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
        <FlareTooltip Content="Default distance, from the theme's token">
            <FlareButton>Theme offset</FlareButton>
        </FlareTooltip>
        <FlareTooltip Content="16px from the trigger" Offset="16">
            <FlareButton>Offset 16</FlareButton>
        </FlareTooltip>
        <FlareTooltip Content="Arrows point away from the side the bubble landed on" Arrow>
            <FlareButton>With an arrow</FlareButton>
        </FlareTooltip>
    </FlareStack>
</FlareStack>
