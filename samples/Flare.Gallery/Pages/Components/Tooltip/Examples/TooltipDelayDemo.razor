<FlareStack Row Justify="FlareJustifyContent.Center" Gap="FlareSpacing.Small" Wrap Style="padding:3rem 1.5rem;">
    <FlareTooltip Content="@GalleryStrings.Tooltip_NoDelay" Delay="0">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_NoDelay</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_HalfSecond" Delay="500">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_HalfSecond</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_OneSecond" Delay="1000">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_OneSecond</FlareButton>
    </FlareTooltip>
</FlareStack>
