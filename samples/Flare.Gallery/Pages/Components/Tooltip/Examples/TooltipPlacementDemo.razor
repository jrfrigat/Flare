<FlareStack Row Justify="FlareJustifyContent.Center" Gap="FlareSpacing.Small" Wrap Padding="FlareSpacing.Custom" PaddingValue="3rem 1.5rem">
    <FlareTooltip Content="@GalleryStrings.Tooltip_TopContent">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_TopButton</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_BottomContent" Placement="Placement.Bottom">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_BottomButton</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_LeftContent" Placement="Placement.Left">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_LeftButton</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_RightContent" Placement="Placement.Right">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_RightButton</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_AlignedStart" Placement="Placement.TopStart">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_TopStartButton</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_AlignedEnd" Placement="Placement.BottomEnd">
        <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_BottomEndButton</FlareButton>
    </FlareTooltip>
</FlareStack>
