<FlareStack Row Justify="FlareJustifyContent.Center" Gap="FlareSpacing.Small" Wrap Style="padding:3rem 1.5rem;">
    <FlareTooltip Content="Top tooltip">
        <FlareButton Variant="ButtonVariant.Outlined">Hover (top)</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="Bottom tooltip" Placement="Placement.Bottom">
        <FlareButton Variant="ButtonVariant.Outlined">Hover (bottom)</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="Left tooltip" Placement="Placement.Left">
        <FlareButton Variant="ButtonVariant.Outlined">Hover (left)</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="Right tooltip" Placement="Placement.Right">
        <FlareButton Variant="ButtonVariant.Outlined">Hover (right)</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_AlignedStart" Placement="Placement.TopStart">
        <FlareButton Variant="ButtonVariant.Outlined">Hover (top-start)</FlareButton>
    </FlareTooltip>
    <FlareTooltip Content="@GalleryStrings.Tooltip_AlignedEnd" Placement="Placement.BottomEnd">
        <FlareButton Variant="ButtonVariant.Outlined">Hover (bottom-end)</FlareButton>
    </FlareTooltip>
</FlareStack>
