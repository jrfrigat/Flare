<FlareStack Gap="FlareSpacing.Small" Padding="FlareSpacing.Custom" PaddingValue="1.5rem">
    <FlareStack Row Wrap Gap="FlareSpacing.Small" Justify="FlareJustifyContent.Center">
        <FlareTooltip Content="@GalleryStrings.Tooltip_LongContent" Placement="Placement.Bottom">
            <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_LongButton</FlareButton>
        </FlareTooltip>
    </FlareStack>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
        @GalleryStrings.Tooltip_LongNote
    </FlareText>
</FlareStack>
