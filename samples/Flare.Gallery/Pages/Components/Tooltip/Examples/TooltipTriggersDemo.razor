<FlareStack Gap="FlareSpacing.Small">
    <FlareStack Row Justify="FlareJustifyContent.Center" Gap="FlareSpacing.Small" Wrap Padding="FlareSpacing.Custom" PaddingValue="1.5rem">
        <FlareTooltip Content="@GalleryStrings.Tooltip_ClickContent" ShowOnClick="true" ShowOnHover="false" Arrow="true">
            <FlareButton Variant="ButtonVariant.Filled">@GalleryStrings.Tooltip_ClickButton</FlareButton>
        </FlareTooltip>
        <FlareTooltip Content="@GalleryStrings.Tooltip_HoverFocusContent" Arrow="true">
            <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_HoverFocusButton</FlareButton>
        </FlareTooltip>
        <FlareTooltip Content="@GalleryStrings.Tooltip_FocusContent" ShowOnHover="false" ShowOnFocus="true">
            <FlareButton Variant="ButtonVariant.Outlined">@GalleryStrings.Tooltip_FocusButton</FlareButton>
        </FlareTooltip>
        <FlareTooltip Content="@GalleryStrings.Tooltip_DisabledContent" Disabled="true">
            <FlareButton Variant="ButtonVariant.Text">@GalleryStrings.Tooltip_DisabledButton</FlareButton>
        </FlareTooltip>
    </FlareStack>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
        @GalleryStrings.Tooltip_A11yNote
    </FlareText>
</FlareStack>
