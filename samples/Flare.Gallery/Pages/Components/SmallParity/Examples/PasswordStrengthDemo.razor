@* The meter is a parameter on the field, not a component beside it - a separate one would have to be
   told the password a second time. The rule is a delegate because password policy belongs to the
   application; the second field shows one. *@
<FlareStack Gap="FlareSpacing.Large" Style="max-width:28rem;">

    <FlarePasswordField @bind-Value="_a"
                        ShowStrength="true"
                        Label="@GalleryStrings.PwStrength_Default"
                        HelperText="@GalleryStrings.PwStrength_DefaultHelp" />

    <FlarePasswordField @bind-Value="_b"
                        ShowStrength="true"
                        StrengthEvaluator="Corporate"
                        Label="@GalleryStrings.PwStrength_Custom"
                        HelperText="@GalleryStrings.PwStrength_CustomHelp" />
</FlareStack>

@code {
    private string? _a = "correcthorsebatterystaple";
    private string? _b = "hunter2";

    // A policy that insists on 16 characters and a symbol, which is exactly the kind of rule a library
    // must not decide for an application.
    private static FlarePasswordStrength Corporate(string? password)
    {
        var value = password ?? string.Empty;
        var reasons = new List<string>();
        if (value.Length < 16) reasons.Add(GalleryStrings.PwStrength_NeedSixteen);
        if (!value.Any(c => !char.IsLetterOrDigit(c))) reasons.Add(GalleryStrings.PwStrength_NeedSymbol);
        return new FlarePasswordStrength(reasons.Count switch { 0 => 4, 1 => 2, _ => 0 }, reasons);
    }
}
