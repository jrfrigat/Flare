@using Flare.Gallery.Pages.Components.DataGrid.Examples

<FlareDataGrid Items="@_employees" PageSize="20" @bind-ExpandedItems="_expandedItems"
               Tree="@(new DataGridTreeConfig<Employee>
               {
                   ChildrenSelector = e => e.Subordinates,
                   KeySelector = e => e.Name,
                   IndentWidth = "24px"
               })">
    <Columns>
        <FlareColumn Title="Name" Field="@(e => e.Name)" Sortable="true" />
        <FlareColumn Title="Position" Field="@(e => e.Position)" Sortable="true" />
        <FlareColumn Title="Department" Field="@(e => e.Department)" Sortable="true" />
    </Columns>
</FlareDataGrid>

@code {
    private HashSet<Employee> _expandedItems = new();

    protected override void OnInitialized()
    {
        foreach (var employee in Flatten(_employees))
            if (employee.Level < 2)
                _expandedItems.Add(employee);
    }

    private static IEnumerable<Employee> Flatten(IEnumerable<Employee> roots)
    {
        foreach (var root in roots)
        {
            yield return root;
            foreach (var child in Flatten(root.Subordinates ?? []))
                yield return child;
        }
    }
    private readonly List<Employee> _employees = new()
    {
        new Employee { Name = "Иван Петров", Position = "CEO", Department = "Руководство", Level = 0,
            Subordinates = new[]
            {
                new Employee { Name = "Мария Сидорова", Position = "CTO", Department = "Разработка", Level = 1,
                    Subordinates = new[]
                    {
                        new Employee { Name = "Алексей Козлов", Position = "Team Lead", Department = "Backend", Level = 2 },
                        new Employee { Name = "Елена Волкова", Position = "Team Lead", Department = "Frontend", Level = 2 },
                    }
                },
                new Employee { Name = "Дмитрий Новиков", Position = "CFO", Department = "Финансы", Level = 1 },
            }
        },
    };

    private sealed class Employee
    {
        public string Name { get; set; } = "";
        public string Position { get; set; } = "";
        public string Department { get; set; } = "";
        public int Level { get; set; }
        public IEnumerable<Employee>? Subordinates { get; set; }
    }
}
