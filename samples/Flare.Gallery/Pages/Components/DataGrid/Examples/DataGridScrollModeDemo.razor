@* Size, paging and the sticky header are three independent questions. Height caps the whole component
   in both states below - the grid scrolls because it ran out of room, not because a mode was switched
   on - and turning paging on only slices the rows; the scrollbar and the header stay exactly where they
   were. StickyHeader is the third question and answers only itself. *@
<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row="true" Gap="FlareSpacing.Large" Wrap="true">
        <FlareSwitch @bind-Value="_paged" Label="PageSize 25 (off: one page, every row)" />
        <FlareSwitch @bind-Value="_sticky" Label="StickyHeader" />
    </FlareStack>

    <FlareDataGrid Items="@_invoices" PageSize="@(_paged ? 25 : 0)" StickyHeader="_sticky"
                   Height="340px" Striped="true" Hoverable="true">
        <Columns>
            <FlareColumn Title="Invoice" Field="@(i => i.Number)" Width="120px" />
            <FlareColumn Title="Customer" Field="@(i => i.Customer)" Sortable="true" />
            <FlareColumn Title="Issued" Field="@(i => i.Issued.ToString("yyyy-MM-dd"))" Sortable="true" SortKey="Issued" Width="140px" />
            <FlareColumn Title="Total" Field="@(i => i.Total)" Type="ColumnDataType.Number" Format="N2" Sortable="true" Width="130px" />
        </Columns>
    </FlareDataGrid>
</FlareStack>

@code {
    private sealed record Invoice(string Number, string Customer, DateTime Issued, decimal Total);

    private static readonly string[] _customers =
        ["Northwind", "Contoso", "Fabrikam", "Adventure Works", "Tailspin", "Proseware", "Litware"];

    private bool _paged;
    private bool _sticky = true;

    private readonly List<Invoice> _invoices = BuildInvoices();

    private static List<Invoice> BuildInvoices()
    {
        var issued = new DateTime(2026, 1, 5, 0, 0, 0, DateTimeKind.Utc);
        var list = new List<Invoice>(240);
        for (var i = 1; i <= 240; i++)
        {
            list.Add(new Invoice(
                $"INV-{i:0000}",
                _customers[i % _customers.Length],
                issued.AddDays(i),
                120m + i % 37 * 48.5m));
        }
        return list;
    }
}
