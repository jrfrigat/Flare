<FlareStack Gap="FlareSpacing.Large">
    <FlareStack MaxWidth="36rem">
        <FlareDateRangePicker @bind-StartDate="_start" @bind-EndDate="_end"
                              Label="Booking period"
                              StartLabel="Check-in" EndLabel="Check-out"
                              HelperText="Select check-in and check-out dates" />
    </FlareStack>
    <FlareStack MaxWidth="36rem">
        <FlareDateRangePicker Label="Disabled" Disabled />
    </FlareStack>
</FlareStack>
<FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">
    @if (_start.HasValue || _end.HasValue)
    {
        @($"{_start?.ToString("dd MMM yyyy") ?? "–"} -> {_end?.ToString("dd MMM yyyy") ?? "–"}")
    }
</FlareText>

@code {
    private DateOnly? _start;
    private DateOnly? _end;
}
