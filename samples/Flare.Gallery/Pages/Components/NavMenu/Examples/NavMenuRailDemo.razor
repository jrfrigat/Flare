@* Rail="true" trims every item to its icon (text, group titles, chevrons and badges hide and the
   icons center). Tooltip supplies the hover label that replaces the hidden text. Inside a
   FlareLayout with MiniRail this turns on automatically while the drawer is collapsed. *@
<FlareStack Row="true" Gap="FlareSpacing.Medium" Align="FlareAlignItems.Start">
    <FlareCard Variant="CardVariant.Filled"
               Width="@(_rail ? "4rem" : "240px")"
               Padding="FlareSpacing.Custom" PaddingValue="0.75rem 0"
               Background="_railBackground">
        <FlareNavMenu Rail="_rail">
            <FlareNavLink Href="" Match="NavMatchMode.Exact" Tooltip="Dashboard">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Dashboard" /></IconContent>
                <ChildContent>Dashboard</ChildContent>
            </FlareNavLink>
            <FlareNavLink Href="#inbox" Tooltip="Inbox">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Inbox" /></IconContent>
                <ChildContent>Inbox</ChildContent>
                <BadgeContent>3</BadgeContent>
            </FlareNavLink>
            <FlareNavLink Href="#reports" Tooltip="Reports">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Analytics" /></IconContent>
                <ChildContent>Reports</ChildContent>
            </FlareNavLink>
            <FlareNavLink Href="#settings" Tooltip="Settings">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Settings" /></IconContent>
                <ChildContent>Settings</ChildContent>
            </FlareNavLink>
        </FlareNavMenu>
    </FlareCard>

    <FlareButton Variant="ButtonVariant.Tonal" OnClick="() => _rail = !_rail">
        <FlareIconView Size="1.1rem" Value="@GalleryIcons.Resolve(_rail ? "menu_open" : "menu")" />
        @(_rail ? "Expand" : "Collapse to rail")
    </FlareButton>
</FlareStack>

@code {
    private static readonly FlareColor _railBackground = FlareColor.Custom("var(--flare-color-surface-container-low)");

    private bool _rail;
}
