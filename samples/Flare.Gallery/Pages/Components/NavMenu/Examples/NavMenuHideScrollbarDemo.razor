@* HideScrollbar="true" lets the menu scroll its overflow while hiding the scrollbar.
   The fixed-height card constrains the menu so it actually scrolls. *@
<FlareCard Variant="CardVariant.Filled" MaxWidth="280px" Height="200px" Padding="FlareSpacing.Custom" PaddingValue="0.75rem 0"
           Background="@(FlareColor.Custom("var(--flare-color-surface-container-low)"))">
    <FlareStack FillHeight="true">
    <FlareNavMenu HideScrollbar="true" Class="@Css.Classes.Fill.Root">
        @for (var i = 1; i <= 15; i++)
        {
            var n = i;
            <FlareNavLink Href="@($"#item-{n}")">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Folder" /></IconContent>
                <ChildContent>Item @n</ChildContent>
            </FlareNavLink>
        }
    </FlareNavMenu>
    </FlareStack>
</FlareCard>
