<FlareCard Variant="CardVariant.Filled" MaxWidth="280px" Padding="FlareSpacing.Custom" PaddingValue="0.75rem 0"
           Background="@(FlareColor.Custom("var(--flare-color-surface-container-low)"))">
    <FlareNavMenu>
        <FlareNavLink Href="" Match="NavMatchMode.Exact">
            <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Home" /></IconContent>
            <ChildContent>Home</ChildContent>
        </FlareNavLink>
        <FlareNavGroup Label="Components" Icon="@MaterialDesign3Icons.Regular.Widgets" Expanded="true">
            <FlareNavLink Href="components/buttons">Buttons</FlareNavLink>
            <FlareNavLink Href="components/inputs">Inputs</FlareNavLink>
            <FlareNavLink Href="components/cards">Cards</FlareNavLink>
        </FlareNavGroup>
        <FlareNavGroup Label="More" Icon="@MaterialDesign3Icons.Regular.MoreHoriz">
            <FlareNavLink Href="components/datagrid">Data Grid</FlareNavLink>
            <FlareNavLink Href="components/dialog">Dialog</FlareNavLink>
        </FlareNavGroup>
    </FlareNavMenu>
</FlareCard>
