@inherits LocalizedPage

@* FlareFormField wraps a control the form did not build: it supplies the label, the helper line, the
   required marker and the label's `for`, and the native input carries Flare's own control class. *@
<FlareForm Model="@_model">
    <FlareFormField Label="@GalleryStrings.Forms_NameLabel" For="forms-custom-name"
                    HelperText="@GalleryStrings.Forms_NameHelper" Required="true">
        <input id="forms-custom-name" class="@Css.Classes.Input.Control" @bind="_name" />
    </FlareFormField>
    <FlareFormField Label="@GalleryStrings.Forms_CityLabel" For="forms-custom-city">
        <input id="forms-custom-city" class="@Css.Classes.Input.Control" @bind="_city" />
    </FlareFormField>
</FlareForm>

@code {
    private FormModel _model = new();
    private string? _name;
    private string? _city;

    private sealed class FormModel { }
}
