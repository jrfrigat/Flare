@using Flare.Gallery.Resources

<FlareStack Gap="FlareSpacing.Medium" MaxWidth="22rem">
    <FlarePasswordField @bind-Value="_password" Immediate="true" Label="@GalleryStrings.PasswordInput_Label" />
    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
        @GalleryStrings.PasswordInput_LiveValue
        <FlareText Element="strong" Inherit>@(string.IsNullOrEmpty(_password) ? GalleryStrings.PasswordInput_LiveValueEmpty : _password)</FlareText>
        @if (!string.IsNullOrEmpty(_password))
        {
            <text> (@_password.Length)</text>
        }
    </FlareText>
</FlareStack>

@code {
    private string? _password;
}
