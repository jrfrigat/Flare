<FlareTabs OnTabClose="HandleTabClose">
    @foreach (var tab in _closeableTabs)
    {
        <FlareTab @key="tab" Label="@tab" Closeable="true">
            <FlareText Typo="TypographyScale.BodyMedium">Content for <FlareText Element="strong" Inherit>@tab</FlareText>.</FlareText>
        </FlareTab>
    }
</FlareTabs>
@if (_closeableTabs.Count == 0)
{
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">All tabs closed.</FlareText>
}

@code {
    private List<string> _closeableTabs = ["Dashboard", "Settings", "Profile", "Reports"];
    private void HandleTabClose(string label) => _closeableTabs.Remove(label);
}
