@inject ISnackbarService Snackbar

<FlareStack Row Gap="FlareSpacing.XLarge" Wrap Align="FlareAlignItems.End" MinHeight="12rem" Padding="FlareSpacing.Custom" PaddingValue="3rem 1rem 1rem">
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareFloatingActionButton Position="FabPosition.Static" AriaLabel="@GalleryStrings.FabMenu_ActionsUp">
            <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" /></IconContent>
            <ChildContent>
                <FlareFloatingActionMenu Placement="Placement.Top">
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Edit" Label="@GalleryStrings.FabMenu_ActionEdit"
                                                 OnClick="@(() => Snackbar.Show(GalleryStrings.FabMenu_ActionEdit))" />
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Share" Label="@GalleryStrings.FabMenu_ActionShare"
                                                 OnClick="@(() => Snackbar.Show(GalleryStrings.FabMenu_ActionShare))" />
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Delete" Label="@GalleryStrings.FabMenu_ActionDelete"
                                                 OnClick="@(() => Snackbar.Show(GalleryStrings.FabMenu_ActionDelete, SnackbarSeverity.Error))" />
                </FlareFloatingActionMenu>
            </ChildContent>
        </FlareFloatingActionButton>
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@GalleryStrings.FabMenu_DirectionUp</FlareText>
    </FlareStack>

    @* The direction is a preference, not a promise: when the chosen side has no room the list opens
       on the opposite one. The Gallery used to switch Placement by breakpoint itself, which was the
       application compensating for what the component now does. *@
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareFloatingActionButton Position="FabPosition.Static" Color="@Colors.Secondary" AriaLabel="@GalleryStrings.FabMenu_ActionsRight">
            <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.MoreHoriz" /></IconContent>
            <ChildContent>
                <FlareFloatingActionMenu Placement="Placement.Right">
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Download" Label="@GalleryStrings.FabMenu_ActionDownload"
                                                 OnClick="@(() => Snackbar.Show(GalleryStrings.FabMenu_ActionDownload))" />
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Print" Label="@GalleryStrings.FabMenu_ActionPrint"
                                                 OnClick="@(() => Snackbar.Show(GalleryStrings.FabMenu_ActionPrint))" />
                </FlareFloatingActionMenu>
            </ChildContent>
        </FlareFloatingActionButton>
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@GalleryStrings.FabMenu_DirectionRight</FlareText>
    </FlareStack>
</FlareStack>
