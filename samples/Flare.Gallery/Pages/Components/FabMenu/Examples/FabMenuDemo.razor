@inject ISnackbarService Snackbar

<FlareStack Row Gap="FlareSpacing.XLarge" Wrap Align="FlareAlignItems.End" Style="min-height:12rem;padding:3rem 1rem 1rem;">
    <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareFloatingActionButton Position="FabPosition.Static" AriaLabel="Actions (up)">
            <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" /></IconContent>
            <ChildContent>
                <FlareFloatingActionMenu Direction="FabMenuDirection.Up">
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Edit" Label="Edit" OnClick="@(() => Snackbar.Show("Edit"))" />
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Share" Label="Share" OnClick="@(() => Snackbar.Show("Share"))" />
                    <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Delete" Label="Delete" OnClick="@(() => Snackbar.Show("Delete", SnackbarSeverity.Error))" />
                </FlareFloatingActionMenu>
            </ChildContent>
        </FlareFloatingActionButton>
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">Up</FlareText>
    </FlareStack>

    @* The direction is the author's call, and a horizontal one needs the room to open into: two labelled
       actions beside the button are wider than a phone. So the direction follows the breakpoint - which
       is what a real screen does, rather than opening off the edge and giving the page a sideways
       scroll. FlareMediaQuery reports the active breakpoint; nothing here is CSS. *@
    <FlareMediaQuery Context="bp">
        <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
            <FlareFloatingActionButton Position="FabPosition.Static" Color="@Colors.Secondary" AriaLabel="Actions (right)">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.MoreHoriz" /></IconContent>
                <ChildContent>
                    <FlareFloatingActionMenu Direction="@(bp <= Breakpoint.Sm ? FabMenuDirection.Up : FabMenuDirection.Right)">
                        <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Download" Label="Download" OnClick="@(() => Snackbar.Show("Downloading…"))" />
                        <FlareFloatingActionMenuItem Icon="@MaterialDesign3Icons.Regular.Print" Label="Print" OnClick="@(() => Snackbar.Show("Printing…"))" />
                    </FlareFloatingActionMenu>
                </ChildContent>
            </FlareFloatingActionButton>
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
                @(bp <= Breakpoint.Sm ? "Right (Up on a phone)" : "Right")
            </FlareText>
        </FlareStack>
    </FlareMediaQuery>
</FlareStack>
