<FlareStack Gap="FlareSpacing.Medium" MaxWidth="22rem">
    <FlareMultiSelect TValue="string" Size="FlareSize.Xs" Items="_fruits" ItemLabel="x => x"
                      Values="_v" ValuesChanged="v => _v = v.ToList()"
                      Chips="true" Label="Extra small (xs)" />
    <FlareMultiSelect TValue="string" Size="FlareSize.Sm" Items="_fruits" ItemLabel="x => x"
                      Values="_v" ValuesChanged="v => _v = v.ToList()"
                      Chips="true" Label="Small (sm)" />
    <FlareMultiSelect TValue="string" Size="FlareSize.Md" Items="_fruits" ItemLabel="x => x"
                      Values="_v" ValuesChanged="v => _v = v.ToList()"
                      Chips="true" Label="Medium (md, default)" />
    <FlareMultiSelect TValue="string" Size="FlareSize.Lg" Items="_fruits" ItemLabel="x => x"
                      Values="_v" ValuesChanged="v => _v = v.ToList()"
                      Chips="true" Label="Large (lg)" />
    <FlareMultiSelect TValue="string" Size="FlareSize.Xl" Items="_fruits" ItemLabel="x => x"
                      Values="_v" ValuesChanged="v => _v = v.ToList()"
                      Chips="true" Label="Extra large (xl)" />
</FlareStack>

@code {
    private readonly List<string> _fruits = ["Apple", "Banana", "Cherry", "Date"];
    private List<string> _v = [];
}
