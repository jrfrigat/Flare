@* Live demo of IBrowserViewportService: one injected service reports the viewport size, breakpoint and
   orientation (updated on a throttled resize), plus ObserveElementAsync tracking a single element's own
   size via the browser ResizeObserver. No DotNetObjectReference or [JSInvokable] plumbing in sight. *@
@inject IBrowserViewportService Viewport
@implements IAsyncDisposable

<FlareStack Gap="FlareSpacing.Medium">
    <FlarePaper Elevation="1" Padding="FlareSpacing.Custom" PaddingValue="1rem">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareText Typo="TypographyScale.TitleSmall">
                @GalleryStrings.Responsive_ViewportSize <FlareText Element="strong" Inherit>@_size.Width &times; @_size.Height px</FlareText>
            </FlareText>
            <FlareText>@GalleryStrings.Responsive_CurrentBp <FlareText Element="strong" Inherit>@_bp</FlareText></FlareText>
            <FlareText>
                @GalleryStrings.Responsive_ViewportOrientation
                <FlareText Element="strong" Inherit>@(_size.IsPortrait ? GalleryStrings.Responsive_Portrait : GalleryStrings.Responsive_Landscape)</FlareText>
            </FlareText>
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
                @GalleryStrings.Responsive_PortraitQuery <FlareText Element="strong" Inherit>@_portrait</FlareText>
            </FlareText>
        </FlareStack>
    </FlarePaper>

    <FlareStack Gap="FlareSpacing.XSmall">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.5rem">
            @GalleryStrings.Responsive_ElementObserverDesc
        </FlareText>
        <FlareSlider @bind-Value="_targetWidth" Min="160" Max="480" Step="10"
                     AriaLabel="@GalleryStrings.Responsive_ElementSize" />
        <FlareCard @ref="_box" Variant="CardVariant.Outlined" Background="@BoxSurface"
                   Width="@($"{_targetWidth:F0}px")" MinHeight="96px"
                   Padding="FlareSpacing.Custom" PaddingValue="1rem">
            <FlareText Element="strong" Inherit>@GalleryStrings.Responsive_ElementSize</FlareText> @_boxWidth &times; @_boxHeight px
        </FlareCard>
    </FlareStack>
</FlareStack>

@code {
    private ViewportSize _size;
    private Breakpoint _bp = Breakpoint.Md;
    private bool _portrait;
    private FlareCard? _box;
    private double _targetWidth = 240;
    private int _boxWidth;
    private int _boxHeight;
    private IAsyncDisposable? _viewportSub;
    private IAsyncDisposable? _elementSub;

    private static readonly FlareColor BoxSurface = FlareColor.Custom("var(--flare-color-surface-container-high)");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _viewportSub = await Viewport.SubscribeAsync(OnViewportAsync);
            _elementSub = await Viewport.ObserveElementAsync(_box!.RootElement, OnElementAsync);
            _portrait = await Viewport.MatchesAsync("(orientation: portrait)");
            StateHasChanged();
        }
        catch (Exception) { /* prerender / JS unavailable */ }
    }

    private async Task OnViewportAsync(ViewportChange change)
    {
        _size = change.Size;
        _bp = change.Breakpoint;
        _portrait = _size.IsPortrait;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnElementAsync(ElementBoundingRect rect)
    {
        _boxWidth = (int)rect.Width;
        _boxHeight = (int)rect.Height;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_viewportSub is not null) { try { await _viewportSub.DisposeAsync(); } catch { } }
        if (_elementSub is not null) { try { await _elementSub.DisposeAsync(); } catch { } }
    }
}
