@* MinColumnWidth builds a responsive card wall with no media queries; AutoFit stretches the present
   cards to fill the row (auto-fit) instead of leaving empty trailing tracks (auto-fill). *@
<FlareGrid MinColumnWidth="12rem" AutoFit Gap="FlareSpacing.Small">
    <FlareCard Padding="FlareSpacing.Custom" PaddingValue="1rem" Variant="CardVariant.Text"
               Background='FlareColor.Custom("var(--flare-color-primary-container)")'>
        <FlareText Align="TextAlign.Center" Typo="TypographyScale.LabelLarge">Tile 1</FlareText>
    </FlareCard>
    <FlareCard Padding="FlareSpacing.Custom" PaddingValue="1rem" Variant="CardVariant.Text"
               Background='FlareColor.Custom("var(--flare-color-secondary-container)")'>
        <FlareText Align="TextAlign.Center" Typo="TypographyScale.LabelLarge">Tile 2</FlareText>
    </FlareCard>
    <FlareCard Padding="FlareSpacing.Custom" PaddingValue="1rem" Variant="CardVariant.Text"
               Background='FlareColor.Custom("var(--flare-color-tertiary-container)")'>
        <FlareText Align="TextAlign.Center" Typo="TypographyScale.LabelLarge">Tile 3</FlareText>
    </FlareCard>
</FlareGrid>
