<FlareStack Gap="FlareSpacing.Small">
    <FlareGrid Columns="12" Gap="FlareSpacing.XSmall">
        <FlareCol Xs="12" Sm="6" Md="4" Lg="3">
            <FlareCard Padding="FlareSpacing.Custom" PaddingValue="0.75rem" Variant="CardVariant.Text"
                       Background='FlareColor.Custom("var(--flare-color-primary-container)")'>
                <FlareText Align="TextAlign.Center" Typo="TypographyScale.LabelSmall">xs=12 sm=6 md=4 lg=3</FlareText>
            </FlareCard>
        </FlareCol>
        <FlareCol Xs="12" Sm="6" Md="4" Lg="3">
            <FlareCard Padding="FlareSpacing.Custom" PaddingValue="0.75rem" Variant="CardVariant.Text"
                       Background='FlareColor.Custom("var(--flare-color-secondary-container)")'>
                <FlareText Align="TextAlign.Center" Typo="TypographyScale.LabelSmall">xs=12 sm=6 md=4 lg=3</FlareText>
            </FlareCard>
        </FlareCol>
        <FlareCol Xs="12" Sm="6" Md="4" Lg="3">
            <FlareCard Padding="FlareSpacing.Custom" PaddingValue="0.75rem" Variant="CardVariant.Text"
                       Background='FlareColor.Custom("var(--flare-color-tertiary-container)")'>
                <FlareText Align="TextAlign.Center" Typo="TypographyScale.LabelSmall">xs=12 sm=6 md=4 lg=3</FlareText>
            </FlareCard>
        </FlareCol>
        <FlareCol Xs="12" Sm="6" Md="12" Lg="3">
            <FlareCard Padding="FlareSpacing.Custom" PaddingValue="0.75rem" Variant="CardVariant.Text"
                       Background='FlareColor.Custom("var(--flare-color-error-container)")'>
                <FlareText Align="TextAlign.Center" Typo="TypographyScale.LabelSmall">xs=12 sm=6 md=12 lg=3</FlareText>
            </FlareCard>
        </FlareCol>
    </FlareGrid>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
        Mobile: 1 column · Tablet: 2 columns · Desktop: 3–4 columns
    </FlareText>
</FlareStack>
