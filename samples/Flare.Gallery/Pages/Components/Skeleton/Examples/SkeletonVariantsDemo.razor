@* One status owns the loading area; the bars themselves are decorative. *@
<FlareVisuallyHidden Role="status" AriaLive="polite">@FlareStrings.Aria_Loading</FlareVisuallyHidden>

<FlareStack Row Gap="FlareSpacing.Large" Wrap Align="FlareAlignItems.Start">
    <FlareStack Gap="FlareSpacing.XSmall" Width="16rem">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.25rem">Text lines (Width / Height)</FlareText>
        <FlareSkeleton Variant="SkeletonVariant.Text" Width="60%" Height="1.25rem" />
        <FlareSkeleton Variant="SkeletonVariant.Text" Height="0.875rem" />
        <FlareSkeleton Variant="SkeletonVariant.Text" Width="80%" Height="0.875rem" />
    </FlareStack>
    <FlareStack Align="FlareAlignItems.Start" Gap="FlareSpacing.XSmall">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="0.25rem">Rect &amp; Circle</FlareText>
        <FlareSkeleton Variant="SkeletonVariant.Rect" Width="12rem" Height="8rem" />
        <FlareSkeleton Variant="SkeletonVariant.Circle" Width="3rem" Height="3rem" />
    </FlareStack>
</FlareStack>
