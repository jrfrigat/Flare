<FlareStack Gap="FlareSpacing.Medium" MaxWidth="30rem">
    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small"
                Padding="FlareSpacing.Custom" PaddingValue="0.75rem"
                Background="@(FlareColor.Custom("var(--flare-color-surface-container)"))">
        <FlareStack Block FlexGrow="1" FlexBasis="0" MinWidth="0">
            <FlareText Typo="TypographyScale.BodySmall" Mono>dotnet add package Flare.Components</FlareText>
        </FlareStack>
        <FlareClipboard Text="dotnet add package Flare.Components" ShowFeedback="true" OnCopied="@(() => _count++)" />
    </FlareStack>

    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
        <FlareText Typo="TypographyScale.BodyMedium">Custom trigger &amp; feedback:</FlareText>
        <FlareClipboard Text="Copied from a custom slot">
            <ChildContent><FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined">Copy</FlareButton></ChildContent>
            <FeedbackContent><FlareChip Label="Copied!" Color="@Colors.Success" /></FeedbackContent>
        </FlareClipboard>
    </FlareStack>

    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
        <FlareText Typo="TypographyScale.BodyMedium">Emphasized (primary) copy:</FlareText>
        <FlareClipboard Text="sk-live-1234567890" Variant="ButtonVariant.Filled" Color="FlareColor.Primary" />
    </FlareStack>

    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">Copied count (OnCopied): @_count</FlareText>
</FlareStack>

@code {
    private int _count;
}
