@using static Flare.Components.FlareResizable

<FlareStack Gap="FlareSpacing.Medium">
@foreach (var edge in Enum.GetValues<ResizableEdge>())
{
    var horizontal = edge is ResizableEdge.Left or ResizableEdge.Right;
    <FlareCard Variant="CardVariant.Outlined">
    <FlareResizable Edge="edge" InitialSize="240px" MinSize="120px" MaxSize="480px"
                    Style="@(horizontal ? "height:120px;" : "width:240px;")">
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelMedium">@Flare.Components.Resources.FlareStrings.Splitter_Resize: @edge</FlareText>
    </FlareResizable>
    </FlareCard>
}
</FlareStack>
