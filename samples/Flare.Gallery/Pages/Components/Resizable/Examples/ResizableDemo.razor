@using static Flare.Components.FlareResizable

<FlareStack Gap="FlareSpacing.Medium">
@foreach (var edge in Enum.GetValues<ResizableEdge>())
{
    var horizontal = edge is ResizableEdge.Left or ResizableEdge.Right;
    <FlareCard Variant="CardVariant.Outlined">
    <FlareStack Height="@(horizontal ? "120px" : "240px")" Width="@(horizontal ? null : "240px")">
        <FlareResizable Edge="edge" InitialSize="240px" MinSize="120px" MaxSize="480px" Class="@Css.Classes.Fill.Root">
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelMedium"
                       Padding="FlareSpacing.Custom" PaddingValue="0.75rem">@Flare.Components.Resources.FlareStrings.Splitter_Resize: @edge</FlareText>
        </FlareResizable>
    </FlareStack>
    </FlareCard>
}
</FlareStack>
