<FlarePaper Outlined Padding="FlareSpacing.Medium">
    <FlareStepper @bind-ActiveIndex="_index">
        <ChildContent>
            <FlareStep Label="@GalleryStrings.StepDemo_Scope">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Key" /></IconContent>
                <ChildContent>
                    <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.StepDemo_Permissions</FlareText>
                </ChildContent>
            </FlareStep>
            <FlareStep Label="@GalleryStrings.StepDemo_Confirm">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.CheckCircle" /></IconContent>
                <ChildContent>
                    <FlareText Typo="TypographyScale.BodyMedium">
                        @GalleryStrings.StepDemo_Generate
                    </FlareText>
                </ChildContent>
            </FlareStep>
        </ChildContent>
        <ActionContent Context="ctx">
            <FlareStack Row Wrap Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Center"
                        Gap="FlareSpacing.Medium">
                <FlareButton Variant="ButtonVariant.Tonal" Shape="ButtonShape.Circular"
                             Disabled="ctx.IsFirst" AriaLabel="@GalleryStrings.StepDemo_Previous"
                             OnClick="@(() => ctx.BackAsync())">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowBack" /></LeadingIcon>
                </FlareButton>
                <FlareText Typo="TypographyScale.LabelLarge">@(ctx.ActiveIndex + 1) / @ctx.Count</FlareText>
                <FlareButton Variant="ButtonVariant.Filled" Shape="ButtonShape.Circular"
                             Disabled="ctx.IsLast" AriaLabel="@GalleryStrings.StepDemo_Next"
                             OnClick="@(() => ctx.NextAsync())">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowForward" /></LeadingIcon>
                </FlareButton>
            </FlareStack>
        </ActionContent>
    </FlareStepper>
</FlarePaper>
<FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
    @string.Format(GalleryStrings.StepDemo_Index, _index)
</FlareText>

@code {
    private int _index;

}
