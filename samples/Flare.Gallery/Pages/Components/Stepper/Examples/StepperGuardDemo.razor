<FlareStepper OnStepChanging="GuardAsync">
    <FlareStep Label="@GalleryStrings.StepDemo_Terms" Description="@GalleryStrings.StepDemo_Required">
        <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Gavel" /></IconContent>
        <ChildContent>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.StepDemo_TermsNote
            </FlareText>
            <FlareCheckbox @bind-Value="_agreed" Label="@GalleryStrings.StepDemo_Accept" />
            @if (_blocked)
            {
                <FlareText Color="FlareColor.Error" Typo="TypographyScale.BodySmall">
                    @GalleryStrings.StepDemo_Blocked
                </FlareText>
            }
        </ChildContent>
    </FlareStep>
    <FlareStep Label="@GalleryStrings.StepDemo_Details">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareField TValue="string" Label="@GalleryStrings.StepDemo_Name" Placeholder="@GalleryStrings.StepDemo_NameHint" />
        </FlareStack>
    </FlareStep>
    <FlareStep Label="@GalleryStrings.StepDemo_Done" Description="@GalleryStrings.StepDemo_Confirm">
        <FlareAlert Severity="AlertSeverity.Success" Title="@GalleryStrings.StepDemo_Ready">@GalleryStrings.StepDemo_Passed</FlareAlert>
    </FlareStep>
</FlareStepper>

@code {
    private bool _agreed;
    private bool _blocked;

    // Validate forward moves only; always allow going back. Returning false vetoes the change.
    private Task<bool> GuardAsync(StepperChange change)
    {
        if (change.To <= change.From) { _blocked = false; return Task.FromResult(true); }
        if (change.From == 0 && !_agreed)
        {
            _blocked = true;
            return Task.FromResult(false);
        }
        _blocked = false;
        return Task.FromResult(true);
    }
}
