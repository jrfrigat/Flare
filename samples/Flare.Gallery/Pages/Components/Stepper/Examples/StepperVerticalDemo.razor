<FlareStepper Orientation="StepperOrientation.Vertical" Linear="false" NonLinear="true"
              OnStepChanged="@(i => _step = i)" AriaLabel="@GalleryStrings.StepDemo_Setup">
    <FlareStep Label="@GalleryStrings.StepDemo_Details" Description="@GalleryStrings.StepDemo_AnyOrder">
        <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.StepDemo_NonLinear</FlareText>
    </FlareStep>
    <FlareStep Label="@GalleryStrings.StepDemo_Payment" HasError="true" ErrorText="@GalleryStrings.StepDemo_Declined">
        <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.StepDemo_ErrorNote</FlareText>
    </FlareStep>
    <FlareStep Label="@GalleryStrings.StepDemo_Done" Description="@GalleryStrings.StepDemo_Finish">
        <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.StepDemo_ReadyNote</FlareText>
    </FlareStep>
</FlareStepper>
<FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">
    @string.Format(GalleryStrings.StepDemo_Index, _step)
</FlareText>

@code {
    private int _step;
}
