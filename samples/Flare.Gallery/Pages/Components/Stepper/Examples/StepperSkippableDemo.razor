@* External control + Skippable: the buttons below drive the stepper through @bind-ActiveIndex, and
   the optional middle step is marked Skippable, so the "Review" indicator can be clicked to jump
   straight past it. *@
<FlareStepper @bind-ActiveIndex="_index">
    <FlareStep Label="@GalleryStrings.StepDemo_Plan" Description="@GalleryStrings.StepDemo_PlanNote">
        <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.StepDemo_PlanNote</FlareText>
    </FlareStep>
    <FlareStep Label="@GalleryStrings.StepDemo_Addons" Optional="true" Skippable="true">
        <FlareText Typo="TypographyScale.BodyMedium">
            @GalleryStrings.StepDemo_SkipNote
        </FlareText>
    </FlareStep>
    <FlareStep Label="@GalleryStrings.StepDemo_Review" Description="@GalleryStrings.StepDemo_Confirm">
        <FlareAlert Severity="AlertSeverity.Success" Title="@GalleryStrings.StepDemo_Ready">@GalleryStrings.StepDemo_ReadyNote</FlareAlert>
    </FlareStep>
</FlareStepper>

<FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center" Wrap="true">
    <FlareButton Variant="ButtonVariant.Outlined" Disabled="@(_index == 0)" OnClick="@(() => _index--)">@GalleryStrings.StepDemo_Previous</FlareButton>
    <FlareButton Variant="ButtonVariant.Outlined" Disabled="@(_index >= 2)" OnClick="@(() => _index++)">@GalleryStrings.StepDemo_Next</FlareButton>
    <FlareButton Variant="ButtonVariant.Tonal" Disabled="@(_index == 2)" OnClick="@(() => _index = 2)">@GalleryStrings.StepDemo_Skip</FlareButton>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@string.Format(GalleryStrings.StepDemo_BoundIndex, _index)</FlareText>
</FlareStack>

@code {
    // @bind-ActiveIndex makes the stepper fully controlled: setting _index from the buttons moves it,
    // and a step-indicator click writes the new index straight back here.
    private int _index;
}
