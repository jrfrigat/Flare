@inherits LocalizedPage

<FlareCard Variant="CardVariant.Outlined" Height="320px" Padding="FlareSpacing.None">
    <FlareLayout>
        @* Dense = a slimmer 48px bar; Height (any CSS length) would override it. *@
        <FlareLayoutAppBar Dense="true" DrawerToggle="true">
            <FlareText Typo="TypographyScale.TitleMedium">@GalleryStrings.LayoutShell_Density</FlareText>
            <FlareStack Row Wrap FlexGrow="1" />
            <FlareAvatar FallbackIcon="@MaterialDesign3Icons.Regular.AccountCircle" Size="AvatarSize.Sm" />
        </FlareLayoutAppBar>

        <FlareLayoutDrawer @bind-Open="_open" Variant="DrawerVariant.Persistent" Width="12rem">
            <FlareStack Padding="FlareSpacing.Custom" PaddingValue="0.75rem 0.5rem">
                <FlareNavMenu>
                    <FlareNavLink Href="#" Match="NavMatchMode.Exact">
                        <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Dashboard" /></IconContent>
                        <ChildContent>@GalleryStrings.Nav_Overview</ChildContent>
                    </FlareNavLink>
                    <FlareNavLink Href="#">
                        <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Settings" /></IconContent>
                        <ChildContent>@GalleryStrings.Settings_Title</ChildContent>
                    </FlareNavLink>
                </FlareNavMenu>
            </FlareStack>
        </FlareLayoutDrawer>

        <FlareLayoutContent>
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">
                @GalleryStrings.LayoutShell_DensityDesc
            </FlareText>
        </FlareLayoutContent>
    </FlareLayout>
</FlareCard>

@code {
    private bool _open = true;
}
