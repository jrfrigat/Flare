@inherits LocalizedPage

@* A phone-width bar. At 200% text its icon controls stop growing at the bar's height, so the trailing
   block stays inside the bar and the title truncates instead of being covered. *@
<FlareCard Variant="CardVariant.Outlined" Width="360px" MaxWidth="100%" Height="240px" Padding="FlareSpacing.None">
    <FlareLayout>
        <FlareLayoutAppBar>
            <FlareText Typo="TypographyScale.TitleLarge" MaxLines="1" FlexGrow="1">@GalleryStrings.LayoutShell_Title</FlareText>
            <FlareColorModeToggle ShowLabel="false" />
            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Search" AriaLabel="@GalleryStrings.Icons_Search" />
            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Settings" AriaLabel="@GalleryStrings.Settings_Title" />
        </FlareLayoutAppBar>

        <FlareLayoutContent>
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">
                @GalleryStrings.LayoutShell_NarrowAppBarDesc
            </FlareText>
        </FlareLayoutContent>
    </FlareLayout>
</FlareCard>
