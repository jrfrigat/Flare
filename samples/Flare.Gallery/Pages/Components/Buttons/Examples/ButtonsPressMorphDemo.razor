@inherits LocalizedPage

<FlareStack Gap="FlareSpacing.Medium">
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
        @GalleryStrings.Buttons_PressMorph_Hint
    </FlareText>

    <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Center">
        <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Xs">Xs</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm">Sm</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Md">Md</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Lg">Lg</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Xl">Xl</FlareButton>
    </FlareStack>

    @* Square asks for sharp corners outright, so it has nothing to travel to and stays put. *@
    <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Center">
        <FlareButton Variant="ButtonVariant.Tonal" Shape="ButtonShape.Circular">Circular</FlareButton>
        <FlareButton Variant="ButtonVariant.Tonal" Shape="ButtonShape.Rounded">Rounded</FlareButton>
        <FlareButton Variant="ButtonVariant.Tonal" Shape="ButtonShape.Square">Square</FlareButton>
    </FlareStack>
</FlareStack>
