@using Flare.Gallery.Resources

<FlareStack MaxWidth="36rem">
    <FlareFileUploadZone OnFilesChanged="HandleDropped2" Accept=".jpg,.png,.gif,.webp" MaxFileSize="@(5 * 1024 * 1024)" Multiple="false">
        <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Padding="FlareSpacing.Custom" PaddingValue="1rem">
            <FlareAvatar FallbackIcon="@MaterialDesign3Icons.Regular.Image" Size="AvatarSize.Lg" Color="FlareColor.Primary" />
            <FlareText Typo="TypographyScale.TitleSmall">@GalleryStrings.FileUpload_AvatarTitle</FlareText>
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">@GalleryStrings.FileUpload_AvatarHint</FlareText>
        </FlareStack>
    </FlareFileUploadZone>
    @if (_avatarName is not null)
    {
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">@string.Format(GalleryStrings.FileUpload_AvatarSelected, _avatarName)</FlareText>
    }
</FlareStack>

@code {
    private string? _avatarName;

    private void HandleDropped2(IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile> files)
        => _avatarName = files.FirstOrDefault()?.Name;
}
