@* The transfer is the application's, not Flare's: Uploader is a delegate, so anything you can write with
   an HttpClient works - including a presigned PUT or a token that refreshes mid-upload. This demo fakes
   the wire so the page needs no server, and reports progress exactly as a real transfer would. *@
<FlareStack Style="max-width:36rem;">
    <FlareFileUploadZone Uploader="FakeTransfer"
                         Auto="true"
                         Multiple="true"
                         Concurrency="2"
                         OnUploadCompleted="@(f => Log($"done: {f.File.Name}"))"
                         OnUploadFailed="@(f => Log($"failed: {f.File.Name} - {f.Error}"))" />

    <FlareStack Row Wrap Gap="FlareSpacing.Small" Style="margin-top:0.75rem;">
        <FlareCheckbox Value="_failNext" ValueChanged="@(v => _failNext = v == true)" Label="Fail the next transfer" />
        <FlareCheckbox Value="_slow" ValueChanged="@(v => _slow = v == true)" Label="Slow transfer" />
    </FlareStack>

    @if (_log.Count > 0)
    {
        <FlareStack Gap="FlareSpacing.XSmall" Style="margin-top:0.75rem;">
            @foreach (var line in _log)
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@line</FlareText>
            }
        </FlareStack>
    }
</FlareStack>

@code {
    private readonly List<string> _log = [];
    private bool _failNext;
    private bool _slow;

    // A stand-in for the application's transfer. A real one would POST, PUT to a presigned URL, or speak
    // a resumable protocol; all Flare needs back is the running byte count and an exception on failure.
    private async Task FakeTransfer(FlareUploadContext ctx)
    {
        var step = Math.Max(1, ctx.File.Size / 20);
        var delay = _slow ? 220 : 60;

        for (long sent = 0; sent < ctx.File.Size; sent += step)
        {
            await Task.Delay(delay, ctx.CancellationToken);
            ctx.Progress.Report(Math.Min(sent + step, ctx.File.Size));

            if (_failNext && sent >= ctx.File.Size / 2)
            {
                _failNext = false;
                throw new InvalidOperationException("413 Payload Too Large");
            }
        }
    }

    private void Log(string line)
    {
        _log.Insert(0, line);
        if (_log.Count > 5) _log.RemoveAt(_log.Count - 1);
    }
}
