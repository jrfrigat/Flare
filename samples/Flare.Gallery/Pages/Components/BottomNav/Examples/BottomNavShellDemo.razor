@* Position="Fixed" pins the bar to the bottom of the VIEWPORT with the safe-area inset intact, and
   ReserveSpace (on by default) keeps a same-height spacer in the flow so the last row of content is
   never hidden behind it. That is the whole app-shell CSS a PWA used to have to write by hand.

   In a real app the bar is meant to span the window; this demo has to keep it inside a phone-sized
   frame, so the frame carries `contain: layout paint`, which makes it the containing block a fixed
   descendant resolves against. (`position: relative` does NOT do that - only containment, a transform
   or a filter does.) *@
<FlareCard Variant="CardVariant.Outlined"
           Style="width:360px;height:420px;padding:0;overflow:hidden;contain:layout paint;display:flex;flex-direction:column;">
    <FlareCardContent Style="flex:1;overflow:auto;">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareText Typo="TypographyScale.TitleMedium">Today</FlareText>
            @foreach (var item in _feed)
            {
                <FlareCard Variant="CardVariant.Filled">
                    <FlareCardHeader Title="@item" Subtitle="Scroll to the bottom" />
                </FlareCard>
            }
            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
                The spacer keeps this last line above the bar.
            </FlareText>
        </FlareStack>
    </FlareCardContent>

    <FlareBottomNav Position="BottomNavPosition.Fixed">
        <FlareBottomNavItem Href="#home" Active="true">
            <IconContent><FlareIconView Value="@FlareIcons.Home" /></IconContent>
            <ChildContent>Home</ChildContent>
        </FlareBottomNavItem>
        <FlareBottomNavItem Href="#search">
            <IconContent><FlareIconView Value="@FlareIcons.Search" /></IconContent>
            <ChildContent>Search</ChildContent>
        </FlareBottomNavItem>
        <FlareBottomNavItem Href="#saved">
            <IconContent><FlareIconView Value="@FlareIcons.Favorite" /></IconContent>
            <ChildContent>Saved</ChildContent>
        </FlareBottomNavItem>
        <FlareBottomNavItem Href="#profile">
            <IconContent><FlareIconView Value="@FlareIcons.Person" /></IconContent>
            <ChildContent>Profile</ChildContent>
        </FlareBottomNavItem>
    </FlareBottomNav>
</FlareCard>

@code {
    private static readonly string[] _feed =
        ["Napoleon", "Medovik", "Sacher", "Red velvet", "Carrot", "Tiramisu", "Pavlova"];
}
