@inject ISnackbarService Snackbar

<FlareStack Gap="FlareSpacing.None">
    <FlareStack Row Wrap Gap="FlareSpacing.Medium" MarginBlockEnd="FlareSpacing.Custom" MarginBlockEndValue="1rem">
        <FlareButton @ref="_darkTrigger" OnClick="OpenDark">Show dark overlay</FlareButton>
        <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => _loadingOpen = true)">Show loading overlay</FlareButton>
    </FlareStack>
    <FlareCard Variant="CardVariant.Text" Height="6rem" Padding="FlareSpacing.None"
               Background='FlareColor.Custom("var(--flare-color-surface-container-low)")'>
        <FlareStack Row Height="100%" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Center" Gap="FlareSpacing.None">
            <FlareText Typo="TypographyScale.BodyMedium">Scoped overlay area - click button above to overlay it</FlareText>
        </FlareStack>
        <FlareOverlay Open="@_loadingOpen" Absolute="true" Opacity="0.7" OnBackdropClick="@(() => _loadingOpen = false)">
            <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Foreground='FlareColor.Custom("#fff")'>
                <FlareProgressCircular />
                <FlareText Typo="TypographyScale.LabelMedium">Loading…</FlareText>
            </FlareStack>
        </FlareOverlay>
    </FlareCard>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">Click the overlay to dismiss.</FlareText>
    @* The overlay is the backdrop only. The panel inside it wears the dialog role, closes on Escape and
       returns focus to the trigger; a focus trap and scroll lock are FlareDialog's job, not this one's. *@
    <FlareOverlay Open="@_darkOpen" OnBackdropClick="CloseDarkAsync">
        <FlareStack role="dialog" aria-labelledby="overlay-demo-title" tabindex="-1" @onkeydown="HandleDarkKey"
                    MaxWidth="24rem" Margin="FlareSpacing.Custom" MarginValue="6rem auto 0">
            <FlareCard Padding="FlareSpacing.Custom" PaddingValue="1.5rem">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareText id="overlay-demo-title" Typo="TypographyScale.TitleMedium">@GalleryStrings.Overlay_DemoTitle</FlareText>
                    <FlareText Typo="TypographyScale.BodyMedium">@GalleryStrings.Overlay_DemoBody</FlareText>
                    <FlareStack Row Justify="FlareJustifyContent.End">
                        <FlareButton @ref="_darkClose" Variant="ButtonVariant.Filled" OnClick="CloseDarkAsync">@GalleryStrings.Overlay_DemoClose</FlareButton>
                    </FlareStack>
                </FlareStack>
            </FlareCard>
        </FlareStack>
    </FlareOverlay>
</FlareStack>

@code {
    private bool _darkOpen;
    private bool _loadingOpen;
    private bool _focusClose;
    private FlareButton? _darkTrigger;
    private FlareButton? _darkClose;

    private void OpenDark()
    {
        _darkOpen = true;
        _focusClose = true;
    }

    private async Task CloseDarkAsync()
    {
        if (!_darkOpen) return;
        _darkOpen = false;
        try { if (_darkTrigger is not null) await _darkTrigger.FocusAsync(); }
        catch (JSException) { }
    }

    private Task HandleDarkKey(KeyboardEventArgs e)
        => e.Key == "Escape" ? CloseDarkAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_darkOpen || !_focusClose) return;
        _focusClose = false;
        try { if (_darkClose is not null) await _darkClose.FocusAsync(); }
        catch (JSException) { }
    }
}
