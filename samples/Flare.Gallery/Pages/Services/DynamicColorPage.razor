@page "/services/dynamic-color"
@inherits LocalizedPage
@using Microsoft.AspNetCore.Components.Forms
@inject IFlareColorExtractor Extractor

<PageTitle>@GalleryStrings.Services_DynamicTitle - Flare</PageTitle>

<GalleryPageTitle>
    <FlareText Typo="TypographyScale.HeadlineMedium">@GalleryStrings.Services_DynamicTitle</FlareText>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyLarge">@GalleryStrings.Services_DynamicSubtitle</FlareText>
</GalleryPageTitle>

<FlareStack Gap="FlareSpacing.Large">

    <FlareAlert Severity="AlertSeverity.Info">@GalleryStrings.Services_DynamicAccentNote</FlareAlert>

    @* ---- Source picker ---------------------------------------------------------------- *@
    <FlareCard Variant="CardVariant.Outlined">
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareStack Row Wrap Gap="FlareSpacing.Medium" Align="FlareAlignItems.Center">
                <FlareFileUploadButton Variant="ButtonVariant.Tonal" Accept="image/*" OnFilesChanged="OnFilesAsync">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Upload" Size="1.25rem" /></LeadingIcon>
                    <ChildContent>@GalleryStrings.Services_DynamicUpload</ChildContent>
                </FlareFileUploadButton>
                <FlareStack FlexGrow="1" FlexBasis="0" MinWidth="16rem">
                    <FlareField TValue="string" @bind-Value="_url" Label="@GalleryStrings.Services_DynamicUrl"
                                Placeholder="https://..." />
                </FlareStack>
                <FlareButton Variant="ButtonVariant.Filled" OnClick="LoadUrlAsync">@GalleryStrings.Services_DynamicLoad</FlareButton>
            </FlareStack>
            <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
                <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.LabelSmall">@GalleryStrings.Services_DynamicHint</FlareText>
                <FlareChip Color="@_dynamic">@_seed</FlareChip>
            </FlareStack>
            @if (!string.IsNullOrEmpty(_fileError))
            {
                <FlareStack MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">
                    <FlareAlert Severity="AlertSeverity.Error">@_fileError</FlareAlert>
                </FlareStack>
            }
        </FlareStack>
    </FlareCard>

    @* ---- "Music player" themed by the extracted color --------------------------------- *@
    <FlareStack MaxWidth="24rem">
        <FlareColorScope Color="_dynamic">
        <FlareCard Padding="FlareSpacing.Custom" PaddingValue="1.25rem" Overflow="hidden">
            <FlareStack Gap="FlareSpacing.Medium" Align="FlareAlignItems.Stretch">
                @* Cover *@
                <FlareCard Background="@ContainerFill" Height="16rem" Padding="FlareSpacing.None"
                           Overflow="hidden" Variant="CardVariant.Filled">
                    @if (_imageUrl is not null)
                    {
                        <FlareImage Src="@_imageUrl" Alt="cover" Width="100%" Height="100%" />
                    }
                    else
                    {
                        <FlareStack Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Center" Height="100%">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.MusicNote" Size="4rem" Color="@OnContainer" />
                        </FlareStack>
                    }
                </FlareCard>

                @* Track info *@
                <FlareStack Gap="FlareSpacing.None">
                    <FlareText Typo="TypographyScale.LabelSmall">@GalleryStrings.Services_DynamicNowPlaying</FlareText>
                    <FlareText Typo="TypographyScale.TitleLarge">@GalleryStrings.Services_DynamicTrack</FlareText>
                    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">@GalleryStrings.Services_DynamicArtist</FlareText>
                </FlareStack>

                @* Progress (dynamic accent) *@
                <FlareProgressLinear Value="38" Color="@_dynamic" />

                @* Transport controls *@
                <FlareStack Row Justify="FlareJustifyContent.SpaceBetween" Align="FlareAlignItems.Center">
                    <FlareButton Variant="ButtonVariant.Text" Color="@_dynamic" AriaLabel="Shuffle"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Shuffle" /></LeadingIcon></FlareButton>
                    <FlareButton Variant="ButtonVariant.Text" Color="@_dynamic" AriaLabel="Previous"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.SkipPrevious" /></LeadingIcon></FlareButton>
                    <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Lg" Color="@_dynamic" AriaLabel="Play"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.PlayArrow" /></LeadingIcon></FlareButton>
                    <FlareButton Variant="ButtonVariant.Text" Color="@_dynamic" AriaLabel="Next"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.SkipNext" /></LeadingIcon></FlareButton>
                    <FlareButton Variant="ButtonVariant.Text" Color="@_dynamic" AriaLabel="Repeat"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Repeat" /></LeadingIcon></FlareButton>
                </FlareStack>
            </FlareStack>
        </FlareCard>
        </FlareColorScope>
    </FlareStack>
    <FlareText Typo="TypographyScale.TitleSmall" MarginBlockStart="FlareSpacing.Custom" MarginBlockStartValue="0.5rem">@GalleryStrings.Services_Usage</FlareText>
    <FlareCodeBlock Value="@_usage" Language="razor" ReadOnly="true" LineNumbers="true" />
</FlareStack>

@code {
    private string _seed = "#6750A4";

    private const string _usage = """
        @inject IFlareColorExtractor Extractor

        <FlareButton Color="_accent">Play</FlareButton>

        @code {
            FlareColor _accent = FlareColor.Primary;

            async Task FromCover(string imageUrl)
            {
                var seed = await Extractor.GetDominantColorAsync(imageUrl);
                if (seed is not null)
                    _accent = FlareColor.Dynamic(seed);   // harmonized, contrast-safe, light/dark
            }
        }
        """;
    private string _url = "";
    private string? _imageUrl;

    private FlareColor _dynamic => FlareColor.Dynamic(_seed);

    private static readonly FlareColor ContainerFill = FlareColor.Custom("var(--fc-container)");
    private static readonly FlareColor OnContainer = FlareColor.Custom("var(--fc-on-container)");

    private const long MaxFileSize = 50 * 1024 * 1024; // 50 MB
    private string? _fileError;

    private async Task OnFilesAsync(IReadOnlyList<IBrowserFile> files)
    {
        _fileError = null;
        if (files.Count == 0) return;
        var file = files[0];
        if (file.Size > MaxFileSize)
        {
            _fileError = $"File size ({file.Size / 1024 / 1024} MB) exceeds maximum ({MaxFileSize / 1024 / 1024} MB).";
            return;
        }
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxFileSize).CopyToAsync(ms);
            _imageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            await ExtractAsync();
        }
        catch (Exception ex)
        {
            _fileError = $"Error reading file: {ex.Message}";
        }
    }

    private async Task LoadUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_url)) return;
        _imageUrl = _url.Trim();
        await ExtractAsync();
    }

    private async Task ExtractAsync()
    {
        if (_imageUrl is null) return;
        var seed = await Extractor.GetDominantColorAsync(_imageUrl);
        if (!string.IsNullOrWhiteSpace(seed)) _seed = seed!;
    }
}
