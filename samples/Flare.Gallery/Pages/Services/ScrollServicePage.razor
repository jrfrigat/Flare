@page "/services/scroll"
@inherits LocalizedPage
@inject IScrollService Scroll
@implements IAsyncDisposable

<PageTitle>@GalleryStrings.Services_ScrollTitle - Flare</PageTitle>

<GalleryPageTitle>
    <FlareText Typo="TypographyScale.HeadlineMedium">@GalleryStrings.Services_ScrollTitle</FlareText>
    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyLarge">@GalleryStrings.Services_ScrollSubtitle</FlareText>
</GalleryPageTitle>

@* The Gallery scrolls an inner shell panel rather than the page, which is exactly the case a selector
   target exists for: the panel belongs to the layout, so this page has no reference to it. *@
<FlareCard Variant="CardVariant.Outlined" MaxWidth="36rem">
    <FlareStack Gap="FlareSpacing.Medium">
        @* FlareProgressLinear reads a 0..100 percentage, so the 0..1 progress is scaled here. *@
        <FlareProgressLinear Value="@(_progress * 100)" />
        <FlareStack Row Wrap Gap="FlareSpacing.Large">
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_Offset <FlareCode>@_top.ToString("F0")</FlareCode>
            </FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_Progress <FlareCode>@_progress.ToString("P0")</FlareCode>
            </FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_Direction <FlareCode>@_direction</FlareCode>
            </FlareText>
        </FlareStack>
        <FlareStack Row Wrap Gap="FlareSpacing.Small">
            <FlareButton OnClick="@(() => Scroll.ScrollToEndAsync(Panel).AsTask())">@GalleryStrings.Services_Scroll_ToEnd</FlareButton>
            <FlareButton Variant="ButtonVariant.Tonal" OnClick="@(() => Scroll.ScrollToTopAsync(Panel).AsTask())">@GalleryStrings.Services_Scroll_ToTop</FlareButton>
        </FlareStack>
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
            @GalleryStrings.Services_Scroll_Hint
        </FlareText>
    </FlareStack>
</FlareCard>

@* One subscription, both axes, on a box this page owns - so the demo is testable on its own rather
   than depending on the page being long enough to scroll. Both panels are watched by selector: the
   layout's own content box, and the strip below. *@
<FlareText Typo="TypographyScale.TitleSmall" Margin="FlareSpacing.Custom" MarginValue="1.75rem 0 0.5rem">@GalleryStrings.Services_Scroll_HorizontalTitle</FlareText>

<FlareCard Variant="CardVariant.Outlined" MaxWidth="36rem">
    <FlareStack Gap="FlareSpacing.Medium">
        <FlareStack id="@StripId" Overflow="auto" Height="11rem">
            @* foreach, not for: the inner FlareStack turns its children into a RenderFragment that runs
               after the loop has finished, and a `for` variable is one variable for the whole loop - every
               row would render the value it held on exit. A foreach variable is per-iteration. *@
            <FlareStack Gap="FlareSpacing.Small" Width="max-content">
                @foreach (var row in Enumerable.Range(1, 12))
                {
                    <FlareStack Row Gap="FlareSpacing.Small">
                        @foreach (var col in Enumerable.Range(1, 12))
                        {
                            <FlareChip Variant="ChipVariant.Outlined" Label="@($"{row}.{col}")" />
                        }
                    </FlareStack>
                }
            </FlareStack>
        </FlareStack>
        <FlareStack Row Gap="FlareSpacing.Small">
            <FlareStack FlexGrow="1" MinWidth="0">
                <FlareProgressLinear Value="@(_stripProgress * 100)" />
            </FlareStack>
            <FlareStack FlexGrow="1" MinWidth="0">
                <FlareProgressLinear Value="@(_hProgress * 100)" />
            </FlareStack>
        </FlareStack>
        <FlareStack Row Wrap Gap="FlareSpacing.Large">
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_Offset <FlareCode>@_stripTop.ToString("F0")</FlareCode>
            </FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_Progress <FlareCode>@_stripProgress.ToString("P0")</FlareCode>
            </FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_Direction <FlareCode>@_stripDirection</FlareCode>
            </FlareText>
        </FlareStack>
        <FlareStack Row Wrap Gap="FlareSpacing.Large">
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_HScroll <FlareCode>@_left.ToString("F0")</FlareCode>
            </FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_HProgress <FlareCode>@_hProgress.ToString("P0")</FlareCode>
            </FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_HDirection <FlareCode>@_hDirection</FlareCode>
            </FlareText>
        </FlareStack>
        <FlareStack Row Wrap Gap="FlareSpacing.Large">
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_Overflows <FlareCode>@_overflows</FlareCode>
            </FlareText>
            <FlareText Typo="TypographyScale.BodyMedium">
                @GalleryStrings.Services_Scroll_AtEdges <FlareCode>@_edges</FlareCode>
            </FlareText>
        </FlareStack>
        <FlareStack Row Wrap Gap="FlareSpacing.Small">
            <FlareButton Variant="ButtonVariant.Tonal" OnClick="@(() => Scroll.ScrollToEndAsync(Strip).AsTask())">@GalleryStrings.Services_Scroll_ToEnd</FlareButton>
            <FlareButton Variant="ButtonVariant.Tonal" OnClick="@(() => Scroll.ScrollToTopAsync(Strip).AsTask())">@GalleryStrings.Services_Scroll_ToTop</FlareButton>
        </FlareStack>
        <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">
            @GalleryStrings.Services_Scroll_HorizontalHint
        </FlareText>
    </FlareStack>
</FlareCard>

<FlareText Typo="TypographyScale.TitleSmall" Margin="FlareSpacing.Custom" MarginValue="1.75rem 0 0.5rem">@GalleryStrings.Services_Usage</FlareText>
<FlareCodeBlock Value="@_usage" Language="razor" ReadOnly="true" LineNumbers="true" />

@code {
    // The Gallery's own scroll container. An app that scrolls the page passes nothing at all.
    private const string Panel = ".flare-layout-content";

    // The strip below carries an id, so this page can hand the scroll service a selector instead of an
    // element reference - the same way it watches the layout's panel.
    private const string StripId = "scroll-demo-strip";
    private const string Strip = "#" + StripId;

    private double _top;
    private double _progress;
    private ScrollDirection _direction = ScrollDirection.None;
    private IAsyncDisposable? _sub;

    private double _left;
    private double _hProgress;
    private ScrollDirection _hDirection = ScrollDirection.None;
    private double _stripTop;
    private double _stripProgress;
    private ScrollDirection _stripDirection = ScrollDirection.None;
    private string _overflows = "-";
    private string _edges = "-";
    private IAsyncDisposable? _stripSub;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _sub = await Scroll.SubscribeAsync(OnScrolled, Panel, new ScrollSubscribeOptions { ThrottleMs = 60 });
        _stripSub = await Scroll.SubscribeAsync(OnStripScrolled, Strip, new ScrollSubscribeOptions { ThrottleMs = 60 });
    }

    private Task OnScrolled(ScrollChange change)
    {
        _top = change.Top;
        _progress = change.Progress;
        if (change.Direction != ScrollDirection.None) _direction = change.Direction;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnStripScrolled(ScrollChange change)
    {
        _left = change.Left;
        _hProgress = change.HorizontalProgress;
        if (change.HorizontalDirection != ScrollDirection.None) _hDirection = change.HorizontalDirection;
        _stripTop = change.Top;
        _stripProgress = change.Progress;
        if (change.Direction != ScrollDirection.None) _stripDirection = change.Direction;
        _overflows = $"x {change.OverflowsHorizontally} / y {change.OverflowsVertically}";
        _edges = change.AtHorizontalStart ? "start" : change.AtHorizontalEnd ? "end" : "-";
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_sub is not null) await _sub.DisposeAsync();
        if (_stripSub is not null) await _stripSub.DisposeAsync();
    }

    private const string _usage = """
        @inject IScrollService Scroll
        @implements IAsyncDisposable

        @code {
            IAsyncDisposable? _sub;
            bool _barVisible = true;

            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (!firstRender) return;

                // The page by default; pass an ElementReference or a CSS selector for a container.
                _sub = await Scroll.SubscribeAsync(OnScrolled, options: new ScrollSubscribeOptions
                {
                    DirectionOnly = true,      // only wake me when the reader turns around
                    DirectionThreshold = 8,    // and not for trackpad jitter
                });
            }

            Task OnScrolled(ScrollChange c)
            {
                _barVisible = c.Direction == ScrollDirection.Up || c.AtStart;
                return InvokeAsync(StateHasChanged);
            }

            // Both axes come off the same notification. For a carousel or a horizontal
            // timeline, name the axis so the direction filter watches that one instead:
            //   new ScrollSubscribeOptions { DirectionOnly = true, Axis = ScrollAxis.Horizontal }
            // then read c.HorizontalDirection / c.HorizontalProgress / c.AtHorizontalEnd.

            public async ValueTask DisposeAsync()
            {
                if (_sub is not null) await _sub.DisposeAsync();
            }
        }
        """;
}
