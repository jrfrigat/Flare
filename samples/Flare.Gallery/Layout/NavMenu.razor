@inherits LocalizedPage
@using Flare.Gallery.Models

@* Primary navigation rail: the top-level sections. Plain pages (Overview, Getting started) navigate;
   the section triggers (Themes, Components, Services, API) toggle the secondary drawer instead of
   navigating, so clicking one reveals that section's pages in the column to the right.

   Every Href here (and everywhere else in the gallery) is base-relative - no leading slash, and ""
   for the home page. The gallery ships to a site root (Docker/nginx) AND to a sub-path (GitHub Pages
   serves it under /Flare/); "/x" resolves against the ORIGIN, ignoring <base href>, so a leading
   slash silently navigates out of the app on Pages and breaks FlareNavLink's active matching too. *@
<FlareNavMenu Mode="Mode">
    <FooterContent>
        <FlareNavLink Href="settings" Tooltip="@GalleryStrings.Settings_Title">
            <IconContent><FlareIconView Size="1.25rem" Value="@MaterialDesign3Icons.Regular.Settings" /></IconContent>
            <ChildContent>@GalleryStrings.Settings_Title</ChildContent>
        </FlareNavLink>
    </FooterContent>
    <ChildContent>
        <FlareNavLink Href="" Match="NavMatchMode.Exact">
            <IconContent><FlareIconView Size="1.25rem" Value="@MaterialDesign3Icons.Regular.Home" /></IconContent>
            <ChildContent>@GalleryStrings.Nav_Overview</ChildContent>
        </FlareNavLink>
        <FlareNavLink OnClick="@(() => ToggleSection(GallerySection.Guide))" Active="@(RouteSection == GallerySection.Guide)">
            <IconContent><FlareIconView Size="1.25rem" Value="@MaterialDesign3Icons.Regular.MenuBook" /></IconContent>
            <ChildContent>@GalleryStrings.Nav_Guide</ChildContent>
        </FlareNavLink>

        <FlareNavLink OnClick="@(() => ToggleSection(GallerySection.Themes))" Active="@(RouteSection == GallerySection.Themes)">
            <IconContent><FlareIconView Size="1.25rem" Value="@MaterialDesign3Icons.Regular.Palette" /></IconContent>
            <ChildContent>@GalleryStrings.Nav_Theming</ChildContent>
        </FlareNavLink>
        <FlareNavLink OnClick="@(() => ToggleSection(GallerySection.Components))" Active="@(RouteSection == GallerySection.Components)">
            <IconContent><FlareIconView Size="1.25rem" Value="@MaterialDesign3Icons.Regular.Category" /></IconContent>
            <ChildContent>@GalleryStrings.Nav_Components</ChildContent>
        </FlareNavLink>
        <FlareNavLink OnClick="@(() => ToggleSection(GallerySection.Services))" Active="@(RouteSection == GallerySection.Services)">
            <IconContent><FlareIconView Size="1.25rem" Value="@MaterialDesign3Icons.Regular.Bolt" /></IconContent>
            <ChildContent>@GalleryStrings.Nav_Services</ChildContent>
        </FlareNavLink>
        <FlareNavLink OnClick="@(() => ToggleSection(GallerySection.Api))" Active="@(RouteSection == GallerySection.Api)">
            <IconContent><FlareIconView Size="1.25rem" Value="@MaterialDesign3Icons.Regular.DataObject" /></IconContent>
            <ChildContent>@GalleryStrings.Nav_Api</ChildContent>
        </FlareNavLink>
    </ChildContent>
</FlareNavMenu>

@code {
    /// <summary>How the primary rail renders (labeled rail when collapsed, full when expanded).</summary>
    [Parameter] public NavMenuMode Mode { get; set; } = NavMenuMode.RailLabeled;
    /// <summary>The currently open section (drives the secondary drawer). Supports <c>@bind-Section</c>.</summary>
    [Parameter] public GallerySection Section { get; set; }
    /// <summary>Raised when a section trigger toggles the open section.</summary>
    [Parameter] public EventCallback<GallerySection> SectionChanged { get; set; }
    /// <summary>The section of the current route -- highlights its trigger so the rail shows where you are.</summary>
    [Parameter] public GallerySection RouteSection { get; set; }

    // Clicking the open section closes the secondary drawer; clicking another switches to it.
    private Task ToggleSection(GallerySection s)
        => SectionChanged.InvokeAsync(Section == s ? GallerySection.None : s);
}
